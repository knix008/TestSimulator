{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyQRGenerator",
  "mainBinaryName": "MyQRGenerator",
  "version": "1.0.0",
  "identifier": "com.shkwon.qrgenerator",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": { "script": "node scripts/build-wasm.js", "wait": true },
    "beforeBuildCommand": "node scripts/build-wasm.js"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "appimage", "deb"],
    "publisher": "SHKWON",
    "copyright": "SHKWON <knix008@naver.com>",
    "category": "Utility",
    "shortDescription": "MyQRGenerator",
    "longDescription": "MyQRGenerator creates QR codes with a Rust encoder and a JavaScript designer: text, URL, Wi-Fi, contact, email, SMS, phone and location codes, custom styles, logos, PNG and SVG export.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "displayLanguageSelector": true,
        "languages": ["English", "Korean"],
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
