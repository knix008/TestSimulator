<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <Platforms>x64</Platforms>
    <OutputName>CompareMasterWinV10Setup</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <SuppressValidation>true</SuppressValidation>
    <OutputPath>$(MSBuildThisFileDirectory)bin\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>$(MSBuildThisFileDirectory)obj\$(Configuration)\</IntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="6.0.2" />
  </ItemGroup>

  <!-- Publish the app before packaging. Only runs when Configuration=Release. -->
  <Target Name="PublishForInstaller" BeforeTargets="PrepareForBuild" Condition="'$(Configuration)' == 'Release'">
    <Exec Command="cmd /c taskkill /IM CompareMasterWinV10.App.exe /F &gt;nul 2&gt;&amp;1" IgnoreExitCode="true" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\.."
          Command="dotnet publish &quot;$(MSBuildProjectDirectory)\..\CompareMasterWinV10.App\CompareMasterWinV10.App.csproj&quot; -c Release -r win-x64 --self-contained false -p:SkipInstaller=true" />
  </Target>
</Project>
