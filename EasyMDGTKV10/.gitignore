# =====================================================================
#  EasyMD GTK - .gitignore
# =====================================================================

# ---------------------------------------------------------------------
# 1. 빌드 산출물
# ---------------------------------------------------------------------
*.o
*.obj
*.a
*.so
*.so.*
*.dylib
*.out
*.exe

# 메인 실행 파일 (Makefile TARGET)
easymd

# 코어 단독 컴파일 산출물 (`make core-only`)
*.core.o

# 빌드/배포 디렉터리
build/
dist/
out/

# ---------------------------------------------------------------------
# 2. 컴파일러 생성물
# ---------------------------------------------------------------------
*.d
*.dep
*.gcda
*.gcno
*.gcov

# ---------------------------------------------------------------------
# 3. 디버깅 / 분석
# ---------------------------------------------------------------------
*.log
build.log
vgcore.*
core
core.*

# ---------------------------------------------------------------------
# 4. 의존성/패키지 캐시
# ---------------------------------------------------------------------
.deps/
*.tar.gz
*.zip
*.deb
*.rpm

# ---------------------------------------------------------------------
# 5. 임시/백업 파일
# ---------------------------------------------------------------------
*.swp
*.swo
*.swn
*~
.*.tmp
*.tmp
*.temp
*.bak
*.orig
*.rej

# ---------------------------------------------------------------------
# 6. OS 메타파일
# ---------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------
# 7. IDE / 에디터 파일
# ---------------------------------------------------------------------
.vscode/
.idea/
*.sublime-*
*.code-workspace
.project
.cproject
.settings/
*.iml
.cache/
compile_commands.json
.clangd/
.clang-format-bak

# ---------------------------------------------------------------------
# 8. 로컬 런처/설치 흔적
#
#    `make install-desktop` 은 ~/.local/share 에 결과물을 만들기 때문에
#    저장소 밖이라 따로 무시할 필요는 없습니다. 다만 sed/cp 가 남길 수
#    있는 백업/임시 파일과 GTK 가 자동 생성하는 아이콘 캐시는 제외합니다.
# ---------------------------------------------------------------------
*.desktop~
.icon-theme.cache
icon-theme.cache

# 빌드 트리에서 어쩌다 떨어질 수 있는 macOS 번들/아이콘 변환 산출물.
# 원본 daemon_hammer.{ico,png,jpg} 는 의도적으로 커밋합니다.
*.app/
*.icns
daemon_hammer.iconset/

# ---------------------------------------------------------------------
# 9. 테스트 / 스크래치 마크다운
#    (편집기 동작 확인용으로 만든 .md 가 커밋되지 않도록)
# ---------------------------------------------------------------------
/tmp_*.md
/scratch/
/sandbox/
/test_*.md
/notes_local.md

# 사용자 환경에서 만들어지는 미리보기 / 변환 파일
*.html.tmp
preview_*.html

# ---------------------------------------------------------------------
# 10. 의도적으로 트래킹되는 파일 (참고용)
# ---------------------------------------------------------------------
# - daemon_hammer.ico        : 앱/창/About 로고 (런타임에 직접 로드)
# - easymd.desktop           : GNOME 런처 정의 (install-desktop 의 입력)
# - Makefile                 : 빌드 정의
# - source/*.c               : C 소스 파일
# - include/*.h              : 헤더 파일
# - style/modern.css         : GTK CSS 테마
# - example/example.md       : 기본 예제 문서
