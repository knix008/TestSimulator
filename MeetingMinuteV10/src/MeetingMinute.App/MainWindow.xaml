<Window x:Class="MeetingMinute.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="회의록 — Meeting Minute"
        Height="780" Width="1080"
        MinHeight="560" MinWidth="880"
        Background="{StaticResource BrushBgDeep}"
        Foreground="{StaticResource BrushText}"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        FontSize="14"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="20">
        <!-- 상단 툴바 -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource BrushBgPanel}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="10,6"
                Margin="0,0,0,16" Height="103">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Menu Grid.Row="0"
                      Background="Transparent"
                      BorderThickness="0"
                      Foreground="{StaticResource BrushText}"
                      HorizontalAlignment="Right">
                    <Menu.Resources>
                        <Style TargetType="MenuItem">
                            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
                            <Setter Property="Background" Value="{StaticResource BrushBgPanel}" />
                        </Style>
                    </Menu.Resources>
                    <MenuItem x:Name="MenuSettings" Header="언어 설정">
                        <MenuItem x:Name="MenuLanguageKo" Header="한국어" IsCheckable="True" Click="MenuLanguageKo_Click" />
                        <MenuItem x:Name="MenuLanguageEn" Header="English" IsCheckable="True" Click="MenuLanguageEn_Click" />
                    </MenuItem>
                </Menu>
                <DockPanel Grid.Row="1" LastChildFill="False" VerticalAlignment="Center" Margin="0,4,0,0">
                    <TextBlock x:Name="TxtAppTitle"
                               DockPanel.Dock="Left"
                               Text="회의록"
                               FontSize="32"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,0,20,0" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="BtnNew" Content="새 문서" Style="{StaticResource ToolbarButton}" Click="BtnNew_Click" />
                        <Button x:Name="BtnOpen" Content="열기…" Style="{StaticResource ToolbarButton}" Click="BtnOpen_Click" />
                        <Button x:Name="BtnSave" Content="저장" Style="{StaticResource PrimaryButton}" Click="BtnSave_Click" />
                        <Button x:Name="BtnSaveAs" Content="다른 이름으로 저장…" Style="{StaticResource ToolbarButton}" Click="BtnSaveAs_Click" />
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource BrushBgPanel}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10,6"
                Margin="0,12,0,0">
            <TextBlock x:Name="TxtElapsedStatus"
                       Foreground="{StaticResource BrushTextMuted}"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Text="회의 시간 상태를 계산 중입니다." />
        </Border>

        <TabControl x:Name="MainTabs"
                    Background="Transparent"
                    BorderThickness="0"
                    SelectionChanged="MainTabs_SelectionChanged">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
                    <Setter Property="Padding" Value="16,10" />
                    <Setter Property="Margin" Value="0,0,4,0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="bd" CornerRadius="8,8,0,0" Padding="{TemplateBinding Padding}"
                                        Background="Transparent" BorderThickness="0">
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushBgPanel}" />
                                        <Setter Property="Foreground" Value="{StaticResource BrushText}" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushBgElevated}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <TabItem x:Name="TabWrite" Header="작성">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,8,0">
                    <StackPanel>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel>
                                    <TextBlock x:Name="LblTitle" Style="{StaticResource FieldLabel}" Text="회의 제목" />
                                    <TextBox x:Name="FldTitle" Style="{StaticResource ModernTextBox}" AcceptsReturn="False" />
                                </StackPanel>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="1.4*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="0.7*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="1.7*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:Name="LblDate" Style="{StaticResource FieldLabel}" Text="일시" />
                                        <DatePicker x:Name="FldDate"
                                                    SelectedDateFormat="Short"
                                                    SelectedDateChanged="MeetingTimeFieldChanged"
                                                    ToolTip="회의 날짜를 달력에서 선택하세요." />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock x:Name="LblTimeRange" Style="{StaticResource FieldLabel}" Text="시작 / 종료 시간" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="FldStartTime"
                                                     Grid.Column="0"
                                                     Style="{StaticResource ModernTextBox}"
                                                     Padding="8,4"
                                                     MaxLength="5"
                                                     PreviewTextInput="TimeField_PreviewTextInput"
                                                     PreviewKeyDown="TimeField_PreviewKeyDown"
                                                     DataObject.Pasting="TimeField_Pasting"
                                                     LostFocus="TimeField_LostFocus"
                                                     TextChanged="MeetingTimeFieldChanged"
                                                     ToolTip="시작 시간 (예: 14:00)" />
                                            <TextBox x:Name="FldEndTime"
                                                     Grid.Column="2"
                                                     Style="{StaticResource ModernTextBox}"
                                                     Padding="8,4"
                                                     MaxLength="5"
                                                     PreviewTextInput="TimeField_PreviewTextInput"
                                                     PreviewKeyDown="TimeField_PreviewKeyDown"
                                                     DataObject.Pasting="TimeField_Pasting"
                                                     LostFocus="TimeField_LostFocus"
                                                     TextChanged="MeetingTimeFieldChanged"
                                                     ToolTip="종료 시간 (예: 15:00)" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="6" Margin="16,0,0,0">
                                        <TextBlock x:Name="LblLocation" Style="{StaticResource FieldLabel}" Text="장소 / 온라인 링크" />
                                        <TextBox x:Name="FldLocation" Style="{StaticResource ModernTextBox}" Padding="8,4" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock x:Name="LblAuthor" Style="{StaticResource FieldLabel}" Text="작성자" />
                                    <TextBox x:Name="FldAuthor" Style="{StaticResource ModernTextBox}" Padding="8,4" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock x:Name="LblAttendees" Style="{StaticResource FieldLabel}" Text="참석자 (한 줄에 한 명, 또는 쉼표 구분)" />
                                <TextBox x:Name="FldAttendees" Style="{StaticResource ModernTextBox}"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <DockPanel LastChildFill="False">
                                    <TextBlock x:Name="LblAgenda"
                                               DockPanel.Dock="Left"
                                               Style="{StaticResource FieldLabel}"
                                               Text="안건 및 논의" />
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button x:Name="BtnAgendaImageAdd"
                                                Content="이미지 추가…"
                                                Style="{StaticResource ToolbarButton}"
                                                Margin="0,0,8,0"
                                                Click="BtnAgendaImageAdd_Click" />
                                        <Button x:Name="BtnAgendaImageRemove"
                                                Content="이미지 제거"
                                                Style="{StaticResource ToolbarButton}"
                                                Click="BtnAgendaImageRemove_Click" />
                                    </StackPanel>
                                </DockPanel>
                                <RichTextBox x:Name="FldAgendaRich"
                                             MinHeight="220"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Auto"
                                             Padding="10"
                                             Background="{StaticResource BrushBgElevated}"
                                             Foreground="{StaticResource BrushText}"
                                             BorderBrush="{StaticResource BrushBorder}"
                                             BorderThickness="1"
                                             FontFamily="Segoe UI Variable Display, Segoe UI"
                                             FontSize="14"
                                             AllowDrop="True"
                                             PreviewDragOver="FldAgendaRich_PreviewDragOver"
                                             Drop="FldAgendaRich_Drop" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock x:Name="LblDecisions" Style="{StaticResource FieldLabel}" Text="결정 사항" />
                                <TextBox x:Name="FldDecisions" Style="{StaticResource ModernTextBox}"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock x:Name="LblActions" Style="{StaticResource FieldLabel}" Text="액션 아이템 (담당 / 내용 / 기한 형식 권장)" />
                                <TextBox x:Name="FldActions" Style="{StaticResource ModernTextBox}"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock x:Name="LblNextMeeting" Style="{StaticResource FieldLabel}" Text="차기 회의" />
                                <TextBox x:Name="FldNext" Style="{StaticResource ModernTextBox}"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock x:Name="LblNotes" Style="{StaticResource FieldLabel}" Text="기타 메모" />
                                <TextBox x:Name="FldNotes" Style="{StaticResource ModernTextBox}"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="TabMarkdown" Header="Markdown">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="TxtMarkdownHint" Grid.Row="0"
                               Foreground="{StaticResource BrushTextMuted}"
                               FontSize="12"
                               Margin="0,0,0,8"
                               TextWrapping="Wrap"
                               Text="파일로 저장되는 Markdown입니다. 직접 수정한 뒤「폼에 반영」을 누르면 작성 탭 필드가 갱신됩니다." />
                    <TextBox x:Name="FldMarkdown"
                             Grid.Row="1"
                             Style="{StaticResource ModernTextBox}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Cascadia Code, Consolas, Courier New"
                             FontSize="13"
                             TextChanged="FldMarkdown_TextChanged" />
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
