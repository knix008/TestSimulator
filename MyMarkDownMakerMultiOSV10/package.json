{
  "name": "mymarkdownmaker",
  "productName": "MyMarkDownMaker",
  "version": "1.0.0",
  "private": true,
  "description": "Merge many Markdown files into one document, see its structure, number its headings and export it (Markdown, HTML, PDF, Word) — Windows, macOS, Linux (Tauri) and the web.",
  "author": "SHKWON <knix008@naver.com>",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "vite",
    "build:web": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:win": "node scripts/build.mjs win",
    "build:mac": "node scripts/build.mjs mac",
    "build:linux": "node scripts/build.mjs linux",
    "build:all": "node scripts/build.mjs all",
    "build:icons": "node scripts/render-icons.mjs",
    "build:docs": "node scripts/build-docs.mjs",
    "test": "node scripts/test.mjs",
    "test:quick": "node scripts/test.mjs --quick",
    "test:unit": "node scripts/test.mjs --only unit,i18n",
    "test:web": "node scripts/test.mjs --only web",
    "test:desktop": "node scripts/test.mjs --only desktop --desktop",
    "i18n:check": "node scripts/i18n-check.mjs",
    "smoke": "node scripts/smoke-web.mjs",
    "clean": "node scripts/clean.mjs",
    "clean:all": "node scripts/clean.mjs --all"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.11.0",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@lezer/highlight": "^1.2.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "dompurify": "^3.1.6",
    "marked": "^12.0.2",
    "pagedjs": "^0.4.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "sharp": "^0.35.5",
    "vite": "^7.3.8"
  }
}