# dependencies
node_modules/

# build output
dist/
dist-ssr/
release/
out/
*.tsbuildinfo
node_modules/.vite/

# packaged installers. `npm run dist:*` copies the artefact next to the sources
# so it is easy to find; it is 80+ MB and must never reach the repository.
*.exe
*.dmg
*.AppImage
*.deb
*.rpm
*.msi
*.snap
*.blockmap
MyCAD-Setup-*

# generated artefacts (rebuilt by npm run build:icons / build:samples / build:installer)
build/installer-associations.nsh
build/file-types.json
# assets/ and sample/ are generated too, but both ship with the repository: the
# packager copies sample/ into the installer, and assets/ holds every icon the
# app, the installer and the shortcuts use. Their generators write the same
# bytes every run, so a rebuild leaves the tree clean.

# test output (regenerated by npm test)
test-results.json
test-output/
coverage/
icon-map*.json

# editor and OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# logs and local env
*.log
npm-debug.log*
.env
.env.local
.env.*.local
