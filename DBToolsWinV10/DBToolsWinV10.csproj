<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>DBTools</Product>
    <Description>Database schema diagram tool</Description>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <SkipInstaller Condition="'$(SkipInstaller)' == ''">false</SkipInstaller>
  </PropertyGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <StartupObject>DBToolsWinV10.Program</StartupObject>
    <RootNamespace>DBToolsWinV10</RootNamespace>
    <AssemblyName>DBToolsWinV10</AssemblyName>
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Sample\**" />
    <Compile Remove="tools\**" />
    <Compile Remove="SmokeTest\**" />
    <Compile Include="Sample\SampleDbGenerator.cs" />
    <Compile Include="Sample\SampleGenerationResult.cs" />
    <Compile Include="Sample\SampleSchemaFactory.cs" />
    <Content Remove="Sample\**" />
    <EmbeddedResource Remove="Sample\**" />
    <None Remove="Sample\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.3.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.1" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.9" />
    <PackageReference Include="PDFsharp" Version="6.2.0" />
    <PackageReference Include="NeoSolve.ImageSharp.AVIF" Version="1.3.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.11" />
    <PackageReference Include="System.Data.OleDb" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Assets\AppIcon.ico" />
    <EmbeddedResource Include="Assets\mouse-pointer-icon.png" />
    <Content Include="Assets\FileIcon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\mdprj_file.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Template\OnlineShop*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="BuildInstallerOnRelease" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' and '$(SkipInstaller)' != 'true' and Exists('$(MSBuildProjectDirectory)\installer\DBToolsWinV10.Installer.wixproj')">
    <Exec Command="dotnet build &quot;$(MSBuildProjectDirectory)\installer\DBToolsWinV10.Installer.wixproj&quot; -c Release -p:Platform=x64" />
  </Target>

</Project>
