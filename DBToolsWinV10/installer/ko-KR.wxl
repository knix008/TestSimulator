<?xml version="1.0" encoding="utf-8"?>
<WixLocalization Culture="ko-kr" xmlns="http://wixtoolset.org/schemas/v4/wxl">
  <String Id="DowngradeError" Value="이미 더 새로운 버전이 설치되어 있습니다." />
  <String Id="ConfirmUpgradeTitle" Value="기존 설치 확인" />
  <String Id="ConfirmUpgradeText" Value="이 컴퓨터에 DBTools의 이전 버전이 설치되어 있습니다.&#13;&#10;&#13;&#10;계속하면 기존 프로그램 파일을 완전히 제거한 뒤 새 버전을 설치합니다.&#13;&#10;&#13;&#10;계속하시겠습니까?" />
  <String Id="ConfirmRemoveUserDataTitle" Value="제거 옵션" />
  <String Id="ConfirmRemoveUserDataText" Value="DBTools를 제거합니다.&#13;&#10;&#13;&#10;아래 옵션을 선택하면 사용자 작업 데이터(설정, 최근 파일 목록 등)도 함께 삭제됩니다.&#13;&#10;데이터 위치: %AppData%\DBToolsWinV10" />
  <String Id="RemoveUserDataCheckbox" Value="작업 데이터도 삭제 (설정 및 최근 파일 목록)" />
  <String Id="FeatureFileAssociationTitle" Value="파일 연결" />
  <String Id="FeatureFileAssociationDescription" Value=".mdprj 프로젝트 파일을 DBTools와 연결하고 탐색기 아이콘을 등록합니다." />
  <String Id="FeatureStartMenuTitle" Value="시작 메뉴 바로 가기" />
  <String Id="FeatureStartMenuDescription" Value="시작 메뉴에 DBTools 바로 가기를 만듭니다." />
  <String Id="FeatureDesktopTitle" Value="바탕 화면 바로 가기" />
  <String Id="FeatureDesktopDescription" Value="바탕 화면에 DBTools 바로 가기를 만듭니다." />
</WixLocalization>
