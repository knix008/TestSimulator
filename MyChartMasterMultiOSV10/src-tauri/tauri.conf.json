{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyChartMaster",
  "mainBinaryName": "MyChartMaster",
  "version": "../package.json",
  "identifier": "com.shkwon.mychartmaster",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1476",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$APPLOCALDATA/**",
          "$APPCONFIG/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "SHKWON",
    "copyright": "Copyright (c) SHKWON (knix008@naver.com)",
    "category": "Productivity",
    "shortDescription": "Chart maker",
    "longDescription": "Make charts of every kind (bar, line, area, pie, donut, scatter, bubble, radar, histogram, box plot, heatmap, treemap, funnel, waterfall, gauge, candlestick, sunburst, sankey and more) from CSV, TSV, Excel (xlsx), OpenDocument (ods), JSON, XML, HTML and Markdown tables; edit the data in a grid; style titles, axes, legends, labels and palettes; export PNG, JPEG, WebP, GIF, AVIF, SVG, PDF, HTML, Word and Markdown; print.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "icons/project.ico": "chart.ico",
      "icons/project.icns": "chart.icns",
      "icons/project.png": "chart.png",
      "../docs/UserGuide.html": "docs/UserGuide.html",
      "../docs/UserGuide.en.html": "docs/UserGuide.en.html",
      "../docs/Tutorial.html": "docs/Tutorial.html",
      "../docs/Tutorial.en.html": "docs/Tutorial.en.html",
      "../docs/images/": "docs/images/",
      "../samples/": "samples/"
    },
    "fileAssociations": [
      {
        "ext": [
          "mychart"
        ],
        "name": "MyChartMaster.Chart",
        "description": "MyChartMaster chart",
        "mimeType": "application/x-mychart",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Korean",
          "English"
        ],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "headerImage": "windows/installerHeader.bmp",
        "sidebarImage": "windows/installerSidebar.bmp",
        "installerHooks": "windows/hooks.nsh",
        "startMenuFolder": "MyChartMaster"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ],
        "files": {
          "/usr/share/mime/packages/mychartmaster.xml": "linux/mychartmaster.xml",
          "/usr/share/icons/hicolor/256x256/mimetypes/application-x-mychart.png": "icons/project.png"
        },
        "postInstallScript": "linux/postinst.sh",
        "postRemoveScript": "linux/postrm.sh"
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3"
        ],
        "files": {
          "/usr/share/mime/packages/mychartmaster.xml": "linux/mychartmaster.xml",
          "/usr/share/icons/hicolor/256x256/mimetypes/application-x-mychart.png": "icons/project.png"
        },
        "postInstallScript": "linux/postinst.sh",
        "postRemoveScript": "linux/postrm.sh"
      }
    }
  }
}
