{
  "name": "mymoney",
  "productName": "MyMoney",
  "version": "1.0.0",
  "description": "Stock quotes for a chosen market, exchange rates, and today's business news.",
  "author": "SHKWON <knix008@naver.com>",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "icons": "python scripts/generate_icons.py",
    "verify:icons": "python scripts/verify_icons.py",
    "test": "python scripts/generate_icons.py && node test/run-all.js",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "start": "node scripts/dev.js",
    "start:web": "python -m http.server 4173",
    "stage": "node scripts/stage-web.js",
    "build": "tauri build",
    "build:win": "node scripts/build-win.js",
    "build:linux": "tauri build --bundles deb,appimage && node scripts/copy-installer.js",
    "build:mac": "tauri build --bundles dmg && node scripts/copy-installer.js"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "jsdom": "^26.1.0"
  }
}
