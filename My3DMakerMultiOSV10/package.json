{
  "name": "my3dmaker",
  "productName": "My3DMaker",
  "private": true,
  "version": "1.0.0",
  "description": "3D engineering simulation for Web, Windows, macOS and Linux (Tauri + Rust solvers) — structural (static, modal, buckling, harmonic, transient, spectrum, random, fatigue, nonlinear, explicit), thermal, thermal stress, fluid flow, electrostatics, DC conduction, magnetostatics, acoustics, topology optimisation and design exploration",
  "author": "SHKWON <knix008@naver.com>",
  "type": "module",
  "scripts": {
    "start": "node scripts/build-wasm.mjs --if-missing && node scripts/start.mjs",
    "dev": "node scripts/build-wasm.mjs --if-missing && vite",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:web": "node scripts/build-wasm.mjs && node scripts/build-docs.mjs && vite build",
    "build:webapp": "vite build",
    "preview": "vite preview --port 5584 --strictPort",
    "tauri": "tauri",
    "test": "node scripts/test.mjs",
    "test:quick": "node scripts/test.mjs --quick",
    "build:win": "node scripts/build.mjs win",
    "build:mac": "node scripts/build.mjs mac",
    "build:linux": "node scripts/build.mjs linux",
    "build:all": "node scripts/build.mjs all",
    "build:icons": "node scripts/render-icons.mjs",
    "build:docs": "node scripts/build-docs.mjs",
    "notices": "node scripts/make-notices.mjs",
    "clean": "node scripts/clean.mjs",
    "clean:all": "node scripts/clean.mjs --all",
    "i18n:check": "node scripts/i18n-check.mjs",
    "guide:images": "node scripts/guide-steps.mjs"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "sharp": "^0.35.5",
    "vite": "^7.1.7"
  }
}