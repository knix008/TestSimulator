{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyPDFViewer",
  "mainBinaryName": "MyPDFViewer",
  "version": "../package.json",
  "identifier": "com.shkwon.mypdfviewer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5179",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "appimage", "deb"],
    "publisher": "SHKWON",
    "copyright": "Copyright © 2026 SHKWON (knix008@naver.com)",
    "license": "MIT",
    "category": "Productivity",
    "shortDescription": "PDF viewer",
    "longDescription": "Read PDFs, highlight and comment on them, and copy the text and images inside them. Highlights are saved into the PDF itself.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "icons/file.ico": "file.ico",
      "icons/file.png": "file.png"
    },
    "fileAssociations": [
      {
        "ext": ["pdfvw"],
        "name": "MyPDFViewer.Workspace",
        "description": "MyPDFViewer Workspace (highlights, clips and bookmarks for a PDF)",
        "mimeType": "application/x-mypdfviewer-workspace",
        "role": "Editor"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "displayLanguageSelector": true,
        "languages": ["Korean", "English"],
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  }
}
