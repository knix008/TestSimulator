{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyNetManager",
  "mainBinaryName": "MyNetManager",
  "version": "../package.json",
  "identifier": "com.shkwon.mynetmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1460",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$APPLOCALDATA/**",
          "$APPCONFIG/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "SHKWON",
    "copyright": "Copyright (c) SHKWON (knix008@naver.com)",
    "category": "Utility",
    "shortDescription": "Network protocol analyzer",
    "longDescription": "Wireshark-style network protocol analyzer: live capture through libpcap / Npcap with capture filters, pcap and pcapng files, dissection of 100+ protocols with a packet list, details tree and bytes pane, display filters, colouring rules, follow TCP/UDP/HTTP/TLS streams, expert information, statistics (protocol hierarchy, conversations, endpoints, I/O graphs, flow graphs, HTTP, DNS), export of packets, dissections and objects, printing.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "icons/project.ico": "capture.ico",
      "icons/project.icns": "capture.icns",
      "icons/project.png": "capture.png",
      "../docs/UserGuide.html": "docs/UserGuide.html",
      "../docs/UserGuide.en.html": "docs/UserGuide.en.html",
      "../docs/Tutorial.html": "docs/Tutorial.html",
      "../docs/Tutorial.en.html": "docs/Tutorial.en.html",
      "../docs/images/": "docs/images/",
      "../samples/": "samples/"
    },
    "fileAssociations": [
      {
        "ext": [
          "pcapng",
          "ntar"
        ],
        "name": "MyNetManager.Capture",
        "description": "Packet capture (pcapng)",
        "mimeType": "application/x-pcapng",
        "role": "Viewer"
      },
      {
        "ext": [
          "pcap",
          "cap"
        ],
        "name": "MyNetManager.CaptureLegacy",
        "description": "Packet capture (pcap)",
        "mimeType": "application/vnd.tcpdump.pcap",
        "role": "Viewer"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Korean",
          "English"
        ],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "headerImage": "windows/installerHeader.bmp",
        "sidebarImage": "windows/installerSidebar.bmp",
        "installerHooks": "windows/hooks.nsh",
        "startMenuFolder": "MyNetManager"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libpcap0.8"
        ],
        "files": {
          "/usr/share/mime/packages/mynetmanager.xml": "linux/mynetmanager.xml",
          "/usr/share/icons/hicolor/256x256/mimetypes/application-x-pcapng.png": "icons/project.png"
        },
        "postInstallScript": "linux/postinst.sh",
        "postRemoveScript": "linux/postrm.sh"
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "libpcap"
        ],
        "files": {
          "/usr/share/mime/packages/mynetmanager.xml": "linux/mynetmanager.xml",
          "/usr/share/icons/hicolor/256x256/mimetypes/application-x-pcapng.png": "icons/project.png"
        },
        "postInstallScript": "linux/postinst.sh",
        "postRemoveScript": "linux/postrm.sh"
      }
    }
  }
}