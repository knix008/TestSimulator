<?xml version="1.0" encoding="utf-8"?>
<WixLocalization Culture="ko-kr" xmlns="http://wixtoolset.org/schemas/v4/wxl">
  <String Id="DowngradeError" Value="이미 더 새로운 버전이 설치되어 있습니다." />
  <String Id="ConfirmUpgradeTitle" Value="기존 설치 확인" />
  <String Id="ConfirmUpgradeText" Value="이 컴퓨터에 MyPDF Editor의 이전 버전이 설치되어 있습니다.&#13;&#10;&#13;&#10;계속하면 기존 프로그램 파일을 완전히 제거한 뒤 새 버전을 설치합니다.&#13;&#10;&#13;&#10;계속하시겠습니까?" />
  <String Id="ConfirmRemoveUserDataTitle" Value="제거 옵션" />
  <String Id="ConfirmRemoveUserDataText" Value="MyPDF Editor를 제거합니다.&#13;&#10;&#13;&#10;아래 옵션을 선택하면 사용자 작업 데이터(설정, 최근 파일 목록 등)도 함께 삭제됩니다.&#13;&#10;데이터 위치: %AppData%\MyPDFEditorWinV10" />
  <String Id="RemoveUserDataCheckbox" Value="작업 데이터도 삭제 (설정 및 최근 파일 목록)" />
  <String Id="FeatureFileAssociationTitle" Value="PDF 파일 연결" />
  <String Id="FeatureFileAssociationDescription" Value=".pdf 파일을 MyPDF Editor와 연결합니다. (기본 PDF 뷰어가 변경될 수 있습니다.)" />
  <String Id="ShortcutsDlgTitle" Value="바로 가기 설정" />
  <String Id="ShortcutsDlgDescription" Value="설치할 바로 가기의 위치를 선택하세요." />
  <String Id="StartMenuShortcutCheckbox" Value="시작 메뉴에 바로 가기 만들기" />
  <String Id="DesktopShortcutCheckbox" Value="바탕 화면에 바로 가기 만들기" />
</WixLocalization>
