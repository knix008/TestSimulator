<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <?define ProductName = "MyPDF Editor v1.0" ?>
  <?define Manufacturer = "MyPDFEditor" ?>
  <?define UpgradeCode = "E5F6A7B8-C9D0-4E1F-2A3B-4C5D6E7F8091" ?>
  <?define PublishDir = "..\bin\Release\net10.0-windows\win-x64\publish" ?>

  <Package Name="$(var.ProductName)"
           Manufacturer="$(var.Manufacturer)"
           Version="1.0.0.0"
           Scope="perMachine"
           InstallerVersion="500"
           UpgradeCode="$(var.UpgradeCode)"
           Language="1042">

    <MajorUpgrade DowngradeErrorMessage="!(loc.DowngradeError)"
                  AllowDowngrades="no"
                  Schedule="afterInstallInitialize"
                  IgnoreRemoveFailure="no" />

    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon.ico" SourceFile="..\Assets\AppIcon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="REMOVEUSERDATA" Value="0" />
    <Property Id="DESKTOP_SHORTCUT" Value="1" />
    <Property Id="STARTMENU_SHORTCUT" Value="1" />

    <ui:WixUI Id="WixUI_FeatureTree" />

    <Upgrade Id="$(var.UpgradeCode)">
      <UpgradeVersion Minimum="0.0.0.0"
                      IncludeMinimum="yes"
                      Maximum="99.0.0.0"
                      IncludeMaximum="yes"
                      OnlyDetect="yes"
                      Property="OLDVERSIONFOUND" />
    </Upgrade>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="MyPDFEditorWinV10" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramMenuAppFolder" Name="MyPDF Editor" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <StandardDirectory Id="AppDataFolder">
      <Directory Id="UserDataRoot" Name="MyPDFEditorWinV10" />
    </StandardDirectory>

    <Feature Id="ProductFeature" Title="$(var.ProductName)" Level="1" AllowAbsent="no">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentRef Id="StartMenuShortcutComponent" />
      <ComponentRef Id="DesktopShortcutComponent" />
    </Feature>

    <Feature Id="FileAssociationFeature"
             Title="!(loc.FeatureFileAssociationTitle)"
             Description="!(loc.FeatureFileAssociationDescription)"
             Level="1000"
             AllowAbsent="yes">
      <ComponentRef Id="FileAssociationComponent" />
    </Feature>

    <Feature Id="UserDataMarkerFeature" Title="User Data" Level="1" AllowAbsent="no" Display="hidden">
      <ComponentRef Id="UserDataMarkerComponent" />
    </Feature>

    <SetProperty Id="WixQuietExecCmdLine"
                 Value="&quot;[SystemFolder]cmd.exe&quot; /c if exist &quot;[AppDataFolder]MyPDFEditorWinV10&quot; rmdir /s /q &quot;[AppDataFolder]MyPDFEditorWinV10&quot;"
                 Before="RemoveUserDataExec"
                 Sequence="execute"
                 Condition="REMOVE~=&quot;ALL&quot; AND REMOVEUSERDATA=&quot;1&quot;" />

    <CustomAction Id="RemoveUserDataExec"
                  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  DllEntry="WixQuietExec"
                  Execute="deferred"
                  Impersonate="yes"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="RemoveUserDataExec"
              Before="RemoveFiles"
              Condition="REMOVE~=&quot;ALL&quot; AND REMOVEUSERDATA=&quot;1&quot;" />
    </InstallExecuteSequence>
  </Package>

  <Fragment>
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)\**">
        <Exclude Files="*.pdb" />
      </Files>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <DirectoryRef Id="ProgramMenuAppFolder">
      <Component Id="StartMenuShortcutComponent"
                 Guid="F1A2B3C4-D5E6-7890-ABCD-EF1234567891"
                 Condition="STARTMENU_SHORTCUT = 1">
        <Shortcut Id="StartMenuShortcut"
                  Name="$(var.ProductName)"
                  Description="PDF viewer and text editor"
                  Target="[INSTALLFOLDER]MyPDFEditorWinV10.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon.ico"
                  IconIndex="0" />
        <RemoveFolder Id="ProgramMenuAppFolderRemove" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\MyPDFEditorWinV10"
                       Name="StartMenuShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>

  <Fragment>
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcutComponent"
                 Guid="A2B3C4D5-E6F7-8901-BCDE-F12345678902"
                 Condition="DESKTOP_SHORTCUT = 1">
        <Shortcut Id="DesktopShortcut"
                  Name="$(var.ProductName)"
                  Description="PDF viewer and text editor"
                  Target="[INSTALLFOLDER]MyPDFEditorWinV10.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon.ico"
                  IconIndex="0" />
        <RegistryValue Root="HKCU"
                       Key="Software\MyPDFEditorWinV10"
                       Name="DesktopShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </StandardDirectory>
  </Fragment>

  <Fragment>
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="FileAssociationComponent" Guid="B3C4D5E6-F7A8-9012-CDEF-123456789003">
        <RegistryKey Root="HKCR" Key=".pdf">
          <RegistryValue Type="string" Value="MyPDFEditorWinV10.pdf" />
        </RegistryKey>
        <RegistryKey Root="HKCR" Key="MyPDFEditorWinV10.pdf">
          <RegistryValue Type="string" Value="PDF Document (MyPDF Editor)" />
          <RegistryKey Key="DefaultIcon">
            <RegistryValue Type="string" Value="[INSTALLFOLDER]MyPDFEditorWinV10.exe,0" />
          </RegistryKey>
          <RegistryKey Key="shell\open\command">
            <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]MyPDFEditorWinV10.exe&quot; &quot;%1&quot;" />
          </RegistryKey>
        </RegistryKey>
        <RegistryValue Root="HKLM"
                       Key="Software\MyPDFEditorWinV10"
                       Name="FileAssociation"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>

  <Fragment>
    <DirectoryRef Id="UserDataRoot">
      <Component Id="UserDataMarkerComponent" Guid="C4D5E6F7-A8B9-0123-DEF0-234567890004">
        <CreateFolder />
        <RegistryValue Root="HKCU"
                       Key="Software\MyPDFEditorWinV10"
                       Name="UserDataRoot"
                       Type="string"
                       Value="[UserDataRoot]"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>

  <Fragment>
    <UI>
      <TextStyle Id="WixUI_Font_Normal" FaceName="Malgun Gothic" Size="9" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Malgun Gothic" Size="12" Bold="yes" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Malgun Gothic" Size="12" Bold="yes" />

      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />

      <Dialog Id="ConfirmUpgradeDlg" Width="370" Height="270" Title="!(loc.ConfirmUpgradeTitle)">
        <Control Id="Title" Type="Text" X="20" Y="20" Width="330" Height="20" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}!(loc.ConfirmUpgradeTitle)" />
        <Control Id="Body" Type="Text" X="20" Y="45" Width="330" Height="120" Text="!(loc.ConfirmUpgradeText)" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)" />
      </Dialog>

      <Dialog Id="ConfirmRemoveUserDataDlg" Width="370" Height="270" Title="!(loc.ConfirmRemoveUserDataTitle)">
        <Control Id="Title" Type="Text" X="20" Y="55" Width="330" Height="20" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}!(loc.ConfirmRemoveUserDataTitle)" />
        <Control Id="Body" Type="Text" X="20" Y="80" Width="330" Height="90" Text="!(loc.ConfirmRemoveUserDataText)" />
        <Control Id="RemoveUserDataCheck" Type="CheckBox" X="20" Y="175" Width="330" Height="17" Property="REMOVEUSERDATA" CheckBoxValue="1" Text="!(loc.RemoveUserDataCheckbox)" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)" />
      </Dialog>

      <Dialog Id="ShortcutsDlg" Width="370" Height="270" Title="!(loc.ShortcutsDlgTitle)">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}!(loc.ShortcutsDlgTitle)" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="320" Height="15" Transparent="yes" NoPrefix="yes" Text="!(loc.ShortcutsDlgDescription)" />
        <Control Id="StartMenuCheckBox" Type="CheckBox" X="20" Y="70" Width="330" Height="17" Property="STARTMENU_SHORTCUT" CheckBoxValue="1" Text="!(loc.StartMenuShortcutCheckbox)" />
        <Control Id="DesktopCheckBox" Type="CheckBox" X="20" Y="95" Width="330" Height="17" Property="DESKTOP_SHORTCUT" CheckBoxValue="1" Text="!(loc.DesktopShortcutCheckbox)" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)" />
      </Dialog>

      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="ConfirmUpgradeDlg" Order="1" Condition="OLDVERSIONFOUND" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="CustomizeDlg" Order="2" Condition="NOT OLDVERSIONFOUND" />

      <Publish Dialog="ConfirmUpgradeDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" />
      <Publish Dialog="ConfirmUpgradeDlg" Control="Next" Event="NewDialog" Value="CustomizeDlg" />

      <Publish Dialog="CustomizeDlg" Control="Next" Event="NewDialog" Value="ShortcutsDlg" Order="3" Condition="1" />
      <Publish Dialog="ShortcutsDlg" Control="Back" Event="NewDialog" Value="CustomizeDlg" Order="1" Condition="1" />
      <Publish Dialog="ShortcutsDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Order="1" Condition="1" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="ShortcutsDlg" Order="3" Condition="NOT Installed" />

      <Publish Dialog="MaintenanceWelcomeDlg" Control="Remove" Event="NewDialog" Value="ConfirmRemoveUserDataDlg" Order="1" />
      <Publish Dialog="ConfirmRemoveUserDataDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />
      <Publish Dialog="ConfirmRemoveUserDataDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" />
    </UI>
  </Fragment>
</Wix>
