<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <Platforms>x64</Platforms>
    <OutputName>MyPDFEditorWinV10Setup</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <SuppressValidation>true</SuppressValidation>
    <OutputPath>$(MSBuildThisFileDirectory)bin\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>$(MSBuildThisFileDirectory)obj\$(Configuration)\</IntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="6.0.2" />
    <PackageReference Include="WixToolset.Util.wixext" Version="6.0.2" />
  </ItemGroup>

  <ItemGroup>
    <WixLocalization Include="ko-KR.wxl" Culture="ko-kr" />
  </ItemGroup>

  <Target Name="PublishForInstaller" BeforeTargets="PrepareForBuild">
    <Exec Command="cmd /c taskkill /IM MyPDFEditorWinV10.exe /F &gt;nul 2&gt;&amp;1" IgnoreExitCode="true" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\.."
          Command="dotnet publish &quot;$(MSBuildProjectDirectory)\..\MyPDFEditorWinV10.csproj&quot; -c Release -r win-x64 --self-contained true -p:PublishSingleFile=false -p:SkipInstaller=true" />
  </Target>
</Project>
