<Project Sdk="WixToolset.Sdk/7.0.0">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <OutputName>SVGEditorWinV10_Setup</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <SuppressIces>ICE69</SuppressIces>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>$(MSBuildThisFileDirectory)..\bin\$(Configuration)\installer\</OutputPath>
    <IntermediateOutputPath>$(MSBuildThisFileDirectory)obj\$(Configuration)\</IntermediateOutputPath>
    <AcceptEula Condition="'$(AcceptEula)' == ''">wix7</AcceptEula>
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SVGEditorWinV10.csproj">
      <AdditionalProperties>SkipInstaller=true</AdditionalProperties>
    </ProjectReference>
    <PackageReference Include="WixToolset.UI.wixext" Version="7.0.0" />
  </ItemGroup>
</Project>
