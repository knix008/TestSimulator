<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ScreenCamWin</AssemblyName>
    <RootNamespace>ScreenCamWin</RootNamespace>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>daemon_hammer.ico</ApplicationIcon>
    <!-- x64: matches the 64-bit VFW codecs installed by default on modern Windows -->
    <PlatformTarget>x64</PlatformTarget>
    <!-- Release 빌드 시 MSI 설치 패키지도 함께 생성 -->
    <GenerateMsiOnBuild>true</GenerateMsiOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- Icon file: copied to output so it can be loaded at runtime if needed -->
    <Content Include="daemon_hammer.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <!-- MainForm.resx is auto-included by the SDK as EmbeddedResource -->
    <!-- DependentUpon metadata only (no duplicate Include needed) -->
    <EmbeddedResource Update="MainForm.resx">
      <DependentUpon>MainForm.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Vortice.MediaFoundation" Version="3.6.2" />
  </ItemGroup>

  <Target
    Name="BuildInstallerMsi"
    AfterTargets="Build"
    Condition="'$(Configuration)' == 'Release' and '$(GenerateMsiOnBuild)' == 'true'"
    Inputs="$(TargetPath);$(TargetDir)**\*;$(MSBuildProjectDirectory)\ScreenCamWinV10.Installer\Package.wxs;$(MSBuildProjectDirectory)\ScreenCamWinV10.Installer\ScreenCamWinV10.Installer.wixproj"
    Outputs="$(MSBuildProjectDirectory)\ScreenCamWinV10.Installer\bin\x64\$(Configuration)\ScreenCamWinV10Setup.msi">
    <Message Importance="high" Text="Building MSI installer (Release)..." />
    <Exec Command="dotnet build &quot;$(MSBuildProjectDirectory)\ScreenCamWinV10.Installer\ScreenCamWinV10.Installer.wixproj&quot; -c $(Configuration) -p:GenerateMsiOnBuild=false -p:BuildProjectReferences=false" />
  </Target>

</Project>
