<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <OutputName>ScreenCamWinV10Setup</OutputName>
    <Platform>x64</Platform>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ScreenCamWin.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" GeneratePathProperty="true" />
  </ItemGroup>

  <!-- MSI·설치 폴더에 포함될 아이콘 — 앱 프로젝트 루트와 동일 파일 -->
  <PropertyGroup>
    <DaemonHammerIcoPath>$(MSBuildThisFileDirectory)..\daemon_hammer.ico</DaemonHammerIcoPath>
  </PropertyGroup>

  <!-- WiX CoreCompile 전에 앱 출력 폴더에 항상 복사 (PreserveNewest 캐시 방지) -->
  <Target Name="SyncDaemonHammerIconForMsi" BeforeTargets="CoreCompile">
    <Error
      Condition="!Exists('$(DaemonHammerIcoPath)')"
      Text="daemon_hammer.ico not found at $(DaemonHammerIcoPath)" />
    <PropertyGroup>
      <_AppOutDir>$(MSBuildThisFileDirectory)..\bin\$(Configuration)\net8.0-windows\</_AppOutDir>
      <_AppOutDirX64>$(MSBuildThisFileDirectory)..\bin\x64\$(Configuration)\net8.0-windows\</_AppOutDirX64>
    </PropertyGroup>
    <Copy
      SourceFiles="$(DaemonHammerIcoPath)"
      DestinationFiles="$(_AppOutDir)daemon_hammer.ico"
      SkipUnchangedFiles="false" />
    <Copy
      SourceFiles="$(DaemonHammerIcoPath)"
      DestinationFiles="$(_AppOutDirX64)daemon_hammer.ico"
      SkipUnchangedFiles="false"
      Condition="Exists('$(_AppOutDirX64)')" />
  </Target>
</Project>

