<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>..\Assets\MyAgileBoard.ico</ApplicationIcon>
    <RootNamespace>MyAgileBoardWinV10</RootNamespace>
    <AssemblyName>MyAgileBoardWinV10</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Update="Forms\MyAgileForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\MyAgileForm.Designer.cs">
      <DependentUpon>MyAgileForm.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Forms\MyAgileForm.resx">
      <DependentUpon>MyAgileForm.cs</DependentUpon>
    </EmbeddedResource>
    <Compile Update="Forms\CardEditForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\CardEditForm.Designer.cs">
      <DependentUpon>CardEditForm.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Forms\CardEditForm.resx">
      <DependentUpon>CardEditForm.cs</DependentUpon>
    </EmbeddedResource>
    <Compile Update="Forms\ColumnSettingsForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\ColumnSettingsForm.Designer.cs">
      <DependentUpon>ColumnSettingsForm.cs</DependentUpon>
    </Compile>
    <Compile Update="Forms\SummaryForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\SummaryForm.Designer.cs">
      <DependentUpon>SummaryForm.cs</DependentUpon>
    </Compile>
    <Compile Update="Forms\BurndownChartForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\BurndownChartForm.Designer.cs">
      <DependentUpon>BurndownChartForm.cs</DependentUpon>
    </Compile>
    <Compile Update="Forms\BurndownChartColorForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\CompletedHistoryForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\CompletedHistoryForm.Designer.cs">
      <DependentUpon>CompletedHistoryForm.cs</DependentUpon>
    </Compile>
    <Compile Update="Forms\AboutForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\AboutForm.Designer.cs">
      <DependentUpon>AboutForm.cs</DependentUpon>
    </Compile>
    <Compile Update="Controls\KanbanColumnControl.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="Controls\KanbanColumnControl.Designer.cs">
      <DependentUpon>KanbanColumnControl.cs</DependentUpon>
    </Compile>
    <Compile Update="Controls\KanbanCardControl.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="Controls\KanbanCardControl.Designer.cs">
      <DependentUpon>KanbanCardControl.cs</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Assets\MyAgileBoard.ico">
      <Link>Assets\MyAgileBoard.ico</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Release 빌드 시 MSI 생성. SkipInstaller=true 로 순환 참조 방지. -->
  <Target Name="BuildInstallerMsi" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' AND '$(SkipInstaller)' != 'true' AND '$(DesignTimeBuild)' != 'true'">
    <Message Text="Building MSI installer (Release)..." Importance="high" />
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\installer\MyAgileBoardWinV10.Installer.wixproj" Targets="Restore;Build" Properties="Configuration=Release;Platform=x64" />
    <Message Text="MSI created: $(MSBuildThisFileDirectory)..\bin\Release\installer\MyAgileBoard_Setup.msi" Importance="high" />
  </Target>

</Project>