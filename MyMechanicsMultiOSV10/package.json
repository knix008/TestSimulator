{
  "name": "mymechanics",
  "productName": "MyMechanics",
  "private": true,
  "version": "1.0.0",
  "description": "Parametric 3D mechanical CAD for Web, Windows, macOS and Linux (Tauri) — constraint sketches, feature-based parts (extrude, revolve, cut, fillet, chamfer, shell, hole, pattern, mirror) on the OpenCASCADE kernel, assemblies with mates, 2D drawings, mass properties, STEP/STL export",
  "author": "SHKWON <knix008@naver.com>",
  "type": "module",
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "vite",
    "build:web": "node scripts/build-docs.mjs && vite build",
    "build:webapp": "vite build",
    "preview": "vite preview --port 4194 --strictPort",
    "tauri": "tauri",
    "test": "node scripts/test.mjs",
    "test:quick": "node scripts/test.mjs --quick",
    "test:unit": "node scripts/test.mjs --only js",
    "test:web": "node scripts/test.mjs --only web",
    "build:win": "node scripts/build.mjs win",
    "build:mac": "node scripts/build.mjs mac",
    "build:linux": "node scripts/build.mjs linux",
    "build:all": "node scripts/build.mjs all",
    "build:icons": "node scripts/render-icons.mjs",
    "notices": "node scripts/make-notices.mjs",
    "clean": "node scripts/clean.mjs",
    "clean:all": "node scripts/clean.mjs --all",
    "build:docs": "node scripts/build-docs.mjs",
    "guide:images": "node scripts/make-guide-images.mjs",
    "tutorial:video": "node scripts/make-tutorial-video.mjs",
    "i18n:check": "node scripts/i18n-check.mjs"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "opencascade.js": "2.0.0-beta.b5ff984",
    "replicad": "1.2.1",
    "replicad-opencascadejs": "1.2.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "sharp": "^0.35.5",
    "vite": "^7.1.7"
  }
}
