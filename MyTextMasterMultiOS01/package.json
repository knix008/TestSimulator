{
  "name": "mytextmaster",
  "productName": "MyTextMaster",
  "private": true,
  "version": "1.0.0",
  "description": "Markdown, HTML and plain text editor for Web, Windows, macOS and Linux (Tauri) — tabs, syntax highlighting, live preview, outline, find & replace, HTML export and printing",
  "author": "SHKWON <knix008@naver.com>",
  "type": "module",
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "vite",
    "build:web": "vite build",
    "preview": "vite preview --port 4182 --strictPort",
    "tauri": "tauri",
    "test": "node scripts/test.mjs",
    "test:unit": "node --test test/*.test.mjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "build:win": "node scripts/build.mjs win",
    "build:mac": "node scripts/build.mjs mac",
    "build:linux": "node scripts/build.mjs linux",
    "build:webapp": "node scripts/build.mjs web",
    "build:all": "node scripts/build.mjs all",
    "build:icons": "node scripts/render-icons.mjs",
    "samples": "node scripts/make-samples.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/language": "^6.11.0",
    "@codemirror/language-data": "^6.5.1",
    "@codemirror/search": "^6.5.10",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.8",
    "@lezer/highlight": "^1.2.1",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "dictionary-en": "^4.0.0",
    "dictionary-ko": "^2.0.0",
    "dompurify": "^3.2.6",
    "marked": "^15.0.12",
    "nspell": "^2.1.5",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "vite": "^7.1.7"
  }
}
