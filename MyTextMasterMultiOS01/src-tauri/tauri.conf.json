{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyTextMaster",
  "mainBinaryName": "MyTextMaster",
  "version": "../package.json",
  "identifier": "com.shkwon.mytextmaster",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1472",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "SHKWON",
    "copyright": "Copyright (c) SHKWON (knix008@naver.com)",
    "category": "Productivity",
    "shortDescription": "Markdown, HTML and text editor",
    "longDescription": "MyTextMaster edits Markdown, HTML and plain text files: tabs, syntax highlighting, live preview side by side with scroll sync, outline, find and replace, Markdown and HTML formatting tools, text tools (case, sort, de-duplicate, trim), encodings (UTF-8, UTF-16, EUC-KR) and line endings, HTML export and printing. Korean and English, 40 colour themes.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../samples/": "samples/"
    },
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "MyTextMaster.Markdown",
        "description": "Markdown document",
        "mimeType": "text/markdown",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Korean", "English"],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "headerImage": "windows/installerHeader.bmp",
        "sidebarImage": "windows/installerSidebar.bmp",
        "startMenuFolder": "MyTextMaster"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "gtk3"]
      }
    }
  }
}
