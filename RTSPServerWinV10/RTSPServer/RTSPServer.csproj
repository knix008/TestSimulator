<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    
    <!-- 애플리케이션 정보 -->
    <AssemblyName>RTSPServer</AssemblyName>
    <RootNamespace>RTSPServer</RootNamespace>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Company>RTSP Server Development</Company>
    <Product>RTSP Video Streaming Server</Product>
    <Description>RTSP 프로토콜을 사용한 비디오 스트리밍 서버 애플리케이션</Description>
    <Copyright>Copyright © 2026 RTSP Server Development</Copyright>
    
    <!-- 게시 설정 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>false</PublishReadyToRun>
    
    <!-- UI 설정 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>daemon_hammer.ico</ApplicationIcon>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    
    <!-- 경고 무시 -->
    <NoWarn>$(NoWarn);NU1510</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="daemon_hammer.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FFMpegCore" Version="5.4.0" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.7" />
  </ItemGroup>

  <Target Name="BuildSetupMsiOnRelease"
          AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release'
                     and '$(BuildingSolutionFile)' != 'true'
                     and '$(SkipMsiOnRelease)' != 'true'">
    <MSBuild Projects="..\RTSPServer.Setup\RTSPServer.Setup.wixproj"
             Targets="Build"
             Properties="Configuration=$(Configuration)" />
  </Target>

</Project>
