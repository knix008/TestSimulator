<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="RTSP Server"
           Manufacturer="RTSP Server Development"
           Version="1.0.0"
           UpgradeCode="A1B2C3D4-E5F6-4A5B-8C7D-9E8F7A6B5C4D"
           Codepage="949"
           Language="1042"
           Scope="perMachine">

    <!-- 동일 UpgradeCode 의 이전 설치: 먼저 제거 후 재설치 -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  Schedule="afterInstallInitialize"
                  DowngradeErrorMessage="더 최신 버전이 이미 설치되어 있습니다." />

    <!-- 단일 cab 파일로 내장 -->
    <MediaTemplate EmbedCab="yes" />

    <!-- 설치 UI: 설치 디렉토리 선택 포함 -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="..\RTSPServer\LICENSE.rtf" />

    <!-- WixUI 대화상자 아이콘 -->
    <WixVariable Id="WixUIInfoIco" Value="..\RTSPServer\daemon_hammer.ico" />
    <WixVariable Id="WixUIExclamationIco" Value="..\RTSPServer\daemon_hammer.ico" />
    <WixVariable Id="WixUINewIco" Value="..\RTSPServer\daemon_hammer.ico" />
    <WixVariable Id="WixUIUpIco" Value="..\RTSPServer\daemon_hammer.ico" />

    <!-- 프로그램 추가/제거 아이콘 -->
    <Icon Id="AppIcon" SourceFile="..\RTSPServer\daemon_hammer.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPHELPLINK" Value="https://github.com/yourusername/rtspserver" />

    <Feature Id="ProductFeature" Title="RTSP Server" Level="1">
      <ComponentGroupRef Id="MainComponents" />
      <ComponentRef Id="MachineRegistryComponent" />
      <ComponentRef Id="StartMenuShortcutsComponent" />
      <ComponentRef Id="FFmpegScriptComponent" />
    </Feature>
    
    <!-- 바탕화면 바로가기 (선택 가능) -->
    <Feature Id="DesktopShortcutFeature"
             Title="바탕화면 바로가기"
             Description="바탕화면에 RTSP Server 바로가기를 생성합니다."
             Level="1">
      <ComponentRef Id="DesktopShortcutComponent" />
    </Feature>
  </Package>

  <!-- 디렉토리 구조 -->
  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="RTSP Server" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="RTSP Server" />
    </StandardDirectory>
  </Fragment>

  <!-- 실행 파일 컴포넌트 -->
  <Fragment>
    <ComponentGroup Id="MainComponents" Directory="INSTALLFOLDER">
      <Component Id="MainExeComponent" Guid="B1C2D3E4-F5A6-4B5C-8D7E-9F8A7B6C5D4E">
        <File Id="MainExe"
              Source="..\RTSPServer\bin\Release\net10.0-windows\win-x64\publish\RTSPServer.exe"
              KeyPath="yes" />
        <File Source="..\RTSPServer\bin\Release\net10.0-windows\win-x64\publish\RTSPServer.dll" />
        <File Source="..\RTSPServer\bin\Release\net10.0-windows\win-x64\publish\RTSPServer.deps.json" />
        <File Source="..\RTSPServer\bin\Release\net10.0-windows\win-x64\publish\RTSPServer.runtimeconfig.json" />
      </Component>
      <Component Id="IconComponent" Guid="C3D4E5F6-A7B8-4C5D-9E7F-0A1B2C3D4E5F">
        <File Source="..\RTSPServer\daemon_hammer.ico" KeyPath="yes" />
      </Component>
      <Component Id="DocsComponent" Guid="D4E5F6A7-B8C9-4D5E-9F8A-1B2C3D4E5F6A">
        <File Id="ReadmeFile" Source="..\RTSPServer\README.md" KeyPath="yes" />
        <File Source="..\RTSPServer\LICENSE.txt" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <!-- FFmpeg 설치 스크립트 컴포넌트 -->
  <Fragment>
    <Component Id="FFmpegScriptComponent"
               Directory="INSTALLFOLDER"
               Guid="E5F6A7B8-C9D0-4E5F-AF9B-2C3D4E5F6A7B">
      <File Id="FFmpegInstallScript"
            Source="InstallFFmpeg.ps1"
            KeyPath="yes" />
    </Component>
  </Fragment>

  <!-- 커스텀 액션: FFmpeg 설치 안내 -->
  <Fragment>
    <CustomAction Id="LaunchFFmpegInstaller"
                  Directory="INSTALLFOLDER"
                  Execute="deferred"
                  Impersonate="no"
                  ExeCommand="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]InstallFFmpeg.ps1&quot;"
                  Return="ignore" />
    
    <InstallExecuteSequence>
      <Custom Action="LaunchFFmpegInstaller" After="InstallFinalize" Condition="NOT Installed" />
    </InstallExecuteSequence>
  </Fragment>

  <!-- perMachine 설치 표시 -->
  <Fragment>
    <Component Id="MachineRegistryComponent"
               Directory="INSTALLFOLDER"
               Guid="0F2F23E8-9438-4A4A-86F3-C1C43D870001">
      <RegistryValue Root="HKLM"
                     Key="SOFTWARE\RTSPServer"
                     Name="Installed"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
      <RegistryValue Root="HKLM"
                     Key="SOFTWARE\RTSPServer"
                     Name="InstallPath"
                     Type="string"
                     Value="[INSTALLFOLDER]" />
      <RegistryValue Root="HKLM"
                     Key="SOFTWARE\RTSPServer"
                     Name="Version"
                     Type="string"
                     Value="1.0.0" />
    </Component>
  </Fragment>

  <!-- 시작 메뉴 바로가기 (HKCU KeyPath) -->
  <Fragment>
    <Component Id="StartMenuShortcutsComponent"
               Directory="INSTALLFOLDER"
               Guid="7C2E8B91-4F30-4A1D-9C8E-2B5F7043A6D1">
      <Shortcut Id="StartMenuShortcut"
                Directory="AppMenuFolder"
                Name="RTSP Server"
                Description="RTSP Video Streaming Server"
                Target="[INSTALLFOLDER]RTSPServer.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon"
                IconIndex="0" />
      <Shortcut Id="UninstallShortcut"
                Directory="AppMenuFolder"
                Name="Uninstall RTSP Server"
                Description="RTSP Server 제거"
                Target="[SystemFolder]msiexec.exe"
                Arguments="/x [ProductCode]"
                Icon="AppIcon"
                IconIndex="0" />
      <RemoveFolder Id="RemoveAppMenuFolder"
                    Directory="AppMenuFolder"
                    On="uninstall" />
      <RegistryValue Root="HKCU"
                     Key="Software\RTSPServer"
                     Name="StartMenuShortcut"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>
  </Fragment>

  <!-- 바탕화면 바로가기 (HKCU KeyPath) -->
  <Fragment>
    <Component Id="DesktopShortcutComponent"
               Directory="INSTALLFOLDER"
               Guid="8D3F9C02-5A41-4B2E-AD9F-3C6E8154B7E2">
      <Shortcut Id="DesktopShortcut"
                Directory="DesktopFolder"
                Name="RTSP Server"
                Description="RTSP Video Streaming Server"
                Target="[INSTALLFOLDER]RTSPServer.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon"
                IconIndex="0" />
      <RegistryValue Root="HKCU"
                     Key="Software\RTSPServer"
                     Name="DesktopShortcut"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>
  </Fragment>

</Wix>
