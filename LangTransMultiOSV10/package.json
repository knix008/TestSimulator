{
  "name": "langtransmultiosv10",
  "private": true,
  "version": "1.0.0",
  "description": "Local-first translation app using Ollama with separate ONNX and Supertonic TTS routing.",
  "author": "SHKWON <knix008@naver.com>",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "npm run start:desktop",
    "start:web": "npm run dev:web",
    "start:desktop": "npm run electron:dev",
    "start:tts": "npm run tts:serve",
    "dev": "npm run dev:web",
    "dev:web": "vite --host 0.0.0.0",
    "electron:dev": "concurrently \"npm:dev\" \"wait-on http://localhost:5173 && electron .\"",
    "tts:dev": "cd tts-service && python -m uvicorn server:app --host 127.0.0.1 --port 8756 --reload",
    "tts:serve": "cd tts-service && python -m uvicorn server:app --host 127.0.0.1 --port 8756",
    "build": "npm run build:web",
    "build:web": "tsc -b && vite build",
    "build:windows": "npm run build:web && electron-builder --win",
    "build:macos": "npm run build:web && electron-builder --mac",
    "build:linux": "npm run build:web && electron-builder --linux",
    "build:desktop": "npm run build:web && electron-builder",
    "build:all": "npm run build:web && electron-builder --win --mac --linux",
    "dist": "npm run build:desktop",
    "dist:web": "npm run build:web",
    "dist:windows": "npm run build:windows",
    "dist:macos": "npm run build:macos",
    "dist:linux": "npm run build:linux",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.langtrans.multios",
    "productName": "LangTrans V1.0.0",
    "icon": "src/assets/app-icon",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "src/assets/app-icon.png",
        "to": "app-icon.png"
      },
      {
        "from": "tts-service",
        "to": "tts-service"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "src/assets/app-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LangTrans V1.0.0"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "concurrently": "^10.0.4",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite-plugin-electron": "^1.1.1",
    "wait-on": "^9.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
