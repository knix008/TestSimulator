<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>MyDiffWinV10.ico</ApplicationIcon>
    <AssemblyTitle>MyDiff Win V10</AssemblyTitle>
    <Product>MyDiff Win V10</Product>
  </PropertyGroup>

  <ItemGroup>
    <None Include="MyDiffWinV10.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Visual Studio 솔루션/프로젝트 Release 빌드에서도 MSI를 생성합니다.
       WiX 프로젝트는 VS에서 직접 빌드되지 않을 수 있어 App 빌드 후 dotnet/msbuild로 패키징합니다. -->
  <Target Name="BuildInstallerOnRelease"
          AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release'
                     AND '$(SkipInstaller)' != 'true'
                     AND '$(BuildingMsiPackage)' != 'true'
                     AND '$(DesignTimeBuild)' != 'true'">
    <Message Importance="high" Text="Building MSI installer package (WiX)..." />
    <Exec Command="cmd /c taskkill /IM MyDiffWinV10.App.exe /F &gt;nul 2&gt;&amp;1" IgnoreExitCode="true" />
    <MSBuild Projects="$(MSBuildProjectDirectory)\..\installer\MyDiffWinV10.Installer.wixproj"
             Targets="Restore;Build"
             Properties="Configuration=Release;Platform=x64;SkipInstaller=true;BuildingMsiPackage=true"
             BuildInParallel="false" />
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\..\installer\bin\Release\MyDiffWinV10Setup.msi')"
           Text="MSI was not created. Close any running MyDiffWinV10.App.exe and rebuild Release, or run: dotnet build installer\MyDiffWinV10.Installer.wixproj -c Release -p:Platform=x64 -p:BuildMsiPackage=true" />
    <Message Importance="high" Text="MSI created: $(MSBuildProjectDirectory)\..\installer\bin\Release\MyDiffWinV10Setup.msi" />
  </Target>

</Project>
