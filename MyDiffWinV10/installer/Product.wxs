<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="MyDiff Win V10"
           Manufacturer="MyDiffWinV10"
           Version="1.0.0.0"
           Scope="perMachine"
           InstallerVersion="500"
           UpgradeCode="6E1B8C2A-9F3D-4C7E-8A1B-3D5E7F9A2B40">

    <MajorUpgrade DowngradeErrorMessage="A newer version is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <ui:WixUI Id="WixUI_FeatureTree" />

    <!-- Same icon as the application. Id must use .exe for shortcuts targeting the exe. -->
    <Icon Id="MyDiffWinV10.App.exe" SourceFile="..\MyDiffWinV10.App\MyDiffWinV10.ico" />
    <Property Id="ARPPRODUCTICON" Value="MyDiffWinV10.App.exe" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="MyDiffWinV10" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramMenuAppFolder" Name="MyDiff Win V10">
        <Component Id="StartMenuShortcutComponent" Guid="*">
          <Shortcut Id="StartMenuShortcut"
                    Name="MyDiff Win V10"
                    Description="2-way line diff viewer for use as a git difftool"
                    Target="[INSTALLFOLDER]MyDiffWinV10.App.exe"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="MyDiffWinV10.App.exe"
                    IconIndex="0" />
          <RemoveFolder Id="ProgramMenuAppFolderRemove" On="uninstall" />
          <RegistryValue Root="HKCU"
                         Key="Software\MyDiffWinV10"
                         Name="StartMenuShortcut"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcutComponent" Guid="*">
        <Shortcut Id="DesktopShortcut"
                  Name="MyDiff Win V10"
                  Description="2-way line diff viewer for use as a git difftool"
                  Target="[INSTALLFOLDER]MyDiffWinV10.App.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="MyDiffWinV10.App.exe"
                  IconIndex="0" />
        <RegistryValue Root="HKCU"
                       Key="Software\MyDiffWinV10"
                       Name="DesktopShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="ProductFeature"
             Title="MyDiff Win V10"
             Description="2-way line diff viewer."
             Level="1"
             AllowAbsent="no">
      <ComponentGroupRef Id="ProductComponents" />

      <Feature Id="StartMenuShortcutFeature"
               Title="Start Menu shortcut"
               Description="Add a shortcut to the Start Menu."
               Level="1"
               AllowAbsent="yes">
        <ComponentRef Id="StartMenuShortcutComponent" />
      </Feature>

      <Feature Id="DesktopShortcutFeature"
               Title="Desktop shortcut"
               Description="Add a shortcut to the Desktop."
               Level="1"
               AllowAbsent="yes">
        <ComponentRef Id="DesktopShortcutComponent" />
      </Feature>
    </Feature>

  </Package>

  <!-- Application files from publish output -->
  <Fragment>
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishOutputDir)**">
        <Exclude Files="*.pdb" />
      </Files>
    </ComponentGroup>
  </Fragment>

</Wix>
