<?xml version="1.0" encoding="utf-8"?>
<WixLocalization Culture="ko-kr"
                 xmlns="http://wixtoolset.org/schemas/v4/wxl"
                 Codepage="949">
  <String Id="UserDataDlg_Title" Value="사용자 설정" Overridable="yes" />
  <String Id="UserDataDlgTitle" Value="{\WixUI_Font_Title}저장된 사용자 데이터" Overridable="yes" />
  <String Id="UserDataDlgBannerBitmap" Value="WixUIBannerBmp" Overridable="yes" />
  <String Id="UserDataDlgUpgradeDescription"
          Value="기존 MyDiff Win V10 설치가 완전히 제거된 후 새 버전이 설치됩니다."
          Overridable="yes" />
  <String Id="UserDataDlgRemoveDescription"
          Value="MyDiff Win V10이 이 컴퓨터에서 제거됩니다."
          Overridable="yes" />
  <String Id="UserDataDlgInstallDescription"
          Value="저장된 사용자 설정 데이터가 있습니다. 설치를 계속하기 전에 삭제할지 선택하세요."
          Overridable="yes" />
  <String Id="UserDataDlgFolderDescription"
          Value="설정은 %AppData%\MyDiffWinV10\settings.json에 저장됩니다 (창 크기, 글꼴, 언어, 마지막 비교 파일 경로)."
          Overridable="yes" />
  <String Id="UserDataDlgCheckBox"
          Value="저장된 사용자 설정을 이 컴퓨터에서 삭제"
          Overridable="yes" />
