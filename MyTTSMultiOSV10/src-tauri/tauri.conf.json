{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyTTS",
  "mainBinaryName": "MyTTS",
  "version": "../package.json",
  "identifier": "com.shkwon.tts-multios",
  "build": {
    "beforeDevCommand": "node scripts/build-tauri-web.mjs",
    "beforeBuildCommand": "node scripts/build-tauri-web.mjs --release",
    "frontendDist": "../dist/web"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "appimage", "deb"],
    "publisher": "SHKWON",
    "copyright": "Copyright © 2025-2026 SHKWON (knix008@naver.com)",
    "category": "Utility",
    "shortDescription": "Embedded-ready TTS (Korean / English)",
    "longDescription": "MyTTS by SHKWON — synthesizes Korean and English speech with installed ONNX / sherpa-onnx models, shows the waveform and saves WAV / MP3.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../dist/sidecar/": "sidecar/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Korean", "English"],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  }
}
