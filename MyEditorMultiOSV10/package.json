{
  "name": "myeditor",
  "version": "1.0.0",
  "description": "My Editor — tabbed text / code editor for Windows, macOS, Linux and the web (syntax highlighting for 100+ languages, autocomplete, find & replace, encodings, line endings, folder tree, terminal with themed prompts, HTML / Markdown preview, 20 themes + custom themes, Korean / English UI).",
  "author": {
    "name": "SHKWON",
    "email": "knix008@naver.com"
  },
  "license": "MIT",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "postinstall": "node scripts/sync-public-svgs.mjs && node scripts/generate-build-info.mjs",
    "prepare:assets": "node scripts/sync-public-svgs.mjs && node scripts/generate-build-info.mjs",
    "prestart": "npm run free:port && npm run prepare:assets",
    "start": "cross-env NODE_OPTIONS=--disable-warning=DEP0060 concurrently -k \"vite --port 5189\" \"wait-on tcp:5189 && cross-env ELECTRON_DEV=1 node scripts/start-electron.mjs\"",
    "predev": "npm run free:port && npm run prepare:assets",
    "dev": "vite --port 5189",
    "electron": "cross-env ELECTRON_DEV=1 node scripts/start-electron.mjs",
    "preview:electron": "node scripts/start-electron.mjs",
    "web": "npm run build && node server/server.js",
    "web:serve": "node server/server.js",
    "generate:icons": "node scripts/generate-icons.mjs && node scripts/generate-file-icons.mjs",
    "generate:file-icons": "node scripts/generate-file-icons.mjs",
    "generate:build-info": "node scripts/generate-build-info.mjs",
    "sync:svgs": "node scripts/sync-public-svgs.mjs",
    "prebuild": "npm run prepare:assets",
    "build": "vite build",
    "prebuild:win": "npm run generate:icons && npm run prepare:assets",
    "build:win": "vite build && electron-builder --win",
    "postbuild:win": "node scripts/copy-installer.js",
    "prebuild:mac": "npm run generate:icons && npm run prepare:assets",
    "build:mac": "vite build && electron-builder --mac",
    "postbuild:mac": "node scripts/copy-installer.js",
    "prebuild:linux": "npm run generate:icons && npm run prepare:assets",
    "build:linux": "vite build && electron-builder --linux",
    "postbuild:linux": "node scripts/copy-installer.js",
    "copy:installer": "node scripts/copy-installer.js",
    "test": "node --test test/*.test.mjs",
    "free:port": "node scripts/free-port.mjs 5189",
    "smoke": "node scripts/smoke.mjs",
    "clean": "node scripts/clean.mjs",
    "clean:all": "node scripts/clean.mjs --all"
  },
  "dependencies": {
    "@codemirror/language-data": "^6.5.2",
    "@lezer/highlight": "^1.2.1",
    "codemirror": "^6.0.2",
    "dicom-parser": "^1.8.21",
    "dictionary-en": "^4.0.0",
    "dompurify": "^3.4.15",
    "heic-decode": "^2.1.0",
    "iconv-lite": "^0.7.3",
    "jpeg-js": "^0.4.4",
    "jpeg-lossless-decoder-js": "^2.1.2",
    "js-yaml": "^4.3.2",
    "marked": "^18.0.13",
    "nspell": "^2.1.5",
    "prettier": "^3.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "sharp": "^0.33.4",
    "vite": "^5.4.1",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.shkwon.myeditor",
    "productName": "My Editor",
    "executableName": "MyEditor",
    "copyright": "Copyright © 2026 SHKWON (knix008@naver.com)",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "core/**/*",
      "build/icons/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "src/build-info.json",
        "to": "build-info.json"
      },
      {
        "from": "build/icons/icon.png",
        "to": "icon.png"
      },
      {
        "from": "build/icons/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "build/fileicons",
        "to": "fileicons",
        "filter": [
          "*.ico"
        ]
      }
    ],
    "asar": true,
    "icon": "build/icons/icon.png",
    "win": {
      "icon": "build/icons/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": false,
      "menuCategory": false,
      "shortcutName": "My Editor",
      "installerIcon": "build/icons/icon.ico",
      "uninstallerIcon": "build/icons/icon.ico",
      "installerHeaderIcon": "build/icons/icon.ico",
      "deleteAppDataOnUninstall": true,
      "include": "build/installer.nsh"
    },
    "mac": {
      "icon": "build/icons/icon.icns",
      "category": "public.app-category.developer-tools",
      "fileAssociations": [
        {
          "ext": ["txt", "md", "log", "json", "js", "ts", "css", "html", "xml", "yaml", "yml", "ini", "cfg", "csv", "py", "c", "cpp", "h", "java", "cs", "sh", "bat", "ps1", "sql"],
          "name": "Text document",
          "role": "Editor"
        }
      ],
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "My Editor ${version}",
      "icon": "build/icons/icon.icns"
    },
    "linux": {
      "icon": "build/icons/png",
      "category": "Utility;TextEditor;Development",
      "fileAssociations": [
        {
          "ext": ["txt", "md", "log", "json", "js", "ts", "css", "html", "xml", "yaml", "yml", "ini", "cfg", "csv", "py", "c", "cpp", "h", "java", "cs", "sh", "bat", "ps1", "sql"],
          "name": "Text document",
          "role": "Editor"
        }
      ],
      "maintainer": "SHKWON <knix008@naver.com>",
      "desktop": {
        "Name": "My Editor",
        "Comment": "Text / code editor",
        "Categories": "Utility;TextEditor;Development;",
        "MimeType": "text/plain;"
      },
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "deb": {
      "afterInstall": "build/linux/after-install.sh",
      "afterRemove": "build/linux/after-remove.sh",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    }
  },
  "allowScripts": {
    "electron@31.7.7": true,
    "sharp@0.33.5": true,
    "esbuild@0.21.5": true
  },
  "homepage": "https://github.com/knix008/TestSimulator",
  "repository": {
    "type": "git",
    "url": "https://github.com/knix008/TestSimulator.git"
  },
  "keywords": [
    "text-editor",
    "code-editor",
    "codemirror",
    "electron"
  ]
}
