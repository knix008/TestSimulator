<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="MemoPadV10"
           Manufacturer="TestSimulator"
           Version="1.0.0.0"
           UpgradeCode="3B8F1E62-9D4A-4C2B-BE7F-1A2C3D4E5F60"
           Scope="perMachine"
           InstallerVersion="500">
    <!-- 기존 설치본이 있으면 새 설치 시작 직후 완전히 제거한 뒤 새로 설치합니다.
         AllowSameVersionUpgrades로 같은 버전을 다시 설치해도 기존본을 제거합니다. -->
    <MajorUpgrade Schedule="afterInstallInitialize"
                  AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of MemoPadV10 is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="..\assets\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <WixVariable Id="WixUILicenseRtf" Value="assets\License.rtf" />
    <WixVariable Id="WixUIExclamationIco" Value="..\assets\app.ico" />
    <WixVariable Id="WixUIInfoIco" Value="..\assets\app.ico" />
    <WixVariable Id="WixUINewIco" Value="..\assets\app.ico" />
    <WixVariable Id="WixUIUpIco" Value="..\assets\app.ico" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="MemoPadV10" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="CmpDesktopShortcut" Guid="*" Bitness="always64">
        <Shortcut Id="ShcDesktop"
                  Name="MemoPadV10"
                  Description="MemoPadV10"
                  Target="[INSTALLFOLDER]MemoPadV10.exe"
                  Icon="AppIcon"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU"
                       Key="Software\TestSimulator\MemoPadV10\Setup"
                       Name="DesktopShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="MemoPadV10">
        <Component Id="CmpStartMenuShortcut" Guid="*" Bitness="always64">
          <Shortcut Id="ShcStartMenu"
                    Name="MemoPadV10"
                    Description="MemoPadV10"
                    Target="[INSTALLFOLDER]MemoPadV10.exe"
                    Icon="AppIcon"
                    WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
          <RegistryValue Root="HKCU"
                         Key="Software\TestSimulator\MemoPadV10\Setup"
                         Name="StartMenuShortcut"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="MemoPadV10" Level="1" AllowAbsent="no" Display="expand"
             Description="MemoPadV10 program files (required).">
      <ComponentGroupRef Id="HarvestedApp" />

      <!-- 사용자가 설치 마법사의 '사용자 지정'에서 켜고 끌 수 있는 바로가기 기능들 -->
      <Feature Id="FeatureDesktopShortcut" Level="1"
               Title="Desktop shortcut"
               Description="Create a shortcut on the desktop (uses the program icon).">
        <ComponentRef Id="CmpDesktopShortcut" />
      </Feature>

      <Feature Id="FeatureStartMenuShortcut" Level="1"
               Title="Start Menu shortcut"
               Description="Create a shortcut in the Start Menu (uses the program icon).">
        <ComponentRef Id="CmpStartMenuShortcut" />
      </Feature>
    </Feature>

    <!-- Mondo: 설치 형식(일반/사용자 지정)에서 바로가기 기능과 설치 위치를 선택할 수 있습니다. -->
    <ui:WixUI Id="WixUI_Mondo" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
  </Package>

  <Fragment>
    <ComponentGroup Id="HarvestedApp" Directory="INSTALLFOLDER">
      <Files Include="$(var.MemoPadV10.TargetDir)**">
        <Exclude Files="*.pdb" />
      </Files>
    </ComponentGroup>
  </Fragment>
</Wix>
