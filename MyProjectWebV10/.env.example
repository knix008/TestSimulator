# Prisma connection URL (MariaDB default)
DATABASE_URL="mysql://root@localhost:3306/myproject"

# Database provider: mariadb | mysql | sqlite | postgresql | sqlserver
DB_PROVIDER=mariadb

# Default database name
DB_NAME=myproject

# MariaDB / MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=

# PostgreSQL (when DB_PROVIDER=postgresql)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=

# SQL Server (when DB_PROVIDER=sqlserver)
# DB_HOST=localhost
# DB_PORT=1433
# DB_USER=sa
# DB_PASSWORD=

# SQLite file path (when DB_PROVIDER=sqlite)
# DB_FILE=./data/myproject.db

# Server
PORT=3001
NODE_ENV=development

# Bootstrap admin (used only before DB is connected; first admin is seeded into mp_users)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Secrets for password encryption and admin sessions
APP_SECRET=change-this-app-secret
JWT_SECRET=change-this-jwt-secret
