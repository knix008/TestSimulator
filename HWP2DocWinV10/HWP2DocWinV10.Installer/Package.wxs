<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package
    Name="!(loc.AppName)"
    Manufacturer="!(loc.Manufacturer)"
    Version="1.0.0"
    UpgradeCode="E3A7C1D4-5B82-4F6E-9A0C-2D8E4F1B6C93"
    Codepage="949"
    Language="1042"
    Scope="perMachine">

    <MajorUpgrade
      Schedule="afterInstallInitialize"
      DowngradeErrorMessage="!(loc.DowngradeError)" />

    <MediaTemplate EmbedCab="yes" />

    <ui:WixUI Id="WixUI_Mondo" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

    <Feature
      Id="FeatureApp"
      Title="!(loc.FeatureApp)"
      Description="!(loc.FeatureAppDesc)"
      Level="1"
      AllowAbsent="no">
      <!-- Release 빌드 출력 전체를 수집합니다. 새 DLL·Tools\rhwp 등이 자동 포함됩니다. -->
      <Files
        Include="$(var.HWP2DocWinV10.TargetDir)**"
        Directory="INSTALLFOLDER">
        <Exclude Files="$(var.HWP2DocWinV10.TargetDir)**\*.pdb" />
        <Exclude Files="$(var.HWP2DocWinV10.TargetDir)runtimes\linux-musl-x64\**" />
        <Exclude Files="$(var.HWP2DocWinV10.TargetDir)runtimes\linux-x64\**" />
        <Exclude Files="$(var.HWP2DocWinV10.TargetDir)runtimes\osx-arm64\**" />
        <Exclude Files="$(var.HWP2DocWinV10.TargetDir)runtimes\osx-x64\**" />
      </Files>

      <Feature
        Id="FeatureStartMenu"
        Title="!(loc.FeatureStartMenu)"
        Description="!(loc.FeatureStartMenuDesc)"
        Level="1"
        AllowAbsent="yes">
        <ComponentGroupRef Id="StartMenuShortcuts" />
      </Feature>

      <Feature
        Id="FeatureDesktop"
        Title="!(loc.FeatureDesktop)"
        Description="!(loc.FeatureDesktopDesc)"
        Level="10"
        AllowAbsent="yes">
        <ComponentGroupRef Id="DesktopShortcuts" />
      </Feature>
    </Feature>

  </Package>

  <Fragment>
    <Property Id="DOTNET10DESKTOP">
      <RegistrySearch
        Root="HKLM"
        Key="SOFTWARE\dotnet\Setup\InstalledVersions\x64\sharedfx\Microsoft.WindowsDesktop.App"
        Name="10.0.0"
        Type="raw" />
    </Property>
    <Launch
      Condition="Installed OR DOTNET10DESKTOP"
      Message="!(loc.DotNetRequired)" />

    <Property Id="WEBVIEW2INSTALLED">
      <RegistrySearch
        Root="HKLM"
        Key="SOFTWARE\WOW6432Node\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}"
        Name="pv"
        Type="raw" />
    </Property>
    <Launch
      Condition="Installed OR WEBVIEW2INSTALLED"
      Message="!(loc.WebView2Required)" />
  </Fragment>

  <Fragment>
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="!(loc.AppName)" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppStartMenuFolder" Name="!(loc.AppName)" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />
  </Fragment>

  <Fragment>
    <Icon Id="AppIcon" SourceFile="$(var.HWP2DocWinV10.ProjectDir)Assets\app.ico" />
    <Icon Id="AppShortcutIcon" SourceFile="$(var.HWP2DocWinV10.TargetDir)HWP2DocWinV10.exe" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
  </Fragment>

  <Fragment>
    <ComponentGroup Id="StartMenuShortcuts" Directory="AppStartMenuFolder">
      <Component Id="StartMenuShortcut">
        <Shortcut
          Id="StartMenuLink"
          Name="!(loc.AppName)"
          Description="!(loc.AppDescription)"
          Target="[INSTALLFOLDER]HWP2DocWinV10.exe"
          WorkingDirectory="INSTALLFOLDER"
          Icon="AppShortcutIcon"
          IconIndex="0" />
        <RegistryValue
          Root="HKCU"
          Key="Software\!(loc.Manufacturer)\!(loc.AppName)"
          Name="StartMenu"
          Type="integer"
          Value="1"
          KeyPath="yes" />
        <RemoveFolder Id="RemoveStartMenuFolder" Directory="AppStartMenuFolder" On="uninstall" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="DesktopShortcuts" Directory="DesktopFolder">
      <Component Id="DesktopShortcut">
        <Shortcut
          Id="DesktopLink"
          Name="!(loc.AppName)"
          Description="!(loc.AppDescription)"
          Target="[INSTALLFOLDER]HWP2DocWinV10.exe"
          WorkingDirectory="INSTALLFOLDER"
          Icon="AppShortcutIcon"
          IconIndex="0" />
        <RegistryValue
          Root="HKCU"
          Key="Software\!(loc.Manufacturer)\!(loc.AppName)"
          Name="Desktop"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

</Wix>
