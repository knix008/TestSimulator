<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>HWP2DocWinV10</AssemblyName>
    <RootNamespace>HWP2DocWinV10</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Assets\obj\**" />
    <Compile Remove="Assets\bin\**" />
    <Compile Remove="Tools\GenerateIcon\**" />
    <None Include="Tools\GenerateIcon\GenerateIcon.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4022.49" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Icons\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Tools\unhwp\unhwp.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="HWP2DocForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="HWP2DocForm.Designer.cs">
      <DependentUpon>HWP2DocForm.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="HWP2DocForm.resx">
      <DependentUpon>HWP2DocForm.cs</DependentUpon>
    </EmbeddedResource>
    <Compile Update="AboutDialog.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="AboutDialog.Designer.cs">
      <DependentUpon>AboutDialog.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="AboutDialog.resx">
      <DependentUpon>AboutDialog.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="BuildMsi" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <Message Text="MSI 빌드 시작..." Importance="high" />
    <Exec Command="dotnet build &quot;$(MSBuildThisFileDirectory)..\HWP2DocWinV10.Installer\HWP2DocWinV10.Installer.wixproj&quot; -c Release --no-dependencies" ConsoleToMsBuild="true" />
    <Message Text="MSI 생성 완료: HWP2DocWinV10.Installer\bin\Release\ko-KR\HWP2Doc-Setup.msi" Importance="high" />
  </Target>

  <!-- WinForms 전용: WebView2 WPF 어셈블리는 WindowsBase 버전 충돌(MSB3277)을 유발합니다. -->
  <Target Name="ExcludeWebView2WpfReference" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="$([System.String]::Copy('%(Identity)').Contains('Microsoft.Web.WebView2.Wpf'))" />
    </ItemGroup>
  </Target>

</Project>
