<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <?define PublishDir="..\DeskSearch\bin\Release\net8.0-windows\win-x64\publish" ?>

  <Package Name="DeskSearch"
           Manufacturer="DeskSearch"
           Version="1.0.0.0"
           Scope="perMachine"
           UpgradeCode="B8F3E2A1-4C5D-6E7F-8901-234567890ABC">

    <MajorUpgrade DowngradeErrorMessage="A newer version of DeskSearch is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <ui:WixUI Id="WixUI_FeatureTree" InstallDirectory="INSTALLFOLDER" />

    <!-- Shortcuts use the same app.ico installed under Assets\app.ico -->
    <Icon Id="AppIcon.ico" SourceFile="$(var.PublishDir)\Assets\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="DeskSearch" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramMenuAppFolder" Name="DeskSearch">
        <Component Id="StartMenuShortcutComponent" Guid="*">
          <Shortcut Id="StartMenuShortcut"
                    Name="DeskSearch"
                    Description="Desktop file and folder search"
                    Target="[INSTALLFOLDER]DeskSearch.exe"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="AppIcon.ico"
                    IconIndex="0" />
          <RemoveFolder Id="ProgramMenuAppFolderRemove" On="uninstall" />
          <RegistryValue Root="HKCU"
                         Key="Software\DeskSearch"
                         Name="StartMenuShortcut"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcutComponent" Guid="*">
        <Shortcut Id="DesktopShortcut"
                  Name="DeskSearch"
                  Description="Desktop file and folder search"
                  Target="[INSTALLFOLDER]DeskSearch.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon.ico"
                  IconIndex="0" />
        <RegistryValue Root="HKCU"
                       Key="Software\DeskSearch"
                       Name="DesktopShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="MainFeature"
             Title="DeskSearch"
             Description="DeskSearch application files."
             Level="1"
             AllowAbsent="no"
             Display="expand">
      <ComponentGroupRef Id="DeskSearchComponents" />

      <Feature Id="StartMenuShortcutFeature"
               Title="Start Menu shortcut"
               Description="Add a shortcut to the Start Menu."
               Level="1"
               AllowAbsent="yes">
        <ComponentRef Id="StartMenuShortcutComponent" />
      </Feature>

      <Feature Id="DesktopShortcutFeature"
               Title="Desktop shortcut"
               Description="Add a shortcut to the Desktop."
               Level="1"
               AllowAbsent="yes">
        <ComponentRef Id="DesktopShortcutComponent" />
      </Feature>
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="DeskSearchComponents" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)\**">
        <Exclude Files="$(var.PublishDir)\**\*.pdb" />
      </Files>
    </ComponentGroup>
  </Fragment>

</Wix>
