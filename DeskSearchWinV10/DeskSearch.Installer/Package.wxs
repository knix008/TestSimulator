<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <?define PublishDir="..\DeskSearch\bin\Release\net8.0-windows\win-x64\publish" ?>

  <Package Name="DeskSearch"
           Manufacturer="DeskSearch"
           Version="1.0.0.0"
           Scope="perMachine"
           UpgradeCode="B8F3E2A1-4C5D-6E7F-8901-234567890ABC">

    <MajorUpgrade DowngradeErrorMessage="!(loc.DowngradeErrorMessage)"
                  Schedule="afterInstallValidate"
                  AllowSameVersionUpgrades="yes"
                  IgnoreRemoveFailure="no" />
    <MediaTemplate EmbedCab="yes" />

    <!-- Unchecked by default: only "1" after the user ticks the box on UserDataDlg. -->
    <Property Id="REMOVEUSERDATA" Secure="yes" />
    <Property Id="USERDATAPROMPTSHOWN" Secure="yes" />
    <!-- App UI language chosen on LanguageDlg (ko / en). Written to HKCU on install. -->
    <Property Id="APPINSTALLLANGUAGE" Secure="yes" Value="ko" />

    <!-- True when %AppData%\DeskSearch already has settings or an index (leftover or upgrade). -->
    <Property Id="USERDATAEXISTS" Secure="yes">
      <DirectorySearch Id="AppDataRoamingSearch" Path="[AppDataFolder]">
        <DirectorySearch Id="DeskSearchDataFolderSearch" Path="DeskSearch" Depth="0">
          <FileSearch Id="DeskSearchSettingsSearch" Name="settings.json" />
        </DirectorySearch>
      </DirectorySearch>
    </Property>
    <Property Id="USERINDEXEXISTS" Secure="yes">
      <DirectorySearch Id="AppDataRoamingIndexSearch" Path="[AppDataFolder]">
        <DirectorySearch Id="DeskSearchIndexFolderSearch" Path="DeskSearch" Depth="0">
          <FileSearch Id="DeskSearchIndexSearch" Name="index.db" />
        </DirectorySearch>
      </DirectorySearch>
    </Property>

    <InstallUISequence>
      <!-- Uninstall via ARP / msiexec when the feature-tree Remove path did not show UserDataDlg. -->
      <Show Dialog="UserDataDlg"
            Before="ProgressDlg"
            Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND NOT USERDATAPROMPTSHOWN" />
    </InstallUISequence>

    <!-- Immediate, before InstallValidate: MajorUpgrade removes the old version right after
         InstallValidate, so a running DeskSearch.exe must be gone by then or its files stay. -->
    <CustomAction Id="KillDeskSearch"
                  Directory="SystemFolder"
                  ExeCommand="taskkill /IM DeskSearch.exe /F"
                  Execute="immediate"
                  Return="ignore" />

    <!-- Deletes whatever is left in the install folder (files the old version created or
         failed to remove) so the new version starts from an empty folder. Only scheduled
         when the folder is named ...\DeskSearch\ (see the condition below). -->
    <CustomAction Id="PurgeInstallFolder"
                  Directory="SystemFolder"
                  ExeCommand="cmd.exe /c if exist &quot;[INSTALLFOLDER]&quot; rmdir /s /q &quot;[INSTALLFOLDER]&quot;"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <CustomAction Id="RemoveAutostartEntry"
                  Directory="SystemFolder"
                  ExeCommand="reg.exe delete &quot;HKCU\Software\Microsoft\Windows\CurrentVersion\Run&quot; /v DeskSearch /f"
                  Execute="deferred"
                  Impersonate="yes"
                  Return="ignore" />

    <!-- [AppDataFolder] is formatted when the action is scheduled (user context with Impersonate).
         Must not run unless UserDataDlg was shown and the delete box was checked. -->
    <CustomAction Id="RemoveUserData"
                  Directory="SystemFolder"
                  ExeCommand="cmd.exe /c if exist &quot;[AppDataFolder]DeskSearch&quot; rmdir /s /q &quot;[AppDataFolder]DeskSearch&quot;"
                  Execute="deferred"
                  Impersonate="yes"
                  Return="ignore" />

    <CustomAction Id="RemoveStartupTask"
                  Directory="SystemFolder"
                  ExeCommand="schtasks.exe /Delete /TN DeskSearch /F"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="KillDeskSearch"
              Before="InstallValidate"
              Condition="WIX_UPGRADE_DETECTED OR REMOVE~=&quot;ALL&quot;" />
      <Custom Action="RemoveStartupTask"
              After="InstallInitialize"
              Condition="WIX_UPGRADE_DETECTED OR REMOVE~=&quot;ALL&quot;" />
      <!-- Never delete AppData unless the user saw UserDataDlg and explicitly checked the box.
           NOT UPGRADINGPRODUCTCODE: the old product's nested uninstall during MajorUpgrade must
           not wipe profile data — only this install session may, after the prompt. -->
      <Custom Action="RemoveUserData"
              After="RemoveStartupTask"
              Condition="REMOVEUSERDATA=&quot;1&quot; AND USERDATAPROMPTSHOWN=&quot;1&quot; AND NOT UPGRADINGPRODUCTCODE AND (WIX_UPGRADE_DETECTED OR USERDATAEXISTS OR USERINDEXEXISTS OR REMOVE~=&quot;ALL&quot;)" />
      <Custom Action="RemoveAutostartEntry"
              After="RemoveUserData"
              Condition="(REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE) OR (REMOVEUSERDATA=&quot;1&quot; AND USERDATAPROMPTSHOWN=&quot;1&quot; AND NOT UPGRADINGPRODUCTCODE AND (WIX_UPGRADE_DETECTED OR USERDATAEXISTS OR USERINDEXEXISTS))" />
      <Custom Action="PurgeInstallFolder"
              After="RemoveAutostartEntry"
              Condition="(WIX_UPGRADE_DETECTED OR REMOVE~=&quot;ALL&quot;) AND INSTALLFOLDER ~&gt;&gt; &quot;\DeskSearch\&quot;" />
    </InstallExecuteSequence>

    <ui:WixUI Id="DeskSearch_FeatureTree" InstallDirectory="INSTALLFOLDER" />

    <!-- Shortcuts use the same app.ico installed under Assets\app.ico -->
    <Icon Id="AppIcon.ico" SourceFile="$(var.PublishDir)\Assets\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="DeskSearch">
        <Component Id="InstallLanguageComponent" Guid="A1B2C3D4-E5F6-7890-ABCD-EF1234567890">
          <RegistryValue Root="HKCU"
                         Key="Software\DeskSearch"
                         Name="InstallLanguage"
                         Type="string"
                         Value="[APPINSTALLLANGUAGE]"
                         KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramMenuAppFolder" Name="DeskSearch">
        <Component Id="StartMenuShortcutComponent" Guid="*">
          <Shortcut Id="StartMenuShortcut"
                    Name="DeskSearch"
                    Description="!(loc.ShortcutDescription)"
                    Target="[INSTALLFOLDER]DeskSearch.exe"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="AppIcon.ico"
                    IconIndex="0" />
          <RemoveFolder Id="ProgramMenuAppFolderRemove" On="uninstall" />
          <RegistryValue Root="HKCU"
                         Key="Software\DeskSearch"
                         Name="StartMenuShortcut"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcutComponent" Guid="*">
        <Shortcut Id="DesktopShortcut"
                  Name="DeskSearch"
                  Description="!(loc.ShortcutDescription)"
                  Target="[INSTALLFOLDER]DeskSearch.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon.ico"
                  IconIndex="0" />
        <RegistryValue Root="HKCU"
                       Key="Software\DeskSearch"
                       Name="DesktopShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="MainFeature"
             Title="!(loc.MainFeatureTitle)"
             Description="!(loc.MainFeatureDescription)"
             Level="1"
             AllowAbsent="no"
             Display="expand">
      <ComponentGroupRef Id="DeskSearchComponents" />
      <ComponentRef Id="InstallLanguageComponent" />

      <Feature Id="StartMenuShortcutFeature"
               Title="!(loc.StartMenuShortcutFeatureTitle)"
               Description="!(loc.StartMenuShortcutFeatureDescription)"
               Level="1"
               AllowAbsent="yes">
        <ComponentRef Id="StartMenuShortcutComponent" />
      </Feature>

      <Feature Id="DesktopShortcutFeature"
               Title="!(loc.DesktopShortcutFeatureTitle)"
               Description="!(loc.DesktopShortcutFeatureDescription)"
               Level="1"
               AllowAbsent="yes">
        <ComponentRef Id="DesktopShortcutComponent" />
      </Feature>
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="DeskSearchComponents" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)\**">
        <Exclude Files="$(var.PublishDir)\**\*.pdb" />
        <Exclude Files="$(var.PublishDir)\createdump.exe" />
        <Exclude Files="$(var.PublishDir)\mscordaccore.dll" />
        <Exclude Files="$(var.PublishDir)\mscordaccore_*.dll" />
        <Exclude Files="$(var.PublishDir)\mscordbi.dll" />
        <Exclude Files="$(var.PublishDir)\Microsoft.DiaSymReader.Native.amd64.dll" />
        <Exclude Files="$(var.PublishDir)\msquic.dll" />
        <Exclude Files="$(var.PublishDir)\clrgc.dll" />
        <Exclude Files="$(var.PublishDir)\dbgshim.dll" />
      </Files>
    </ComponentGroup>
  </Fragment>

</Wix>
