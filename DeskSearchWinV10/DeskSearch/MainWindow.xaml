<Window x:Class="DeskSearch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskSearch"
        Width="340"
        Height="48"
        MinWidth="280"
        MaxWidth="720"
        MinHeight="48"
        MaxHeight="48"
        SizeToContent="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="False"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Closed="Window_Closed"
        LocationChanged="Window_LocationChanged"
        SizeChanged="Window_SizeChanged">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#222222"/>
        <SolidColorBrush x:Key="SubTextBrush" Color="#888888"/>
        <SolidColorBrush x:Key="IconMutedBrush" Color="#555555"/>
        <SolidColorBrush x:Key="IconPrimaryBrush" Color="#141414"/>
        <SolidColorBrush x:Key="IconAccentBrush" Color="#004578"/>
        <SolidColorBrush x:Key="ListItemHoverBrush" Color="#15000000"/>
        <SolidColorBrush x:Key="ListItemSelectedBrush" Color="#220078D4"/>

        <Style x:Key="AppIconGlyphStyle" TargetType="TextBlock">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1.1" ScaleY="1.1"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TransparentIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Border x:Name="RootBorder"
                Background="#F2FFFFFF"
                BorderBrush="#33000000"
                BorderThickness="1"
                CornerRadius="10"
                Padding="10,8"
                PreviewMouseLeftButtonDown="RootBorder_PreviewMouseLeftButtonDown">
            <Grid MinHeight="30" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="DragHandle"
                        Grid.Column="0"
                        Width="18"
                        Height="30"
                        Cursor="SizeAll"
                        ToolTip=""
                        Background="Transparent"
                        VerticalAlignment="Center"
                        Margin="-4,0,0,0"
                        MouseLeftButtonDown="DragHandle_MouseLeftButtonDown">
                    <TextBlock Text="&#xE700;"
                               Style="{StaticResource AppIconGlyphStyle}"
                               FontSize="13"
                               Foreground="{DynamicResource IconMutedBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <TextBlock Grid.Column="1"
                           Text="&#xE721;"
                           Style="{StaticResource AppIconGlyphStyle}"
                           FontSize="15"
                           Foreground="{DynamicResource IconPrimaryBrush}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Margin="0,0,8,0"/>

                <TextBox x:Name="SearchBox"
                         Grid.Column="2"
                         Height="30"
                         VerticalAlignment="Center"
                         PreviewMouseLeftButtonDown="SearchBox_PreviewMouseLeftButtonDown"
                         BorderThickness="0"
                         Background="Transparent"
                         FontSize="14"
                         Padding="0"
                         VerticalContentAlignment="Center"
                         CaretBrush="{DynamicResource PrimaryTextBrush}"
                         Foreground="{DynamicResource PrimaryTextBrush}"
                         IsEnabled="False"
                         TextChanged="SearchBox_TextChanged"
                         KeyDown="SearchBox_KeyDown"/>

                <Button x:Name="SettingsButton"
                        Grid.Column="3"
                        Style="{StaticResource TransparentIconButton}"
                        Width="28"
                        Height="30"
                        Margin="6,0,0,0"
                        Padding="0"
                        Cursor="Hand"
                        VerticalAlignment="Center"
                        Click="MenuSettings_Click">
                    <Grid Width="17" Height="17">
                        <TextBlock Text="&#xE713;"
                                   Style="{StaticResource AppIconGlyphStyle}"
                                   FontSize="17"
                                   Foreground="{DynamicResource IconPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                            <TextBlock.RenderTransform>
                                <ScaleTransform ScaleX="1.14" ScaleY="1.14"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Grid>
                </Button>
            </Grid>
        </Border>

        <Border x:Name="LeftResizeGrip"
                Width="8"
                HorizontalAlignment="Left"
                Background="Transparent"
                Cursor="SizeWE"
                MouseLeftButtonDown="LeftResizeGrip_MouseLeftButtonDown"/>
        <Border x:Name="RightResizeGrip"
                Width="8"
                HorizontalAlignment="Right"
                Background="Transparent"
                Cursor="SizeWE"
                MouseLeftButtonDown="RightResizeGrip_MouseLeftButtonDown"/>
    </Grid>
</Window>
