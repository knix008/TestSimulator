<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImportWindowsFormsImplicitUsings>false</ImportWindowsFormsImplicitUsings>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <NeutralResourcesLanguage>ko-KR</NeutralResourcesLanguage>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>DeskSearch</Product>
    <Company>DeskSearch</Company>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- UI strings: ko/en only. Search matches file names in any language (Unicode). -->
    <SatelliteResourceLanguages>en;ko</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\app.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Release publish: drop runtime files not needed to run DeskSearch (debug/dump/HTTP3). -->
  <Target Name="PruneUnnecessaryPublishFiles" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <UnnecessaryPublishFile Include="$(PublishDir)createdump.exe" />
      <UnnecessaryPublishFile Include="$(PublishDir)mscordaccore.dll" />
      <UnnecessaryPublishFile Include="$(PublishDir)mscordaccore_*.dll" />
      <UnnecessaryPublishFile Include="$(PublishDir)mscordbi.dll" />
      <UnnecessaryPublishFile Include="$(PublishDir)Microsoft.DiaSymReader.Native.amd64.dll" />
      <UnnecessaryPublishFile Include="$(PublishDir)msquic.dll" />
      <UnnecessaryPublishFile Include="$(PublishDir)clrgc.dll" />
      <UnnecessaryPublishFile Include="$(PublishDir)dbgshim.dll" />
    </ItemGroup>
    <Delete Files="@(UnnecessaryPublishFile)" TreatErrorsAsWarnings="true" />
  </Target>

  <!-- Release 빌드 후 MSI 생성 (Visual Studio 단일 프로젝트 빌드 포함). -->
  <Target Name="BuildInstallerOnRelease"
          AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release' AND '$(SkipInstaller)' != 'true' AND '$(DesignTimeBuild)' != 'true'">
    <Message Importance="high" Text="Building MSI installer package (WiX)..." />
    <Exec Command="cmd /c taskkill /IM DeskSearch.exe /F &gt;nul 2&gt;&amp;1" IgnoreExitCode="true" />
    <MSBuild Projects="$(MSBuildProjectDirectory)\..\DeskSearch.Installer\DeskSearch.Installer.wixproj"
             Properties="Configuration=Release;Platform=x64;SkipInstaller=true"
             Targets="Build" />
    <Message Importance="high" Text="MSI created: $(MSBuildProjectDirectory)\..\DeskSearch.Installer\bin\Release\DeskSearchSetup.msi" />
  </Target>

</Project>
