<Window x:Class="DeskSearch.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="SettingsRoot"
        Width="480"
        Height="820"
        MinWidth="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="#FAFAFA">
    <Window.Resources>
        <Style x:Key="SettingsActionButton" TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="ColorSwatchButton" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#BBBBBB"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SwatchBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwatchBorder" Property="BorderBrush" Value="#666666"/>
                                <Setter TargetName="SwatchBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SwatchBorder" Property="BorderBrush" Value="#0078D4"/>
                                <Setter TargetName="SwatchBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExcludedDirectoryListBoxItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="White"
                                BorderBrush="#D8D8D8"
                                BorderThickness="0,0,0,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#E8F4FD"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ItemBorder" Property="Background" Value="#F3F3F3"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExcludedDirectoriesListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ExcludedDirectoryListBoxItem}"/>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding}"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsComboBox" TargetType="ComboBox">
            <Style.Resources>
                <Style TargetType="ContentPresenter">
                    <Setter Property="VerticalAlignment" Value="Center"/>
                </Style>
            </Style.Resources>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="MinHeight" Value="28"/>
                        <Setter Property="Padding" Value="8,0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="20,20,16,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText"
                   Grid.Row="0"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0,0,0,16"/>

        <ScrollViewer x:Name="SettingsScrollViewer"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      Padding="0,0,4,0"
                      PreviewMouseWheel="SettingsScrollViewer_PreviewMouseWheel"
                      ScrollChanged="SettingsScrollViewer_ScrollChanged">
            <StackPanel Margin="0,0,12,8">
                <TextBlock x:Name="LanguageLabel" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <RadioButton x:Name="LanguageKoreanRadio"
                             GroupName="Language"
                             Margin="0,0,0,4"
                             Checked="LanguageRadio_Checked"/>
                <RadioButton x:Name="LanguageEnglishRadio"
                             GroupName="Language"
                             Margin="0,0,0,16"
                             Checked="LanguageRadio_Checked"/>

                <TextBlock x:Name="SearchOptionsLabel" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <CheckBox x:Name="CaseSensitiveSearchCheckBox"
                          Margin="0,0,0,4"/>
                <TextBlock x:Name="CaseSensitiveSearchDescLabel"
                           FontSize="11"
                           Foreground="#888888"
                           Margin="22,0,0,4"
                           TextWrapping="Wrap"/>
                <CheckBox x:Name="UseRegexSearchCheckBox"
                          Margin="0,0,0,4"/>
                <TextBlock x:Name="UseRegexSearchDescLabel"
                           FontSize="11"
                           Foreground="#888888"
                           Margin="22,0,0,4"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="SearchResultSortLabel"
                           FontWeight="SemiBold"
                           Margin="0,8,0,6"/>
                <TextBlock x:Name="SearchResultSortDescLabel"
                           FontSize="11"
                           Foreground="#888888"
                           Margin="0,0,0,6"
                           TextWrapping="Wrap"/>
                <ComboBox x:Name="SearchResultSortComboBox"
                          Style="{StaticResource SettingsComboBox}"
                          Margin="0,0,0,4"/>
                <TextBlock x:Name="SearchMultilingualNoteLabel"
                           FontSize="11"
                           Foreground="#888888"
                           Margin="0,0,0,16"
                           TextWrapping="Wrap"/>

                <TextBlock x:Name="ExclusionLabel" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock x:Name="ExcludedDrivesDescLabel"
                           FontSize="11"
                           Foreground="#888888"
                           Margin="0,0,0,6"
                           TextWrapping="Wrap"/>
                <WrapPanel x:Name="ExcludedDrivesPanel"
                           Margin="0,0,0,12"/>

                <TextBlock x:Name="ExcludedDirectoriesLabel" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock x:Name="ExcludedDirectoriesDescLabel"
                           FontSize="11"
                           Foreground="#888888"
                           Margin="0,0,0,6"
                           TextWrapping="Wrap"/>
                <ListBox x:Name="ExcludedDirectoriesListBox"
                         Style="{StaticResource ExcludedDirectoriesListBoxStyle}"
                         Height="112"
                         Margin="0,0,0,6"/>
                <WrapPanel Margin="0,0,0,16">
                    <Button x:Name="BrowseExcludedDirectoryButton"
                            Style="{StaticResource SettingsActionButton}"
                            Click="BrowseExcludedDirectory_Click"/>
                    <Button x:Name="RemoveExcludedDirectoryButton"
                            Style="{StaticResource SettingsActionButton}"
                            Click="RemoveExcludedDirectory_Click"/>
                </WrapPanel>

                <TextBlock x:Name="PeriodicResyncLabel" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock x:Name="PeriodicResyncDescLabel"
                           FontSize="11"
                           Foreground="#888888"
                           Margin="0,0,0,6"
                           TextWrapping="Wrap"/>
                <ComboBox x:Name="PeriodicResyncComboBox"
                          Style="{StaticResource SettingsComboBox}"
                          Margin="0,0,0,16"/>

                <TextBlock x:Name="IndexProgressLabel" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock x:Name="IndexProgressPhaseLabel"
                           FontWeight="SemiBold"
                           Foreground="#0078D4"
                           Margin="0,0,0,4"
                           Visibility="Collapsed"/>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="48"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="IndexProgressTrack"
                            Height="18"
                            Background="#E6E6E6"
                            CornerRadius="4"
                            ClipToBounds="True"
                            VerticalAlignment="Center">
                        <Border x:Name="IndexProgressFill"
                                Background="#0078D4"
                                CornerRadius="4"
                                HorizontalAlignment="Left"
                                Width="0"/>
                    </Border>
                    <TextBlock x:Name="IndexProgressPercentLabel"
                               Grid.Column="1"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>
                <TextBlock x:Name="IndexProgressStatusLabel"
                           FontSize="11"
                           Foreground="#888888"
                           Margin="0,0,0,8"
                           TextWrapping="Wrap"/>
                <WrapPanel Margin="0,0,0,16">
                    <Button x:Name="ReSearchButton"
                            Style="{StaticResource SettingsActionButton}"
                            Click="IndexAction_Click"/>
                    <Button x:Name="ResetIndexButton"
                            Style="{StaticResource SettingsActionButton}"
                            Click="ResetIndex_Click"/>
                    <Button x:Name="OpenDataFolderButton"
                            Style="{StaticResource SettingsActionButton}"
                            Click="OpenDataFolder_Click"/>
                </WrapPanel>

                <TextBlock x:Name="StartupLabel" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <CheckBox x:Name="RunAtStartupCheckBox"
                          Margin="0,0,0,4"/>
                <TextBlock x:Name="RunAtStartupDescLabel"
                           FontSize="11"
                           Foreground="#888888"
                           Margin="22,0,0,16"
                           TextWrapping="Wrap"/>

                <TextBlock x:Name="BackgroundColorLabel" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border x:Name="BackgroundPreview"
                            Grid.Row="0"
                            Height="32"
                            CornerRadius="6"
                            BorderBrush="#CCCCCC"
                            BorderThickness="1"
                            Margin="0,0,0,6"/>
                    <Button x:Name="PickBackgroundColorButton"
                            Grid.Row="1"
                            Style="{StaticResource SettingsActionButton}"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,0"
                            Click="PickBackgroundColor_Click"/>
                </Grid>
                <WrapPanel x:Name="BackgroundSwatchPanel"
                           Margin="0,0,0,12"/>

                <TextBlock x:Name="BackgroundOpacityLabel" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="48"/>
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="BackgroundOpacitySlider"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Minimum="40" Maximum="100" TickFrequency="5"
                            IsMoveToPointEnabled="True"
                            ValueChanged="BackgroundOpacitySlider_ValueChanged"/>
                    <TextBlock x:Name="BackgroundOpacityValueLabel"
                               Grid.Column="1"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>

                <TextBlock x:Name="BorderColorLabel" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border x:Name="BorderPreview"
                            Grid.Row="0"
                            Height="32"
                            CornerRadius="6"
                            BorderBrush="#CCCCCC"
                            BorderThickness="1"
                            Margin="0,0,0,6"/>
                    <Button x:Name="PickBorderColorButton"
                            Grid.Row="1"
                            Style="{StaticResource SettingsActionButton}"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,0"
                            Click="PickBorderColor_Click"/>
                </Grid>
                <WrapPanel x:Name="BorderSwatchPanel"
                           Margin="0,0,0,12"/>

                <TextBlock x:Name="TextColorLabel" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            Height="32"
                            CornerRadius="6"
                            BorderBrush="#CCCCCC"
                            BorderThickness="1"
                            Background="White"
                            Margin="0,0,0,6">
                        <TextBlock x:Name="TextPreview"
                                   VerticalAlignment="Center"
                                   Margin="8,0"/>
                    </Border>
                    <Button x:Name="PickTextColorButton"
                            Grid.Row="1"
                            Style="{StaticResource SettingsActionButton}"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,0"
                            Click="PickTextColor_Click"/>
                </Grid>
                <WrapPanel x:Name="TextSwatchPanel"
                           Margin="0,0,0,12"/>

                <TextBlock x:Name="WindowOpacityLabel" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="48"/>
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="WindowOpacitySlider"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Minimum="50" Maximum="100" TickFrequency="5"
                            IsMoveToPointEnabled="True"
                            ValueChanged="WindowOpacitySlider_ValueChanged"/>
                    <TextBlock x:Name="WindowOpacityValueLabel"
                               Grid.Column="1"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>

                <TextBlock x:Name="DisplayPriorityLabel" FontWeight="SemiBold" Margin="0,4,0,6"/>
                <RadioButton x:Name="PriorityAboveOthersRadio"
                             GroupName="DisplayPriority"
                             Margin="0,0,0,4"/>
                <TextBlock x:Name="AboveOthersDescLabel"
                           FontSize="11"
                           Foreground="#888888"
                           Margin="22,0,0,8"
                           TextWrapping="Wrap"/>
                <RadioButton x:Name="PriorityNormalRadio"
                             GroupName="DisplayPriority"
                             Margin="0,0,0,4"/>
                <TextBlock x:Name="NormalPriorityDescLabel"
                           FontSize="11"
                           Foreground="#888888"
                           Margin="22,0,0,4"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,12,0">
            <Button x:Name="CancelButton"
                    Style="{StaticResource SettingsActionButton}"
                    Margin="0,0,8,0"
                    Click="Cancel_Click"/>
            <Button x:Name="SaveButton"
                    Style="{StaticResource SettingsActionButton}"
                    Margin="0,0,0,0"
                    IsDefault="True"
                    Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
