<Window x:Class="DeskSearch.ResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskSearch Results"
        Width="340"
        Height="482"
        MinWidth="280"
        MaxWidth="720"
        MinHeight="76"
        MaxHeight="560"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#222222"/>
        <SolidColorBrush x:Key="SubTextBrush" Color="#888888"/>
        <SolidColorBrush x:Key="IconAccentBrush" Color="#004578"/>
        <SolidColorBrush x:Key="ListItemHoverBrush" Color="#15000000"/>
        <SolidColorBrush x:Key="ListItemSelectedBrush" Color="#220078D4"/>
        <Style x:Key="AppIconGlyphStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="RootBorder"
                Grid.Row="0"
                Background="#F2FFFFFF"
                BorderBrush="#33000000"
                BorderThickness="1"
                CornerRadius="10"
                Padding="8,6"
                ClipToBounds="False">
            <Grid>
                <ListBox x:Name="ResultsList"
                         VerticalAlignment="Stretch"
                         HorizontalAlignment="Stretch"
                         BorderThickness="0"
                         Background="Transparent"
                         Padding="0,0,0,4"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="False"
                         MouseDoubleClick="ResultsList_MouseDoubleClick"
                         MouseMove="ResultsList_MouseMove"
                         MouseLeave="ResultsList_MouseLeave"
                         KeyDown="ResultsList_KeyDown">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;"
                                           FontSize="14"
                                           Foreground="{DynamicResource IconAccentBrush}"
                                           Margin="0,0,6,0"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource AppIconGlyphStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding FileName}"
                                           FontSize="13"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Directory}"
                                       FontSize="11"
                                       Foreground="{DynamicResource SubTextBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,0,0,1"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="4,6"/>
                        <EventSetter Event="PreviewMouseRightButtonDown" Handler="ResultItem_PreviewMouseRightButtonDown"/>
                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ResultItem_PreviewMouseLeftButtonDown"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ItemBorder"
                                            Background="Transparent"
                                            CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ListItemHoverBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ListItemSelectedBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
                <TextBlock x:Name="EmptyResultsLabel"
                           Visibility="Collapsed"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource SubTextBrush}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="8"/>
            </Grid>
        </Border>

        <Border x:Name="BottomResizeGrip"
                Grid.Row="1"
                Height="8"
                VerticalAlignment="Bottom"
                Background="Transparent"
                Cursor="SizeNS"
                MouseLeftButtonDown="BottomResizeGrip_MouseLeftButtonDown"/>

        <Popup x:Name="ResultToolTipPopup"
               AllowsTransparency="True"
               Placement="Relative"
               StaysOpen="True"
               IsOpen="False"
               PopupAnimation="None">
            <Border x:Name="ResultToolTipBorder"
                    IsHitTestVisible="False"
                    Background="#F5FFFFFF"
                    BorderBrush="#33000000"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10,8"
                    MaxWidth="560">
                <StackPanel>
                    <TextBlock x:Name="ResultToolTipNameText"
                               TextTrimming="CharacterEllipsis"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#222222"/>
                    <TextBlock x:Name="ResultToolTipPathText"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               LineStackingStrategy="BlockLineHeight"
                               LineHeight="16"
                               MaxHeight="32"
                               FontSize="11"
                               Foreground="#888888"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
