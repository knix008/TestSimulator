<Window x:Class="DeskSearch.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380"
        SizeToContent="Height"
        MinWidth="340"
        MaxWidth="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#FAFAFA">
    <Border Padding="28,24,28,22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="52"
                        Height="52"
                        CornerRadius="10"
                        Background="White"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        Margin="0,0,16,0"
                        VerticalAlignment="Top">
                    <Image x:Name="AppIconImage"
                           Width="40"
                           Height="40"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="ProductNameText"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#1A1A1A"/>
                    <TextBlock x:Name="VersionText"
                               FontSize="12"
                               Foreground="#888888"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Height="1"
                    Background="#E8E8E8"
                    Margin="0,20,0,16"/>

            <TextBlock x:Name="DescriptionText"
                       Grid.Row="2"
                       FontSize="13"
                       Foreground="#444444"
                       TextWrapping="Wrap"
                       LineHeight="20"/>

            <TextBlock x:Name="AuthorText"
                       Grid.Row="3"
                       FontSize="12"
                       Foreground="#666666"
                       Margin="0,14,0,0"
                       TextWrapping="Wrap"/>

            <Button x:Name="OkButton"
                    Grid.Row="4"
                    MinWidth="96"
                    MinHeight="32"
                    Padding="16,6"
                    Margin="0,22,0,0"
                    HorizontalAlignment="Right"
                    IsDefault="True"
                    IsCancel="True"
                    Cursor="Hand"
                    Click="OkButton_Click"/>
        </Grid>
    </Border>
</Window>
