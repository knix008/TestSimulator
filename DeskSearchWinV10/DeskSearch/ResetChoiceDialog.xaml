<Window x:Class="DeskSearch.ResetChoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460"
        SizeToContent="Height"
        MinWidth="420"
        MaxWidth="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#FAFAFA">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="MessageText"
                   Grid.Row="0"
                   FontSize="13"
                   TextWrapping="Wrap"
                   LineHeight="20"
                   Margin="0,0,0,14"/>

        <StackPanel Grid.Row="1">
            <RadioButton x:Name="IndexOnlyRadio"
                         GroupName="ResetScope"
                         Margin="0,0,0,8"
                         IsChecked="True"/>
            <RadioButton x:Name="IndexAndSettingsRadio"
                         GroupName="ResetScope"/>
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button x:Name="ConfirmButton"
                    MinWidth="88"
                    Padding="12,4"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Click="ConfirmButton_Click"/>
            <Button x:Name="CancelButton"
                    MinWidth="88"
                    Padding="12,4"
                    IsCancel="True"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
