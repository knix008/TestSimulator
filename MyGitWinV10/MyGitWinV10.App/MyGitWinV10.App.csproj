<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>AnyCPU</Platforms>
    <ApplicationIcon>..\Assets\MyGit.ico</ApplicationIcon>
    <AssemblyTitle>MyGit V1.0.0</AssemblyTitle>
    <Product>MyGit V1.0.0</Product>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\Assets\Info_icon.png" Link="Assets\Info_icon.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Assets\FileStatusIcons\*.png" Link="Assets\FileStatusIcons\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.2.0" />
    <PackageReference Include="LibGit2Sharp" Version="0.31.0" />
    <PackageReference Include="Octokit" Version="13.0.1" />
    <PackageReference Include="QuestPDF" Version="2024.12.3" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <!-- Visual Studio 솔루션/프로젝트 Release 빌드에서도 MSI를 생성합니다.
       WiX 프로젝트는 VS에서 직접 빌드되지 않을 수 있어 App 빌드 후 dotnet/msbuild로 패키징합니다. -->
  <Target Name="BuildInstallerOnRelease"
          AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release'
                     AND '$(SkipInstaller)' != 'true'
                     AND '$(BuildingMsiPackage)' != 'true'
                     AND '$(DesignTimeBuild)' != 'true'">
    <Message Importance="high" Text="Building MSI installer package (WiX)..." />
    <Exec Command="cmd /c taskkill /IM MyGitWinV10.App.exe /F &gt;nul 2&gt;&amp;1" IgnoreExitCode="true" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\.."
          Command="dotnet build &quot;$(MSBuildProjectDirectory)\..\installer\MyGitWinV10.Installer.wixproj&quot; -c Release -p:Platform=x64 -p:SkipInstaller=true -p:BuildingMsiPackage=true -p:BuildMsiPackage=true -m:1" />
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\..\installer\bin\Release\MyGitWinV10Setup.msi')"
           Text="MSI was not created. Close any running MyGitWinV10.App.exe and rebuild Release, or run: .\installer\build-installer.ps1" />
    <Message Importance="high" Text="MSI created: $(MSBuildProjectDirectory)\..\installer\bin\Release\MyGitWinV10Setup.msi" />
  </Target>

</Project>
