<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Fragment>
    <StandardDirectory Id="AppDataFolder">
      <Directory Id="MyGitUserDataFolder" Name="MyGitWinV10" />
    </StandardDirectory>

    <Property Id="REMOVEUSERDATA" Secure="yes" />

    <Property Id="USERDATAFOLDER" Secure="yes">
      <RegistrySearch Id="UserDataFolderSearch"
                      Root="HKCU"
                      Key="Software\MyGitWinV10"
                      Name="UserDataPath"
                      Type="raw" />
    </Property>

    <SetProperty Id="USERDATAFOLDER"
                 Value="[MyGitUserDataFolder]"
                 Before="CostInitialize"
                 Sequence="both"
                 Condition="NOT USERDATAFOLDER" />

    <Component Id="UserDataPathComponent"
               Directory="MyGitUserDataFolder"
               Guid="C4D5E6F7-A8B9-4C0D-9E1F-2A3B4C5D6E7F">
      <RegistryValue Root="HKCU"
                     Key="Software\MyGitWinV10"
                     Name="UserDataPath"
                     Type="string"
                     Value="[MyGitUserDataFolder]"
                     KeyPath="yes" />
    </Component>

    <Component Id="UserDataRemovalComponent"
               Directory="MyGitUserDataFolder"
               Guid="B8E4F2A1-6C3D-4E5F-9A0B-1D2C3E4F5A6B"
               Condition="REMOVEUSERDATA=&quot;1&quot;">
      <CreateFolder Directory="MyGitUserDataFolder" />
      <util:RemoveFolderEx Property="USERDATAFOLDER" On="both" />
      <RemoveFolder Id="RemoveMyGitUserDataFolder" Directory="MyGitUserDataFolder" On="both" />
    </Component>
  </Fragment>
</Wix>
