{
  "name": "zipmaster-multios",
  "version": "1.0.0",
  "description": "ZipMaster Multi-OS — 다양한 압축 파일을 관리하는 크로스플랫폼(Web/Windows/macOS/Linux) 압축 관리자",
  "author": "Suho Kwon",
  "license": "MIT",
  "main": "out/main/main.js",
  "scripts": {
    "start": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build:web": "vite build --config vite.web.config.ts",
    "preview:web": "vite preview --config vite.web.config.ts",
    "dev:desktop": "electron-vite dev",
    "build:desktop:bundle": "electron-vite build",
    "build:desktop": "electron-vite build && electron-builder",
    "build:win": "electron-vite build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "events": "^3.3.0",
    "fflate": "^0.8.2",
    "libarchive.js": "^2.0.2",
    "node-7z": "^3.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tar-stream": "^3.1.7"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/tar-stream": "^3.1.3",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.1.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "typescript": "^5.5.2",
    "vite": "^5.3.2"
  }
}
