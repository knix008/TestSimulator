    "id": "x6",
    "text": "USB to UART with the CH340G",
    "x": 1500,
    "y": 1400,
    "size": 90,
    "rot": 0
   },
   {
    "id": "x7",
    "text": "VBUS from the USB connector powers everything (it is a power output,\nso no PWR_FLAG is needed). D+/D- are joined by the USB_D+ / USB_D- labels.",
    "x": 1500,
    "y": 1800,
    "size": 45,
    "rot": 0
   }
