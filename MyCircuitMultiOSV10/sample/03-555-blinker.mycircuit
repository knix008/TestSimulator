  "texts": [
   {
    "id": "x1",
    "text": "555 astable LED blinker",
    "x": 1300,
    "y": 900,
    "size": 90,
    "rot": 0
   },
   {
    "id": "x2",
    "text": "RA = R1, RB = R2, C = C2\nf = 1.44 / ((RA + 2 RB) C) = 1.44 / ((1k + 94k) x 10u) = approx. 1.5 Hz\nDuty cycle = (RA + RB) / (RA + 2 RB) = approx. 50 %",
    "x": 1300,
    "y": 3900,
    "size": 50,
    "rot": 0
   },
   {
    "id": "x3",
    "text": "The NE555 has no simulation model:\nthis sample is about the PCB and the 3D view.",
    "x": 5200,
    "y": 3500,
    "size": 45,
    "rot": 0
   }
  ],
