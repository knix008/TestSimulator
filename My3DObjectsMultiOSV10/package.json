{
  "name": "my3dobjects",
  "productName": "My3DObjects",
  "version": "1.0.0",
  "description": "Cross-platform (Web / Windows / macOS / Linux) image-to-3D object maker running Stable Fast 3D, SPAR3D, TripoSR, TRELLIS and Hunyuan3D locally (GPU when there is one, CPU otherwise), with a 3D viewer, a converter for GLB, glTF, OBJ, STL, PLY, FBX, DAE, 3MF and more, and 3MF / STL export for 3D printers.",
  "author": {
    "name": "SHKWON",
    "email": "knix008@naver.com"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/sync-public-svgs.mjs && node scripts/sync-doc.mjs && node scripts/sync-samples.mjs && node scripts/generate-build-info.mjs",
    "prepare:assets": "node scripts/ensure-deps.mjs && node scripts/sync-public-svgs.mjs && node scripts/sync-doc.mjs && node scripts/sync-samples.mjs && node scripts/generate-build-info.mjs",
    "ensure:deps": "node scripts/ensure-deps.mjs",
    "clean": "node scripts/clean.mjs",
    "clean:all": "node scripts/clean.mjs --all",
    "clean:dry": "node scripts/clean.mjs --all --dry-run",
    "prestart": "node scripts/ensure-deps.mjs",
    "start": "tauri dev",
    "predev": "npm run free:port && npm run prepare:assets",
    "dev": "vite --port 5196",
    "preweb": "npm run free:port && npm run prepare:assets",
    "web": "node scripts/web.mjs",
    "engine": "node scripts/engine.mjs",
    "tauri": "tauri",
    "generate:icons": "node scripts/generate-icons.mjs",
    "generate:build-info": "node scripts/generate-build-info.mjs",
    "sync:svgs": "node scripts/sync-public-svgs.mjs",
    "sync:doc": "node scripts/sync-doc.mjs",
    "sync:samples": "node scripts/sync-samples.mjs",
    "samples": "node scripts/make-samples.mjs && node scripts/sync-samples.mjs",
    "samples:index": "node scripts/update-sample-index.mjs && node scripts/sync-samples.mjs",
    "prebuild": "npm run prepare:assets",
    "build": "vite build",
    "prebuild:win": "node scripts/ensure-deps.mjs && npm run generate:icons",
    "build:win": "tauri build --bundles nsis && node scripts/copy-installer.mjs",
    "prebuild:mac": "node scripts/ensure-deps.mjs && npm run generate:icons",
    "build:mac": "tauri build --bundles dmg && node scripts/copy-installer.mjs",
    "prebuild:linux": "node scripts/ensure-deps.mjs && npm run generate:icons",
    "build:linux": "tauri build --bundles appimage,deb && node scripts/copy-installer.mjs",
    "prebuild:all": "node scripts/ensure-deps.mjs && npm run generate:icons",
    "build:all": "tauri build && node scripts/copy-installer.mjs",
    "copy:installer": "node scripts/copy-installer.mjs",
    "preview": "vite preview --port 4196",
    "free:port": "node scripts/free-port.mjs 5196",
    "pretest": "node scripts/ensure-deps.mjs",
    "test": "npm run test:js && npm run test:engine && npm run test:rust",
    "test:js": "vitest run",
    "test:engine": "node scripts/test-engine.mjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "smoke": "node test/e2e/smoke.mjs",
    "smoke:print3d": "node test/e2e/print3d-menus.mjs",
    "guide:images": "node scripts/make-guide-images.mjs",
    "pretest:watch": "node scripts/ensure-deps.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "@testing-library/react": "^16.0.1",
    "@vitejs/plugin-react": "^4.3.1",
    "i18next": "^23.11.5",
    "jsdom": "^24.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^14.1.2",
    "sharp": "^0.33.4",
    "vite": "^5.4.1",
    "vitest": "^2.1.1"
  },
  "allowScripts": {
    "sharp@0.33.5": true,
    "esbuild@0.21.5": true
  }
}
