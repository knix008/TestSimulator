<Window x:Class="ScreenCaptureMaster.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Screen Capture Master" 
        Height="600" 
        Width="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Icon="daemon_hammer.ico">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" 
                Background="{StaticResource SurfaceBrush}" 
                CornerRadius="8" 
                Padding="20"
                Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Image Source="daemon_hammer.ico" 
                       Width="48" 
                       Height="48" 
                       Margin="0,0,15,0"/>
                
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Screen Capture Master" 
                               FontSize="24" 
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Capture your screen with ease" 
                               FontSize="14"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Capture Options -->
        <Border Grid.Row="1" 
                Background="{StaticResource SurfaceBrush}" 
                CornerRadius="8" 
                Padding="20"
                Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Capture Options" 
                           FontSize="18" 
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,15"/>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Button Grid.Column="0" 
                            Content="Capture Full Screen" 
                            Style="{StaticResource ModernButton}"
                            Click="CaptureFullScreenButton_Click"
                            Margin="0,0,10,0"
                            Height="45"/>
                    
                    <Button Grid.Column="1" 
                            Content="Capture Region" 
                            Style="{StaticResource ModernButton}"
                            Click="CaptureRegionButton_Click"
                            Margin="5,0,5,0"
                            Height="45"/>
                    
                    <Button Grid.Column="2" 
                            Content="Capture Window" 
                            Style="{StaticResource ModernButton}"
                            Click="CaptureWindowButton_Click"
                            Margin="10,0,0,0"
                            Height="45"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Save Options -->
        <Border Grid.Row="2" 
                Background="{StaticResource SurfaceBrush}" 
                CornerRadius="8" 
                Padding="20"
                Margin="0,0,0,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0"
                           Text="Save Options" 
                           FontSize="18" 
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,15"/>
                
                <Grid Grid.Row="1" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBox x:Name="SavePathTextBox" 
                             Style="{StaticResource ModernTextBox}"
                             IsReadOnly="True"
                             Margin="0,0,10,0"/>
                    
                    <Button Grid.Column="1" 
                            Content="Browse..." 
                            Style="{StaticResource ModernButton}"
                            Click="BrowseButton_Click"
                            Width="120"/>
                </Grid>
                
                <StackPanel Grid.Row="2" Orientation="Horizontal">
                    <CheckBox x:Name="AutoSaveCheckBox"
                              Content="Auto-save captures"
                              IsChecked="False"
                              VerticalAlignment="Center"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              Margin="0,0,20,0"/>
                    
                    <TextBlock Text="Format:"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,10,0"/>
                    
                    <ComboBox x:Name="FormatComboBox"
                              Width="100"
                              SelectedIndex="0"
                              VerticalAlignment="Center">
                        <ComboBoxItem Content="PNG"/>
                        <ComboBoxItem Content="JPEG"/>
                        <ComboBoxItem Content="BMP"/>
                        <ComboBoxItem Content="GIF"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Preview Area -->
        <Border Grid.Row="3" 
                Background="{StaticResource SurfaceBrush}" 
                CornerRadius="8" 
                Padding="20"
                Margin="0,0,0,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0"
                           Text="Preview" 
                           FontSize="18" 
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,15"/>
                
                <Border Grid.Row="1" 
                        BorderBrush="#E0E0E0" 
                        BorderThickness="1"
                        CornerRadius="4"
                        Background="#F5F5F5"
                        Margin="0,0,0,15">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" 
                                  VerticalScrollBarVisibility="Auto">
                        <Image x:Name="PreviewImage" 
                               Stretch="Uniform"
                               Margin="10"/>
                    </ScrollViewer>
                </Border>
                
                <!-- Action Buttons -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <Button Grid.Column="1"
                            Content="📋 Copy to Clipboard"
                            Style="{StaticResource ModernButton}"
                            Click="CopyToClipboardButton_Click"
                            Width="180"
                            Margin="0,0,10,0"
                            Background="#4CAF50"/>
                    
                    <Button Grid.Column="2"
                            Content="📁 Open File"
                            Style="{StaticResource ModernButton}"
                            Click="OpenFileButton_Click"
                            Width="130"
                            Margin="0,0,10,0"/>
                    
                    <Button Grid.Column="3"
                            Content="📂 Open Folder"
                            Style="{StaticResource ModernButton}"
                            Click="OpenFolderButton_Click"
                            Width="140"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="4" 
                Background="{StaticResource SurfaceBrush}" 
                CornerRadius="8" 
                Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Text="Status:" 
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                
                <TextBlock x:Name="StatusTextBlock" 
                           Grid.Column="1"
                           Text="Ready to capture" 
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
