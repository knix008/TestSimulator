<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>daemon_hammer.ico</ApplicationIcon>
    <AssemblyName>ScreenCaptureMaster</AssemblyName>
    <RootNamespace>ScreenCaptureMaster</RootNamespace>
    <Platforms>AnyCPU;x64;x86</Platforms>
    <Version>1.0.0</Version>
    <Company>Your Company</Company>
    <Product>Screen Capture Master</Product>
    <Copyright>Copyright © 2026</Copyright>
    <Description>A modern screen capture application</Description>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="daemon_hammer.ico" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="daemon_hammer.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.2.0" />
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.26100.1742" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
  </ItemGroup>

  <Target Name="BuildInstallerOnRelease"
          AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release' and '$(MSBuildProjectName)' == 'ScreenCaptureMaster' and '$(SkipInstallerBuild)' != 'true'">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\.."
          Command="dotnet build &quot;$(MSBuildProjectDirectory)\..\ScreenCaptureMaster.Installer\ScreenCaptureMaster.Installer.wixproj&quot; -c Release -p:Platform=x64" />
  </Target>

</Project>
