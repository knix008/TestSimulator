<Window x:Class="ScreenCaptureMaster.WindowSelector"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Window to Capture"
        Height="500"
        Width="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        ResizeMode="CanResize">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="Select a window to capture:"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   Margin="0,0,0,15"/>

        <!-- Window List -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="4"
                Margin="0,0,0,15">
            <ListBox x:Name="WindowListBox"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="5"
                     MouseDoubleClick="WindowListBox_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="5">
                            <TextBlock Text="{Binding Title}"
                                       FontSize="14"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding Bounds}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Status -->
        <TextBlock Grid.Row="2"
                   x:Name="StatusText"
                   Text="Loading windows..."
                   FontSize="12"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   Margin="0,0,0,15"/>

        <!-- Buttons -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="Refresh"
                    Style="{StaticResource ModernButton}"
                    Click="RefreshButton_Click"
                    Width="100"
                    Margin="0,0,10,0"/>

            <Button Grid.Column="2"
                    Content="Select"
                    Style="{StaticResource ModernButton}"
                    Click="SelectButton_Click"
                    Width="100"
                    Margin="0,0,10,0"/>

            <Button Grid.Column="3"
                    Content="Cancel"
                    Style="{StaticResource ModernButton}"
                    Click="CancelButton_Click"
                    Width="100"
                    Background="#757575"/>
        </Grid>
    </Grid>
</Window>
