<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="Screen Capture Master"
           Manufacturer="Your Company"
           Version="1.0.0.0"
           UpgradeCode="E5F6A7B8-C9D0-4E1F-B2A3-3C4D5E6F7A8B"
           Language="1033"
           Compressed="yes"
           InstallerVersion="500">

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="..\daemon_hammer.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <ui:WixUI Id="WixUI_FeatureTree" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Screen Capture Master" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramMenuAppFolder" Name="Screen Capture Master" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="MainApplication"
             Title="Screen Capture Master"
             Description="Main application files"
             Level="1"
             ConfigurableDirectory="INSTALLFOLDER">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>

    <Feature Id="StartMenuShortcutFeature"
             Title="Start Menu Shortcut"
             Description="Create a Start Menu shortcut."
             Level="1"
             AllowAbsent="yes">
      <ComponentRef Id="StartMenuShortcutComponent" />
    </Feature>

    <Feature Id="DesktopShortcutFeature"
             Title="Desktop Shortcut"
             Description="Create a Desktop shortcut."
             Level="1"
             AllowAbsent="yes">
      <ComponentRef Id="DesktopShortcutComponent" />
    </Feature>

  </Package>

  <Fragment>
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Files Include="..\ScreenCaptureMaster\bin\Release\net8.0-windows10.0.26100.0\win-x64\publish\**">
        <Exclude Files="*.pdb" />
      </Files>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <DirectoryRef Id="ProgramMenuAppFolder">
      <Component Id="StartMenuShortcutComponent" Guid="*">
        <Shortcut Id="StartMenuShortcut"
                  Name="Screen Capture Master"
                  Description="Launch Screen Capture Master"
                  Target="[INSTALLFOLDER]ScreenCaptureMaster.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RemoveFolder Id="ProgramMenuAppFolderRemove" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\ScreenCaptureMaster"
                       Name="StartMenuShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>

  <Fragment>
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcutComponent" Guid="*">
        <Shortcut Id="DesktopShortcut"
                  Name="Screen Capture Master"
                  Description="Launch Screen Capture Master"
                  Target="[INSTALLFOLDER]ScreenCaptureMaster.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RegistryValue Root="HKCU"
                       Key="Software\ScreenCaptureMaster"
                       Name="DesktopShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </StandardDirectory>
  </Fragment>

</Wix>
