<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  
  <Package Name="Screen Capture Master"
           Manufacturer="Your Company"
           Version="1.0.0.0"
           UpgradeCode="E5F6A7B8-C9D0-4E1F-B2A3-3C4D5E6F7A8B"
           Language="1033"
           Compressed="yes"
           InstallerVersion="500">

    <SummaryInformation Description="Screen Capture Master Installer"
                        Manufacturer="Your Company"
                        Keywords="Installer,Screen Capture,Screenshot" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="..\daemon_hammer.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <!-- UI Configuration -->
    <ui:WixUI Id="WixUI_FeatureTree" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

    <!-- Standard directories -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Screen Capture Master">
        <Component Id="MainExecutable" Bitness="always64" Guid="A1B2C3D4-E5F6-4A5B-8C9D-1E2F3A4B5C6D">
          <File Id="ScreenCaptureMasterEXE"
                Source="..\ScreenCaptureMaster\bin\Release\net8.0-windows\win-x64\publish\ScreenCaptureMaster.exe">
            
            <!-- Start Menu Shortcut -->
            <Shortcut Id="StartMenuShortcut"
                      Directory="ProgramMenuFolder"
                      Name="Screen Capture Master"
                      Description="Launch Screen Capture Master"
                      WorkingDirectory="INSTALLFOLDER"
                      Icon="AppIcon" />
            
            <!-- Desktop Shortcut -->
            <Shortcut Id="DesktopShortcut"
                      Directory="DesktopFolder"
                      Name="Screen Capture Master"
                      Description="Launch Screen Capture Master"
                      WorkingDirectory="INSTALLFOLDER"
                      Icon="AppIcon" />
          </File>
          
          <File Id="IconFile"
                Source="..\daemon_hammer.ico" />
          
          <!-- Registry entry as KeyPath for non-advertised shortcuts -->
          <RemoveFolder Id="RemoveProgramMenuFolder" Directory="ProgramMenuFolder" On="uninstall" />
          <RemoveFolder Id="RemoveDesktopFolder" Directory="DesktopFolder" On="uninstall" />
          <RegistryValue Root="HKCU" 
                         Key="Software\ScreenCaptureMaster" 
                         Name="installed" 
                         Type="integer" 
                         Value="1" 
                         KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <!-- Features -->
    <Feature Id="MainApplication"
             Title="Screen Capture Master"
             Description="Main application files"
             Level="1"
             ConfigurableDirectory="INSTALLFOLDER">
      
      <ComponentRef Id="MainExecutable" />
    </Feature>

  </Package>
</Wix>
