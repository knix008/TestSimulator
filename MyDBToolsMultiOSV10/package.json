{
  "name": "dbtools-multios",
  "version": "1.0.1",
  "description": "Cross-platform ER diagram and database schema design tool (Tauri desktop shell)",
  "author": "SHKWON <knix008@naver.com>",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "node scripts/dev.mjs",
    "web": "node scripts/dev.mjs",
    "tauri": "tauri",
    "build": "npm run build:docs && vite build",
    "build:web": "npm run build",
    "build:docs": "node scripts/build-docs.mjs",
    "build:debug": "npm run build && tauri build --debug --no-bundle",
    "build:win": "node scripts/platform-build.mjs win",
    "build:mac": "node scripts/platform-build.mjs mac",
    "build:linux": "node scripts/platform-build.mjs linux",
    "clean": "node scripts/clean.mjs",
    "clean:all": "node scripts/clean.mjs --all",
    "preview": "vite preview",
    "make:icons": "node scripts/make-icons.mjs",
    "make:template": "node scripts/make-template.mjs",
    "test": "node test/index.mjs",
    "test:watch": "node --watch test/index.mjs",
    "test:integration": "node test/index.mjs SQLite",
    "test:fidelity": "node test/index.mjs fidelity",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "docx": "^9.0.2",
    "exceljs": "^4.4.0",
    "gifenc": "^1.0.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sql.js": "^1.12.0",
    "uuid": "^11.1.0",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.5",
    "@tauri-apps/cli": "^2.9.0"
  },
  "type": "module"
}
