{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyDBTools",
  "mainBinaryName": "MyDBTools",
  "version": "1.0.1",
  "identifier": "com.shkwon.mydbtools",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5174",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "appimage",
      "deb"
    ],
    "publisher": "SHKWON",
    "copyright": "Copyright (c) 2026 SHKWON",
    "category": "DeveloperTool",
    "shortDescription": "ER diagram and database schema design tool",
    "longDescription": "MyDBTools designs database schemas as ER diagrams, analyses normalization and indexes, and exports SQL, documents and images.",
    "icon": [
      "../assets/icons/32x32.png",
      "../assets/icons/128x128.png",
      "../assets/icons/256x256.png",
      "../assets/icon.png",
      "../assets/icon.ico"
    ],
    "resources": {
      "../template/": "template/",
      "../assets/file-icon.ico": "file-icon.ico"
    },
    "fileAssociations": [
      {
        "ext": [
          "mdprj"
        ],
        "name": "MyDBTools Project",
        "description": "MyDBTools ER diagram project",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "languages": [
          "Korean",
          "English"
        ],
        "installMode": "currentUser",
        "installerIcon": "../assets/icon.ico",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    }
  }
}
