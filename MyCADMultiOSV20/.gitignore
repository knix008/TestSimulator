# Dependencies
node_modules/

# Build output
dist/
src-tauri/target/
src-tauri/gen/

# Installers (npm run build:win / build:mac / build:linux / build:all)
release/
/MyCAD-*.exe
/MyCAD-*.msi
/MyCAD-*.dmg
/MyCAD-*.deb
/MyCAD-*.rpm
/MyCAD-*.AppImage

# The tutorial video stays in the repository (npm run record:tutorial)
!/MyCAD-Tutorial*.mp4

# Test runs (npm test) and logs
test-results/
*.log

# Atomic saves in progress (the app writes ".<name>.<pid>.tmp" and renames it)
.*.tmp

# Python helpers (scripts/freecad, scripts/ezdxf)
__pycache__/
*.pyc
.venv/
venv/

# Local tools for the docs and the video (ffmpeg, FreeCAD portable) — use FFMPEG / FREECAD_CMD instead
/tools/

# Editors and OS files
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
