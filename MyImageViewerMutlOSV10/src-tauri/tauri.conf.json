{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyImageViewer",
  "version": "1.0.2",
  "identifier": "com.shkwon.imageviewer",
  "build": {
    "devUrl": "http://127.0.0.1:17810",
    "frontendDist": "../src",
    "beforeDevCommand": "node host/server.js"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "**"
          ],
          "deny": []
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "../host",
      "../doc",
      "../scripts/rembg_worker.py"
    ],
    "publisher": "SHKWON",
    "copyright": "Copyright (c) 2024-2026 SHKWON (knix008@naver.com)",
    "shortDescription": "Image viewer and editor",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Korean",
          "English"
        ],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "startMenuFolder": "MyImageViewer",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
