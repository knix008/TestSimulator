{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyImageViewer",
  "version": "1.0.2",
  "identifier": "com.shkwon.imageviewer",
  "build": {
    "devUrl": "http://127.0.0.1:17810",
    "frontendDist": "../src",
    "beforeDevCommand": "node host/server.js"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MyImageViewer",
        "width": 1400,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 600,
        "decorations": false,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**"],
          "deny": []
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "../host",
      "../doc",
      "../scripts/rembg_worker.py"
    ]
  }
}
