{
 "format": "myproductionflow",
 "version": 1,
 "name": "Inventory policy (SD)",
 "description": "Seasonal lookup demand, smoothed forecast, ordering",
 "settings": {
  "timeUnit": "day",
  "duration": 365,
  "warmup": 0,
  "seed": 1,
  "randomSeed": false,
  "sdDt": 0.5,
  "sdMethod": "euler",
  "agentDt": 0.25,
  "sampleInterval": 0,
  "speed": 4,
  "floorWidth": 60,
  "floorDepth": 40,
  "costPerEntity": 0
 },
 "blocks": [
  {
   "id": "bmwhnf38810x8p",
   "type": "lookup",
   "name": "Season",
   "x": -14,
   "y": -8,
   "rot": 0,
   "props": {
    "input": "t % 365",
    "xs": "0, 90, 180, 270, 365",
    "ys": "80, 140, 200, 120, 80",
    "unitLabel": ""
   }
  },
  {
   "id": "bmwhnf38810yl",
   "type": "variable",
   "name": "Demand",
   "x": -6,
   "y": -8,
   "rot": 0,
   "props": {
    "equation": "Season * uniform(0.9, 1.1)",
    "unitLabel": ""
   }
  },
  {
   "id": "bmwhnf38810zxu",
   "type": "smooth",
   "name": "Forecast",
   "x": 2,
   "y": -8,
   "rot": 0,
   "props": {
    "input": "Demand",
    "delay": 14,
    "initial": "",
    "unitLabel": ""
   }
  },
  {
   "id": "bmwhnf388110u2",
   "type": "parameter",
   "name": "CoverDays",
   "x": 10,
   "y": -8,
   "rot": 0,
   "props": {
    "value": 10,
    "min": 2,
    "max": 30,
    "unitLabel": ""
   }
  },
  {
   "id": "bmwhnf388111df",
   "type": "stock",
   "name": "Pipeline",
   "x": -6,
   "y": 2,
   "rot": 0,
   "props": {
    "initial": "1000",
    "nonNegative": true,
    "unitLabel": "",
    "capacity": 0
   }
  },
  {
   "id": "bmwhnf388112hb",
   "type": "stock",
   "name": "Inventory",
   "x": 8,
   "y": 2,
   "rot": 0,
   "props": {
    "initial": "1500",
    "nonNegative": true,
    "unitLabel": "",
    "capacity": 0
   }
  },
  {
   "id": "bmwhnf388113q3",
   "type": "flow",
   "name": "Orders",
   "x": -14,
   "y": 2,
   "rot": 0,
   "props": {
    "equation": "max(0, Forecast + (Forecast * CoverDays - Inventory) / 5)",
    "unitLabel": "",
    "openTime": 0,
    "closedTime": 0
   }
  },
  {
   "id": "bmwhnf388114mp",
   "type": "flow",
   "name": "Arrivals",
   "x": 1,
   "y": 2,
   "rot": 0,
   "props": {
    "equation": "Pipeline / 7",
    "unitLabel": "",
    "openTime": 0,
    "closedTime": 0
   }
  },
  {
   "id": "bmwhnf388115sm",
   "type": "flow",
   "name": "Sales",
   "x": 15,
   "y": 2,
   "rot": 0,
   "props": {
    "equation": "min(Demand, Inventory)",
    "unitLabel": "",
    "openTime": 0,
    "closedTime": 0
   }
  }
 ],
