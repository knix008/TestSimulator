# 의존성과 빌드 결과
node_modules/
# Rust(Tauri) 빌드 결과. 실행 파일과 설치 파일(target/release/bundle)이 모두 여기에 생긴다.
src-tauri/target/
# tauri 가 만드는 스키마 따위. 빌드할 때마다 다시 만든다.
src-tauri/gen/
# Electron 판이 쓰던 빌드 폴더. 예전에 만든 것이 남아 있을 수 있다.
dist/
out/

# 빌드 뒤 루트로 복사한 설치 파일(tools/copy-installer.js).
# Windows 는 MyDeskBox-Setup-<판>-x64.exe 로 이름을 바꾸고, 나머지는 Tauri 가 지은 이름 그대로다
# (MyDeskBox_<판>_aarch64.dmg, MyDeskBox_<판>_amd64.deb, MyDeskBox_<판>_amd64.AppImage).
/MyDeskBox-Setup-*.exe
/MyDeskBox_*.exe
/MyDeskBox_*.dmg
/MyDeskBox_*.deb
/MyDeskBox_*.AppImage
/MyDeskBox_*.rpm

# 로그와 임시 파일
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
# store.rs 는 layout.json.tmp 에 쓴 뒤 이름을 바꾼다. 갑자기 끝나면 남을 수 있다.
*.tmp
*.tmp.*
*.bak

# 검사 결과
coverage/
.nyc_output/

# 운영체제
.DS_Store
._*
.AppleDouble
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# 편집기
.vscode/
.idea/
.vs/
*.code-workspace
*.swp
*~

# 로컬 설정.
# 설치본의 설정과 박스 보관함(boxes/)은 사용자 데이터 폴더(%APPDATA%\MyDeskBox)에 있어 여기에 들어오지 않는다.
# 검사가 만드는 폴더(mydeskbox-*)도 운영체제 임시 폴더에 생기므로 여기에 적을 것이 없다.
.env
