{
  "name": "mydeskbox",
  "productName": "MyDeskBox",
  "version": "1.0.0",
  "description": "바탕화면 펜스. Windows, macOS, Linux에서 아이콘을 반투명 박스에 모아 둡니다.",
  "author": {
    "name": "SHKWON",
    "email": "knix008@naver.com"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "node tools/start.js",
    "test": "npm run test:js && npm run test:rust",
    "test:js": "node --test --test-reporter=./tools/reporter.js test/*.test.js",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:tap": "node --test test/*.test.js",
    "icons": "node tools/make-icons.js",
    "tauri": "tauri",
    "pack": "tauri build --no-bundle",
    "build": "tauri build && node tools/copy-installer.js",
    "build:win": "tauri build --bundles nsis && node tools/copy-installer.js",
    "build:mac": "tauri build --bundles dmg && node tools/copy-installer.js",
    "build:linux": "tauri build --bundles appimage,deb && node tools/copy-installer.js"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "koffi": "^2.14.1"
  }
}
