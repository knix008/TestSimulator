{
  "name": "mydeskbox",
  "productName": "MyDeskBox",
  "version": "1.0.0",
  "description": "바탕화면 펜스. Windows, macOS, Linux에서 아이콘을 반투명 박스에 모아 둡니다.",
  "author": {
    "name": "SHKWON",
    "email": "knix008@naver.com"
  },
  "license": "MIT",
  "main": "src/main/main.js",
  "scripts": {
    "start": "node tools/start.js",
    "test": "node --test --test-reporter=./tools/reporter.js test/*.test.js",
    "icons": "node tools/make-icons.js",
    "pack": "electron-builder --dir",
    "build": "electron-builder && node tools/copy-installer.js",
    "build:win": "electron-builder --win && node tools/copy-installer.js",
    "build:mac": "electron-builder --mac && node tools/copy-installer.js",
    "build:linux": "electron-builder --linux && node tools/copy-installer.js",
    "test:tap": "node --test test/*.test.js"
  },
  "dependencies": {
    "koffi": "^2.14.1"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.suhokwon.mydeskbox",
    "productName": "MyDeskBox",
    "copyright": "Copyright © 2026 SHKWON",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!**/*.map"
    ],
    "asarUnpack": [
      "**/node_modules/koffi/**"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": false,
      "shortcutName": "MyDeskBox",
      "multiLanguageInstaller": true,
      "displayLanguageSelector": true,
      "installerLanguages": [
        "ko_KR",
        "en_US"
      ],
      "language": "1042",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "deleteAppDataOnUninstall": false,
      "allowElevation": true,
      "runAfterFinish": true
    },
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Utility",
      "synopsis": "Desktop fences for your icons",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
