{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyPhotoCut",
  "mainBinaryName": "MyPhotoCut",
  "version": "../package.json",
  "identifier": "com.shkwon.myphotocut",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1470",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$APPLOCALDATA/**",
          "$APPCONFIG/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "SHKWON",
    "copyright": "Copyright (c) SHKWON (knix008@naver.com)",
    "category": "GraphicsAndDesign",
    "shortDescription": "Photo to caricature maker",
    "longDescription": "Turns a photo into caricatures: finds the face and its features (offline face model), exaggerates the head, eyes, nose, mouth and chin, and draws forty caricatures at once in forty styles. Each one takes effects (colour, background, outline, frame, caption, speech bubble, stickers) and is saved as PNG, JPEG, WebP, AVIF, GIF, BMP, TIFF, TGA, PPM, QOI, ICO, PDF or SVG, a ZIP of all of them or a contact sheet.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "icons/project.ico": "project.ico",
      "icons/project.icns": "project.icns",
      "icons/project.png": "project.png",
      "../docs/UsersGuide.html": "docs/UsersGuide.html",
      "../docs/UsersGuide.en.html": "docs/UsersGuide.en.html",
      "../docs/images/": "docs/images/"
    },
    "fileAssociations": [
      {
        "ext": [
          "mypcut"
        ],
        "name": "MyPhotoCut.Project",
        "description": "MyPhotoCut Project",
        "mimeType": "application/x-myphotocut",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Korean",
          "English"
        ],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "headerImage": "windows/installerHeader.bmp",
        "sidebarImage": "windows/installerSidebar.bmp",
        "installerHooks": "windows/hooks.nsh",
        "startMenuFolder": "MyPhotoCut"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ],
        "files": {
          "/usr/share/mime/packages/myphotocut.xml": "linux/myphotocut.xml",
          "/usr/share/icons/hicolor/256x256/mimetypes/application-x-myphotocut.png": "icons/project.png"
        },
        "postInstallScript": "linux/postinst.sh",
        "postRemoveScript": "linux/postrm.sh"
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3"
        ],
        "files": {
          "/usr/share/mime/packages/myphotocut.xml": "linux/myphotocut.xml",
          "/usr/share/icons/hicolor/256x256/mimetypes/application-x-myphotocut.png": "icons/project.png"
        },
        "postInstallScript": "linux/postinst.sh",
        "postRemoveScript": "linux/postrm.sh"
      }
    }
  }
}
