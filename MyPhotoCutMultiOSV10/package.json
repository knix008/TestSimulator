{
  "name": "myphotocut",
  "productName": "MyPhotoCut",
  "private": true,
  "version": "1.0.0",
  "description": "Photo to caricature maker for Web, Windows, macOS and Linux (Tauri) — finds the face, exaggerates its features and draws ten caricatures in different styles at once, with effects, frames, captions and export",
  "author": "SHKWON <knix008@naver.com>",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/prepare-assets.mjs",
    "assets": "node scripts/prepare-assets.mjs --force",
    "start": "node scripts/start.mjs",
    "dev": "vite",
    "build:web": "vite build",
    "preview": "vite preview --port 4195 --strictPort",
    "tauri": "tauri",
    "test": "node scripts/test.mjs",
    "test:unit": "node scripts/test.mjs --only js,rust",
    "test:gui": "node scripts/test.mjs --only web",
    "build:win": "node scripts/build.mjs win",
    "build:mac": "node scripts/build.mjs mac",
    "build:linux": "node scripts/build.mjs linux",
    "build:all": "node scripts/build.mjs all",
    "build:icons": "node scripts/render-icons.mjs",
    "build:docs": "node scripts/build-docs.mjs",
    "guide:shots": "node scripts/smoke-web.mjs --out docs/images --steps test/e2e/guide.steps.json --width 1440 --height 900 --jpeg",
    "i18n": "node scripts/make-i18n.mjs",
    "samples": "node scripts/fetch-samples.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.2.2",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "vite": "^7.1.7"
  }
}
