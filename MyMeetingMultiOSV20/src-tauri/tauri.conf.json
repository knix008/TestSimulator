{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyMeeting",
  "mainBinaryName": "MyMeeting",
  "version": "2.0.0",
  "identifier": "com.shkwon.mymeeting",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build:ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "appimage", "deb"],
    "publisher": "SHKWON",
    "copyright": "Copyright (c) 2026 SHKWON (knix008@naver.com)",
    "category": "Productivity",
    "fileAssociations": [
      {
        "ext": ["mtg"],
        "name": "MyMeeting.Minutes",
        "description": "MyMeeting meeting minutes",
        "role": "Editor",
        "mimeType": "application/vnd.mymeeting+json"
      }
    ],
    "shortDescription": "Meeting minutes editor",
    "longDescription": "MyMeeting writes structured meeting minutes - attendees, agenda, discussion, decisions and action items - and prints or exports them.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "languages": ["Korean", "English"],
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    },
    "macOS": { "minimumSystemVersion": "10.15" },
    "linux": {
      "deb": { "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"] }
    }
  }
}
