{
  "name": "my-uml-multi-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "description": "UML diagram editor.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.json && vite build",
    "build:web": "npm run build",
    "build:desktop": "npm run build && electron-builder --publish never && node scripts/copy-installers.cjs",
    "build:win": "npm run build && electron-builder --win --publish never && node scripts/copy-installers.cjs",
    "build:linux": "npm run build && electron-builder --linux --publish never && node scripts/copy-installers.cjs",
    "build:mac": "npm run build && electron-builder --mac --publish never && node scripts/copy-installers.cjs",
    "build:all": "npm run build && electron-builder --win --linux --mac --publish never && node scripts/copy-installers.cjs",
    "start": "node scripts/run-win.cjs",
    "run:win": "node scripts/run-win.cjs",
    "start:win": "npm run run:win",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "check": "npm run build && npm run test"
  },
  "build": {
    "appId": "com.shkwon.myumlmultios",
    "productName": "UML Editor",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/app/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/app-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "UML Editor"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "assets/app-icon.svg"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "assets/app-icon.svg"
    },
    "fileAssociations": [
      {
        "ext": "umlprj",
        "name": "MyUML Project",
        "description": "MyUML project file",
        "role": "Editor",
        "icon": "assets/app-icon.ico"
      }
    ]
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "fast-xml-parser": "^5.10.1",
    "gifenc": "^1.0.3",
    "lucide-react": "^0.561.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "vite": "^7.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
