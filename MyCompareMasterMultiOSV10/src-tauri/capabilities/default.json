{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Every window (app, menu popup, dialogs) loads from the core's loopback server",
  "windows": ["*"],
  "remote": {
    "urls": ["http://127.0.0.1:*", "http://127.0.0.1:*/*"]
  },
  "permissions": [
    "core:default",
    "allow-app-info",
    "allow-app-quit",
    "allow-window-title",
    "allow-window-min-size",
    "allow-window-background",
    "allow-window-minimize",
    "allow-window-resize-to",
    "allow-window-toggle-maximize",
    "allow-window-is-maximized",
    "allow-window-native-theme",
    "allow-window-reset-zoom",
    "allow-window-start-drag",
    "allow-pick-file",
    "allow-pick-directory",
    "allow-pick-save",
    "allow-clipboard-write",
    "allow-clipboard-read",
    "allow-shell-open",
    "allow-shell-reveal",
    "allow-merge-saved",
    "allow-print-window",
    "allow-settings-broadcast",
    "allow-menu-open",
    "allow-menu-close",
    "allow-menu-payload",
    "allow-menu-size",
    "allow-menu-choose",
    "allow-dialog-open",
    "allow-dialog-payload",
    "allow-dialog-result",
    "allow-dialog-close",
    "allow-dialog-close-all",
    "allow-dialog-size"
  ]
}
