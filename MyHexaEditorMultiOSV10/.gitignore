# Git keeps only the sources. Everything below is installed or generated:
#   npm run setup  (or npm install)  — node_modules, the Rust wasm32 target, public/hexcore.wasm, public/doc/
#   npm run build:* / npm test        — build output, installers, test results

# ── installed (npm run setup / npm install)
node_modules/
.npm/
.pnpm-store/

# ── Rust build output
src-tauri/target/
src-tauri/gen/
crates/*/target/
target/

# ── generated by scripts/prepare.mjs (dev / build:web / start / test / setup) and build:icons
public/hexcore.wasm
public/doc/
assets/icon.png
assets/icon.icns
assets/icon.ico
assets/project.png

# ── web build and installers
dist/
release/
/MyHexaMaster-*.exe
/MyHexaMaster-*.msi
/MyHexaMaster-*.dmg
/MyHexaMaster-*.deb
/MyHexaMaster-*.rpm
/MyHexaMaster-*.AppImage
/MyHexaMaster-*.zip
*.exe.sig
*.AppImage.tar.gz

# ── tests, caches, temporary files
test-results/
coverage/
.vite/
.cache/
*.log
*.tmp
.*.myhexa-*.tmp

# ── editors and operating systems
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# ── local secrets
.env
.env.*
