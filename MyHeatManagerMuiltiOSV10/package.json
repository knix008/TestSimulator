{
  "name": "myheatmanager",
  "productName": "MyHeatManager",
  "private": true,
  "version": "1.0.0",
  "description": "Thermal simulation workbench for Web, Windows, macOS and Linux (Tauri + Rust solver + WebAssembly) — steady and transient conduction, convection, radiation, phase change, conjugate heat transfer, porous media, thermal stress, reliability and heat maps",
  "author": "SHKWON <knix008@naver.com>",
  "type": "module",
  "scripts": {
    "start": "node scripts/start.mjs",
    "predev": "node engine/build-wasm.mjs",
    "dev": "vite",
    "build:wasm": "node engine/build-wasm.mjs",
    "build:web": "npm run build:wasm && vite build",
    "preview": "vite preview --port 4190 --strictPort",
    "tauri": "tauri",
    "test": "node scripts/test.mjs",
    "test:js": "node --test test/unit/*.test.js",
    "test:rust": "node scripts/test.mjs --only rust",
    "build:win": "node scripts/build.mjs win",
    "build:mac": "node scripts/build.mjs mac",
    "build:linux": "node scripts/build.mjs linux",
    "build:all": "node scripts/build.mjs all",
    "build:icons": "node scripts/render-icons.mjs",
    "samples": "node scripts/make-samples.mjs && node scripts/make-format-samples.mjs",
    "build:docs": "node scripts/build-docs.mjs",
    "test:e2e": "node scripts/test.mjs --only web,desktop",
    "tutorial:capture": "node scripts/tutorial-capture.mjs && node scripts/build-docs.mjs",
    "tutorial:video": "node scripts/tutorial-video.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "vite": "^7.1.7"
  }
}
