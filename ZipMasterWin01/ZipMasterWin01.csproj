<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Properties\AssemblyInfo.cs" />
    <Compile Update="ZipMasterForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="ZipMasterForm.Designer.cs">
      <DependentUpon>ZipMasterForm.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="ZipMasterForm.resx">
      <DependentUpon>ZipMasterForm.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="BuildInstallerOnRelease"
          AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release' and '$(SkipInstaller)' != 'true'">
    <MSBuild Projects="installer\ZipMasterWin01.Installer.wixproj"
             Targets="Restore;Build"
             Properties="Configuration=$(Configuration)" />
  </Target>
</Project>