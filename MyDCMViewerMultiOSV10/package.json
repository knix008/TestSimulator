{
  "name": "mydcmviewer",
  "productName": "MyDCMViewer",
  "version": "1.0.0",
  "description": "MyDCMViewer — DICOM and medical image viewer for Windows, macOS, Linux (Tauri) and the web: start page, guided tutorial, window/level, presets, colour maps, cine, layouts, MPR / curved MPR, 3D volume rendering, image filters, PET/CT fusion, measurements, DICOMDIR / ZIP, SR / ECG / PDF / RT documents, tag editor, anonymise, PACS (C-ECHO / FIND / GET / MOVE / STORE, Storage SCP), export to 45 image formats plus video, PDF, DICOM and CSV, batch conversion.",
  "author": "SHKWON <knix008@naver.com>",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "node scripts/dev.mjs",
    "dev": "node scripts/dev.mjs",
    "web": "node server.js",
    "stage": "node scripts/build-web.js",
    "build:web": "node scripts/build-web.js",
    "build:win": "node scripts/platform-build.mjs win",
    "build:mac": "node scripts/platform-build.mjs mac",
    "build:linux": "node scripts/platform-build.mjs linux",
    "build:all": "node scripts/platform-build.mjs all",
    "create-icons": "node scripts/create-icons.js",
    "test": "node --test --test-reporter=./test/reporter.js test/*.test.js",
    "test:tap": "node --test test/*.test.js",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "smoke": "node scripts/smoke.mjs",
    "smoke:desktop": "node scripts/smoke.mjs --desktop",
    "mini-pacs": "node scripts/mini-pacs.cjs",
    "help:build": "node scripts/make-help.mjs",
    "help:media": "node scripts/make-help-media.mjs",
    "tutorial:video": "node scripts/make-tutorial-video.mjs",
    "video-samples": "node scripts/make-video-samples.mjs"
  },
  "dependencies": {
    "@cornerstonejs/codec-charls": "^1.2.7",
    "@cornerstonejs/codec-libjpeg-turbo-12bit": "^0.4.7",
    "@cornerstonejs/codec-libjpeg-turbo-8bit": "^1.2.8",
    "@cornerstonejs/codec-openjpeg": "^1.3.6",
    "@jsquash/avif": "^2.1.1",
    "@jsquash/jxl": "^1.3.0",
    "@jsquash/webp": "^1.5.0",
    "dicom-parser": "^1.8.21",
    "jpeg-lossless-decoder-js": "^2.1.2",
    "libheif-js": "^1.23.2",
    "pako": "^2.2.0",
    "utif": "^3.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "express": "^4.22.2",
    "sharp": "^0.35.3"
  },
  "homepage": "https://github.com/knix008/TestSimulator",
  "keywords": [
    "dicom",
    "medical-imaging",
    "viewer",
    "tauri"
  ]
}
