{
  "format": "mysim",
  "version": 1,
  "name": "유한요소 3D: 방열판과 브래킷",
  "description": "SolidWorks Simulation·Ansys 형 3D 해석 두 가지: 핀 8개 알루미늄 방열판에 10 W 칩을 얹고 공기로 식힐 때의 온도, 벽에 볼트로 고정한 강철 L 브래킷에 1.5 kN 을 걸 때의 von Mises 응력과 안전율. 3D 보기에서 색칠된 표면을 돌려 봅니다.",
  "nodes": [
    {
      "id": "sink",
      "type": "fem.solid",
      "name": "방열판 온도",
      "x": 60,
      "y": 50,
      "params": {
        "physics": "heat",
        "part": "# Aluminium heat sink: a base with eight fins, a 10 W chip under it, air all round\nunits: mm\nmaterial: aluminium\nbase plate: box 0 0 0 80 60 5\nadd fins: box 2 0 5 6 60 35, repeat = 8, dx = 10\nmesh: n = 60\nsource: box 30 20 0 50 40 2, power = 10\nconvection: all, h = 12, Tinf = 25\nprobe chip: 40 30 0\nprobe fin: 7 30 35",
        "deform": 1
      },
      "disabled": false
    },
    {
      "id": "bracket",
      "type": "fem.solid",
      "name": "브래킷 응력",
      "x": 60,
      "y": 330,
      "params": {
        "physics": "elasticity",
        "part": "# Steel L bracket bolted to a wall (x = 0), 1.5 kN down on the end of the foot\nunits: mm\nmaterial: steel\nbase foot: box 0 0 0 120 60 10\nadd wall: box 0 0 10 10 60 80\ncut slot: cylinder z 80 30 -1 12 8\nmesh: n = 50\nfix: x-\nload: box 100 0 10 120 60 10, f = 0 0 -1500\nprobe end: 120 30 10",
        "deform": 1,
        "yield": 275000000
      },
      "disabled": false
    },
    {
      "id": "p1",
      "type": "out.plot",
      "name": "차트",
      "x": 320,
      "y": 50,
      "params": {
        "chart": "heatmap",
        "logX": false,
        "logY": false,
        "equal": false,
        "span": "2",
        "title": "가운데 단면 온도 (°C)"
      },
      "disabled": false
    },
    {
      "id": "p2",
      "type": "out.plot",
      "name": "차트",
      "x": 320,
      "y": 330,
      "params": {
        "chart": "heatmap",
        "logX": false,
        "logY": false,
        "equal": false,
        "span": "2",
        "title": "가운데 단면 von Mises 응력 (Pa)"
      },
      "disabled": false
    },
    {
      "id": "k1",
      "type": "out.kpi",
      "name": "KPI 값",
      "x": 580,
      "y": 190,
      "params": {
        "label": "칩 온도",
        "aggregate": "last",
        "scale": 1,
        "source": "T(chip)",
        "unit": "°C",
        "high": 85
      },
      "disabled": false
    },
    {
      "id": "k2",
      "type": "out.kpi",
      "name": "KPI 값",
      "x": 840,
      "y": 190,
      "params": {
        "label": "안전율",
        "aggregate": "last",
        "scale": 1,
        "source": "safety factor",
        "low": 2
      },
      "disabled": false
    }
  ],
  "links": [
    {
      "id": "l1",
      "from": "sink",
      "fromPort": "out",
      "to": "p1",
      "toPort": "in"
    },
    {
      "id": "l2",
      "from": "bracket",
      "fromPort": "out",
      "to": "p2",
      "toPort": "in"
    },
    {
      "id": "l3",
      "from": "sink",
      "fromPort": "out",
      "to": "k1",
      "toPort": "in"
    },
    {
      "id": "l4",
      "from": "bracket",
      "fromPort": "out",
      "to": "k2",
