{
  "format": "mysim",
  "version": 1,
  "name": "Structures: frames, trusses, natural frequencies",
  "description": "Three SAP2000/Ansys-style structural analyses: a steel portal frame under a distributed and a wind load (member forces, deflection, buckling load factor), a Warren truss bridge (axial forces and the bar that buckles first) and the natural frequencies of a cantilever (3D finite element modal analysis, about 181 Hz in theory). Pick a frame and see its original and deformed shape in the 3D view.",
  "nodes": [
    {
      "id": "portal",
      "type": "frame.struct",
      "name": "Portal frame",
      "x": 60,
      "y": 50,
      "params": {
        "frame": "# A steel portal frame 6 m × 4 m: fixed columns, a beam with 10 kN/m, wind 5 kN at the top\nunits: m\nmaterial: steel\nsection col: box b = 0.2, h = 0.2, t = 0.01\nsection beam: rect b = 0.15, h = 0.4\nnode a: 0 0 0\nnode b: 0 0 4\nnode c: 6 0 4\nnode d: 6 0 0\nbeam c1: a b, section = col\nbeam g1: b c, section = beam\nbeam c2: d c, section = col\nsupport a: fixed\nsupport d: fixed\nudl g1: 0 0 -10000\nload b: 5000 0 0\ngravity: 0 0 -9.81",
        "segments": 8,
        "buckling": "true",
        "deform": 1
      },
      "disabled": false
    },
    {
      "id": "truss",
      "type": "frame.struct",
      "name": "Warren truss",
      "x": 60,
      "y": 330,
      "params": {
        "frame": "# A 12 m Warren truss, 20 kN at each lower joint\nunits: m\nmaterial: steel\nsection chord: box b = 0.12, h = 0.12, t = 0.006\nsection web: pipe d = 0.08, t = 0.005\nnode l0: 0 0 0\nnode l1: 3 0 0\nnode l2: 6 0 0\nnode l3: 9 0 0\nnode l4: 12 0 0\nnode u1: 1.5 0 2\nnode u2: 4.5 0 2\nnode u3: 7.5 0 2\nnode u4: 10.5 0 2\ntruss b1: l0 l1, section = chord\ntruss b2: l1 l2, section = chord\ntruss b3: l2 l3, section = chord\ntruss b4: l3 l4, section = chord\ntruss t1: u1 u2, section = chord\ntruss t2: u2 u3, section = chord\ntruss t3: u3 u4, section = chord\ntruss w1: l0 u1, section = web\ntruss w2: u1 l1, section = web\ntruss w3: l1 u2, section = web\ntruss w4: u2 l2, section = web\ntruss w5: l2 u3, section = web\ntruss w6: u3 l3, section = web\ntruss w7: l3 u4, section = web\ntruss w8: u4 l4, section = web\nsupport l0: pinned\nsupport l4: dofs = uy uz\nsupport u1: dofs = uy\nsupport u2: dofs = uy\nsupport u3: dofs = uy\nsupport u4: dofs = uy\nsupport l1: dofs = uy\nsupport l2: dofs = uy\nsupport l3: dofs = uy\nload l1: 0 0 -20000\nload l2: 0 0 -20000\nload l3: 0 0 -20000",
        "segments": 8,
        "buckling": "true",
        "deform": 1
      },
      "disabled": false
    },
    {
      "id": "modes",
      "type": "fem.solid",
      "name": "Cantilever natural frequencies",
      "x": 60,
      "y": 610,
      "params": {
        "physics": "modal",
        "modes": 6,
        "mode": 1,
        "part": "# Aluminium beam 300 × 30 × 20 mm clamped at x = 0: f1 ≈ 181 Hz (beam theory)\nunits: mm\nmaterial: aluminium\nbase beam: box 0 0 0 300 30 20\nmesh: n = 60\nfix: x-",
        "deform": 1
      },
      "disabled": false
    },
    {
      "id": "p1",
      "type": "out.plot",
      "name": "Chart",
      "x": 320,
      "y": 50,
      "params": {
        "chart": "table",
        "logX": false,
        "logY": false,
        "equal": false,
        "span": "2",
        "title": "Portal: member forces",
        "table": "member forces"
      },
      "disabled": false
    },
    {
      "id": "p2",
      "type": "out.plot",
      "name": "Chart",
      "x": 320,
      "y": 330,
      "params": {
        "chart": "bar",
        "logX": false,
        "logY": false,
        "equal": false,
        "span": "2",
        "title": "Truss: axial force (N)",
        "table": "member forces",
        "y": "N"
      },
      "disabled": false
    },
    {
      "id": "p3",
      "type": "out.plot",
      "name": "Chart",
      "x": 320,
      "y": 610,
      "params": {
        "chart": "bar",
        "logX": false,
        "logY": false,
        "equal": false,
        "span": "1",
        "title": "Natural frequencies (Hz)",
        "table": "modes",
        "y": "frequency"
      },
      "disabled": false
    },
    {
      "id": "k1",
      "type": "out.kpi",
      "name": "KPI value",
      "x": 840,
      "y": 50,
      "params": {
        "label": "Portal buckling factor",
        "aggregate": "last",
        "scale": 1,
        "source": "buckling load factor",
        "low": 3
      },
      "disabled": false
    },
    {
      "id": "k2",
      "type": "out.kpi",
      "name": "KPI value",
      "x": 840,
      "y": 330,
      "params": {
        "label": "Truss safety factor",
        "aggregate": "last",
        "scale": 1,
        "source": "safety factor",
        "low": 2
      },
      "disabled": false
    },
    {
      "id": "k3",
      "type": "out.kpi",
      "name": "KPI value",
      "x": 580,
      "y": 610,
      "params": {
        "label": "First frequency",
        "aggregate": "last",
        "scale": 1,
        "source": "f1",
        "unit": "Hz"
      },
      "disabled": false
    }
  ],
  "links": [
    {
      "id": "l1",
      "from": "portal",
      "fromPort": "out",
      "to": "p1",
      "toPort": "in"
    },
    {
      "id": "l2",
      "from": "truss",
      "fromPort": "out",
      "to": "p2",
      "toPort": "in"
    },
    {
      "id": "l3",
