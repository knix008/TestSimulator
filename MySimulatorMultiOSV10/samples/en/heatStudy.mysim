{
  "format": "mysim",
  "version": 1,
  "name": "MyHeatManager heat studies (built-in engine)",
  "description": "MyHeatManager's solver is built into MySimulator, so .myheat models run without any other program: a chip with a thermal interface and a copper foil under a heat sink (steady) and a wall under a daily outdoor temperature cycle (transient). The results feed charts and KPIs like any other node.",
  "nodes": [
    {
      "id": "chip",
      "type": "io.myheat",
      "name": "Chip and heat sink",
      "x": 60,
      "y": 50,
      "params": {
        "field": "T",
        "content": "",
        "fileName": "thin_layer.myheat"
      },
      "disabled": false
    },
    {
      "id": "wall",
      "type": "io.myheat",
      "name": "A wall over a day",
      "x": 60,
      "y": 330,
      "params": {
        "field": "T",
        "content": "",
        "fileName": "time_bc.myheat"
      },
      "disabled": false
    },
    {
      "id": "p1",
      "type": "out.plot",
      "name": "Chart",
      "x": 320,
      "y": 50,
      "params": {
        "chart": "heatmap",
        "logX": false,
        "logY": false,
        "equal": false,
        "span": "2",
        "title": "Temperature (°C)"
      },
      "disabled": false
    },
    {
      "id": "p2",
      "type": "out.plot",
      "name": "Chart",
      "x": 320,
      "y": 330,
      "params": {
        "chart": "heatmap",
        "logX": false,
        "logY": false,
        "equal": false,
        "span": "2",
        "title": "Wall at the end of the day (°C)"
      },
      "disabled": false
    },
    {
      "id": "k1",
      "type": "out.kpi",
      "name": "KPI value",
      "x": 840,
      "y": 50,
      "params": {
        "label": "Hottest point",
        "aggregate": "last",
        "scale": 1,
        "source": "Tmax",
        "unit": "°C"
      },
      "disabled": false
    },
    {
      "id": "k2",
      "type": "out.kpi",
      "name": "KPI value",
      "x": 840,
      "y": 190,
      "params": {
        "label": "Heat balance error",
        "aggregate": "last",
        "scale": 1,
        "source": "balance error"
      },
      "disabled": false
    },
    {
      "id": "k3",
      "type": "out.kpi",
      "name": "KPI value",
      "x": 840,
      "y": 330,
      "params": {
        "label": "Mid-wall temperature",
        "aggregate": "last",
        "scale": 1,
        "source": "probe mid",
        "unit": "°C"
      },
      "disabled": false
    }
  ],
  "links": [
    {
      "id": "l1",
      "from": "chip",
      "fromPort": "out",
      "to": "p1",
      "toPort": "in"
    },
    {
      "id": "l2",
      "from": "wall",
      "fromPort": "out",
      "to": "p2",
      "toPort": "in"
    },
    {
      "id": "l3",
      "from": "chip",
      "fromPort": "out",
      "to": "k1",
      "toPort": "in"
    },
    {
      "id": "l4",
      "from": "chip",
      "fromPort": "out",
      "to": "k2",
      "toPort": "in"
    },
    {
      "id": "l5",
      "from": "wall",
      "fromPort": "out",
      "to": "k3",
      "toPort": "in"
    }
  ],
  "settings": {
    "seed": 1
  },
  "view": null
}
