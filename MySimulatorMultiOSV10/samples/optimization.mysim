{
  "format": "mysim",
  "version": 1,
  "name": "최적화 (국소·전역)",
  "description": "로젠브록 함수의 넬더-미드 탐색 경로와, 국소 최솟값이 많은 라스트리긴 함수의 차분 진화 전역 탐색.",
  "nodes": [
    {
      "id": "nm",
      "type": "opt.minimize",
      "name": "로젠브록 (넬더-미드)",
      "x": 60,
      "y": 50,
      "params": {
        "objective": "(1 - x)^2 + 100*(y - x^2)^2",
        "variables": "x: -2 .. 2 = -1.2\ny: -1 .. 3 = 1",
        "goal": "minimize",
        "method": "nelderMead",
        "maxIterations": 2000,
        "tolerance": 1e-10,
        "logMap": true,
        "seed": 1
      },
      "disabled": false
    },
    {
      "id": "de",
      "type": "opt.minimize",
      "name": "라스트리긴 (차분 진화)",
      "x": 60,
      "y": 330,
      "params": {
        "objective": "20 + x^2 - 10*cos(2*pi*x) + y^2 - 10*cos(2*pi*y)",
        "variables": "x: -5.12 .. 5.12\ny: -5.12 .. 5.12",
        "goal": "minimize",
        "method": "de",
        "maxIterations": 300,
        "tolerance": 1e-10,
        "logMap": true,
        "seed": 1
      },
      "disabled": false
    },
    {
      "id": "p1",
      "type": "out.plot",
      "name": "차트",
      "x": 320,
      "y": 50,
      "params": {
        "chart": "heatmap",
        "logX": false,
        "logY": false,
        "equal": false,
        "span": "1",
        "title": "로젠브록 지도와 경로"
      },
      "disabled": false
    },
    {
      "id": "p2",
      "type": "out.plot",
      "name": "차트",
      "x": 580,
      "y": 50,
      "params": {
        "chart": "line",
        "logX": false,
        "logY": true,
        "equal": false,
        "span": "1",
        "title": "수렴",
        "table": "history",
        "y": "objective"
      },
      "disabled": false
    },
    {
      "id": "p3",
      "type": "out.plot",
      "name": "차트",
      "x": 320,
      "y": 330,
      "params": {
        "chart": "heatmap",
        "logX": false,
        "logY": false,
        "equal": false,
        "span": "1",
        "title": "라스트리긴 지도와 경로"
      },
      "disabled": false
    },
    {
      "id": "k",
      "type": "out.kpi",
      "name": "KPI 값",
      "x": 580,
      "y": 330,
      "params": {
        "label": "찾은 전역 최솟값",
        "aggregate": "last",
        "scale": 1,
        "source": "optimum"
      },
      "disabled": false
    }
  ],
  "links": [
    {
      "id": "l1",
      "from": "nm",
      "fromPort": "out",
      "to": "p1",
      "toPort": "in"
    },
    {
      "id": "l2",
      "from": "nm",
      "fromPort": "out",
      "to": "p2",
      "toPort": "in"
    },
    {
      "id": "l3",
      "from": "de",
      "fromPort": "out",
      "to": "p3",
      "toPort": "in"
    },
    {
      "id": "l4",
      "from": "de",
      "fromPort": "out",
      "to": "k",
      "toPort": "in"
    }
  ],
  "settings": {
    "seed": 1
  },
  "view": null
}
