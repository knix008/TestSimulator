{
  "format": "mysim",
  "version": 1,
  "name": "소리 파일 분석 (WAV)",
  "description": "파이프라인 안에 담은 WAV 파일(가 장화음 440·660 Hz, 1.2 kHz 휘파람, 잡음)을 읽어 스펙트럼으로 음을 찾고, 스펙트로그램을 그리고, 필터로 휘파람을 지웁니다. Excel·STL·MATLAB·PNG 파일도 같은 파일 데이터 노드로 읽습니다.",
  "nodes": [
    {
      "id": "wav",
      "type": "source.file",
      "name": "chord.wav",
      "x": 60,
      "y": 190,
      "params": {
        "content": "",
        "fileName": "chord.wav"
      },
      "disabled": false
    },
    {
      "id": "fft",
      "type": "signal.fft",
      "name": "스펙트럼",
      "x": 320,
      "y": 50,
      "params": {
        "window": "hann",
        "removeMean": true,
        "zeroPad": false,
        "fs": 0
      },
      "disabled": false
    },
    {
      "id": "spec",
      "type": "signal.spectrogram",
      "name": "스펙트로그램",
      "x": 320,
      "y": 330,
      "params": {
        "segment": 256,
        "overlap": 75,
        "window": "hann",
        "fs": 0
      },
      "disabled": false
    },
    {
      "id": "lp",
      "type": "signal.filter",
      "name": "휘파람 제거 (900 Hz)",
      "x": 320,
      "y": 190,
      "params": {
        "design": "butterworth",
        "type": "lowpass",
        "cutoff": 900,
        "cutoff2": 50,
        "order": 8,
        "taps": 101,
        "width": 9,
        "zeroPhase": true,
        "fs": 0
      },
      "disabled": false
    },
    {
      "id": "peaks",
      "type": "signal.peaks",
      "name": "음 찾기",
      "x": 580,
      "y": 50,
      "params": {
        "minProminence": 0,
        "minDistance": 0,
        "maxCount": 50,
        "valleys": false,
        "column": "amplitude",
        "prominence": 0.05
      },
      "disabled": false
    },
    {
      "id": "fft2",
      "type": "signal.fft",
      "name": "필터 후 스펙트럼",
      "x": 580,
      "y": 190,
      "params": {
        "window": "hann",
        "removeMean": true,
        "zeroPad": false,
        "fs": 0,
        "column": "filtered"
      },
      "disabled": false
    },
    {
      "id": "p1",
      "type": "out.plot",
      "name": "차트",
      "x": 840,
      "y": 50,
      "params": {
        "chart": "line",
        "logX": false,
        "logY": false,
        "equal": false,
        "span": "2",
        "title": "스펙트럼 (dB)",
        "y": "dB"
      },
      "disabled": false
    },
    {
      "id": "p2",
      "type": "out.plot",
      "name": "차트",
      "x": 580,
      "y": 330,
      "params": {
        "chart": "heatmap",
        "logX": false,
        "logY": false,
        "equal": false,
        "span": "2",
        "title": "스펙트로그램"
      },
      "disabled": false
    },
    {
      "id": "p3",
      "type": "out.plot",
      "name": "차트",
      "x": 840,
      "y": 190,
      "params": {
        "chart": "line",
        "logX": false,
        "logY": false,
        "equal": false,
        "span": "1",
        "title": "필터 후 (dB)",
        "y": "dB"
      },
      "disabled": false
    },
    {
      "id": "k1",
      "type": "out.kpi",
      "name": "KPI 값",
      "x": 1100,
      "y": 50,
      "params": {
        "label": "가장 큰 음",
        "aggregate": "last",
        "scale": 1,
        "source": "dominant frequency",
        "unit": "Hz"
      },
      "disabled": false
    }
  ],
  "links": [
    {
      "id": "l1",
      "from": "wav",
      "fromPort": "out",
      "to": "fft",
      "toPort": "in"
    },
    {
      "id": "l2",
      "from": "wav",
      "fromPort": "out",
      "to": "spec",
      "toPort": "in"
    },
    {
      "id": "l3",
      "from": "wav",
      "fromPort": "out",
      "to": "lp",
      "toPort": "in"
    },
    {
      "id": "l4",
      "from": "fft",
      "fromPort": "out",
      "to": "peaks",
      "toPort": "in"
    },
    {
      "id": "l5",
      "from": "lp",
      "fromPort": "out",
      "to": "fft2",
      "toPort": "in"
    },
    {
      "id": "l6",
      "from": "fft",
      "fromPort": "out",
      "to": "p1",
      "toPort": "in"
    },
    {
      "id": "l7",
      "from": "spec",
      "fromPort": "out",
      "to": "p2",
      "toPort": "in"
    },
    {
      "id": "l8",
      "from": "fft2",
      "fromPort": "out",
      "to": "p3",
      "toPort": "in"
    },
    {
      "id": "l9",
      "from": "fft",
      "fromPort": "out",
      "to": "k1",
      "toPort": "in"
    }
  ],
  "settings": {
    "seed": 1
  },
  "view": null
}
