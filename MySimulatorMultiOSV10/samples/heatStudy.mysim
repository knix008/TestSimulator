{
  "format": "mysim",
  "version": 1,
  "name": "MyHeatManager 열 해석 (내장 엔진)",
  "description": "MyHeatManager 의 해석 엔진이 MySimulator 에 들어 있어 다른 프로그램 없이 .myheat 모델을 풉니다: 열 계면재·구리 박막이 있는 칩과 방열판(정상), 하루 동안 바깥 기온이 바뀌는 벽(과도). 결과는 다른 노드처럼 차트와 KPI 로 이어집니다.",
  "nodes": [
    {
      "id": "chip",
      "type": "io.myheat",
      "name": "칩과 방열판",
      "x": 60,
      "y": 50,
      "params": {
        "field": "T",
        "content": "",
        "fileName": "thin_layer.myheat"
      },
      "disabled": false
    },
    {
      "id": "wall",
      "type": "io.myheat",
      "name": "하루 동안의 벽",
      "x": 60,
      "y": 330,
      "params": {
        "field": "T",
        "content": "",
        "fileName": "time_bc.myheat"
      },
      "disabled": false
    },
    {
      "id": "p1",
      "type": "out.plot",
      "name": "차트",
      "x": 320,
      "y": 50,
      "params": {
        "chart": "heatmap",
        "logX": false,
        "logY": false,
        "equal": false,
        "span": "2",
        "title": "온도 (°C)"
      },
      "disabled": false
    },
    {
      "id": "p2",
      "type": "out.plot",
      "name": "차트",
      "x": 320,
      "y": 330,
      "params": {
        "chart": "heatmap",
        "logX": false,
        "logY": false,
        "equal": false,
        "span": "2",
        "title": "하루 끝의 벽 (°C)"
      },
      "disabled": false
    },
    {
      "id": "k1",
      "type": "out.kpi",
      "name": "KPI 값",
      "x": 840,
      "y": 50,
      "params": {
        "label": "최고 온도",
        "aggregate": "last",
        "scale": 1,
        "source": "Tmax",
        "unit": "°C"
      },
      "disabled": false
    },
    {
      "id": "k2",
      "type": "out.kpi",
      "name": "KPI 값",
      "x": 840,
      "y": 190,
      "params": {
        "label": "열 수지 오차",
        "aggregate": "last",
        "scale": 1,
        "source": "balance error"
      },
      "disabled": false
    },
    {
      "id": "k3",
      "type": "out.kpi",
      "name": "KPI 값",
      "x": 840,
      "y": 330,
      "params": {
        "label": "벽 가운데 온도",
        "aggregate": "last",
        "scale": 1,
        "source": "probe mid",
        "unit": "°C"
      },
      "disabled": false
    }
  ],
  "links": [
    {
      "id": "l1",
      "from": "chip",
      "fromPort": "out",
      "to": "p1",
      "toPort": "in"
    },
    {
      "id": "l2",
      "from": "wall",
      "fromPort": "out",
      "to": "p2",
      "toPort": "in"
    },
    {
      "id": "l3",
      "from": "chip",
      "fromPort": "out",
      "to": "k1",
      "toPort": "in"
    },
    {
      "id": "l4",
      "from": "chip",
      "fromPort": "out",
      "to": "k2",
      "toPort": "in"
    },
    {
      "id": "l5",
      "from": "wall",
      "fromPort": "out",
      "to": "k3",
      "toPort": "in"
    }
  ],
  "settings": {
    "seed": 1
  },
  "view": null
}
