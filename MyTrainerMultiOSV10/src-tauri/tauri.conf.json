{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyTrainer",
  "mainBinaryName": "MyTrainer",
  "version": "../package.json",
  "identifier": "com.shkwon.mytrainer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1470",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "SHKWON",
    "copyright": "Copyright (c) SHKWON (knix008@naver.com)",
    "category": "DeveloperTool",
    "shortDescription": "Visual deep learning workbench",
    "longDescription": "Design neural networks visually, prepare data, train them live with TensorFlow.js or PyTorch, watch every layer and neuron work, test the trained model and edit the generated PyTorch code.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../docs/": "docs/"
    },
    "fileAssociations": [
      {
        "ext": ["mytrain"],
        "name": "MyTrainer.Project",
        "description": "MyTrainer Project",
        "mimeType": "application/x-mytrainer",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Korean", "English"],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh",
        "startMenuFolder": "MyTrainer"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"],
        "files": {
          "/usr/share/mime/packages/mytrainer.xml": "linux/mytrainer.xml"
        },
        "postInstallScript": "linux/postinst.sh",
        "postRemoveScript": "linux/postrm.sh"
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "gtk3"],
        "files": {
          "/usr/share/mime/packages/mytrainer.xml": "linux/mytrainer.xml"
        },
        "postInstallScript": "linux/postinst.sh",
        "postRemoveScript": "linux/postrm.sh"
      }
    }
  }
}
