{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build CommandCenterGTKv10",
            "type": "shell",
            "command": "make",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Run CommandCenterGTKv10",
            "type": "shell",
            "command": "make run",
            "group": "test",
            "dependsOn": "Build CommandCenterGTKv10",
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        }
    ]
}
