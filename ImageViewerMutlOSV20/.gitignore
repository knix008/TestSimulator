samples/image-*.dcm
samples/**/*.zip

# Feature-test reports (regenerated by `npm test`)
tests/results.html
tests/results.json

# Test-driver artifacts (CDP screenshots, synthetic DICOM fixtures, scratch copies)
shots/
scratch/
*.orig.js

# Electron profiles left behind by --user-data-dir when driving the app over CDP
udata/
.electron-user-data/

# Editor / tooling local overrides
.claude/settings.local.json
*.code-workspace
