{
  "name": "mypdfviewer",
  "version": "1.0.0",
  "description": "Cross-platform (Web / Windows / macOS / Linux) PDF viewer that lets you read PDFs and copy the text and images inside them.",
  "author": {
    "name": "SHKWON",
    "email": "knix008@naver.com"
  },
  "license": "MIT",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "postinstall": "node scripts/copy-pdfjs-assets.mjs && node scripts/generate-build-info.mjs",
    "prepare:assets": "node scripts/copy-pdfjs-assets.mjs && node scripts/generate-build-info.mjs",
    "prestart": "npm run prepare:assets",
    "start": "cross-env NODE_OPTIONS=--disable-warning=DEP0060 concurrently -k \"vite --port 5179\" \"wait-on tcp:5179 && cross-env ELECTRON_DEV=1 node scripts/start-electron.mjs\"",
    "predev": "npm run prepare:assets",
    "dev": "vite --port 5179",
    "preweb": "npm run prepare:assets",
    "web": "vite --port 5179",
    "electron": "cross-env ELECTRON_DEV=1 node scripts/start-electron.mjs",
    "preview:electron": "node scripts/start-electron.mjs",
    "generate:icons": "node scripts/generate-icons.mjs",
    "generate:build-info": "node scripts/generate-build-info.mjs",
    "copy:pdfjs": "node scripts/copy-pdfjs-assets.mjs",
    "prebuild": "npm run prepare:assets",
    "build": "vite build",
    "prebuild:win": "npm run generate:icons && npm run prepare:assets",
    "build:win": "vite build && electron-builder --win",
    "postbuild:win": "node scripts/copy-installer.js",
    "prebuild:mac": "npm run generate:icons && npm run prepare:assets",
    "build:mac": "vite build && electron-builder --mac",
    "postbuild:mac": "node scripts/copy-installer.js",
    "prebuild:linux": "npm run generate:icons && npm run prepare:assets",
    "build:linux": "vite build && electron-builder --linux",
    "postbuild:linux": "node scripts/copy-installer.js",
    "copy:installer": "node scripts/copy-installer.js",
    "preview": "vite preview --port 4179"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "i18next": "^23.11.5",
    "pdfjs-dist": "^4.8.69",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^14.1.2",
    "sharp": "^0.33.4",
    "vite": "^5.4.1",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.shkwon.mypdfviewer",
    "productName": "MyPDFViewer",
    "copyright": "Copyright © 2026 SHKWON (knix008@naver.com)",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icons/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "src/build-info.json",
        "to": "build-info.json"
      },
      {
        "from": "build/icons/file.ico",
        "to": "file.ico"
      },
      {
        "from": "build/icons/file.png",
        "to": "file.png"
      }
    ],
    "asar": true,
    "icon": "build/icons/icon.png",
    "fileAssociations": [
      {
        "ext": "pdfvw",
        "name": "MyPDFViewer Workspace",
        "description": "MyPDFViewer Workspace (highlights, clips and bookmarks for a PDF)",
        "mimeType": "application/x-mypdfviewer-workspace",
        "role": "Editor",
        "icon": "build/icons/file.ico"
      }
    ],
    "win": {
      "icon": "build/icons/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": false,
      "menuCategory": true,
      "shortcutName": "MyPDFViewer",
      "installerIcon": "build/icons/icon.ico",
      "uninstallerIcon": "build/icons/icon.ico",
      "installerHeaderIcon": "build/icons/icon.ico",
      "deleteAppDataOnUninstall": true,
      "include": "build/installer.nsh"
    },
    "mac": {
      "icon": "build/icons/icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "build/icons/png",
      "category": "Office;Viewer",
      "desktop": {
        "MimeType": "application/x-mypdfviewer-workspace;application/pdf"
      },
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "allowScripts": {
    "electron@31.7.7": true,
    "sharp@0.33.5": true,
    "esbuild@0.21.5": true
  }
}
