# ── Dependencies ────────────────────────────────────────
node_modules/

# ── Build output (reproducible: npm install && npm run build:<os>) ──
dist/
release/
build/icons/
src/build-info.json
public/icon.svg

# ── Installers copied to the project root by scripts/copy-installer.js ──
*.exe
*.dmg
*.AppImage
*.deb
*.rpm
*.snap
*.zip
*.blockmap

# ── Smoke-test output (npm run smoke): screenshots (main + tool windows), scripts, private profile ──
.smoke/
.icons-preview.png
.npm-install.log

# ── Dev profiles (CC_USER_DATA=<folder>) and local env ──
.profile*/
.env
.env.*

# ── Local / editor / OS noise ───────────────────────────
*.log
npm-debug.log*
.vite/
.eslintcache
coverage/
*.tmp
*~
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
.claude/
