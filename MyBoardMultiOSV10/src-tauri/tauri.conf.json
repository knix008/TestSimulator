{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyBoard",
  "mainBinaryName": "MyBoard",
  "version": "../package.json",
  "identifier": "com.shkwon.myboard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5520",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$APPLOCALDATA/**",
          "$APPCONFIG/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "SHKWON",
    "copyright": "Copyright (c) SHKWON (knix008@naver.com)",
    "category": "Productivity",
    "shortDescription": "Kanban boards and issue tracking",
    "longDescription": "Manage projects, boards, backlogs and issues the Kanban way: columns with WIP limits, swimlanes, quick filters, a search language, workflows, reports, automation, checklists and covers. Data is stored in SQLite, MySQL, MariaDB, PostgreSQL or SQL Server.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "icons/project.ico": "project.ico",
      "icons/project.icns": "project.icns",
      "icons/project.png": "project.png",
      "runtime/": "runtime/",
      "../public/doc/": "doc/"
    },
    "fileAssociations": [
      {
        "ext": [
          "myboard"
        ],
        "name": "MyBoard.Project",
        "description": "MyBoard Project",
        "mimeType": "application/x-myboard",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Korean",
          "English"
        ],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "headerImage": "windows/installerHeader.bmp",
        "sidebarImage": "windows/installerSidebar.bmp",
        "installerHooks": "windows/hooks.nsh",
        "startMenuFolder": "MyBoard"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ],
        "files": {
          "/usr/share/mime/packages/myboard.xml": "linux/myboard.xml",
          "/usr/share/icons/hicolor/256x256/mimetypes/application-x-myboard.png": "icons/project.png"
        },
        "postInstallScript": "linux/postinst.sh",
        "postRemoveScript": "linux/postrm.sh"
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3"
        ],
        "files": {
          "/usr/share/mime/packages/myboard.xml": "linux/myboard.xml",
          "/usr/share/icons/hicolor/256x256/mimetypes/application-x-myboard.png": "icons/project.png"
        },
        "postInstallScript": "linux/postinst.sh",
        "postRemoveScript": "linux/postrm.sh"
      }
    }
  }
}
