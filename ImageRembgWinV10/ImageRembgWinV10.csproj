<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Description>Interactive image background removal tool</Description>
    <Product>$(Product)</Product>
    <Company>$(Company)</Company>
    <Copyright>$(Copyright)</Copyright>
    <Version>$(Version)</Version>
    <AssemblyVersion>$(AssemblyVersion)</AssemblyVersion>
    <FileVersion>$(FileVersion)</FileVersion>
    <InformationalVersion>$(InformationalVersion)</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Tools/**" />
    <None Include="Tools/**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\AppIcon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\AppIcon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Models\README.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!--
      rembg2.onnx (RMBG-2.0) is gated/non-commercial-licensed on Hugging Face and cannot be
      redistributed via the public installer. It is copied for local dev/test builds, but
      excluded from the Installer publish profile (see Installer.pubxml) so the MSI stays
      small and doesn't bundle a model users must individually accept the license for.
    -->
    <Content Include="Assets\Models\rembg2.onnx" Condition="'$(ExcludeRembg2ModelFromPublish)' != 'true'">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.22.0" />
    <PackageReference Include="HeyRed.ImageSharp.Heif" Version="2.1.3" />
    <PackageReference Include="LibHeif.Native.win-x64" Version="1.15.1" />
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260602" />
    <PackageReference Include="OpenCvSharp4.Extensions" Version="4.13.0.20260602" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260602" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>

  <!--
    Some referenced NuGet packages (notably Microsoft.ML.OnnxRuntime) ship native binaries for
    every platform (iOS, Android, macOS, Linux, win-x86, win-arm64) and publish doesn't trim them
    for a framework-dependent single-RID publish. This app is win-x64 only, so strip every other
    RID's "runtimes" folder from the publish output to keep the MSI from bundling ~200MB of
    binaries that can never run on the target machine.
  -->
  <Target Name="TrimUnusedRuntimeAssets" AfterTargets="Publish">
    <ItemGroup>
      <_AllRuntimeDirs Include="$([System.IO.Directory]::GetDirectories('$(PublishDir)runtimes'))" Condition="Exists('$(PublishDir)runtimes')" />
      <_UnusedRuntimeDirs Include="@(_AllRuntimeDirs)" Condition="'%(Filename)' != 'win-x64'" />
    </ItemGroup>
    <RemoveDir Directories="@(_UnusedRuntimeDirs)" Condition="'@(_UnusedRuntimeDirs)' != ''" />
  </Target>

</Project>