<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Image2TextWin</AssemblyName>
    <RootNamespace>Image2TextWin</RootNamespace>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Company>Image2TextWin</Company>
    <Product>Image to ASCII Art</Product>
    <Description>이미지를 ASCII 아트로 변환하는 프로그램</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.0.2" />
    <PackageReference Include="PdfSharp" Version="6.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\AppIcon.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Release 빌드 후 WiX MSI 자동 생성 -->
  <Target Name="BuildMsi" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <Message Text="MSI 빌드 중..." Importance="high" />
    <Exec
      Command="wix build &quot;$(MSBuildProjectDirectory)\installer\Package.wxs&quot; -ext WixToolset.UI.wixext -culture ko-KR -o &quot;$(MSBuildProjectDirectory)\installer\Output\Image2TextWin_Setup_v$(Version).msi&quot;"
      WorkingDirectory="$(MSBuildProjectDirectory)\installer"
      ContinueOnError="true" />
    <Message Text="MSI 생성 완료: installer\Output\Image2TextWin_Setup_v$(Version).msi" Importance="high" />
  </Target>

</Project>
