					"text": "name: deploy\non:\n  push:\n    branches: [main]\njobs:\n  build:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n      - run: ./gradlew test bootJar\n      - run: kubectl apply -f deployment.yaml",
					"_parent": {
						"$ref": "AAAAAAFNF9REBRAX33Os9Ws7"
					}
