     {
      "_type": "EBNFRule",
      "_id": "AAAAAAG13McaC8AafnosE8xb",
      "name": "expression",
      "expression": "term, { ( \"+\" | \"-\" ), term }",
      "_parent": {
       "$ref": "AAAAAAG13McaC8AFTcq5txW8"
      }
     },
     {
      "_type": "EBNFRule",
      "_id": "AAAAAAG13McaC8AHFXVWk8/U",
      "name": "term",
      "expression": "factor, { ( \"*\" | \"/\" ), factor }",
      "_parent": {
       "$ref": "AAAAAAG13McaC8AFTcq5txW8"
      }
     },
     {
      "_type": "EBNFRule",
      "_id": "AAAAAAG13McaC9A9QPh1p2My",
      "name": "factor",
      "expression": "number | \"(\", expression, \")\"",
