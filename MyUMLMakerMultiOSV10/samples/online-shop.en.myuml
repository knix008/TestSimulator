     {
      "_type": "DSDocument",
      "_id": "AAAAAAG13MWdA4AJITq6grUf",
      "name": "application.yaml",
      "format": "yaml",
      "text": "server:\n  port: 8080\nspring:\n  datasource:\n    url: jdbc:postgresql://db01:5432/shop\n    username: shop\n  cache:\n    type: redis\nshop:\n  currency: KRW\n  free-shipping-over: 50000\n  payment:\n    provider: toss\n    timeout-seconds: 30",
      "_parent": {
       "$ref": "AAAAAAG13MWSA4AZkjfBx2IB"
      }
     },
     {
      "_type": "DSDocument",
      "_id": "AAAAAAG13MWfA4AgTytvIj62",
      "name": "deployment.yaml",
      "format": "yaml",
      "text": "apiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: shop-web\nspec:\n  replicas: 2\n  template:\n    spec:\n      containers:\n        - name: shop\n          image: registry.example.com/shop:1.4.2\n          ports:\n            - containerPort: 8080\n          envFrom:\n            - configMapRef:\n                name: shop-config",
      "_parent": {
       "$ref": "AAAAAAG13MWSA4AZkjfBx2IB"
