      "text": "{\n  \"orderId\": \"ORD-20260901-0042\",\n  \"customer\": {\n    \"id\": 7,\n    \"name\": \"Minji Kim\",\n    \"vip\": true\n  },\n  \"items\": [\n    {\n      \"sku\": \"BK-UML\",\n      \"title\": \"UML Distilled\",\n      \"qty\": 2,\n      \"price\": 24000\n    },\n    {\n      \"sku\": \"CF-DRIP\",\n      \"title\": \"Coffee beans\",\n      \"qty\": 1,\n      \"price\": 20000\n    }\n  ],\n  \"shipping\": {\n    \"method\": \"express\",\n    \"address\": \"1 Main Street, Seoul\"\n  },\n  \"coupon\": null,\n  \"total\": 68000\n}",
