{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyUMLMaker",
  "mainBinaryName": "MyUMLMaker",
  "version": "../package.json",
  "identifier": "com.shkwon.myumlmaker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1450",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$APPLOCALDATA/**",
          "$APPCONFIG/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "SHKWON",
    "copyright": "Copyright (c) SHKWON (knix008@naver.com)",
    "category": "DeveloperTool",
    "shortDescription": "UML and software modelling",
    "longDescription": "Model-based UML 2 diagrams (class, package, object, composite structure, component, deployment, profile, use case, sequence, communication, timing, interaction overview, information flow, state machine, activity) plus ERD, flowchart, data flow, SysML, BPMN, C4, mind map, wireframe and cloud diagrams. Model Explorer and editors, quick edit, auto layout, validation, code generation and reverse engineering, StarUML (.mdj), Mermaid and PlantUML import/export, HTML / Markdown documentation, PDF / SVG / picture export and printing.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "icons/drawing.ico": "drawing.ico",
      "icons/drawing.icns": "drawing.icns",
      "icons/drawing.png": "drawing.png",
      "icons/template.ico": "template.ico",
      "icons/template.icns": "template.icns",
      "icons/template.png": "template.png",
      "../docs/UsersGuide.html": "docs/UsersGuide.html",
      "../docs/UsersGuide.en.html": "docs/UsersGuide.en.html",
      "../docs/Tutorial.html": "docs/Tutorial.html",
      "../docs/Tutorial.en.html": "docs/Tutorial.en.html",
      "../UsersGuide.md": "docs/UsersGuide.md",
      "../README.md": "docs/README.md",
      "../docs/tutorial/images/": "docs/tutorial/images/",
      "../samples/": "samples/"
    },
    "fileAssociations": [
      {
        "ext": [
          "muml"
        ],
        "name": "MyUMLMaker.Project",
        "description": "MyUMLMaker Project",
        "mimeType": "application/x-myumlmaker",
        "role": "Editor"
      },
      {
        "ext": [
          "mumlt"
        ],
        "name": "MyUMLMaker.Template",
        "description": "MyUMLMaker Project Template",
        "mimeType": "application/x-myumlmaker-template",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Korean",
          "English"
        ],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "headerImage": "windows/installerHeader.bmp",
        "sidebarImage": "windows/installerSidebar.bmp",
        "installerHooks": "windows/hooks.nsh",
        "startMenuFolder": "MyUMLMaker"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ],
        "files": {
          "/usr/share/mime/packages/myumlmaker.xml": "linux/myumlmaker.xml",
          "/usr/share/icons/hicolor/256x256/mimetypes/application-x-myumlmaker.png": "icons/drawing.png",
          "/usr/share/icons/hicolor/256x256/mimetypes/application-x-myumlmaker-template.png": "icons/template.png"
        },
        "postInstallScript": "linux/postinst.sh",
        "postRemoveScript": "linux/postrm.sh"
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3"
        ],
        "files": {
          "/usr/share/mime/packages/myumlmaker.xml": "linux/myumlmaker.xml",
          "/usr/share/icons/hicolor/256x256/mimetypes/application-x-myumlmaker.png": "icons/drawing.png",
          "/usr/share/icons/hicolor/256x256/mimetypes/application-x-myumlmaker-template.png": "icons/template.png"
        },
        "postInstallScript": "linux/postinst.sh",
        "postRemoveScript": "linux/postrm.sh"
      }
    }
  }
}
