{
  "_comment": "Deprecated, abandoned or end-of-life packages. 'range' uses the ecosystem's own range syntax; omitted means every version.",
  "packages": [
    { "ecosystem": "npm", "name": "request", "replacement": "fetch / undici / axios", "note": "request has been deprecated since 2020" },
    { "ecosystem": "npm", "name": "request-promise", "replacement": "fetch / got", "note": "deprecated together with request" },
    { "ecosystem": "npm", "name": "node-uuid", "replacement": "uuid", "note": "renamed to uuid" },
    { "ecosystem": "npm", "name": "uuid", "range": "<7.0.0", "replacement": "uuid@>=9", "note": "uuid 3.x and older are deprecated (Math.random based in some environments)" },
    { "ecosystem": "npm", "name": "gulp-util", "replacement": "individual modules (plugin-error, fancy-log ...)", "note": "deprecated by the gulp team" },
    { "ecosystem": "npm", "name": "tslint", "replacement": "eslint + typescript-eslint", "note": "TSLint was deprecated in 2019" },
    { "ecosystem": "npm", "name": "babel-eslint", "replacement": "@babel/eslint-parser", "note": "renamed and deprecated" },
    { "ecosystem": "npm", "name": "core-js", "range": "<3.23.3", "replacement": "core-js@3 latest", "note": "core-js < 3.23.3 is no longer maintained and may be slow" },
    { "ecosystem": "npm", "name": "har-validator", "replacement": "none (no longer needed)", "note": "deprecated" },
    { "ecosystem": "npm", "name": "querystring", "replacement": "URLSearchParams", "note": "legacy API, deprecated" },
    { "ecosystem": "npm", "name": "node-sass", "replacement": "sass (Dart Sass)", "note": "LibSass and node-sass are deprecated" },
    { "ecosystem": "npm", "name": "istanbul", "replacement": "nyc / c8", "note": "deprecated" },
    { "ecosystem": "npm", "name": "popper.js", "replacement": "@popperjs/core", "note": "moved to @popperjs/core" },
    { "ecosystem": "npm", "name": "left-pad", "replacement": "String.prototype.padStart", "note": "deprecated" },
    { "ecosystem": "PyPI", "name": "pycrypto", "replacement": "pycryptodome", "note": "unmaintained since 2013 with known vulnerabilities" },
    { "ecosystem": "PyPI", "name": "nose", "replacement": "pytest / nose2", "note": "unmaintained; does not work on Python 3.10+" },
    { "ecosystem": "PyPI", "name": "sklearn", "replacement": "scikit-learn", "note": "the 'sklearn' package name is a deprecated alias that now fails to install" },
    { "ecosystem": "PyPI", "name": "distribute", "replacement": "setuptools", "note": "merged back into setuptools" },
    { "ecosystem": "PyPI", "name": "pep8", "replacement": "pycodestyle", "note": "renamed" },
    { "ecosystem": "PyPI", "name": "beautifulsoup", "replacement": "beautifulsoup4", "note": "BeautifulSoup 3 is Python 2 only" },
    { "ecosystem": "PyPI", "name": "pypdf2", "replacement": "pypdf", "note": "PyPDF2 development moved to pypdf" },
    { "ecosystem": "Maven", "name": "log4j:log4j", "replacement": "org.apache.logging.log4j:log4j-core (2.x) or reload4j", "note": "Log4j 1.x reached end of life in 2015" },
    { "ecosystem": "Maven", "name": "commons-httpclient:commons-httpclient", "replacement": "org.apache.httpcomponents.client5:httpclient5", "note": "end of life" },
    { "ecosystem": "NuGet", "name": "WindowsAzure.Storage", "replacement": "Azure.Storage.Blobs / Azure.Storage.Queues", "note": "deprecated legacy SDK" },
    { "ecosystem": "NuGet", "name": "Microsoft.Azure.ServiceBus", "replacement": "Azure.Messaging.ServiceBus", "note": "deprecated legacy SDK" },
    { "ecosystem": "Go", "name": "github.com/golang/protobuf", "replacement": "google.golang.org/protobuf", "note": "superseded by the APIv2 module" },
    { "ecosystem": "Go", "name": "github.com/dgrijalva/jwt-go", "replacement": "github.com/golang-jwt/jwt", "note": "unmaintained, has an unfixed vulnerability" },
    { "ecosystem": "Go", "name": "github.com/pkg/errors", "replacement": "standard library errors (Go 1.13+)", "note": "archived repository" },
    { "ecosystem": "crates.io", "name": "failure", "replacement": "thiserror / anyhow", "note": "deprecated (RUSTSEC-2020-0036)" },
    { "ecosystem": "crates.io", "name": "tempdir", "replacement": "tempfile", "note": "deprecated (RUSTSEC-2018-0017)" },
    { "ecosystem": "Packagist", "name": "swiftmailer/swiftmailer", "replacement": "symfony/mailer", "note": "abandoned" },
    { "ecosystem": "Packagist", "name": "fzaninotto/faker", "replacement": "fakerphp/faker", "note": "abandoned" },
    { "ecosystem": "RubyGems", "name": "sass", "replacement": "sassc / dartsass-rails", "note": "Ruby Sass reached end of life in 2019" }
  ]
}
