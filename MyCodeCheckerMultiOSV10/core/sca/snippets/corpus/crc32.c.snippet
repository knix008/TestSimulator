/* MyCodeChecker sample corpus: table-driven CRC-32 (written for the snippet index, Zlib). */
#include <stddef.h>
#include <stdint.h>

static uint32_t crc_table[256];
static int crc_table_ready = 0;

static void crc_make_table(void)
{
    for (uint32_t n = 0; n < 256; n++) {
        uint32_t c = n;
        for (int k = 0; k < 8; k++) {
            if (c & 1) {
                c = 0xEDB88320u ^ (c >> 1);
            } else {
                c = c >> 1;
            }
        }
        crc_table[n] = c;
    }
    crc_table_ready = 1;
}

uint32_t crc_update(uint32_t crc, const unsigned char *buf, size_t len)
{
    uint32_t c = crc ^ 0xFFFFFFFFu;
    if (!crc_table_ready) {
        crc_make_table();
    }
    for (size_t i = 0; i < len; i++) {
        c = crc_table[(c ^ buf[i]) & 0xFF] ^ (c >> 8);
    }
    return c ^ 0xFFFFFFFFu;
}

uint32_t crc_of(const unsigned char *buf, size_t len)
{
    return crc_update(0u, buf, len);
}
