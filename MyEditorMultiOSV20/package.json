{
  "name": "myeditor",
  "version": "1.0.0",
  "description": "My Editor — tabbed text / code editor for Windows, macOS, Linux and the web (Tauri desktop shell, syntax highlighting for 100+ languages, autocomplete, find & replace, encodings, line endings, folder tree, terminal with themed prompts, HTML / Markdown preview, 20 themes + custom themes, Korean / English UI).",
  "author": {
    "name": "SHKWON",
    "email": "knix008@naver.com"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/generate-icons.mjs --if-needed && node scripts/sync-public-svgs.mjs && node scripts/generate-build-info.mjs",
    "prepare:assets": "node scripts/generate-icons.mjs --if-needed && node scripts/sync-public-svgs.mjs && node scripts/generate-build-info.mjs",
    "prestart": "npm run free:port && npm run prepare:assets",
    "start": "tauri dev",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "build:web": "npm run prepare:assets && vite build",
    "build:win": "node scripts/platform-build.mjs win",
    "build:linux": "node scripts/platform-build.mjs linux",
    "build:mac": "node scripts/platform-build.mjs mac",
    "predev": "npm run free:port && npm run prepare:assets",
    "dev": "vite --port 5189",
    "web": "npm run build && node server/server.js",
    "web:serve": "node server/server.js",
    "generate:icons": "node scripts/generate-icons.mjs",
    "generate:build-info": "node scripts/generate-build-info.mjs",
    "sync:svgs": "node scripts/sync-public-svgs.mjs",
    "prebuild": "npm run prepare:assets",
    "build": "vite build",
    "test": "node --test --test-reporter ./test/lint-reporter.mjs test/*.test.mjs",
    "test:lint": "node --test --test-reporter ./test/lint-reporter.mjs test/lint-cases.test.mjs",
    "test:tap": "node --test test/*.test.mjs",
    "free:port": "node scripts/free-port.mjs 5189",
    "smoke": "node scripts/smoke.mjs",
    "clean": "node scripts/clean.mjs",
    "clean:all": "node scripts/clean.mjs --all"
  },
  "dependencies": {
    "@codemirror/language-data": "^6.5.2",
    "@lezer/highlight": "^1.2.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "codemirror": "^6.0.2",
    "dicom-parser": "^1.8.21",
    "dictionary-en": "^4.0.0",
    "dompurify": "^3.4.15",
    "heic-decode": "^2.1.0",
    "iconv-lite": "^0.7.3",
    "jpeg-js": "^0.4.4",
    "jpeg-lossless-decoder-js": "^2.1.2",
    "js-yaml": "^4.3.2",
    "marked": "^18.0.13",
    "nspell": "^2.1.5",
    "prettier": "^3.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "@vitejs/plugin-react": "^4.3.1",
    "sharp": "^0.33.4",
    "vite": "^5.4.1"
  },
  "allowScripts": {
    "sharp@0.33.5": true,
    "esbuild@0.21.5": true
  },
  "homepage": "https://github.com/knix008/TestSimulator",
  "repository": {
    "type": "git",
    "url": "https://github.com/knix008/TestSimulator.git"
  },
  "keywords": [
    "text-editor",
    "code-editor",
    "codemirror",
    "tauri"
  ]
}
