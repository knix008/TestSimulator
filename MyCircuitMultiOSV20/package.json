{
  "name": "mycircuit",
  "productName": "MyCircuit",
  "version": "1.0.0",
  "private": true,
  "description": "MyCircuit V1.0 — schematic, PCB, 3D and simulation electronics design for Web, Windows, macOS and Linux (Tauri)",
  "author": "SHKWON <knix008@naver.com>",
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "node scripts/start.mjs",
    "serve": "node scripts/serve.mjs",
    "tauri": "tauri",
    "test": "node scripts/test.mjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "smoke": "node test/smoke/gui-smoke.mjs",
    "smoke:desktop": "node test/smoke/desktop-smoke.mjs",
    "i18n:check": "node scripts/i18n-keys.mjs",
    "build:web": "node scripts/build-info.mjs && node scripts/build-web.mjs",
    "build:debug": "node scripts/build.mjs debug",
    "build:win": "node scripts/build.mjs win",
    "build:mac": "node scripts/build.mjs mac",
    "build:linux": "node scripts/build.mjs linux",
    "build:all": "node scripts/build.mjs all",
    "build:icons": "node scripts/render-art.mjs",
    "build:art": "node scripts/render-art.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "png-to-ico": "^2.1.8",
    "pngjs": "^7.0.0",
    "three": "0.186.1"
  }
}
