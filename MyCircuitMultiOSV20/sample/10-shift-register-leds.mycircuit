  "texts": [
   {
    "id": "x1",
    "text": "Q[A..H] bus: the labels make the connections,\nthe bus line only shows they belong together.",
    "x": 7000,
    "y": 1500,
    "size": 45,
    "rot": 0
   },
   {
    "id": "x2",
    "text": "C1: decoupling next to U1 pin 16",
    "x": 5200,
    "y": 4900,
    "size": 45,
    "rot": 0
   },
   {
    "id": "x3",
    "text": "PWR_FLAG: +5V and GND come from J1",
    "x": 1800,
    "y": 4100,
    "size": 45,
    "rot": 0
   },
   {
    "id": "x4",
    "text": "74HC595 LED bar",
    "x": 1300,
    "y": 1100,
    "size": 90,
    "rot": 0
   },
   {
    "id": "x5",
    "text": "Shift eight bits in on SER (one per SRCLK rising edge), then pulse RCLK to latch them onto the LEDs.\nR1 keeps the active-low SRCLR high (no clear) and R10 keeps the active-low OE low (outputs on) when the inputs float.",
    "x": 1300,
    "y": 5600,
    "size": 50,
    "rot": 0
   }
  ],
  "sheets": [],
  "dimensions": []
 },
