  "texts": [
   {
    "id": "x1",
    "text": "Transistor as a switch",
    "x": 1500,
    "y": 1300,
    "size": 90,
    "rot": 0
   },
   {
    "id": "x2",
    "text": "Button pressed: Ib = (4.5 V - 0.7 V) / R2 = approx. 0.38 mA, enough to saturate Q1.\nThe LED current is set by R1: (4.5 V - 2 V - 0.1 V) / 220 = approx. 11 mA.\nR3 pulls the base low so Q1 is off when the button is released.\nSW1 field \"state\" = closed / open selects what the simulator sees.",
    "x": 1500,
    "y": 4500,
    "size": 50,
    "rot": 0
   }
  ],
  "sheets": [],
  "dimensions": []
 },
