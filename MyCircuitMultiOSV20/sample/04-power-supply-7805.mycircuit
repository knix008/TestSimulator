  "texts": [
   {
    "id": "x1",
    "text": "5 V regulated supply",
    "x": 1500,
    "y": 1200,
    "size": 90,
    "rot": 0
   },
   {
    "id": "x2",
    "text": "F1 protects against shorts, D1 against a reversed plug.\nThe LM7805 needs about 2 V of headroom: VIN = 12 V - 0.7 V (D1).\nPWR_FLAG marks VIN as driven (it is fed only through F1 and D1).",
    "x": 1500,
    "y": 3500,
    "size": 50,
    "rot": 0
   },
   {
    "id": "x3",
    "text": "Mounting holes",
    "x": 1800,
    "y": 4000,
    "size": 45,
    "rot": 0
   }
