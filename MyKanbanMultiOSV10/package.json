{
  "name": "my-kanban-multi-os",
  "productName": "MyKanban",
  "version": "1.0.2",
  "buildNumber": "1",
  "description": "Multi-platform Kanban Board (Tauri + Web)",
  "main": "server.js",
  "scripts": {
    "dev": "node server.js",
    "start": "tauri dev",
    "start:web": "node server.js",
    "postinstall": "node scripts/install-native-deps.js",
    "build:debug": "node scripts/build.js debug",
    "build:win": "node scripts/build.js win",
    "build:mac": "node scripts/build.js mac",
    "build:linux": "node scripts/build.js linux",
    "build:all": "node scripts/build.js all",
    "smoke": "node scripts/smoke.js",
    "test": "node test/run.js",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "docx": "^9.7.1",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "knex": "^3.1.0",
    "mssql": "^11.0.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.9.1",
    "pdfkit": "^0.19.1",
    "pg": "^8.11.3",
    "sqlite3": "^5.1.7",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}
