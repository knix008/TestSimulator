{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyKanban",
  "mainBinaryName": "MyKanban",
  "version": "../package.json",
  "identifier": "com.kanban.multios",
  "build": {
    "frontendDist": "shell",
    "beforeDevCommand": "node scripts/stage-sidecar.js",
    "beforeBuildCommand": "node scripts/stage-sidecar.js"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "appimage", "deb"],
    "publisher": "SHKWON",
    "copyright": "Copyright © 2026 SHKWON(knix008@naver.com)",
    "category": "Productivity",
    "shortDescription": "MyKanban",
    "longDescription": "Multi-platform Kanban board with multi-user projects and five database engines",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../dist/sidecar/": "sidecar/",
      "../assets/kprj.ico": "kprj.ico"
    },
    "fileAssociations": [
      {
        "ext": ["kprj"],
        "name": "MyKanban Project",
        "description": "MyKanban Project File",
        "mimeType": "application/x-mykanban-project",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Korean", "English"],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
