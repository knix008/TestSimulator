ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('IFC4'),'2;1');
FILE_NAME('sample_building.ifc','2024-01-01T00:00:00',('BIM User'),('Sample Corp'),
'3D Architecture Viewer','','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
/* === Project Setup === */
#1=IFCPROJECT('0001',$,'Sample Apartment',$,$,$,$,(#100),#10);
#10=IFCUNITASSIGNMENT((#11));
#11=IFCSIUNIT(*,.LENGTHUNIT.,.MILLI.,.METRE.);
/* === Coordinate Context === */
#20=IFCCARTESIANPOINT((0.,0.,0.));
#21=IFCDIRECTION((0.,0.,1.));
#22=IFCDIRECTION((1.,0.,0.));
#100=IFCGEOMETRICREPRESENTATIONCONTEXT('Model','Model',3,1.0E-5,#23,$);
#23=IFCAXIS2PLACEMENT3D(#20,#21,#22);
/* === Site & Building === */
#200=IFCSITE('0002',$,'Default Site',$,$,#201,$,$,.ELEMENT.,$,$,$,$,$);
#201=IFCLOCALPLACEMENT($,#202);
#202=IFCAXIS2PLACEMENT3D(#20,#21,#22);
#300=IFCBUILDING('0003',$,'Apartment',$,$,#301,$,$,.ELEMENT.,$,$,$);
#301=IFCLOCALPLACEMENT(#201,#302);
#302=IFCAXIS2PLACEMENT3D(#20,#21,#22);
#400=IFCBUILDINGSTOREY('0004',$,'Level 1',$,$,#401,$,$,.ELEMENT.,0.);
#401=IFCLOCALPLACEMENT(#301,#402);
#402=IFCAXIS2PLACEMENT3D(#20,#21,#22);
/* === Aggregation === */
#500=IFCRELAGGREGATES('R001',$,$,$,#1,(#200));
#501=IFCRELAGGREGATES('R002',$,$,$,#200,(#300));
#502=IFCRELAGGREGATES('R003',$,$,$,#300,(#400));
/* === Wall 1: Bottom (x=0 to 12000, y=0) === */
#1000=IFCWALLSTANDARDCASE('W001',$,'Bottom Wall',$,$,#1001,#1005,$);
#1001=IFCLOCALPLACEMENT(#401,#1002);
#1002=IFCAXIS2PLACEMENT3D(#1003,#21,#1004);
#1003=IFCCARTESIANPOINT((0.,0.,0.));
#1004=IFCDIRECTION((1.,0.,0.));
#1005=IFCPRODUCTDEFINITIONSHAPE($,$,(#1006));
#1006=IFCSHAPEREPRESENTATION(#100,'Body','SweptSolid',(#1007));
#1007=IFCEXTRUDEDAREASOLID(#1008,#1009,#21,2800.);
#1008=IFCRECTANGLEPROFILEDEF(.AREA.,$,#1010,12000.,200.);
#1009=IFCAXIS2PLACEMENT3D(#1011,$,$);
#1010=IFCAXIS2PLACEMENT2D(#1012,$);
#1011=IFCCARTESIANPOINT((6000.,0.,0.));
#1012=IFCCARTESIANPOINT((0.,0.));
/* === Wall 2: Top (x=0 to 12000, y=9000) === */
#2000=IFCWALLSTANDARDCASE('W002',$,'Top Wall',$,$,#2001,#2005,$);
#2001=IFCLOCALPLACEMENT(#401,#2002);
#2002=IFCAXIS2PLACEMENT3D(#2003,#21,#2004);
#2003=IFCCARTESIANPOINT((0.,9000.,0.));
#2004=IFCDIRECTION((1.,0.,0.));
#2005=IFCPRODUCTDEFINITIONSHAPE($,$,(#2006));
#2006=IFCSHAPEREPRESENTATION(#100,'Body','SweptSolid',(#2007));
#2007=IFCEXTRUDEDAREASOLID(#2008,#2009,#21,2800.);
#2008=IFCRECTANGLEPROFILEDEF(.AREA.,$,#2010,12000.,200.);
#2009=IFCAXIS2PLACEMENT3D(#2011,$,$);
#2010=IFCAXIS2PLACEMENT2D(#2012,$);
#2011=IFCCARTESIANPOINT((6000.,0.,0.));
#2012=IFCCARTESIANPOINT((0.,0.));
/* === Wall 3: Left (x=0, y=0 to 9000) === */
#3000=IFCWALLSTANDARDCASE('W003',$,'Left Wall',$,$,#3001,#3005,$);
#3001=IFCLOCALPLACEMENT(#401,#3002);
#3002=IFCAXIS2PLACEMENT3D(#3003,#21,#3004);
#3003=IFCCARTESIANPOINT((0.,0.,0.));
#3004=IFCDIRECTION((0.,1.,0.));
#3005=IFCPRODUCTDEFINITIONSHAPE($,$,(#3006));
#3006=IFCSHAPEREPRESENTATION(#100,'Body','SweptSolid',(#3007));
#3007=IFCEXTRUDEDAREASOLID(#3008,#3009,#21,2800.);
#3008=IFCRECTANGLEPROFILEDEF(.AREA.,$,#3010,9000.,200.);
#3009=IFCAXIS2PLACEMENT3D(#3011,$,$);
#3010=IFCAXIS2PLACEMENT2D(#3012,$);
#3011=IFCCARTESIANPOINT((4500.,0.,0.));
#3012=IFCCARTESIANPOINT((0.,0.));
/* === Wall 4: Right (x=12000, y=0 to 9000) === */
#4000=IFCWALLSTANDARDCASE('W004',$,'Right Wall',$,$,#4001,#4005,$);
#4001=IFCLOCALPLACEMENT(#401,#4002);
#4002=IFCAXIS2PLACEMENT3D(#4003,#21,#4004);
#4003=IFCCARTESIANPOINT((12000.,0.,0.));
#4004=IFCDIRECTION((0.,1.,0.));
#4005=IFCPRODUCTDEFINITIONSHAPE($,$,(#4006));
#4006=IFCSHAPEREPRESENTATION(#100,'Body','SweptSolid',(#4007));
#4007=IFCEXTRUDEDAREASOLID(#4008,#4009,#21,2800.);
#4008=IFCRECTANGLEPROFILEDEF(.AREA.,$,#4010,9000.,200.);
#4009=IFCAXIS2PLACEMENT3D(#4011,$,$);
#4010=IFCAXIS2PLACEMENT2D(#4012,$);
#4011=IFCCARTESIANPOINT((4500.,0.,0.));
#4012=IFCCARTESIANPOINT((0.,0.));
/* === Interior Wall A (x=0 to 6000, y=4500) === */
#5000=IFCWALLSTANDARDCASE('W005',$,'Interior Wall A',$,$,#5001,#5005,$);
#5001=IFCLOCALPLACEMENT(#401,#5002);
#5002=IFCAXIS2PLACEMENT3D(#5003,#21,#5004);
#5003=IFCCARTESIANPOINT((0.,4500.,0.));
#5004=IFCDIRECTION((1.,0.,0.));
#5005=IFCPRODUCTDEFINITIONSHAPE($,$,(#5006));
#5006=IFCSHAPEREPRESENTATION(#100,'Body','SweptSolid',(#5007));
#5007=IFCEXTRUDEDAREASOLID(#5008,#5009,#21,2800.);
#5008=IFCRECTANGLEPROFILEDEF(.AREA.,$,#5010,6000.,200.);
#5009=IFCAXIS2PLACEMENT3D(#5011,$,$);
#5010=IFCAXIS2PLACEMENT2D(#5012,$);
#5011=IFCCARTESIANPOINT((3000.,0.,0.));
#5012=IFCCARTESIANPOINT((0.,0.));
/* === Interior Wall B (x=6000, y=0 to 4500) === */
#6000=IFCWALLSTANDARDCASE('W006',$,'Interior Wall B',$,$,#6001,#6005,$);
#6001=IFCLOCALPLACEMENT(#401,#6002);
#6002=IFCAXIS2PLACEMENT3D(#6003,#21,#6004);
#6003=IFCCARTESIANPOINT((6000.,0.,0.));
#6004=IFCDIRECTION((0.,1.,0.));
#6005=IFCPRODUCTDEFINITIONSHAPE($,$,(#6006));
#6006=IFCSHAPEREPRESENTATION(#100,'Body','SweptSolid',(#6007));
#6007=IFCEXTRUDEDAREASOLID(#6008,#6009,#21,2800.);
#6008=IFCRECTANGLEPROFILEDEF(.AREA.,$,#6010,4500.,200.);
#6009=IFCAXIS2PLACEMENT3D(#6011,$,$);
#6010=IFCAXIS2PLACEMENT2D(#6012,$);
#6011=IFCCARTESIANPOINT((2250.,0.,0.));
#6012=IFCCARTESIANPOINT((0.,0.));
/* === Interior Wall C (x=6000 to 12000, y=5500) === */
#7000=IFCWALLSTANDARDCASE('W007',$,'Interior Wall C',$,$,#7001,#7005,$);
#7001=IFCLOCALPLACEMENT(#401,#7002);
#7002=IFCAXIS2PLACEMENT3D(#7003,#21,#7004);
#7003=IFCCARTESIANPOINT((6000.,5500.,0.));
#7004=IFCDIRECTION((1.,0.,0.));
#7005=IFCPRODUCTDEFINITIONSHAPE($,$,(#7006));
#7006=IFCSHAPEREPRESENTATION(#100,'Body','SweptSolid',(#7007));
#7007=IFCEXTRUDEDAREASOLID(#7008,#7009,#21,2800.);
#7008=IFCRECTANGLEPROFILEDEF(.AREA.,$,#7010,6000.,200.);
#7009=IFCAXIS2PLACEMENT3D(#7011,$,$);
#7010=IFCAXIS2PLACEMENT2D(#7012,$);
#7011=IFCCARTESIANPOINT((3000.,0.,0.));
#7012=IFCCARTESIANPOINT((0.,0.));
ENDSEC;
END-ISO-10303-21;
