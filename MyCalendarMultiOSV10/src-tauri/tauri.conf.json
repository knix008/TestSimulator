{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "My Calendar",
  "version": "1.0.0",
  "identifier": "com.mycalendar.multios",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "My Calendar",
        "url": "index.html",
        "width": 520,
        "height": 680,
        "minWidth": 366,
        "minHeight": 378,
        "x": 96,
        "y": 72,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "skipTaskbar": true,
        "alwaysOnTop": false,
        "resizable": true,
        "visible": true,
        "backgroundColor": "#00000000",
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost http://localhost:1420; script-src 'self' 'unsafe-inline' 'unsafe-eval' http://localhost:1420; connect-src 'self' ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420 https://date.nager.at; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "appimage", "deb", "rpm"],
    "icon": [
      "../assets/app.ico",
      "icons/128x128@2x.png",
      "icons/128x128.png",
      "icons/32x32.png",
      "icons/icon.icns"
    ],
    "category": "Utility",
    "shortDescription": "Transparent desktop calendar",
    "longDescription": "A frameless transparent calendar with themes, live public holidays, and a system tray.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "displayLanguageSelector": true,
        "languages": ["English", "Korean"],
        "installMode": "currentUser",
        "installerIcon": "../assets/installer.ico",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
