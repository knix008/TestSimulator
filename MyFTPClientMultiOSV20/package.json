{
  "name": "myftpclient",
  "version": "1.0.0",
  "description": "My FTP Client — FTP / FTPS / SFTP client for Windows, macOS, Linux and the web (Tauri desktop shell around a Node core: server listing, local tree, upload/download with progress and conflict handling, connection profiles, terminal).",
  "author": {
    "name": "SHKWON",
    "email": "knix008@naver.com"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/sync-public-svgs.mjs && node scripts/generate-build-info.mjs",
    "prepare:assets": "node scripts/sync-public-svgs.mjs && node scripts/generate-build-info.mjs",
    "start": "node scripts/dev.mjs",
    "dev": "node scripts/dev.mjs --web",
    "tauri": "tauri",
    "web": "npm run build && node server/server.js",
    "web:serve": "node server/server.js",
    "generate:icons": "node scripts/generate-icons.mjs",
    "generate:build-info": "node scripts/generate-build-info.mjs",
    "sync:svgs": "node scripts/sync-public-svgs.mjs",
    "prebuild": "npm run prepare:assets",
    "build": "vite build",
    "build:desktop": "tauri build",
    "build:win": "tauri build --bundles nsis",
    "postbuild:win": "node scripts/copy-installer.mjs",
    "build:mac": "tauri build --bundles dmg",
    "postbuild:mac": "node scripts/copy-installer.mjs",
    "build:linux": "tauri build --bundles appimage,deb",
    "postbuild:linux": "node scripts/copy-installer.mjs",
    "copy:installer": "node scripts/copy-installer.mjs",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --test-concurrency=1 --test-timeout=120000 --test-reporter=./test/reporter.mjs test/*.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "clean": "node scripts/clean.mjs",
    "clean:all": "node scripts/clean.mjs --all"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.0",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "basic-ftp": "^6.2.1",
    "iconv-lite": "^0.7.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "@vitejs/plugin-react": "^4.3.1",
    "esbuild": "^0.21.5",
    "sharp": "^0.33.4",
    "vite": "^5.4.1"
  },
  "allowScripts": {
    "sharp@0.33.5": true,
    "esbuild@0.21.5": true
  },
  "homepage": "https://github.com/knix008/TestSimulator",
  "repository": {
    "type": "git",
    "url": "https://github.com/knix008/TestSimulator.git"
  },
  "keywords": [
    "ftp",
    "ftps",
    "sftp",
    "file-transfer",
    "tauri"
  ]
}
