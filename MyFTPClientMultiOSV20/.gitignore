# ── Dependencies ────────────────────────────────────────
node_modules/

# ── Build output (reproducible: npm install && npm run build:<os>) ──
dist/
src/build-info.json
public/icon.svg

# ── Tauri (Rust) build output. Cargo.lock and src-tauri/icons/ are committed. ──
src-tauri/target/
src-tauri/gen/
# Node runtime + bundled core shipped as a resource (scripts/stage-runtime.mjs)
src-tauri/runtime/

# ── Installers copied to the project root by scripts/copy-installer.mjs ──
*.exe
*.dmg
*.AppImage
*.deb
*.rpm
*.snap
*.zip
*.blockmap
*.msi
*.msix

# ── Smoke-test output (npm run smoke): screenshots, private profile, Edge profile ──
.smoke/
.icons-preview.png
.npm-install.log

# ── Secrets / local env ─────────────────────────────────
.env
.env.*
!.env.example

# ── Coverage / caches ───────────────────────────────────
coverage/
.nyc_output/
.cache/
.turbo/
*.tsbuildinfo

# ── Local / editor / OS noise ───────────────────────────
*.log
npm-debug.log*
.vite/
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
*~
*.swp
*.swo
.idea/
