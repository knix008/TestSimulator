{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyBrainMap",
  "version": "1.0.0",
  "identifier": "com.shkwon.mybrainmap",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5201",
    "beforeDevCommand": "node scripts/sync-tauri-icons.mjs && npm run dev",
    "beforeBuildCommand": "node scripts/sync-tauri-icons.mjs && node scripts/stage-tauri-sidecar.mjs --with-deps && npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage", "app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "sidecar/": "app/"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "displayLanguageSelector": true,
        "customLanguageFiles": {
          "Hebrew": "nsis/Hebrew.nsh"
        },
        "languages": [
          "Korean",
          "English",
          "Japanese",
          "SimpChinese",
          "TradChinese",
          "Spanish",
          "SpanishInternational",
          "French",
          "German",
          "Italian",
          "Portuguese",
          "PortugueseBR",
          "Russian",
          "Arabic",
          "Bulgarian",
          "Dutch",
          "Hebrew",
          "Swedish",
          "Turkish",
          "Ukrainian"
        ]
      }
    },
    "category": "Productivity",
    "shortDescription": "Mind mapping",
    "longDescription": "Mind maps, org charts, trees, timelines and fishbone diagrams with notes, markers, tasks, relationships and outline / Gantt views.",
    "copyright": "Copyright © 2026 SHKWON",
    "publisher": "SHKWON",
    "fileAssociations": [
      {
        "ext": ["tmap"],
        "name": "MyBrainMap map",
        "description": "MyBrainMap map",
        "role": "Editor"
      },
      {
        "ext": ["mm", "opml", "xmind", "mmap"],
        "name": "Mind map",
        "description": "Mind map",
        "role": "Viewer"
      }
    ]
  }
}
