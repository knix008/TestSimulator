{
  "name": "mybrainmap",
  "version": "1.0.0",
  "description": "My BrainMap — mind mapping for Windows, macOS, Linux and the web (Tauri desktop shell): map / org chart / tree / timeline / fishbone layouts, topics with notes, markers, tasks, links and images, relationships, boundaries, callouts, outline and Gantt views, filters, presentation mode, import / export (OPML, Markdown, FreeMind, XMind, MindManager, PNG, SVG, PDF, Word), 40 themes, Korean / English UI.",
  "author": {
    "name": "SHKWON",
    "email": "knix008@naver.com"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/generate-icons.mjs --if-needed && node scripts/sync-public-svgs.mjs && node scripts/generate-build-info.mjs",
    "prepare:assets": "node scripts/generate-icons.mjs --if-needed && node scripts/sync-public-svgs.mjs && node scripts/generate-build-info.mjs",
    "prestart": "npm run free:port && npm run prepare:assets",
    "start": "tauri dev",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "build:web": "npm run prepare:assets && vite build",
    "build:win": "node scripts/platform-build.mjs win",
    "build:linux": "node scripts/platform-build.mjs linux",
    "build:mac": "node scripts/platform-build.mjs mac",
    "predev": "npm run free:port && npm run prepare:assets",
    "dev": "vite --port 5201",
    "web": "npm run build && node server/server.js",
    "web:serve": "node server/server.js",
    "generate:icons": "node scripts/generate-icons.mjs",
    "generate:build-info": "node scripts/generate-build-info.mjs",
    "sync:svgs": "node scripts/sync-public-svgs.mjs",
    "prebuild": "npm run prepare:assets",
    "build": "vite build",
    "test": "node --test --test-reporter ./test/lint-reporter.mjs test/*.test.mjs",
    "test:tap": "node --test test/*.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test:gui": "node scripts/gui-menus.mjs",
    "samples": "node scripts/make-samples.mjs",
    "free:port": "node scripts/free-port.mjs 5201",
    "help:media": "node scripts/make-help-media.mjs",
    "tutorial:video": "node scripts/make-tutorial-video.mjs",
    "clean": "node scripts/clean.mjs",
    "clean:all": "node scripts/clean.mjs --all"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "dompurify": "^3.4.15",
    "marked": "^18.0.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "@vitejs/plugin-react": "^4.3.1",
    "sharp": "^0.33.4",
    "vite": "^5.4.1"
  },
  "allowScripts": {
    "sharp@0.33.5": true,
    "esbuild@0.21.5": true
  },
  "homepage": "https://github.com/knix008/TestSimulator",
  "repository": {
    "type": "git",
    "url": "https://github.com/knix008/TestSimulator.git"
  },
  "keywords": [
    "mind-map",
    "mindmap",
    "brainstorming",
    "tauri"
  ]
}
