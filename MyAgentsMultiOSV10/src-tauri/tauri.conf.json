{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyAgents",
  "mainBinaryName": "MyAgents",
  "version": "../package.json",
  "identifier": "com.shkwon.myagents",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5560",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$APPLOCALDATA/**",
          "$APPCONFIG/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "SHKWON",
    "copyright": "Copyright (c) SHKWON (knix008@naver.com)",
    "category": "Productivity",
    "shortDescription": "No-code AI agent builder",
    "longDescription": "Build AI agents and automations on a visual canvas: triggers (manual, chat, webhook, schedule), LLM and agent nodes with tools (Claude, OpenAI, Gemini, Ollama, OpenAI-compatible), knowledge bases (RAG), code, HTTP, loops, branches and human approval — and watch every run step by step.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "icons/project.ico": "project.ico",
      "icons/project.icns": "project.icns",
      "icons/project.png": "project.png",
      "runtime/": "runtime/",
      "../public/doc/": "doc/"
    },
    "fileAssociations": [
      {
        "ext": [
          "myagent"
        ],
        "name": "MyAgents.Agent",
        "description": "MyAgents agent",
        "mimeType": "application/x-myagents",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Korean",
          "English"
        ],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "headerImage": "windows/installerHeader.bmp",
        "sidebarImage": "windows/installerSidebar.bmp",
        "installerHooks": "windows/hooks.nsh",
        "startMenuFolder": "MyAgents"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ],
        "files": {
          "/usr/share/mime/packages/myagents.xml": "linux/myagents.xml",
          "/usr/share/icons/hicolor/256x256/mimetypes/application-x-myagents.png": "icons/project.png"
        },
        "postInstallScript": "linux/postinst.sh",
        "postRemoveScript": "linux/postrm.sh"
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3"
        ],
        "files": {
          "/usr/share/mime/packages/myagents.xml": "linux/myagents.xml",
          "/usr/share/icons/hicolor/256x256/mimetypes/application-x-myagents.png": "icons/project.png"
        },
        "postInstallScript": "linux/postinst.sh",
        "postRemoveScript": "linux/postrm.sh"
      }
    }
  }
}
