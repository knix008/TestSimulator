{
  "id": "graphite",
  "name": "Graphite",
  "author": "MyDockBar",
  "description": "Neutral graphite. Stays out of the way. (tile shape)",
  "dark": true,
  "variables": {
    "--plate-bg": "linear-gradient(180deg, rgba(100,103,111,0.94), rgba(52,55,61,0.96))",
    "--plate-border": "1px solid rgba(172,174,178,0.3)",
    "--plate-radius": "14px",
    "--plate-shadow": "0 10px 26px rgba(0,0,0,0.4), inset 0 1px 0 rgba(255,255,255,0.12)",
    "--plate-backdrop": "blur(8px)",
    "--reflection-opacity": "0.22",
    "--plate-clip": "none",
    "--icon-radius": "6px",
    "--sep-width": "2px",
    "--item-bg": "rgba(135,137,143,0.28)",
    "--item-border": "1px solid rgba(200,201,203,0.35)",
    "--item-radius": "10px",
    "--item-shadow": "inset 0 1px 0 rgba(255,255,255,0.25)",
    "--item-inset": "-4px",
    "--sep-color": "rgba(201,203,207,0.5)",
    "--icon-shadow": "0 6px 13px rgba(14,15,17,0.55)",
    "--indicator-color": "#95a5c6",
    "--indicator-glow": "0 0 10px rgba(149,165,198,0.9)",
    "--tooltip-bg": "rgba(22,23,24,0.96)",
    "--tooltip-fg": "#e5eaf5",
    "--tooltip-border": "1px solid rgba(149,165,198,0.4)",
    "--tooltip-shadow": "0 8px 20px rgba(0,0,0,0.45)",
    "--drop-accent": "#95a5c6"
  },
  "ui": {
    "--bg": "#1b1c1d",
    "--bg-raised": "#28282a",
    "--bg-sunken": "#141415",
    "--fg": "#e9ecf1",
    "--fg-dim": "#8d98b0",
    "--line": "#3c3d3f",
    "--accent": "#95a5c6",
    "--accent-fg": "#141415",
    "--danger": "#ff7a72"
  }
}
