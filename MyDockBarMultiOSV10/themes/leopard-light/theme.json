{
  "id": "leopard-light",
  "name": "Leopard Light",
  "author": "MyDockBar",
  "description": "The Leopard shelf, receding into the screen with a lit front edge, on a light surface. (shelf3d shape)",
  "dark": false,
  "variables": {
    "--plate-bg": "linear-gradient(180deg, rgba(118,115,113,0.5) 0%, rgba(208,205,201,0.4) 58%, rgba(235,234,232,0.6) 74%, rgba(235,234,232,0.6) 77%, rgba(162,159,156,0.62) 80%, rgba(77,76,74,0.72) 100%)",
    "--plate-border": "1px solid rgba(234,233,231,0.4)",
    "--plate-radius": "6px",
    "--plate-shadow": "0 12px 30px rgba(0,0,0,0.55), inset 0 1px 0 rgba(250,249,249,0.5)",
    "--plate-backdrop": "blur(22px) saturate(180%)",
    "--reflection-opacity": "0.46",
    "--plate-clip": "polygon(3% 0, 97% 0, 100% 100%, 0 100%)",
    "--icon-radius": "0px",
    "--sep-width": "2px",
    "--sep-color": "rgba(108,102,96,0.55)",
    "--icon-shadow": "0 6px 13px rgba(41,40,39,0.32)",
    "--indicator-color": "#756c61",
