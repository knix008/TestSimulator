  "ui": {
    "--bg": "#f5f5f5",
    "--bg-raised": "#ffffff",
    "--bg-sunken": "#e9e8e8",
    "--fg": "#32271b",
    "--fg-dim": "#7c6c5a",
    "--line": "#d2d1d0",
    "--accent": "#756c61",
    "--accent-fg": "#ffffff",
    "--danger": "#c8352f"
  }
