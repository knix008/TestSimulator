  "ui": {
    "--bg": "#f4f6f6",
    "--bg-raised": "#ffffff",
    "--bg-sunken": "#e5ebea",
    "--fg": "#1b322d",
    "--fg-dim": "#5a7c75",
    "--line": "#cbd7d4",
    "--accent": "#2fa78f",
    "--accent-fg": "#ffffff",
    "--danger": "#c8352f"
  }
