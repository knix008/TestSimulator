{
  "id": "jade-light",
  "name": "Jade Light",
  "author": "MyDockBar",
  "description": "Cool jade with a soft glow, on a light surface. (notched shape)",
  "dark": false,
  "variables": {
    "--plate-bg": "linear-gradient(180deg, rgba(226,238,236,0.42) 0%, rgba(207,226,223,0.34) 48%, rgba(124,136,134,0.42) 100%)",
    "--plate-border": "1px solid rgba(233,242,241,0.5)",
    "--plate-radius": "10px",
    "--plate-shadow": "0 14px 40px rgba(52,57,56,0.5), inset 0 1px 0 rgba(250,252,252,0.65), inset 0 -1px 0 rgba(255,255,255,0.12)",
    "--plate-backdrop": "blur(22px) saturate(180%)",
    "--reflection-opacity": "0.36",
    "--plate-clip": "polygon(0 0, 100% 0, 100% 62%, 97% 100%, 3% 100%, 0 62%)",
    "--icon-radius": "0px",
    "--sep-width": "2px",
    "--sep-color": "rgba(71,143,129,0.55)",
    "--icon-shadow": "0 6px 13px rgba(41,45,45,0.32)",
    "--indicator-color": "#2fa78f",
    "--indicator-glow": "0 0 10px rgba(47,167,143,0.9)",
