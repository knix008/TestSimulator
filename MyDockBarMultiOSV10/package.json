{
  "name": "mydockbar",
  "productName": "MyDockBar",
  "version": "1.0.0",
  "description": "A cross-platform, theme-able application dock for Windows, macOS and Linux.",
  "author": {
    "name": "Suho Kwon",
    "email": "suho.kwon@gmail.com"
  },
  "license": "MIT",
  "main": "src/main/main.js",
  "scripts": {
    "prestart": "node scripts/ensure-icons.js",
    "start": "electron .",
    "predev": "node scripts/ensure-icons.js",
    "dev": "electron . --dev",
    "pretest": "node scripts/ensure-icons.js",
    "test": "node --test --test-concurrency=1 --test-reporter=./scripts/test-reporter.js \"test/*.test.js\"",
    "test:tap": "node --test \"test/*.test.js\"",
    "icons": "node scripts/make-icons.js",
    "themes": "node scripts/make-themes.js",
    "pack": "node scripts/ensure-icons.js && electron-builder --dir",
    "build": "node scripts/ensure-icons.js && electron-builder",
    "build:win": "node scripts/ensure-icons.js && electron-builder --win",
    "build:mac": "node scripts/ensure-icons.js && electron-builder --mac",
    "build:linux": "node scripts/ensure-icons.js && electron-builder --linux",
    "build:fast": "node scripts/ensure-icons.js && electron-builder -c.compression=store",
    "release:win": "node scripts/ensure-icons.js && electron-builder --win --x64 --arm64",
    "release:mac": "node scripts/ensure-icons.js && electron-builder --mac --x64 --arm64",
    "release:linux": "node scripts/ensure-icons.js && electron-builder --linux --x64 --arm64"
  },
  "devDependencies": {
    "electron": "^44.4.4",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.4"
  },
  "desktopName": "mydockbar.desktop"
}
