<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
    Name="ImageSelectorV10"
    Manufacturer="ImageSelector"
    Version="$(var.ProductVersion)"
    UpgradeCode="CC052D20-90A4-46BD-9CD7-9460E9565EFA"
    Language="1042"
    Codepage="949"
    Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="이미 설치된 버전이 더 최신입니다." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="DaemonHammerIcon" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="DaemonHammerIcon" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="ImageSelectorV10">
        <Files Include="$(var.PublishDir)\**" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="ImageSelectorV10">
        <Component Id="StartMenuShortcutComponent" Guid="*">
          <Shortcut
            Id="StartMenuShortcut"
            Name="ImageSelectorV10"
            Description="ImageSelectorV10 실행"
            Target="[INSTALLFOLDER]ImageSelectorV10.exe"
            WorkingDirectory="INSTALLFOLDER"
            Icon="DaemonHammerIcon" />
          <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\ImageSelectorV10" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcutComponent" Guid="*">
        <Shortcut
          Id="DesktopShortcut"
          Name="ImageSelectorV10"
          Description="ImageSelectorV10 실행"
          Target="[INSTALLFOLDER]ImageSelectorV10.exe"
          WorkingDirectory="INSTALLFOLDER"
          Icon="DaemonHammerIcon" />
        <RegistryValue Root="HKCU" Key="Software\ImageSelectorV10" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
  </Package>
</Wix>
