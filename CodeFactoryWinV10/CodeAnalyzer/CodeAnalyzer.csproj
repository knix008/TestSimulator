<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tools/**" />
    <None Remove="tools/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.12.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic" Version="4.12.0" />
    <PackageReference Include="TreeSitter.DotNet" Version="1.3.0" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.2.0" />
    <PackageReference Include="MySqlConnector" Version="2.4.0" />
    <PackageReference Include="Npgsql" Version="9.0.3" />
    <PackageReference Include="QuestPDF" Version="2024.12.2" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\HourGlasses.gif">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\AppIcon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    TreeSitter.DotNet places native grammar DLLs under runtimes/<rid>/native/.
    NativeLibrary.Load looks in the application base directory, so we copy them up to the output root.
    Only win-x64 DLLs are needed since this is a Windows WinForms application.
  -->
  <Target Name="CopyTreeSitterNativeDlls" AfterTargets="Build">
    <ItemGroup>
      <_TreeSitterNativeDlls Include="$(OutDir)runtimes\win-x64\native\tree-sitter*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_TreeSitterNativeDlls)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- Release 빌드 시 MSI를 항상 생성 (VS에서 앱 프로젝트만 빌드해도 동작) -->
  <PropertyGroup>
    <SetupProjectPath>$(MSBuildThisFileDirectory)..\CodeAnalyzer.Setup\CodeAnalyzer.Setup.wixproj</SetupProjectPath>
    <MsiOutputPath>$(MSBuildThisFileDirectory)..\CodeAnalyzer.Setup\bin\$(Configuration)\CodeAnalyzer.Setup.msi</MsiOutputPath>
  </PropertyGroup>

  <Target Name="RemindMsiRequiresRelease"
          AfterTargets="CopyTreeSitterNativeDlls"
          Condition="'$(Configuration)' != 'Release' and '$(BuildingMsiPackage)' != 'true'">
    <Message Importance="high" Text="MSI is not built in $(Configuration) configuration. Switch to Release | Any CPU and rebuild to create CodeAnalyzer.Setup.msi." />
  </Target>

  <Target Name="BuildMsiInstaller"
          AfterTargets="CopyTreeSitterNativeDlls"
          Condition="'$(Configuration)' == 'Release' and '$(BuildingMsiPackage)' != 'true' and Exists('$(SetupProjectPath)')">
    <MSBuild Projects="$(SetupProjectPath)"
             Targets="Restore"
             Properties="Configuration=Release;BuildingMsiPackage=true"
             BuildInParallel="false" />
    <MSBuild Projects="$(SetupProjectPath)"
             Targets="Build"
             Properties="Configuration=Release;BuildingMsiPackage=true"
             BuildInParallel="false" />
    <Error Condition="!Exists('$(MsiOutputPath)')"
           Text="MSI was not created at $(MsiOutputPath). See CodeAnalyzer.Setup build output for errors." />
    <Message Importance="high" Text="MSI ready: $(MsiOutputPath)" />
  </Target>

</Project>