<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <!-- Keep MSI at bin\Release\ (not bin\Any CPU\Release\) when VS passes Platform=Any CPU. -->
    <BaseOutputPath>bin\</BaseOutputPath>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
    <IntermediateOutputPath>obj\$(Configuration)\</IntermediateOutputPath>
    <!-- ICE60: auto-harvested DLL files lack a Language attribute; suppress as false positive -->
    <SuppressIces>ICE60</SuppressIces>
  </PropertyGroup>

  <PropertyGroup>
    <NuGetPackageRoot Condition="'$(NuGetPackageRoot)' == ''">$(UserProfile)\.nuget\packages\</NuGetPackageRoot>
    <_UiWixExtDll>$(NuGetPackageRoot)wixtoolset.ui.wixext\5.0.2\wixext5\WixToolset.UI.wixext.dll</_UiWixExtDll>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" GeneratePathProperty="true" />
    <WixExtension Include="$(_UiWixExtDll)" Condition="Exists('$(_UiWixExtDll)')" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodeAnalyzer\CodeAnalyzer.csproj">
      <AdditionalProperties>BuildingMsiPackage=true</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>

  <Target Name="ReportMsiOutput" AfterTargets="Build">
    <Message Importance="high" Text="MSI created: $(TargetPath)" />
  </Target>
</Project>
