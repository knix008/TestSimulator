<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <UseAppHost>true</UseAppHost>
    <RootNamespace>RTSPClientWinV10</RootNamespace>
    <AssemblyName>RTSPClientWinV10</AssemblyName>
    <Version>0.1.0</Version>
    <Authors>SHKWON</Authors>
    <Company>SHKWON</Company>
    <Product>RTSPClientWinV10</Product>
    <Description>LAN 1:1 RTSP video/audio call client</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
    <Platforms>AnyCPU;x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <EnableWindowsFormsDesigner>true</EnableWindowsFormsDesigner>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Platform)' == 'x64'">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)' == 'AnyCPU' or '$(Platform)' == ''">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <!-- Defaults when WiX / dotnet publish packages the app -->
  <PropertyGroup Condition="'$(PublishProtocol)' != '' or '$(DeployOnBuild)' == 'true'">
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp.WinForms" Version="3.10.0" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RTSPCall.Core\RTSPCall.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\assets\app.ico" Link="assets\app.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\app.png" Link="assets\app.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
