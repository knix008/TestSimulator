{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyISOMaker",
  "mainBinaryName": "MyISOMaker",
  "version": "../package.json",
  "identifier": "com.shkwon.myisomaker",
  "build": {
    "beforeDevCommand": "node scripts/build-host.mjs && npm run dev:renderer",
    "devUrl": "http://localhost:5183",
    "beforeBuildCommand": "node scripts/build-host.mjs --release && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "MyISOMaker",
        "width": 1480,
        "height": 900,
        "minWidth": 1480,
        "minHeight": 700,
        "center": true,
        "dragDropEnabled": true,
        "visible": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg",
      "appimage",
      "deb"
    ],
    "publisher": "SHKWON",
    "copyright": "Copyright © SHKWON",
    "category": "Utility",
    "shortDescription": "ISO create / extract / edit / mount",
    "longDescription": "MyISOMaker by SHKWON — open, edit, save, create, make bootable and mount disc images.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../dist-sidecar/": "sidecar/",
      "../vendor/xorriso/": "vendor/xorriso/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Korean",
          "English"
        ],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "xorriso"
        ]
      }
    }
  }
}
