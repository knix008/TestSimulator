{
  "name": "3dfloormultiosv10",
  "version": "1.0.0",
  "private": true,
  "description": "Cross-platform 2D floor plan to 3D converter (Three.js), inspired by FloorPlanTo3D-unityClient",
  "author": "SHKWON <knix008@naver.com>",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "desktopName": "floorplanto3d.desktop",
  "scripts": {
    "start": "node scripts/start-desktop.mjs",
    "dev": "vite",
    "build": "node scripts/generate-icon.mjs && vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "node scripts/start-desktop.mjs",
    "electron:build": "npm run build && cross-env VITE_DEV_SERVER_URL= electron .",
    "icons": "node scripts/make-icon-transparent.mjs && node scripts/generate-icon.mjs",
    "samples": "node scripts/prepare-samples.mjs",
    "samples:synthetic": "node scripts/generate-plan-samples.mjs",
    "dreamspace:setup": "node scripts/setup-dreamspace.mjs",
    "dreamspace": "npm --prefix DreamSpaceAI run dev",
    "dreamspace:install": "npm --prefix DreamSpaceAI install",
    "dist:web": "npm run build && node scripts/package-web.mjs",
    "dist:win": "node scripts/dist-desktop.mjs win",
    "dist:mac": "node scripts/dist-desktop.mjs mac",
    "dist:linux": "node scripts/dist-desktop.mjs linux",
    "dist:desktop": "node scripts/dist-desktop.mjs auto",
    "dist:all": "node scripts/package-all.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^37.2.3",
    "electron-builder": "^26.0.12",
    "vite": "^8.1.1",
    "wait-on": "^8.0.4"
  },
  "dependencies": {
    "three": "^0.185.1"
  }
}
