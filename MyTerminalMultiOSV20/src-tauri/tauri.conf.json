{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyTerminal",
  "mainBinaryName": "MyTerminal",
  "version": "../package.json",
  "identifier": "com.shkwon.myterminal",
  "build": {
    "beforeDevCommand": "node scripts/build-tauri-web.js",
    "beforeBuildCommand": "node scripts/build-tauri-web.js --release",
    "frontendDist": "../dist/web"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "appimage", "deb"],
    "publisher": "SHKWON",
    "copyright": "Copyright © 2026 SHKWON",
    "category": "DeveloperTool",
    "shortDescription": "Modern cross-platform terminal",
    "longDescription": "MyTerminal by SHKWON — terminal for Windows, Linux, macOS, and Web.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../dist/sidecar/": "sidecar/"
    },
    "licenseFile": "../build/license.txt",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Korean", "English"],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  }
}
