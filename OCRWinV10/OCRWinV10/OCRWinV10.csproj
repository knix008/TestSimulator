<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.0.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <AssemblyName>OCRWinV10</AssemblyName>
    <Product>한국어 OCR</Product>
    <Company>OCRWinV10</Company>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <Import Project="InstallerPublish.props" Condition="'$(TrimInstallerPayload)' == 'true'" />

  <ItemGroup>
    <Content Include="app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="models\paddle\korean_PP-OCRv5_mobile_rec\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EasyOcrSharp" Version="2.1.1" />
    <PackageReference Include="OpenCvSharp4.Extensions" Version="4.11.0.20250507" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.11.0.20250507" />
    <PackageReference Include="Sdcb.PaddleInference.runtime.win64.mkl" Version="3.3.1.70" />
    <PackageReference Include="Sdcb.PaddleOCR" Version="3.3.1" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
  </ItemGroup>

  <!-- 단독 Release 빌드(시작 프로젝트) 시 MSI 생성. 솔루션 빌드는 Setup 프로젝트가 담당. -->
  <Target Name="BuildMsiInstaller"
          AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release'
                     and '$(BuildMsi)' != 'false'
                     and '$(BuildingSolutionFile)' != 'true'">
    <Message Text="Building MSI (OCRWinV10Setup)..." Importance="high" />
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\Setup\OCRWinV10Setup.wixproj"
             Targets="Build"
             Properties="Configuration=Release;Platform=x64;BuildMsi=false;TrimInstallerPayload=true" />
    <Message Text="MSI: $([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\Setup\bin\Release\OCRWinV10Setup.msi'))"
             Importance="high" />
  </Target>

</Project>
