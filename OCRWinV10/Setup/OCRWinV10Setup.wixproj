<Project Sdk="WixToolset.Sdk/7.0.0">

  <PropertyGroup>
    <OutputName>OCRWinV10Setup</OutputName>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <Configurations>Release</Configurations>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- WiX 7 OSMF EULA (https://wixtoolset.org/osmf/) -->
    <AcceptEula Condition="'$(AcceptEula)' == ''">wix7</AcceptEula>
    <_PublishDirRaw>$(MSBuildThisFileDirectory)..\OCRWinV10\bin\Publish\win-x64</_PublishDirRaw>
    <PublishDir>$([System.IO.Path]::GetFullPath('$(_PublishDirRaw)'))\</PublishDir>
    <IconPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\OCRWinV10\app.ico'))</IconPath>
    <DefineConstants>PublishDir=$(PublishDir);IconPath=$(IconPath)</DefineConstants>
  </PropertyGroup>

  <Target Name="PublishMainApp" BeforeTargets="CoreCompile">
    <Message Text="[OCRWinV10Setup] Publishing self-contained win-x64..." Importance="high" />
    <Exec Command="dotnet publish &quot;$(MSBuildThisFileDirectory)..\OCRWinV10\OCRWinV10.csproj&quot; -c Release -r win-x64 --self-contained true -p:PublishSingleFile=false -p:BuildMsi=false -p:TrimInstallerPayload=true -o &quot;$(PublishDir)&quot;"
          IgnoreExitCode="false" />
  </Target>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="7.0.0" GeneratePathProperty="true" />
  </ItemGroup>

  <!-- VS 단독 빌드 시 PackageReference만으로 확장이 안 잡히는 WIX0200 방지 -->
  <PropertyGroup>
    <_UiWixExtDll Condition="'$(_UiWixExtDll)' == '' and '$(PkgWixToolset_UI_wixext)' != ''">$(PkgWixToolset_UI_wixext)\wixext7\WixToolset.UI.wixext.dll</_UiWixExtDll>
    <_UiWixExtDll Condition="'$(_UiWixExtDll)' == '' and '$(NuGetPackageRoot)' != ''">$(NuGetPackageRoot)wixtoolset.ui.wixext\7.0.0\wixext7\WixToolset.UI.wixext.dll</_UiWixExtDll>
  </PropertyGroup>
  <ItemGroup>
    <WixExtension Include="$(_UiWixExtDll)" Condition="Exists('$(_UiWixExtDll)')" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Product.wxs" />
    <Compile Include="Payload.wxs" />
  </ItemGroup>

</Project>
