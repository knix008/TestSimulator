{
  "name": "mypaint",
  "version": "10.0.0",
  "private": true,
  "description": "MyPaint 10.0 drawing tool",
  "author": {
    "name": "SHKWON",
    "email": "knix008@naver.com"
  },
  "license": "MIT",
  "scripts": {
    "icons": "node scripts/make-icons.js",
    "start": "node scripts/dev.js",
    "tauri": "tauri",
    "stage": "node scripts/stage-app.js",
    "test": "node scripts/run-tests.js",
    "test:rust": "node scripts/stage-app.js && cargo test --manifest-path src-tauri/Cargo.toml",
    "build:web": "node scripts/build-web.js",
    "build:win": "tauri build --bundles nsis && node scripts/copy-setup.js",
    "build:linux": "node scripts/build-linux.js",
    "build:macos": "node scripts/build-macos.js",
    "build": "npm run icons && npm run vendor && npm run build:web && npm run build:win && npm run build:linux && npm run build:macos",
    "vendor": "node scripts/vendor.js",
    "fixtures": "node scripts/make-fixtures.js",
    "samples": "node scripts/fetch-heic.js && node scripts/make-samples.js",
    "samples:heic": "node scripts/fetch-heic.js"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4"
  },
  "dependencies": {
    "@cornerstonejs/codec-charls": "^1.2.7",
    "@cornerstonejs/codec-libjpeg-turbo-12bit": "^0.4.7",
    "@cornerstonejs/codec-libjpeg-turbo-8bit": "^1.2.8",
    "@cornerstonejs/codec-openjpeg": "^1.3.6",
    "dicom-parser": "^1.8.21",
    "jpeg-lossless-decoder-js": "^2.1.2",
    "libheif-js": "^1.23.5",
    "pako": "^2.2.0",
    "utif": "^3.1.0"
  }
}
