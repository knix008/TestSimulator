<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="FTP Client"
           Manufacturer="FTPClientWin"
           Version="1.0.0.0"
           UpgradeCode="B9F4E2A1-C3D6-4E8B-A0F1-2B5C7D9E3F0A"
           Language="1033">

    <SummaryInformation Description="FTP Client Installer" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of FTP Client is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <ui:WixUI Id="WixUI_Minimal" />

    <Icon Id="AppIcon.ico" SourceFile="..\FTPClientWin\daemon_hammer.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />

    <Feature Id="MainFeature" Title="FTP Client" Level="1">
      <ComponentGroupRef Id="AppComponents" />
      <ComponentGroupRef Id="Shortcuts" />
    </Feature>

  </Package>

  <!-- Directory structure -->
  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="ManufacturerFolder" Name="FTPClientWin">
        <Directory Id="INSTALLFOLDER" Name="FTP Client" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="FTP Client" />
    </StandardDirectory>
  </Fragment>

  <!-- Start menu shortcut -->
  <Fragment>
    <ComponentGroup Id="Shortcuts" Directory="INSTALLFOLDER">
      <Component Id="StartMenuShortcut" Guid="E5F6A7B8-C9D0-4E1F-2A3B-456789ABCDEF">
        <Shortcut Id="AppStartMenuShortcut"
                  Name="FTP Client"
                  Description="FTP / FTPS / SFTP Client"
                  Target="[INSTALLFOLDER]FTPClientWin.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon.ico" />
        <RemoveFolder Id="CleanAppMenuFolder" Directory="AppMenuFolder" On="uninstall" />
        <RegistryValue Root="HKLM"
                       Key="Software\FTPClientWin\FTPClient"
                       Name="installed"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

</Wix>
