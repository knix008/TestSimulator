<Project Sdk="WixToolset.Sdk/4.0.5">

  <PropertyGroup>
    <OutputType>Package</OutputType>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <Configurations>Debug;Release</Configurations>
    <!-- 앱 publish 출력 디렉토리 -->
    <AppPublishDir>$(MSBuildThisFileDirectory)publish\</AppPublishDir>
  </PropertyGroup>

  <!-- WiX 확장 패키지 -->
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext"   Version="4.0.5" />
    <PackageReference Include="WixToolset.Util.wixext" Version="4.0.5" />
  </ItemGroup>

  <!--
    Release 빌드 시 dotnet publish → publish\ 폴더 생성.
    publish\ 폴더의 모든 파일이 MSI에 포함됩니다.
  -->
  <Target Name="PublishApp" BeforeTargets="HarvestDirectory;CompileWix">
    <Exec Command="dotnet publish &quot;$(MSBuildThisFileDirectory)..\FTPClientWin\FTPClientWin.csproj&quot; -c $(Configuration) --no-self-contained -r win-x64 -o &quot;$(AppPublishDir)&quot;" />
  </Target>

  <!-- publish 폴더를 통째로 수확하여 AppComponents 그룹 생성 -->
  <ItemGroup>
    <HarvestDirectory Include="$(AppPublishDir)">
      <ComponentGroupName>AppComponents</ComponentGroupName>
      <DirectoryRefId>INSTALLFOLDER</DirectoryRefId>
      <SuppressRootDirectory>true</SuppressRootDirectory>
    </HarvestDirectory>
  </ItemGroup>

</Project>
