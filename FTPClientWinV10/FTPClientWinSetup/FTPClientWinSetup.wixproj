<Project Sdk="WixToolset.Sdk/7.0.0">

  <PropertyGroup>
    <OutputType>Package</OutputType>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <Configurations>Debug;Release</Configurations>
    <PublishDir>$(MSBuildThisFileDirectory)publish</PublishDir>
    <GeneratedWxs>$(MSBuildThisFileDirectory)AppFiles.g.wxs</GeneratedWxs>
    <AppProject>$(MSBuildThisFileDirectory)..\FTPClientWin\FTPClientWin.csproj</AppProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="7.0.0" />
  </ItemGroup>

  <!-- 빌드 전: dotnet publish → AppFiles.g.wxs 생성 -->
  <Target Name="PublishAndHarvest" BeforeTargets="CoreCompile">
    <Exec Command="dotnet publish &quot;$(AppProject)&quot; -c $(Configuration) --no-self-contained -r win-x64 -o &quot;$(PublishDir)&quot;" />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)GenerateAppFiles.ps1&quot;"
          EnvironmentVariables="WIX_PUBLISH_DIR=$(PublishDir);WIX_OUTPUT_FILE=$(GeneratedWxs)" />
  </Target>


</Project>
