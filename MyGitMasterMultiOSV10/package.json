{
  "name": "mygitmaster",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "My Git Master — cross-platform Git client (Tauri desktop app + web) with a built-in diff & 3-way merge tool and terminal",
  "author": "SHKWON <knix008@naver.com>",
  "license": "MIT",
  "scripts": {
    "start": "node scripts/dev.mjs desktop",
    "dev": "node scripts/dev.mjs desktop",
    "dev:web": "node scripts/dev.mjs web",
    "serve": "node dist-server/cli.cjs",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "icons": "node scripts/generate-icons.mjs",
    "guide:shots": "node scripts/guide-shots.mjs",
    "installer": "node scripts/copy-installer.mjs",
    "tauri": "node node_modules/@tauri-apps/cli/tauri.js",
    "build:ui": "node node_modules/vite/bin/vite.js build",
    "build:server": "node scripts/bundle-server.mjs",
    "build": "npm run build:ui && npm run build:server",
    "build:desktop": "node node_modules/@tauri-apps/cli/tauri.js build && npm run installer",
    "build:win": "node node_modules/@tauri-apps/cli/tauri.js build --bundles nsis && npm run installer",
    "build:mac": "node node_modules/@tauri-apps/cli/tauri.js build --bundles dmg && npm run installer",
    "build:linux": "node node_modules/@tauri-apps/cli/tauri.js build --bundles appimage,deb && npm run installer",
    "test": "node scripts/test-all.mjs",
    "test:unit": "node scripts/test-all.mjs --unit",
    "test:shell": "node scripts/test-all.mjs --shell"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@tauri-apps/api": "^2.12.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "express": "^4.21.2",
    "node-pty": "^1.1.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  },
  "engines": {
    "node": ">=20.19"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "node-pty@1.1.0": true
  }
}
