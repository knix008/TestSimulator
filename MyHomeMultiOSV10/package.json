{
  "name": "myhomemaker",
  "productName": "MyHomeMaker",
  "private": true,
  "version": "1.0.0",
  "description": "Graphical website builder for Web, Windows, macOS and Linux (Tauri) — drag-and-drop blocks, pages, site designs, templates and samples, live preview, static site export (HTML/CSS/ZIP)",
  "author": "SHKWON <knix008@naver.com>",
  "type": "module",
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "vite",
    "build:web": "vite build",
    "preview": "vite preview --port 4185 --strictPort",
    "tauri": "tauri",
    "test": "node scripts/test.mjs",
    "test:quick": "node scripts/test.mjs --quick",
    "test:unit": "node scripts/test.mjs --only js,rust",
    "test:e2e": "node scripts/test.mjs --only web,desktop",
    "build:win": "node scripts/build.mjs win",
    "build:mac": "node scripts/build.mjs mac",
    "build:linux": "node scripts/build.mjs linux",
    "build:webapp": "node scripts/build.mjs web",
    "build:all": "node scripts/build.mjs all",
    "build:icons": "node scripts/render-icons.mjs",
    "build:docs": "node scripts/build-docs.mjs",
    "guide:images": "node scripts/guide-images.mjs",
    "i18n:check": "node scripts/i18n-keys.mjs",
    "smoke": "node test/e2e/web.smoke.mjs",
    "smoke:desktop": "node test/e2e/desktop.smoke.mjs",
    "tutorial:docs": "node scripts/tutorial-capture.mjs docs",
    "tutorial:video": "node scripts/tutorial-capture.mjs video",
    "tutorial:check": "node scripts/tutorial-capture.mjs check",
    "build:dict": "node scripts/build-dict.mjs",
    "clean": "node scripts/clean.mjs",
    "clean:all": "node scripts/clean.mjs --all",
    "clean:dry": "node scripts/clean.mjs --all --dry-run"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "an-array-of-english-words": "^2.0.0",
    "dictionary-ko": "^2.0.0",
    "vite": "^7.1.7"
  }
}
