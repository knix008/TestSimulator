{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyHomeMaker",
  "mainBinaryName": "MyHomeMaker",
  "version": "../package.json",
  "identifier": "com.shkwon.myhomemaker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1460",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$APPLOCALDATA/**",
          "$APPCONFIG/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "SHKWON",
    "copyright": "Copyright (c) SHKWON (knix008@naver.com)",
    "category": "DeveloperTool",
    "shortDescription": "Graphical website builder",
    "longDescription": "Build websites by dragging blocks onto pages: heroes, features, galleries, pricing tables, testimonials, team, timelines, FAQs, contact forms, bulletin boards, maps and videos. 40 site designs plus themes of your own, 12 templates and 40 sample sites (15 with a board), a Problems panel with English and Korean spelling check; edit text in place, check desktop, tablet and phone widths, preview in the browser and publish the site as an HTML/CSS folder or a ZIP file.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "icons/project.ico": "project.ico",
      "icons/project.icns": "project.icns",
      "icons/project.png": "project.png",
      "icons/template.ico": "template.ico",
      "icons/template.icns": "template.icns",
      "icons/template.png": "template.png",
      "../public/docs/UsersGuide.html": "docs/UsersGuide.html",
      "../public/docs/UsersGuide.en.html": "docs/UsersGuide.en.html",
      "../public/docs/Tutorial.html": "docs/Tutorial.html",
      "../public/docs/Tutorial.en.html": "docs/Tutorial.en.html",
      "../public/docs/images/": "docs/images/"
    },
    "fileAssociations": [
      {
        "ext": [
          "myhome"
        ],
        "name": "MyHomeMaker.Site",
        "description": "MyHomeMaker Site",
        "mimeType": "application/x-myhomemaker",
        "role": "Editor"
      },
      {
        "ext": [
          "mhomt"
        ],
        "name": "MyHomeMaker.Template",
        "description": "MyHomeMaker Site Template",
        "mimeType": "application/x-myhomemaker-template",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Korean",
          "English"
        ],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "headerImage": "windows/installerHeader.bmp",
        "sidebarImage": "windows/installerSidebar.bmp",
        "installerHooks": "windows/hooks.nsh",
        "startMenuFolder": "MyHomeMaker"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ],
        "files": {
          "/usr/share/mime/packages/myhomemaker.xml": "linux/myhomemaker.xml",
          "/usr/share/icons/hicolor/256x256/mimetypes/application-x-myhomemaker.png": "icons/project.png",
          "/usr/share/icons/hicolor/256x256/mimetypes/application-x-myhomemaker-template.png": "icons/template.png"
        },
        "postInstallScript": "linux/postinst.sh",
        "postRemoveScript": "linux/postrm.sh"
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3"
        ],
        "files": {
          "/usr/share/mime/packages/myhomemaker.xml": "linux/myhomemaker.xml",
          "/usr/share/icons/hicolor/256x256/mimetypes/application-x-myhomemaker.png": "icons/project.png",
          "/usr/share/icons/hicolor/256x256/mimetypes/application-x-myhomemaker-template.png": "icons/template.png"
        },
        "postInstallScript": "linux/postinst.sh",
        "postRemoveScript": "linux/postrm.sh"
      }
    }
  }
}
