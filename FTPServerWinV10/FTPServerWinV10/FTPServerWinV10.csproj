<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>daemon_hammer.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SSH.NET" Version="2025.1.0" />
  </ItemGroup>

  <!-- Release 빌드 시 MSI 생성 (VS에서 시작 프로젝트만 빌드해도 동작). SkipInstaller로 순환 방지. -->
  <Target Name="BuildInstallerMsi"
          AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release' AND '$(SkipInstaller)' != 'true' AND '$(DesignTimeBuild)' != 'true'">
    <Message Text="Building MSI installer (Release)..." Importance="high" />
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\FTPServerWinV10Setup\FTPServerWinV10Setup.wixproj"
             Targets="Restore;Build"
             Properties="Configuration=Release;Platform=x64" />
    <Message Text="MSI created: $(MSBuildThisFileDirectory)..\FTPServerWinV10Setup\bin\Release\FTPServerWinV10_Setup.msi" Importance="high" />
  </Target>

</Project>