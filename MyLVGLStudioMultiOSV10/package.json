{
  "name": "mylvglstudio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "My LVGL Studio - graphic screen designer and runner for LVGL applications (Tauri + JavaScript)",
  "author": "SHKWON <knix008@naver.com>",
  "license": "MIT",
  "scripts": {
    "start": "node scripts/dev.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:web": "node scripts/dev.mjs web",
    "build:ui": "node node_modules/vite/bin/vite.js build",
    "fetch:lvgl": "node scripts/fetch-lvgl.mjs",
    "build:engine": "node scripts/build-engine.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "samples": "node scripts/generate-samples.mjs",
    "conf-templates": "node scripts/generate-conf-templates.mjs",
    "mvvm-source": "node scripts/generate-mvvm-source.mjs",
    "tauri": "node node_modules/@tauri-apps/cli/tauri.js",
    "build:win": "node node_modules/@tauri-apps/cli/tauri.js build --bundles nsis && node scripts/copy-installer.mjs",
    "build:mac": "node node_modules/@tauri-apps/cli/tauri.js build --bundles dmg && node scripts/copy-installer.mjs",
    "build:linux": "node node_modules/@tauri-apps/cli/tauri.js build --bundles appimage,deb && node scripts/copy-installer.mjs",
    "tutorial:video": "node scripts/tutorial-video.mjs",
    "test": "node test/run.mjs",
    "build:e2e": "node scripts/build-e2e.mjs",
    "test:gui": "node scripts/build-e2e.mjs && node test/gui.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.0",
    "vite": "^6.2.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
