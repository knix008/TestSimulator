<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <GenerateMsiOnBuild>true</GenerateMsiOnBuild>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>daemon_hammer.ico</ApplicationIcon>
    <RootNamespace>ImageViewerV30</RootNamespace>
    <AssemblyName>ImageViewerV30</AssemblyName>
    <NoWarn>$(NoWarn);NU1903;NU1902</NoWarn>
    <!-- MSI/배포: Windows x64만 포함 (AnyCPU 시 LibVLC 3종 + ONNX 전 플랫폼 ≈ 460MB) -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <VlcWindowsX64Enabled>true</VlcWindowsX64Enabled>
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp.WinForms" Version="3.9.7.1" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.6" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="MainForm.cs" />
    <Compile Update="MainForm.Designer.cs">
      <DependentUpon>MainForm.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="MainForm.resx">
      <DependentUpon>MainForm.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Content Include="assets\icons\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="daemon_hammer.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="models\u2net.onnx" Condition="Exists('models\u2net.onnx')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>models\u2net.onnx</Link>
    </Content>
    <Content Include="models\bria-rmbg-2.0.onnx" Condition="Exists('models\bria-rmbg-2.0.onnx')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>models\bria-rmbg-2.0.onnx</Link>
    </Content>
  </ItemGroup>

  <Target
    Name="BuildInstallerMsi"
    AfterTargets="Build"
    Condition="'$(Configuration)' == 'Release' and '$(GenerateMsiOnBuild)' == 'true'"
    Inputs="$(TargetPath);$(TargetDir)**\*;$(MSBuildProjectDirectory)\ImageViewerV30.Installer\Package.wxs;$(MSBuildProjectDirectory)\ImageViewerV30.Installer\ImageViewerV30.Installer.wixproj"
    Outputs="$(MSBuildProjectDirectory)\ImageViewerV30.Installer\bin\x64\$(Configuration)\ImageViewerV30.Installer.msi">
    <Message Importance="high" Text="Building MSI installer for Release configuration..." />
    <Exec Command="dotnet build &quot;$(MSBuildProjectDirectory)\ImageViewerV30.Installer\ImageViewerV30.Installer.wixproj&quot; -c $(Configuration) -p:GenerateMsiOnBuild=false -p:BuildProjectReferences=false" />
  </Target>

</Project>
