<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
    Name="ImageViewerV30"
    Manufacturer="ImageViewerV30"
    Version="1.0.0"
    Scope="perMachine"
    UpgradeCode="B7B58C6B-D2C8-4CE1-B7C4-9CB8D6D16BE0">

    <MajorUpgrade DowngradeErrorMessage="A newer version of ImageViewerV30 is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="low" />

    <Icon Id="daemon_hammer.ico" SourceFile="$(var.ImageViewerV30.TargetDir)daemon_hammer.ico" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="ImageViewerV30" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="ImageViewerV30" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <ui:WixUI Id="WixUI_FeatureTree" />

    <Feature Id="MainFeature" Title="ImageViewerV30" Level="1" AllowAbsent="no">
      <ComponentGroupRef Id="AppFiles" />
    </Feature>

    <Feature Id="DesktopShortcutFeature" Title="Create desktop shortcut" Level="1" AllowAbsent="yes">
      <ComponentRef Id="DesktopShortcutComponent" />
    </Feature>

    <Feature Id="StartMenuShortcutFeature" Title="Create Start Menu shortcut" Level="1" AllowAbsent="yes">
      <ComponentRef Id="StartMenuShortcutComponent" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.ImageViewerV30.TargetDir)\**" />
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcutComponent" Guid="*">
        <Shortcut
          Id="DesktopShortcut"
          Name="ImageViewerV30"
          Description="ImageViewerV30"
          Target="[INSTALLFOLDER]ImageViewerV30.exe"
          WorkingDirectory="INSTALLFOLDER"
          Icon="daemon_hammer.ico" />
        <RegistryValue
          Root="HKCU"
          Key="Software\ImageViewerV30"
          Name="DesktopShortcut"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      </Component>
    </StandardDirectory>
  </Fragment>

  <Fragment>
    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="StartMenuShortcutComponent" Guid="*">
        <Shortcut
          Id="StartMenuShortcut"
          Name="ImageViewerV30"
          Description="ImageViewerV30"
          Target="[INSTALLFOLDER]ImageViewerV30.exe"
          WorkingDirectory="INSTALLFOLDER"
          Icon="daemon_hammer.ico" />
        <RemoveFolder Id="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue
          Root="HKCU"
          Key="Software\ImageViewerV30"
          Name="StartMenuShortcut"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
