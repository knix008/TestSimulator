{
  "name": "mysimulationmath",
  "version": "1.0.0",
  "description": "MySimulationMath — numerical computing, plotting and block-diagram simulation for Windows, macOS, Linux and the web (Tauri desktop shell). Korean / English UI, 40 themes.",
  "author": {
    "name": "SHKWON",
    "email": "knix008@naver.com"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/start.mjs",
    "tauri:build": "tauri build",
    "build": "vite build",
    "build:web": "npm run build && node server/server.js",
    "build:win": "node scripts/platform-build.mjs win",
    "build:linux": "node scripts/platform-build.mjs linux",
    "build:mac": "node scripts/platform-build.mjs mac",
    "web": "npm run build:web",
    "web:serve": "node server/server.js",
    "msm": "node scripts/msm.mjs",
    "generate:icons": "node scripts/generate-icons.mjs",
    "generate:samples": "node scripts/generate-sample-thumbs.mjs",
    "generate:models": "node scripts/generate-model-thumbs.mjs",
    "generate:sample-files": "node scripts/generate-sample-files.mjs",
    "test": "node --test --test-reporter=./test/reporter.mjs test/*.test.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.6.0",
    "@codemirror/language": "^6.10.2",
    "@codemirror/legacy-modes": "^6.4.1",
    "@codemirror/lint": "^6.8.1",
    "@codemirror/search": "^6.5.6",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.33.0",
    "@lezer/highlight": "^1.2.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "dictionary-en": "^4.0.0",
    "nspell": "^2.1.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "@vitejs/plugin-react": "^4.3.1",
    "sharp": "^0.33.4",
    "vite": "^5.4.1"
  },
  "allowScripts": {
    "sharp@0.33.5": true,
    "esbuild@0.21.5": true
  }
}
