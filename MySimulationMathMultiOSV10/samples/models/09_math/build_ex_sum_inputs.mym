% 입력들의 합 / Sum of the inputs
% 사인파·계단·램프를 Sum 블록으로 더해, 세 입력과 그 합을 한 스코프에 겹쳐 봅니다
% A sine, a step and a ramp added by a Sum block: the three inputs and their sum overlaid on one scope
% (example model, builds and opens the model — MySimulationMath start page)
% Example model "ex_sum_inputs": built from M code, then opened in the model editor.
mdl = 'ex_sum_inputs';
try
    open_system(mdl);            % already loaded: show it
catch
    new_system(mdl);
    add_block('SineWave', [mdl '/Sine'], 'Position', [152 50 192 90]);
    add_block('Step', [mdl '/Step'], 'Time', '2', 'After', '0.5', 'Position', [96 145 136 185]);
    add_block('Ramp', [mdl '/Ramp'], 'slope', '0.1', 'Position', [40 240 80 280]);
    add_block('Sum', [mdl '/Sum'], 'Inputs', '+++', 'Position', [348 145 388 185]);
    add_block('Scope', [mdl '/Scope'], 'NumInputPorts', '4', 'Layout', 'overlay', 'Legend', 'on', 'Position', [600 145 640 251]);
    add_line(mdl, 'Sine/1', 'Sum/1');
    add_line(mdl, 'Step/1', 'Sum/2');
    add_line(mdl, 'Ramp/1', 'Sum/3');
    add_line(mdl, 'Sine/1', 'Scope/1');
    add_line(mdl, 'Step/1', 'Scope/2');
    add_line(mdl, 'Ramp/1', 'Scope/3');
    add_line(mdl, 'Sum/1', 'Scope/4');
    set_param(mdl, 'StopTime', '10');
    open_system(mdl);
end
