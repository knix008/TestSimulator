% Getting started: variables, matrices and output.
a = 3;
b = [1 2 3; 4 5 6]
c = b' * a          % transpose and scale
d = b .^ 2          % element-wise power
total = sum(b(:))
fprintf('The mean of b is %.3f\n', mean(b(:)));
disp('Done.');
