{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MySimulationMath",
  "version": "1.0.0",
  "identifier": "com.shkwon.mysimulationmath",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5230",
    "beforeDevCommand": "node scripts/generate-icons.mjs --if-needed && npm run dev",
    "beforeBuildCommand": "node scripts/generate-icons.mjs --if-needed && npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null,
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "appimage",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "icons/m.ico": "m.ico",
      "icons/msim.ico": "msim.ico"
    },
    "fileAssociations": [
      {
        "ext": [
          "msim",
          "smdl"
        ],
        "name": "MySimulationMath.Model",
        "description": "MySimulationMath block diagram model",
        "role": "Editor",
        "mimeType": "application/x-mysimulationmath-model"
      },
      {
        "ext": [
          "mat"
        ],
        "name": "MySimulationMath.Data",
        "description": "MySimulationMath data file",
        "role": "Editor",
        "mimeType": "application/x-mysimulationmath-data"
      }
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "./windows/hooks.nsh",
        "displayLanguageSelector": true,
        "languages": [
          "Korean",
          "English"
        ]
      }
    },
    "category": "Education",
    "shortDescription": "Numerical computing, plotting and block-diagram simulation",
    "longDescription": "An array-language numerical computing environment with Command Window, Editor, Workspace, figures and a block-diagram simulation tool.",
    "copyright": "Copyright © 2026 SHKWON",
    "publisher": "SHKWON"
  }
}
