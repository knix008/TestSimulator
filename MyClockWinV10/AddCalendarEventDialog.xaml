<Window x:Class="MyClockWinV10.AddCalendarEventDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="340" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Window.Resources>

        <!-- ── Color swatch RadioButton ─────────────────────────────────── -->
        <Style x:Key="ColorSwatchRadio" TargetType="RadioButton">
            <Setter Property="Width"  Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Ellipse x:Name="Fill"
                                     Fill="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                     Width="22" Height="22"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Ellipse x:Name="Ring"
                                     Width="26" Height="26"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Stroke="Transparent" StrokeThickness="2" Fill="Transparent"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Width"  Value="24"/>
                                <Setter TargetName="Fill" Property="Height" Value="24"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── CalendarDayButton ──────────────────────────────────────────── -->
        <Style TargetType="CalendarDayButton">
            <Setter Property="Foreground"               Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Background"               Value="Transparent"/>
            <Setter Property="MinWidth"                 Value="30"/>
            <Setter Property="MinHeight"                Value="26"/>
            <Setter Property="FontSize"                 Value="11"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment"   Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CalendarDayButton">
                        <Grid>
                            <Rectangle x:Name="Bg" Fill="Transparent" RadiusX="3" RadiusY="3"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Fill"
                                        Value="{DynamicResource TabSelectedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Fill"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsToday" Value="True">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsInactive" Value="True">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource SubtleForegroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── CalendarButton (month/year navigation grid) ───────────────── -->
        <Style TargetType="CalendarButton">
            <Setter Property="Foreground"               Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Background"               Value="Transparent"/>
            <Setter Property="MinWidth"                 Value="40"/>
            <Setter Property="MinHeight"                Value="42"/>
            <Setter Property="FontSize"                 Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment"   Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CalendarButton">
                        <Grid>
                            <Rectangle x:Name="Bg" Fill="Transparent" RadiusX="3" RadiusY="3"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Fill"
                                        Value="{DynamicResource TabSelectedBrush}"/>
                            </Trigger>
                            <Trigger Property="HasSelectedDays" Value="True">
                                <Setter TargetName="Bg" Property="Fill"
                                        Value="{DynamicResource TabSelectedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── CalendarItem (the popup calendar body) ────────────────────── -->
        <Style TargetType="CalendarItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CalendarItem">
                        <ControlTemplate.Resources>
                            <DataTemplate x:Key="{x:Static CalendarItem.DayTitleTemplateResourceKey}">
                                <TextBlock Text="{Binding}"
                                           FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SubtleForegroundBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Margin="0,3,0,3"/>
                            </DataTemplate>
                        </ControlTemplate.Resources>
                        <Border Background="{DynamicResource WindowBackgroundBrush}"
                                BorderBrush="{DynamicResource TabBackgroundBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="6,4,6,6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Button x:Name="PART_PreviousButton"
                                            Content="◀" Width="26" Height="26"
                                            HorizontalAlignment="Left"
                                            Foreground="{DynamicResource ForegroundBrush}"
                                            Background="Transparent" BorderThickness="0"
                                            FontSize="10" Cursor="Hand"/>
                                    <Button x:Name="PART_HeaderButton"
                                            HorizontalAlignment="Center"
                                            Foreground="{DynamicResource ForegroundBrush}"
                                            Background="Transparent" BorderThickness="0"
                                            FontSize="13" FontWeight="SemiBold" Cursor="Hand"/>
                                    <Button x:Name="PART_NextButton"
                                            Content="▶" Width="26" Height="26"
                                            HorizontalAlignment="Right"
                                            Foreground="{DynamicResource ForegroundBrush}"
                                            Background="Transparent" BorderThickness="0"
                                            FontSize="10" Cursor="Hand"/>
                                </Grid>
                                <Grid x:Name="PART_MonthView" Grid.Row="1"/>
                                <Grid x:Name="PART_YearView"  Grid.Row="1" Visibility="Hidden"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── DatePickerTextBox (inner text field) ──────────────────────── -->
        <Style TargetType="DatePickerTextBox">
            <Setter Property="Background"     Value="{DynamicResource PanelBackgroundBrush}"/>
            <Setter Property="Foreground"     Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="CaretBrush"     Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"        Value="6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePickerTextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup Name="WatermarkStates">
                                    <VisualState Name="Unwatermarked"/>
                                    <VisualState Name="Watermarked">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PART_Watermark"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.5" Duration="0"/>
                                            <DoubleAnimation Storyboard.TargetName="PART_ContentHost"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid>
                                <ContentControl x:Name="PART_Watermark"
                                                Opacity="0"
                                                Foreground="{DynamicResource SubtleForegroundBrush}"
                                                Padding="{TemplateBinding Padding}"
                                                VerticalAlignment="Center"/>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── DatePicker ────────────────────────────────────────────────── -->
        <Style TargetType="DatePicker">
            <Setter Property="Background"      Value="{DynamicResource PanelBackgroundBrush}"/>
            <Setter Property="Foreground"      Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource TabBackgroundBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height"          Value="34"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Padding"         Value="4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>
                                <DatePickerTextBox x:Name="PART_TextBox"
                                                   Grid.Column="0"
                                                   Background="Transparent"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   Padding="{TemplateBinding Padding}"
                                                   FontSize="{TemplateBinding FontSize}"
                                                   VerticalContentAlignment="Center"
                                                   BorderThickness="0"/>
                                <Button x:Name="PART_Button"
                                        Grid.Column="1"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Focusable="False"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center">
                                    <TextBlock Text="▼" FontSize="9"
                                               Foreground="{DynamicResource SubtleForegroundBrush}"
                                               VerticalAlignment="Center"/>
                                </Button>
                                <Popup x:Name="PART_Popup"
                                       AllowsTransparency="True"
                                       Placement="Bottom"
                                       StaysOpen="False"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <StackPanel Margin="16,14,16,16">

        <!-- 제목 -->
        <TextBlock Text="제목" FontSize="12" FontWeight="SemiBold"
                   Foreground="{DynamicResource SubtleForegroundBrush}" Margin="0,0,0,4"/>
        <TextBox x:Name="TitleBox" Height="34" FontSize="13"
                 Background="{DynamicResource PanelBackgroundBrush}"
                 Foreground="{DynamicResource ForegroundBrush}"
                 BorderBrush="{DynamicResource TabBackgroundBrush}" BorderThickness="1"
                 Padding="8,4" Margin="0,0,0,12"/>

        <!-- 시작 날짜 -->
        <TextBlock Text="시작 날짜" FontSize="12" FontWeight="SemiBold"
                   Foreground="{DynamicResource SubtleForegroundBrush}" Margin="0,0,0,4"/>
        <DatePicker x:Name="StartDatePicker"
                    SelectedDateFormat="Long"
                    Margin="0,0,0,2"
                    SelectedDateChanged="StartDatePicker_Changed"/>
        <TextBlock x:Name="LunarLabel" FontSize="11"
                   Foreground="{DynamicResource SubtleForegroundBrush}"
                   Margin="0,0,0,6"/>

        <!-- 시작 시간 -->
        <Border x:Name="StartTimePanel" Margin="0,0,0,12">
            <Grid>
                <TextBlock Text="시간" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource SubtleForegroundBrush}"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="−" Width="30" Height="32" FontSize="14" Click="StartHourDown_Click"/>
                    <TextBox x:Name="StartHourText" Width="48" Height="32" FontSize="15" FontWeight="Bold"
                             FontFamily="Consolas" TextAlignment="Center" MaxLength="2" Padding="0"
                             Background="{DynamicResource PanelBackgroundBrush}"
                             Foreground="{DynamicResource ForegroundBrush}"
                             BorderBrush="{DynamicResource TabBackgroundBrush}" BorderThickness="1"
                             VerticalContentAlignment="Center"
                             GotFocus="TimeField_GotFocus" LostFocus="TimeField_LostFocus"/>
                    <Button Content="+" Width="30" Height="32" FontSize="14" Click="StartHourUp_Click"/>
                    <TextBlock Text=":" Width="14" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource SubtleForegroundBrush}"
                               TextAlignment="Center" VerticalAlignment="Center"/>
                    <Button Content="−" Width="30" Height="32" FontSize="14" Click="StartMinuteDown_Click"/>
                    <TextBox x:Name="StartMinuteText" Width="48" Height="32" FontSize="15" FontWeight="Bold"
                             FontFamily="Consolas" TextAlignment="Center" MaxLength="2" Padding="0"
                             Background="{DynamicResource PanelBackgroundBrush}"
                             Foreground="{DynamicResource ForegroundBrush}"
                             BorderBrush="{DynamicResource TabBackgroundBrush}" BorderThickness="1"
                             VerticalContentAlignment="Center"
                             GotFocus="TimeField_GotFocus" LostFocus="TimeField_LostFocus"/>
                    <Button Content="+" Width="30" Height="32" FontSize="14" Click="StartMinuteUp_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 종료 날짜 -->
        <TextBlock Text="종료 날짜" FontSize="12" FontWeight="SemiBold"
                   Foreground="{DynamicResource SubtleForegroundBrush}" Margin="0,0,0,4"/>
        <DatePicker x:Name="EndDatePicker"
                    SelectedDateFormat="Long"
                    Margin="0,0,0,2"
                    SelectedDateChanged="EndDatePicker_Changed"/>
        <TextBlock x:Name="EndLunarLabel" FontSize="11"
                   Foreground="{DynamicResource SubtleForegroundBrush}"
                   Margin="0,0,0,6"/>

        <!-- 종료 시간 -->
        <Border x:Name="EndTimePanel" Margin="0,0,0,12">
            <Grid>
                <TextBlock Text="시간" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource SubtleForegroundBrush}"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="−" Width="30" Height="32" FontSize="14" Click="EndHourDown_Click"/>
                    <TextBox x:Name="EndHourText" Width="48" Height="32" FontSize="15" FontWeight="Bold"
                             FontFamily="Consolas" TextAlignment="Center" MaxLength="2" Padding="0"
                             Background="{DynamicResource PanelBackgroundBrush}"
                             Foreground="{DynamicResource ForegroundBrush}"
                             BorderBrush="{DynamicResource TabBackgroundBrush}" BorderThickness="1"
                             VerticalContentAlignment="Center"
                             GotFocus="TimeField_GotFocus" LostFocus="TimeField_LostFocus"/>
                    <Button Content="+" Width="30" Height="32" FontSize="14" Click="EndHourUp_Click"/>
                    <TextBlock Text=":" Width="14" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource SubtleForegroundBrush}"
                               TextAlignment="Center" VerticalAlignment="Center"/>
                    <Button Content="−" Width="30" Height="32" FontSize="14" Click="EndMinuteDown_Click"/>
                    <TextBox x:Name="EndMinuteText" Width="48" Height="32" FontSize="15" FontWeight="Bold"
                             FontFamily="Consolas" TextAlignment="Center" MaxLength="2" Padding="0"
                             Background="{DynamicResource PanelBackgroundBrush}"
                             Foreground="{DynamicResource ForegroundBrush}"
                             BorderBrush="{DynamicResource TabBackgroundBrush}" BorderThickness="1"
                             VerticalContentAlignment="Center"
                             GotFocus="TimeField_GotFocus" LostFocus="TimeField_LostFocus"/>
                    <Button Content="+" Width="30" Height="32" FontSize="14" Click="EndMinuteUp_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 종일 이벤트 -->
        <Grid Margin="0,0,0,12">
            <TextBlock Text="종일 이벤트" FontSize="13"
                       Foreground="{DynamicResource ForegroundBrush}"
                       VerticalAlignment="Center"/>
            <CheckBox x:Name="AllDayCheck" IsChecked="False"
                      Style="{StaticResource ToggleSwitchStyle}"
                      HorizontalAlignment="Right" VerticalAlignment="Center"
                      Checked="AllDay_Changed" Unchecked="AllDay_Changed"/>
        </Grid>

        <!-- 알람 -->
        <TextBlock Text="알람" FontSize="12" FontWeight="SemiBold"
                   Foreground="{DynamicResource SubtleForegroundBrush}" Margin="0,0,0,4"/>
        <ComboBox x:Name="ReminderCombo" Height="32" FontSize="13"
                  Margin="0,0,0,12"/>

        <!-- 반복 -->
        <TextBlock Text="반복" FontSize="12" FontWeight="SemiBold"
                   Foreground="{DynamicResource SubtleForegroundBrush}" Margin="0,0,0,4"/>
        <ComboBox x:Name="RecurrenceCombo" Height="32" FontSize="13"
                  Margin="0,0,0,12"/>

        <!-- 색깔 -->
        <TextBlock Text="색깔" FontSize="12" FontWeight="SemiBold"
                   Foreground="{DynamicResource SubtleForegroundBrush}" Margin="0,0,0,6"/>
        <WrapPanel x:Name="ColorPanel" Margin="0,0,0,12">
            <RadioButton x:Name="Color1" Tag="#4A90D9" GroupName="EventColor" Style="{StaticResource ColorSwatchRadio}" Margin="0,0,6,0"/>
            <RadioButton x:Name="Color2" Tag="#E05C5C" GroupName="EventColor" Style="{StaticResource ColorSwatchRadio}" Margin="0,0,6,0"/>
            <RadioButton x:Name="Color3" Tag="#4CAF50" GroupName="EventColor" Style="{StaticResource ColorSwatchRadio}" Margin="0,0,6,0"/>
            <RadioButton x:Name="Color4" Tag="#F5A623" GroupName="EventColor" Style="{StaticResource ColorSwatchRadio}" Margin="0,0,6,0"/>
            <RadioButton x:Name="Color5" Tag="#9B59B6" GroupName="EventColor" Style="{StaticResource ColorSwatchRadio}" Margin="0,0,6,0"/>
            <RadioButton x:Name="Color6" Tag="#1ABC9C" GroupName="EventColor" Style="{StaticResource ColorSwatchRadio}" Margin="0,0,6,0"/>
            <RadioButton x:Name="Color7" Tag="#E67E22" GroupName="EventColor" Style="{StaticResource ColorSwatchRadio}" Margin="0,0,6,0"/>
            <RadioButton x:Name="Color8" Tag="#EC407A" GroupName="EventColor" Style="{StaticResource ColorSwatchRadio}"/>
        </WrapPanel>

        <!-- 메모 -->
        <TextBlock Text="메모" FontSize="12" FontWeight="SemiBold"
                   Foreground="{DynamicResource SubtleForegroundBrush}" Margin="0,0,0,4"/>
        <TextBox x:Name="DescBox" Height="58" FontSize="12"
                 TextWrapping="Wrap" AcceptsReturn="True"
                 Background="{DynamicResource PanelBackgroundBrush}"
                 Foreground="{DynamicResource ForegroundBrush}"
                 BorderBrush="{DynamicResource TabBackgroundBrush}" BorderThickness="1"
                 Padding="6,4" Margin="0,0,0,16"/>

        <!-- 버튼 행 -->
        <Grid>
            <Button x:Name="DeleteBtn" Content="삭제" Width="76" Height="34" FontSize="13"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource DangerBrush}" Foreground="White"
                    Visibility="Collapsed"
                    Click="Delete_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="취소" Width="76" Height="34" FontSize="13"
                        Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button Content="저장" Width="76" Height="34" FontSize="13"
                        FontWeight="SemiBold"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="{DynamicResource ActiveBtnFgBrush}"
                        Click="Save_Click"/>
            </StackPanel>
        </Grid>

    </StackPanel>
</Window>
