<Window x:Class="MyClockWinV10.AlarmNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="알람" Height="220" Width="360"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Topmost="True" ResizeMode="NoResize"
        WindowStyle="None"
        Background="{DynamicResource WindowBackgroundBrush}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome GlassFrameThickness="0"
                            ResizeBorderThickness="0"
                            CaptionHeight="0"
                            CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource AccentBrush}"
            BorderThickness="2"
            CornerRadius="10"
            Margin="2">
        <Grid Margin="20,16,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="AlarmHeaderText" Grid.Row="0" Text="알람"
                       FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource SubtleForegroundBrush}"
                       HorizontalAlignment="Left"/>

            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,8,0,8">
                <TextBlock x:Name="AlarmTimeText" FontSize="44" FontWeight="Bold"
                           FontFamily="Consolas"
                           Foreground="{DynamicResource DigitalTextBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="AlarmLabelText" FontSize="15"
                           Foreground="{DynamicResource ForegroundBrush}"
                           HorizontalAlignment="Center" Margin="0,6,0,0"
                           TextWrapping="Wrap" TextAlignment="Center"/>
            </StackPanel>

            <Button Grid.Row="2" Content="확인" Height="40"
                    Background="{DynamicResource AccentBrush}"
                    Foreground="{DynamicResource ActiveBtnFgBrush}"
                    FontSize="15" FontWeight="SemiBold"
                    IsDefault="True"
                    Click="Confirm_Click"/>
        </Grid>
    </Border>
</Window>
