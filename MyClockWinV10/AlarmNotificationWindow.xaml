<Window x:Class="MyClockWinV10.AlarmNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="알람" Height="230" Width="420"
        WindowStartupLocation="CenterScreen"
        Topmost="True" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Border Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="12" Margin="2">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="AlarmHeaderText" Text="알람" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource SubtleForegroundBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,6"/>
                <TextBlock x:Name="AlarmTimeText" FontSize="52" FontWeight="Bold"
                           FontFamily="Consolas"
                           Foreground="{DynamicResource DigitalTextBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="AlarmLabelText" FontSize="18"
                           Foreground="{DynamicResource ForegroundBrush}"
                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
            <Button Grid.Row="1" Content="닫기" Height="44" Margin="0,16,0,0"
                    Background="{DynamicResource AccentBrush}"
                    Foreground="{DynamicResource ActiveBtnFgBrush}"
                    FontSize="16" FontWeight="SemiBold"
                    Click="CloseButton_Click"/>
        </Grid>
    </Border>
</Window>
