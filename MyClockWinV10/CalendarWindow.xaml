<Window x:Class="MyClockWinV10.CalendarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Google Calendar"
        Width="480" MinWidth="360"
        Height="620" MinHeight="420"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterOwner">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome GlassFrameThickness="0"
                            ResizeBorderThickness="5"
                            CaptionHeight="0"
                            CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid Grid.Row="0" Background="{DynamicResource TabBackgroundBrush}"
              MouseLeftButtonDown="Caption_MouseLeftButtonDown">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <!-- Calendar icon -->
                <Viewbox Width="15" Height="15" Margin="0,0,7,0" VerticalAlignment="Center">
                    <Canvas Width="16" Height="16">
                        <Rectangle Canvas.Left="1" Canvas.Top="3" Width="14" Height="12"
                                   Stroke="{DynamicResource SubtleForegroundBrush}"
                                   StrokeThickness="1.5" Fill="Transparent"/>
                        <Line X1="1" Y1="7.5" X2="15" Y2="7.5"
                              Stroke="{DynamicResource SubtleForegroundBrush}" StrokeThickness="1"/>
                        <Rectangle Canvas.Left="4" Canvas.Top="0.5" Width="2" Height="4"
                                   Fill="{DynamicResource SubtleForegroundBrush}" RadiusX="1" RadiusY="1"/>
                        <Rectangle Canvas.Left="10" Canvas.Top="0.5" Width="2" Height="4"
                                   Fill="{DynamicResource SubtleForegroundBrush}" RadiusX="1" RadiusY="1"/>
                        <Rectangle Canvas.Left="3"  Canvas.Top="9.5" Width="2.5" Height="2"
                                   Fill="{DynamicResource SubtleForegroundBrush}"/>
                        <Rectangle Canvas.Left="6.5" Canvas.Top="9.5" Width="2.5" Height="2"
                                   Fill="{DynamicResource SubtleForegroundBrush}"/>
                        <Rectangle Canvas.Left="10" Canvas.Top="9.5" Width="2.5" Height="2"
                                   Fill="{DynamicResource AccentBrush}"/>
                    </Canvas>
                </Viewbox>
                <TextBlock Text="Google Calendar" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource SubtleForegroundBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <Button Content="✕" Width="30" Height="22" FontSize="11"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"
                    Background="#C0392B" Foreground="White"
                    Click="CloseBtn_Click"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
        </Grid>

        <!-- Connection section -->
        <Border Grid.Row="1" Background="{DynamicResource PanelBackgroundBrush}"
                Margin="10,10,10,0" CornerRadius="6" Padding="12,10">
            <Grid>
                <!-- Not connected -->
                <StackPanel x:Name="DisconnectedPanel">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Ellipse Width="9" Height="9" Fill="#757575"
                                 VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="연결 안됨" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SubtleForegroundBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock FontSize="12" Foreground="{DynamicResource SubtleForegroundBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,8" LineHeight="18">
                        Google Calendar 일정의 알림을 받으려면 Google 계정에 연결하세요.<LineBreak/>
                        <LineBreak/>
                        먼저 Google Cloud Console에서 발급받은 파일을<LineBreak/>
                        <Run FontFamily="Consolas" FontWeight="SemiBold">%AppData%\MyClock\google_credentials.json</Run>
                        <LineBreak/>으로 복사한 뒤 아래 버튼을 눌러 연결하세요.
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <Button x:Name="ConnectBtn" Content="Google 계정 연결"
                                Height="32" Padding="16,0"
                                Background="{DynamicResource AccentBrush}"
                                Foreground="{DynamicResource ActiveBtnFgBrush}"
                                FontWeight="SemiBold" FontSize="13"
                                Click="ConnectBtn_Click"/>
                        <TextBlock x:Name="ConnectStatusText"
                                   VerticalAlignment="Center" Margin="10,0,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource SubtleForegroundBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Connected -->
                <Grid x:Name="ConnectedPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" Fill="#4CAF50"
                                 VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock x:Name="EmailText" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="SyncBtn" Content="동기화"
                                Height="26" Padding="12,0" Margin="10,0,0,0" FontSize="12"
                                Background="{DynamicResource AccentBrush}"
                                Foreground="{DynamicResource ActiveBtnFgBrush}"
                                Click="SyncBtn_Click"/>
                        <Button Content="연결 해제"
                                Height="26" Padding="12,0" Margin="5,0,0,0" FontSize="12"
                                Click="DisconnectBtn_Click"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" x:Name="LastSyncText"
                               FontSize="11" Margin="16,5,0,0"
                               Foreground="{DynamicResource SubtleForegroundBrush}"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Events area -->
        <Grid Grid.Row="2" Margin="10,10,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="다가오는 일정 (14일 이내)"
                       FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource SubtleForegroundBrush}"
                       Margin="0,0,0,6"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="EmptyText"
                               HorizontalAlignment="Center" Margin="0,40,0,0"
                               FontSize="13"
                               Foreground="{DynamicResource SubtleForegroundBrush}"
                               Visibility="Collapsed"/>
                    <ItemsControl x:Name="EventList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,6" Padding="12,10"
                                        Background="{DynamicResource PanelBackgroundBrush}"
                                        CornerRadius="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource ForegroundBrush}"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding DisplayStart}"
                                                       FontSize="12" Margin="0,3,0,0"
                                                       Foreground="{DynamicResource AccentBrush}"/>
                                            <TextBlock FontSize="11" Margin="0,3,0,0"
                                                       Foreground="{DynamicResource SubtleForegroundBrush}">
                                                <Run Text="⏰ "/><Run Text="{Binding ReminderSummary}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
