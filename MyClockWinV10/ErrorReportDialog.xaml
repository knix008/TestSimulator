<Window x:Class="MyClockWinV10.ErrorReportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="오류 발생" Height="460" Width="580" MinHeight="360" MinWidth="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="None"
        Background="{DynamicResource WindowBackgroundBrush}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            CaptionHeight="0"
                            CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Background="{DynamicResource TabBackgroundBrush}"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <TextBlock Text="오류 발생" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource SubtleForegroundBrush}"
                       VerticalAlignment="Center" Margin="12,0,0,0"
                       shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            <Button Content="✕" Width="30" Height="22" FontSize="11"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"
                    Background="#C0392B" Foreground="White"
                    Click="Close_Click"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource PanelBackgroundBrush}" Margin="2,0,2,2">
            <Grid Margin="20,16,20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="SummaryText" Grid.Row="0"
                           TextWrapping="Wrap"
                           FontSize="14" LineHeight="22"
                           Foreground="{DynamicResource ForegroundBrush}"
                           Margin="0,0,0,12"/>

                <TextBox x:Name="DetailsText" Grid.Row="1"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="12"
                         Padding="10"
                         Background="{DynamicResource WindowBackgroundBrush}"
                         Foreground="{DynamicResource ForegroundBrush}"
                         BorderBrush="{DynamicResource BorderBrush}"
                         BorderThickness="1"/>

                <TextBlock x:Name="CopyStatusText" Grid.Row="2"
                           Margin="0,8,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource SubtleForegroundBrush}"
                           Visibility="Collapsed"/>

                <StackPanel Grid.Row="3" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button x:Name="CopyButton" Content="내용 복사" Width="100" Height="36" Margin="0,0,10,0"
                            Click="Copy_Click"/>
                    <Button Content="닫기" Width="88" Height="36"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="{DynamicResource ActiveBtnFgBrush}"
                            FontWeight="SemiBold"
                            IsDefault="True"
                            Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
