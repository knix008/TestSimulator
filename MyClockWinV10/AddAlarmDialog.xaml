<Window x:Class="MyClockWinV10.AddAlarmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="알람 추가" Height="280" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Border Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="12" Margin="2">
        <Grid Margin="28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="시간 설정" FontSize="13"
                       Foreground="{DynamicResource SubtleForegroundBrush}"/>
            <StackPanel Grid.Row="2" Orientation="Horizontal">
                <ComboBox x:Name="HourCombo" Width="90" Height="46"
                          FontSize="22" HorizontalContentAlignment="Center"/>
                <TextBlock Text=" : " FontSize="28" VerticalAlignment="Center"
                           Foreground="{DynamicResource ForegroundBrush}"/>
                <ComboBox x:Name="MinuteCombo" Width="90" Height="46"
                          FontSize="22" HorizontalContentAlignment="Center"/>
            </StackPanel>

            <TextBlock Grid.Row="4" Text="레이블 (선택)" FontSize="13"
                       Foreground="{DynamicResource SubtleForegroundBrush}"/>
            <TextBox Grid.Row="5" x:Name="LabelText" Height="42" Margin="0,8,0,0"
                     FontSize="15" VerticalContentAlignment="Center"
                     MaxLength="40"/>

            <StackPanel Grid.Row="6" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="취소" Width="90" Height="40" Margin="0,0,10,0"
                        Click="Cancel_Click"/>
                <Button Content="추가" Width="90" Height="40"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="{DynamicResource ActiveBtnFgBrush}"
                        FontWeight="SemiBold"
                        Click="OK_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
