<UserControl x:Class="MyClockWinV10.Controls.WorldTimePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MyClockWinV10.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button Grid.Row="0" Content="+ 도시 추가"
                Height="30" Width="90" HorizontalAlignment="Right"
                Margin="0,0,0,6"
                Background="{DynamicResource AccentBrush}"
                Foreground="{DynamicResource ActiveBtnFgBrush}"
                FontWeight="SemiBold" FontSize="12"
                Click="AddCity_Click"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="WorldTimeList" Margin="0,0,0,4">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,3" Padding="8,6"
                                Background="{DynamicResource PanelBackgroundBrush}"
                                CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Mini analog clock -->
                                <local:MiniAnalogClockControl Grid.Column="0"
                                    LocalTime="{Binding LocalDateTime}"
                                    Width="72" Height="72"
                                    Margin="0,0,10,0"/>

                                <!-- City / region -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding City}"
                                               FontSize="15" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBlock Text="{Binding Region}"
                                               FontSize="11"
                                               Foreground="{DynamicResource SubtleForegroundBrush}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Digital time -->
                                <TextBlock Grid.Column="2" Text="{Binding DisplayTime}"
                                           FontSize="20" FontWeight="Bold"
                                           Foreground="{DynamicResource DigitalTextBrush}"
                                           VerticalAlignment="Center"
                                           FontFamily="Consolas"
                                           Margin="6,0"/>

                                <!-- Delete -->
                                <Button Grid.Column="3" Content="✕"
                                        Width="26" Height="26" FontSize="11"
                                        Background="{DynamicResource DangerBrush}"
                                        Foreground="White"
                                        VerticalAlignment="Center"
                                        Click="DeleteCity_Click"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
