<UserControl x:Class="MyClockWinV10.Controls.WorldTimePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MyClockWinV10.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,0,0,6">
            <Button Content="기본 도시"
                    Height="30" MinWidth="72" Margin="0,0,6,0"
                    FontSize="12"
                    Click="ResetCities_Click"
                    ToolTip="도시 목록을 기본값으로 되돌립니다"/>
            <Button Content="+ 도시 추가"
                    Height="30" Width="90"
                    Background="{DynamicResource AccentBrush}"
                    Foreground="{DynamicResource ActiveBtnFgBrush}"
                    FontWeight="SemiBold" FontSize="12"
                    Click="AddCity_Click"/>
        </StackPanel>

        <ListBox Grid.Row="1" x:Name="WorldTimeList" Margin="0,0,0,4"
                     Background="Transparent" BorderThickness="0"
                     SelectionMode="Single"
                     AllowDrop="True"
                     VirtualizingPanel.IsVirtualizing="False"
                     ScrollViewer.CanContentScroll="False"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     PreviewMouseLeftButtonDown="Item_PreviewMouseLeftButtonDown"
                     PreviewMouseMove="Item_PreviewMouseMove"
                     DragOver="WorldTimeList_DragOver"
                     Drop="WorldTimeList_Drop">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,3"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="AllowDrop" Value="True"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ItemBd" Padding="0"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{DynamicResource AccentBrush}"
                                            BorderThickness="0"
                                            CornerRadius="8">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBd" Property="BorderThickness" Value="1"/>
                                            <Setter TargetName="ItemBd" Property="Opacity" Value="0.98"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <EventSetter Event="DragOver" Handler="Item_DragOver"/>
                        <EventSetter Event="Drop" Handler="Item_Drop"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="8,6"
                                Background="{DynamicResource PanelBackgroundBrush}"
                                CornerRadius="8"
                                Cursor="SizeAll"
                                ToolTip="드래그하여 순서 변경">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="⋮⋮"
                                           FontSize="14" FontWeight="Bold"
                                           Foreground="{DynamicResource SubtleForegroundBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"
                                           Opacity="0.55"/>

                                <local:MiniAnalogClockControl Grid.Column="1"
                                    LocalTime="{Binding LocalDateTime}"
                                    Width="72" Height="72"
                                    Margin="0,0,10,0"/>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding City}"
                                               FontSize="15" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBlock Text="{Binding Region}"
                                               FontSize="11"
                                               Foreground="{DynamicResource SubtleForegroundBrush}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>

                                <TextBlock Grid.Column="3" Text="{Binding DisplayTime}"
                                           FontSize="20" FontWeight="Bold"
                                           Foreground="{DynamicResource DigitalTextBrush}"
                                           VerticalAlignment="Center"
                                           FontFamily="Consolas"
                                           Margin="6,0"/>

                                <Button Grid.Column="4" Content="삭제"
                                        MinWidth="40" Height="26" FontSize="11" Padding="6,0"
                                        Background="{DynamicResource DangerBrush}"
                                        Foreground="White"
                                        VerticalAlignment="Center"
                                        Cursor="Hand"
                                        Tag="{Binding}"
                                        ToolTip="이 도시를 목록에서 제거"
                                        Click="DeleteCity_Click"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
