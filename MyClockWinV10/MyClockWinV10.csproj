<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>MyClockWinV10</AssemblyName>
    <RootNamespace>MyClockWinV10</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>AppIcon.ico</ApplicationIcon>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms assembly for NotifyIcon — referenced without UseWindowsForms
         so no WinForms implicit usings pollute the WPF namespace. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embed icon as WPF pack resource so it can be referenced in XAML Image -->
    <Resource Include="AppIcon.ico" />
  </ItemGroup>

  <!-- Visual Studio often builds only the startup project (F6), not the whole solution.
       Build the WiX Setup project after every Release build so MSI is always produced. -->
  <PropertyGroup>
    <SetupWixproj>$(MSBuildThisFileDirectory)Setup\Setup.wixproj</SetupWixproj>
    <SetupMsiPath>$(MSBuildThisFileDirectory)Setup\bin\x64\Release\MyClockWinV10-Setup.msi</SetupMsiPath>
  </PropertyGroup>

  <Target Name="BuildInstallerPackage"
          AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release' and Exists('$(SetupWixproj)')">
    <MSBuild Projects="$(SetupWixproj)"
             Properties="Configuration=Release;Platform=x64;BuildProjectReferences=false"
             Targets="Build" />
    <Copy SourceFiles="$(SetupMsiPath)"
          DestinationFiles="$(OutputPath)MyClockWinV10-Setup.msi"
          SkipUnchangedFiles="true"
          Condition="Exists('$(SetupMsiPath)')" />
    <Message Importance="high"
             Text="MSI: $(OutputPath)MyClockWinV10-Setup.msi (also $(SetupMsiPath))"
             Condition="Exists('$(SetupMsiPath)')" />
  </Target>

</Project>
