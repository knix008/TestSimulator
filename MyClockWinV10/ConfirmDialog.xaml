<Window x:Class="MyClockWinV10.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="확인" Height="200" Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="{DynamicResource WindowBackgroundBrush}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome GlassFrameThickness="0"
                            ResizeBorderThickness="0"
                            CaptionHeight="0"
                            CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Background="{DynamicResource TabBackgroundBrush}"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <TextBlock x:Name="TitleText" Text="확인" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource SubtleForegroundBrush}"
                       VerticalAlignment="Center" Margin="12,0,0,0"
                       shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            <Button Content="✕" Width="30" Height="22" FontSize="11"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"
                    Background="#C0392B" Foreground="White"
                    Click="No_Click"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource PanelBackgroundBrush}" Margin="2,0,2,2">
            <Grid Margin="24,20,24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="MessageText" Grid.Row="0"
                           TextWrapping="Wrap"
                           FontSize="14" LineHeight="22"
                           Foreground="{DynamicResource ForegroundBrush}"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button Content="아니오" Width="88" Height="38" Margin="0,0,10,0"
                            Click="No_Click"/>
                    <Button Content="예" Width="88" Height="38"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="{DynamicResource ActiveBtnFgBrush}"
                            FontWeight="SemiBold"
                            IsDefault="True"
                            Click="Yes_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
