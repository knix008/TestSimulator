<Window x:Class="MyClockWinV10.AddWorldTimeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="도시 추가" Height="310" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Border Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="12" Margin="2">
        <Grid Margin="28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 도시 이름 -->
            <TextBlock Grid.Row="0" Text="도시 이름" FontSize="13"
                       Foreground="{DynamicResource SubtleForegroundBrush}"/>
            <Grid Grid.Row="2">
                <TextBox x:Name="CityBox" Height="36" FontSize="14"
                         VerticalContentAlignment="Center" MaxLength="40"
                         TextChanged="CityBox_TextChanged"
                         LostFocus="CityBox_LostFocus"
                         PreviewKeyDown="CityBox_PreviewKeyDown"/>
                <Popup x:Name="CityPopup"
                       PlacementTarget="{Binding ElementName=CityBox}"
                       Placement="Bottom" StaysOpen="False"
                       Width="{Binding ActualWidth, ElementName=CityBox}">
                    <Border Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1">
                        <ListBox x:Name="CityList"
                                 MaxHeight="200"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 SelectionChanged="CityList_SelectionChanged"
                                 PreviewMouseLeftButtonDown="CityList_PreviewMouseDown">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                                    <Setter Property="Padding" Value="10,5"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background"
                                                                Value="{DynamicResource AccentBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background"
                                                                Value="{DynamicResource AccentBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2">
                                        <TextBlock Text="{Binding City}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ForegroundBrush}"/>
                                        <TextBlock Text="{Binding Country}" FontSize="11"
                                                   Foreground="{DynamicResource SubtleForegroundBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Popup>
            </Grid>

            <!-- 지역 / 국가 -->
            <TextBlock Grid.Row="4" Text="지역 / 국가" FontSize="13"
                       Foreground="{DynamicResource SubtleForegroundBrush}"/>
            <Grid Grid.Row="6">
                <TextBox x:Name="RegionBox" Height="36" FontSize="14"
                         VerticalContentAlignment="Center" MaxLength="40"
                         TextChanged="RegionBox_TextChanged"
                         LostFocus="RegionBox_LostFocus"
                         PreviewKeyDown="RegionBox_PreviewKeyDown"/>
                <Popup x:Name="RegionPopup"
                       PlacementTarget="{Binding ElementName=RegionBox}"
                       Placement="Bottom" StaysOpen="False"
                       Width="{Binding ActualWidth, ElementName=RegionBox}">
                    <Border Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1">
                        <ListBox x:Name="RegionList"
                                 MaxHeight="160"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 SelectionChanged="RegionList_SelectionChanged"
                                 PreviewMouseLeftButtonDown="RegionList_PreviewMouseDown">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                                    <Setter Property="Padding" Value="10,6"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background"
                                                                Value="{DynamicResource AccentBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background"
                                                                Value="{DynamicResource AccentBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Border>
                </Popup>
            </Grid>

            <!-- 시간대 + 버튼 -->
            <Grid Grid.Row="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="시간대" FontSize="13"
                           Foreground="{DynamicResource SubtleForegroundBrush}"/>
                <ComboBox Grid.Row="2" x:Name="TzCombo" Height="36" FontSize="12"
                          DisplayMemberPath="DisplayName"/>
                <StackPanel Grid.Row="4" Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="취소" Width="90" Height="38" Margin="0,0,10,0"
                            Click="Cancel_Click"/>
                    <Button Content="추가" Width="90" Height="38"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="{DynamicResource ActiveBtnFgBrush}"
                            FontWeight="SemiBold"
                            Click="Add_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
