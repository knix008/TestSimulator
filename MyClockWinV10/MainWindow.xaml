<Window x:Class="MyClockWinV10.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:MyClockWinV10.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="MyClock"
        Icon="AppIcon.ico"
        Height="300" Width="300"
        MinHeight="300" MinWidth="300"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        StateChanged="Window_StateChanged">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome GlassFrameThickness="0"
                            ResizeBorderThickness="5"
                            CaptionHeight="0"
                            CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Caption / drag bar -->
        <Grid Grid.Row="0"
              Background="{DynamicResource TabBackgroundBrush}"
              MouseLeftButtonDown="Caption_MouseLeftButtonDown">

            <!-- Left: icon + title -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Image Source="AppIcon.ico" Width="16" Height="16" Margin="0,0,6,0"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="MyClock" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource SubtleForegroundBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Right: mode toggle + panel toggle | window controls -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,6,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">

                <!-- Clock mode toggle (digital ↔ analog) -->
                <Button x:Name="ClockModeBtn" Width="28" Height="22"
                        Click="ClockModeBtn_Click" ToolTip="아날로그로 전환">
                    <Viewbox Width="14" Height="14" Stretch="Uniform">
                        <Canvas Width="16" Height="16">
                            <!-- Digital-mode icon: 7-segment "8" -->
                            <Canvas x:Name="IconDigital">
                                <!-- a: top -->
                                <Rectangle Canvas.Left="3.5" Canvas.Top="0.5" Width="9" Height="2"
                                           Fill="{DynamicResource SubtleForegroundBrush}"/>
                                <!-- f: top-left -->
                                <Rectangle Canvas.Left="1" Canvas.Top="2.5" Width="2" Height="4.5"
                                           Fill="{DynamicResource SubtleForegroundBrush}"/>
                                <!-- b: top-right -->
                                <Rectangle Canvas.Left="13" Canvas.Top="2.5" Width="2" Height="4.5"
                                           Fill="{DynamicResource SubtleForegroundBrush}"/>
                                <!-- g: middle -->
                                <Rectangle Canvas.Left="3.5" Canvas.Top="7" Width="9" Height="2"
                                           Fill="{DynamicResource SubtleForegroundBrush}"/>
                                <!-- e: bottom-left -->
                                <Rectangle Canvas.Left="1" Canvas.Top="9" Width="2" Height="4.5"
                                           Fill="{DynamicResource SubtleForegroundBrush}"/>
                                <!-- c: bottom-right -->
                                <Rectangle Canvas.Left="13" Canvas.Top="9" Width="2" Height="4.5"
                                           Fill="{DynamicResource SubtleForegroundBrush}"/>
                                <!-- d: bottom -->
                                <Rectangle Canvas.Left="3.5" Canvas.Top="13.5" Width="9" Height="2"
                                           Fill="{DynamicResource SubtleForegroundBrush}"/>
                            </Canvas>
                            <!-- Analog-mode icon: clock face + hands -->
                            <Ellipse x:Name="IconAnalog"
                                     Canvas.Left="1" Canvas.Top="1" Width="14" Height="14"
                                     Stroke="{DynamicResource SubtleForegroundBrush}"
                                     StrokeThickness="1.5" Fill="Transparent"
                                     Visibility="Collapsed"/>
                            <Line x:Name="IconHour"
                                  X1="8" Y1="8" X2="8" Y2="3.5"
                                  Stroke="{DynamicResource SubtleForegroundBrush}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Visibility="Collapsed"/>
                            <Line x:Name="IconMin"
                                  X1="8" Y1="8" X2="12.5" Y2="10.5"
                                  Stroke="{DynamicResource SubtleForegroundBrush}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Visibility="Collapsed"/>
                        </Canvas>
                    </Viewbox>
                </Button>

                <!-- Separator -->
                <Rectangle Width="1" Height="16" Margin="6,0"
                           Fill="{DynamicResource SubtleForegroundBrush}" Opacity="0.25"/>

                <!-- Window controls -->
                <Button Content="─" Width="30" Height="22" FontSize="11"
                        Click="MinBtn_Click" ToolTip="최소화"/>
                <Button Content="□" Width="30" Height="22" FontSize="11"
                        Click="MaxBtn_Click" ToolTip="최대화" Margin="2,0"/>
                <Button Content="✕" Width="30" Height="22" FontSize="11"
                        Background="#C0392B" Foreground="White"
                        Click="CloseBtn_Click" ToolTip="닫기"/>
            </StackPanel>
        </Grid>

        <!-- Date -->
        <TextBlock Grid.Row="1" x:Name="HeaderDateText"
                   FontSize="14" Foreground="{DynamicResource SubtleForegroundBrush}"
                   HorizontalAlignment="Center" Margin="0,6,0,0"/>

        <!-- Clock area -->
        <Grid Grid.Row="2" Margin="18,4,18,0">
            <Grid x:Name="DigitalPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- 7-Segment style -->
                <TextBlock Grid.Row="0" x:Name="AmPmText"
                           FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}"
                           HorizontalAlignment="Center"/>
                <ctrl:SevenSegmentDisplay Grid.Row="1" x:Name="SevenSeg"
                                          SegColor="{DynamicResource DigitalTextBrush}"
                                          DimColor="{DynamicResource SegDimBrush}"
                                          Visibility="Visible"/>
                <ctrl:DotMatrixDisplay Grid.Row="1" x:Name="DotMatrixClock"
                                        DotColor="{DynamicResource DigitalTextBrush}"
                                        DimColor="{DynamicResource SegDimBrush}"
                                        Visibility="Collapsed"/>
                <!-- LcdText / Minimal style -->
                <Viewbox x:Name="TextClockBox" Grid.Row="0" Grid.RowSpan="2"
                         Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Visibility="Collapsed">
                    <StackPanel Margin="4" HorizontalAlignment="Center">
                        <TextBlock x:Name="TextAmPm" HorizontalAlignment="Center"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock x:Name="TextTime" HorizontalAlignment="Center"
                                   FontSize="60" FontWeight="Bold" FontFamily="Consolas"
                                   Foreground="{DynamicResource DigitalTextBrush}"/>
                    </StackPanel>
                </Viewbox>
            </Grid>

            <ctrl:AnalogClockControl x:Name="AnalogClock"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      Visibility="Collapsed"/>
        </Grid>

        <!-- Bottom: analog time text + panel toggle -->
        <Grid Grid.Row="3" Margin="4,2,4,8">
            <TextBlock x:Name="ClockStatusText"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource SubtleForegroundBrush}"
                       FontFamily="Consolas" FontSize="14"/>
            <Button x:Name="PanelToggleBtn" Content="▶"
                    Width="28" Height="22" FontSize="11"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Click="PanelToggle_Click" ToolTip="설정 패널"/>
        </Grid>
    </Grid>
</Window>
