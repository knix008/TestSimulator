<Window x:Class="MyClockWinV10.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:MyClockWinV10.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="MyClock"
        Icon="AppIcon.ico"
        Height="300" Width="300"
        MinWidth="140" MinHeight="50"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        Background="Transparent"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        StateChanged="Window_StateChanged"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
        PreviewMouseRightButtonDown="Window_PreviewMouseRightButtonDown"
        MouseMove="Window_MouseMove"
        PreviewMouseLeftButtonUp="Window_PreviewMouseLeftButtonUp">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome GlassFrameThickness="0"
                            ResizeBorderThickness="5"
                            CaptionHeight="0"
                            CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid"
          Background="#01000000">

        <Grid x:Name="ClockSizer"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <Grid x:Name="DigitalPanel"
                  Background="Transparent"
                  VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" x:Name="AmPmText"
                           FontSize="22" FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,2"/>
                <ctrl:SevenSegmentDisplay Grid.Row="1" x:Name="SevenSeg"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          SegColor="{DynamicResource DigitalTextBrush}"
                                          DimColor="{DynamicResource SegDimBrush}"
                                          Visibility="Visible"/>
                <ctrl:DotMatrixDisplay Grid.Row="1" x:Name="DotMatrixClock"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        DotColor="{DynamicResource DigitalTextBrush}"
                                        DimColor="{DynamicResource SegDimBrush}"
                                        Visibility="Collapsed"/>
                <Viewbox x:Name="TextClockBox" Grid.Row="0" Grid.RowSpan="2"
                         Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="TextAmPm" HorizontalAlignment="Center"
                                   FontSize="20" FontWeight="Bold"
                                   Margin="0,0,0,2"/>
                        <TextBlock x:Name="TextTime" HorizontalAlignment="Center"
                                   FontSize="60" FontWeight="Bold" FontFamily="Consolas"
                                   Foreground="{DynamicResource DigitalTextBrush}"/>
                    </StackPanel>
                </Viewbox>
            </Grid>

            <ctrl:AnalogClockControl x:Name="AnalogClock"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      Visibility="Collapsed"/>

            <Canvas x:Name="OverlayCanvas"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    IsHitTestVisible="False">
                <Border x:Name="WindowBackgroundLayer"
                        Visibility="Collapsed"
                        IsHitTestVisible="False"/>
                <TextBlock x:Name="HeaderDateText"
                           FontSize="14"
                           Foreground="{DynamicResource SubtleForegroundBrush}"
                           TextAlignment="Center"
                           Visibility="Collapsed"
                           IsHitTestVisible="False"/>
                <TextBlock x:Name="ClockStatusText"
                           Foreground="{DynamicResource SubtleForegroundBrush}"
                           FontFamily="Consolas"
                           FontSize="14"
                           TextAlignment="Center"
                           Visibility="Collapsed"
                           IsHitTestVisible="False"/>
                <Border x:Name="ResizeHoverOutline"
                        Visibility="Collapsed"
                        IsHitTestVisible="False"
                        BorderBrush="{DynamicResource SubtleForegroundBrush}"
                        BorderThickness="1"
                        Opacity="0.4"/>
                <Canvas x:Name="ResizeGripVisual"
                        Visibility="Collapsed"
                        IsHitTestVisible="False"
                        Width="16" Height="16">
                    <Line X1="8"  Y1="16" X2="16" Y2="8"
                          Stroke="{DynamicResource SubtleForegroundBrush}"
                          StrokeThickness="1.3" Opacity="0.7"/>
                    <Line X1="4"  Y1="16" X2="16" Y2="4"
                          Stroke="{DynamicResource SubtleForegroundBrush}"
                          StrokeThickness="1.3" Opacity="0.85"/>
                    <Line X1="0"  Y1="16" X2="16" Y2="0"
                          Stroke="{DynamicResource SubtleForegroundBrush}"
                          StrokeThickness="1.3"/>
                </Canvas>
            </Canvas>
        </Grid>
    </Grid>
</Window>
