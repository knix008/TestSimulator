<Window x:Class="MyClockWinV10.SidePanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:MyClockWinV10.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="MyClock"
        Width="1" MinWidth="0"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Window.Resources>
        <Style x:Key="SidePanelTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource SubtleForegroundBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="{DynamicResource TabBackgroundBrush}"
                                Padding="{TemplateBinding Padding}">
                            <Border x:Name="Indicator" BorderThickness="0,0,0,3"
                                    BorderBrush="Transparent">
                                <ContentPresenter ContentSource="Header"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  TextBlock.Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource TabSelectedBrush}"/>
                                <Setter TargetName="Indicator" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource ForegroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidePanelTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="TabStripPlacement" Value="Top"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource SidePanelTabItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="{DynamicResource TabBackgroundBrush}">
                                <TabPanel IsItemsHost="True"
                                          HorizontalAlignment="Stretch"
                                          Margin="4,0"/>
                            </Border>
                            <Border Grid.Row="1" Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome GlassFrameThickness="0"
                            ResizeBorderThickness="0"
                            CaptionHeight="0"
                            CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <!-- Separator on the edge facing the main clock window -->
    <Border x:Name="PanelChromeBorder"
            BorderBrush="{DynamicResource TabBackgroundBrush}" BorderThickness="1,0,0,0">
        <TabControl x:Name="SettingsTabControl" Style="{StaticResource SidePanelTabControlStyle}">

            <!-- 세계 시간 -->
            <TabItem Header="세계 시간">
                <Grid Margin="10,6,10,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" x:Name="WorldHeaderText"
                               FontSize="11" Foreground="{DynamicResource SubtleForegroundBrush}"
                               HorizontalAlignment="Right" Margin="0,0,0,4"/>
                    <ctrl:WorldTimePanel x:Name="WorldPanel" Grid.Row="1"/>
                </Grid>
            </TabItem>

            <!-- 알람 -->
            <TabItem Header="알람">
                <Grid Margin="10,6,10,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock Text="알람" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   VerticalAlignment="Center"/>
                        <Button Content="+ 추가" Height="30" Width="72"
                                HorizontalAlignment="Right"
                                Background="{DynamicResource AccentBrush}"
                                Foreground="{DynamicResource ActiveBtnFgBrush}"
                                FontWeight="SemiBold" FontSize="13"
                                Click="AddAlarm_Click"/>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="AlarmList" HorizontalContentAlignment="Stretch">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,2" Padding="8,8"
                                            Background="{DynamicResource PanelBackgroundBrush}"
                                            CornerRadius="6">
                                        <StackPanel>
                                            <!-- time + repeat badge + controls -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding DisplayTime}"
                                                           FontSize="22" FontWeight="Bold"
                                                           FontFamily="Consolas"
                                                           Foreground="{DynamicResource DigitalTextBrush}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding RepeatSummary}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource SubtleForegroundBrush}"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Margin="4,0,4,0"/>
                                                <CheckBox Grid.Column="2"
                                                          IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                          Style="{StaticResource ToggleSwitchStyle}"
                                                          VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <Button Grid.Column="3" Content="편집"
                                                        Width="40" Height="26" FontSize="12"
                                                        VerticalAlignment="Center" Margin="0,0,4,0"
                                                        Click="EditAlarm_Click"/>
                                                <Button Grid.Column="4" Content="삭제"
                                                        Width="40" Height="26" FontSize="12"
                                                        Background="{DynamicResource DangerBrush}"
                                                        Foreground="White"
                                                        VerticalAlignment="Center"
                                                        Click="DeleteAlarm_Click"/>
                                            </Grid>
                                            <!-- label row -->
                                            <TextBlock Text="{Binding Label}"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource ForegroundBrush}"
                                                       Margin="2,4,0,0"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- 타이머 -->
            <TabItem Header="타이머">
                <Grid Margin="10,6,10,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header: title + add button -->
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock Text="타이머" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   VerticalAlignment="Center"/>
                        <Button Content="+ 추가" Height="30" Width="72"
                                HorizontalAlignment="Right"
                                Background="{DynamicResource AccentBrush}"
                                Foreground="{DynamicResource ActiveBtnFgBrush}"
                                FontWeight="SemiBold" FontSize="13"
                                Click="AddTimer_Click"/>
                    </Grid>

                    <!-- Timer list -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="TimerList" HorizontalContentAlignment="Stretch">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,2" Padding="10,8"
                                            Background="{DynamicResource PanelBackgroundBrush}"
                                            CornerRadius="6">
                                        <StackPanel>

                                            <!-- Remaining time + delete button -->
                                            <Grid Margin="0,0,0,6">
                                                <TextBlock Text="{Binding DisplayRemaining}"
                                                           FontSize="28" FontWeight="Bold" FontFamily="Consolas"
                                                           Foreground="{DynamicResource DigitalTextBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Button Content="×" Width="26" Height="22" FontSize="14"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Background="{DynamicResource DangerBrush}" Foreground="White"
                                                        Click="DeleteTimer_Click"/>
                                            </Grid>

                                            <!-- Duration spinners: H : M : S -->
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Hours -->
                                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                                    <TextBlock Text="시" FontSize="11"
                                                               Foreground="{DynamicResource SubtleForegroundBrush}"
                                                               HorizontalAlignment="Center"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                        <Button Content="−" Width="28" Height="28" FontSize="14"
                                                                Click="TimerHoursDown_Click"
                                                                IsEnabled="{Binding IsIdle}"/>
                                                        <TextBlock Text="{Binding HoursText}" Width="30"
                                                                   FontSize="18" FontWeight="Bold" FontFamily="Consolas"
                                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                                   TextAlignment="Center" VerticalAlignment="Center"/>
                                                        <Button Content="+" Width="28" Height="28" FontSize="14"
                                                                Click="TimerHoursUp_Click"
                                                                IsEnabled="{Binding IsIdle}"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <TextBlock Grid.Column="1" Text=":" FontSize="18" FontWeight="Bold"
                                                           Foreground="{DynamicResource SubtleForegroundBrush}"
                                                           VerticalAlignment="Bottom" Margin="2,0,2,2"/>

                                                <!-- Minutes -->
                                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                                    <TextBlock Text="분" FontSize="11"
                                                               Foreground="{DynamicResource SubtleForegroundBrush}"
                                                               HorizontalAlignment="Center"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                        <Button Content="−" Width="28" Height="28" FontSize="14"
                                                                Click="TimerMinutesDown_Click"
                                                                IsEnabled="{Binding IsIdle}"/>
                                                        <TextBlock Text="{Binding MinutesText}" Width="30"
                                                                   FontSize="18" FontWeight="Bold" FontFamily="Consolas"
                                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                                   TextAlignment="Center" VerticalAlignment="Center"/>
                                                        <Button Content="+" Width="28" Height="28" FontSize="14"
                                                                Click="TimerMinutesUp_Click"
                                                                IsEnabled="{Binding IsIdle}"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <TextBlock Grid.Column="3" Text=":" FontSize="18" FontWeight="Bold"
                                                           Foreground="{DynamicResource SubtleForegroundBrush}"
                                                           VerticalAlignment="Bottom" Margin="2,0,2,2"/>

                                                <!-- Seconds -->
                                                <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                                    <TextBlock Text="초" FontSize="11"
                                                               Foreground="{DynamicResource SubtleForegroundBrush}"
                                                               HorizontalAlignment="Center"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                        <Button Content="−" Width="28" Height="28" FontSize="14"
                                                                Click="TimerSecondsDown_Click"
                                                                IsEnabled="{Binding IsIdle}"/>
                                                        <TextBlock Text="{Binding SecondsText}" Width="30"
                                                                   FontSize="18" FontWeight="Bold" FontFamily="Consolas"
                                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                                   TextAlignment="Center" VerticalAlignment="Center"/>
                                                        <Button Content="+" Width="28" Height="28" FontSize="14"
                                                                Click="TimerSecondsUp_Click"
                                                                IsEnabled="{Binding IsIdle}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Control buttons -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="{Binding StartLabel}"
                                                        Width="82" Height="34" FontSize="13" FontWeight="SemiBold"
                                                        Margin="0,0,5,0"
                                                        Background="{DynamicResource AccentBrush}"
                                                        Foreground="{DynamicResource ActiveBtnFgBrush}"
                                                        IsEnabled="{Binding CanStart}"
                                                        Click="TimerStart_Click"/>
                                                <Button Content="일시정지"
                                                        Width="82" Height="34" FontSize="13"
                                                        Margin="0,0,5,0"
                                                        IsEnabled="{Binding IsRunning}"
                                                        Click="TimerPause_Click"/>
                                                <Button Content="정지"
                                                        Width="60" Height="34" FontSize="13"
                                                        Background="{DynamicResource DangerBrush}" Foreground="White"
                                                        IsEnabled="{Binding CanStop}"
                                                        Click="TimerStop_Click"/>
                                            </StackPanel>

                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- 설정 -->
            <TabItem Header="설정">
                <ScrollViewer Margin="10,6,10,10" VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- 알람음 -->
                        <TextBlock Text="알람 / 타이머 종료음" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SubtleForegroundBrush}"
                                   Margin="0,0,0,5"/>
                        <Border Background="{DynamicResource PanelBackgroundBrush}"
                                CornerRadius="6" Padding="12,10" Margin="0,0,0,14">
                            <StackPanel>
                                <ComboBox x:Name="AlarmSoundCombo" FontSize="13"
                                          SelectionChanged="AlarmSoundCombo_Changed"/>
                                <Grid Margin="0,10,0,0">
                                    <TextBlock Text="볼륨" FontSize="13"
                                               Foreground="{DynamicResource ForegroundBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="AlarmVolumeLabel" Text="50 %"
                                               FontSize="11"
                                               Foreground="{DynamicResource SubtleForegroundBrush}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Slider x:Name="AlarmVolumeSlider"
                                        Minimum="0" Maximum="100" Value="50"
                                        Margin="0,6,0,0"
                                        ValueChanged="AlarmVolume_Changed"/>
                                <Button Content="미리듣기" Height="32" FontSize="13"
                                        Margin="0,8,0,0"
                                        Click="PreviewAlarmSound_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- 시간 형식 -->
                        <TextBlock Text="시간 형식" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SubtleForegroundBrush}"
                                   Margin="0,0,0,5"/>
                        <Border Background="{DynamicResource PanelBackgroundBrush}"
                                CornerRadius="6" Padding="12,9" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="Format12h" Content="12시간 (오전/오후)"
                                             GroupName="Fmt" IsChecked="True"
                                             Checked="Format_Checked" FontSize="13"/>
                                <RadioButton x:Name="Format24h" Content="24시간"
                                             GroupName="Fmt" Checked="Format_Checked" FontSize="13"/>
                            </StackPanel>
                        </Border>

                        <!-- 테마 -->
                        <TextBlock Text="테마" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SubtleForegroundBrush}"
                                   Margin="0,0,0,5"/>
                        <Border Background="{DynamicResource PanelBackgroundBrush}"
                                CornerRadius="6" Padding="10,10" Margin="0,0,0,14">
                            <WrapPanel>
                                <Button Tag="DarkTheme"   Content="다크"      Width="78" Height="32" Margin="0,0,5,5" Click="Theme_Click"/>
                                <Button Tag="LightTheme"  Content="라이트"    Width="78" Height="32" Margin="0,0,5,5" Click="Theme_Click"/>
                                <Button Tag="BlueTheme"   Content="미드나이트" Width="78" Height="32" Margin="0,0,5,5" Click="Theme_Click"/>
                                <Button Tag="OceanTheme"  Content="오션"      Width="78" Height="32" Margin="0,0,5,5" Click="Theme_Click"/>
                                <Button Tag="RedTheme"    Content="루비"      Width="78" Height="32" Margin="0,0,5,5" Click="Theme_Click"/>
                                <Button Tag="GreenTheme"  Content="에메랄드"  Width="78" Height="32" Margin="0,0,5,5" Click="Theme_Click"/>
                                <Button Tag="PurpleTheme" Content="퍼플"      Width="78" Height="32" Margin="0,0,5,5" Click="Theme_Click"/>
                                <Button Tag="AmberTheme"  Content="앰버"      Width="78" Height="32" Margin="0,0,5,5" Click="Theme_Click"/>
                                <Button Tag="RoseTheme"   Content="로즈"      Width="78" Height="32" Margin="0,0,5,5" Click="Theme_Click"/>
                                <Button Tag="MonoTheme"   Content="모노"      Width="78" Height="32" Margin="0,0,5,5" Click="Theme_Click"/>
                                <Button Tag="SunsetTheme" Content="선셋"      Width="78" Height="32" Margin="0,0,5,5" Click="Theme_Click"/>
                                <Button Tag="MintTheme"   Content="민트"      Width="78" Height="32" Margin="0,0,5,5" Click="Theme_Click"/>
                            </WrapPanel>
                        </Border>

                        <!-- 디지털 숫자 밝기 -->
                        <TextBlock Text="디지털 숫자 밝기" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SubtleForegroundBrush}"
                                   Margin="0,0,0,5"/>
                        <Border Background="{DynamicResource PanelBackgroundBrush}"
                                CornerRadius="6" Padding="12,10" Margin="0,0,0,14">
                            <StackPanel>
                                <Slider x:Name="BrightnessSlider"
                                        Minimum="0" Maximum="100" Value="50"
                                        SmallChange="1" LargeChange="10"
                                        TickPlacement="BottomRight" TickFrequency="10"
                                        IsSnapToTickEnabled="False"
                                        Loaded="BrightnessSlider_Layout"
                                        SizeChanged="BrightnessSlider_Layout"
                                        ValueChanged="Brightness_Changed"/>
                                <Canvas x:Name="BrightnessScaleCanvas"
                                        Height="14" Margin="0,2,0,0"/>
                                <TextBlock x:Name="BrightnessLabel"
                                           Text="50 %" FontSize="11"
                                           Foreground="{DynamicResource SubtleForegroundBrush}"
                                           HorizontalAlignment="Right" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- 디지털 숫자 색상 -->
                        <TextBlock Text="디지털 숫자 색상" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SubtleForegroundBrush}"
                                   Margin="0,0,0,5"/>
                        <Border Background="{DynamicResource PanelBackgroundBrush}"
                                CornerRadius="6" Padding="10,10" Margin="0,0,0,14">
                            <WrapPanel x:Name="ColorSwatches"/>
                        </Border>

                        <!-- 디지털 스타일 -->
                        <TextBlock Text="디지털 스타일" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SubtleForegroundBrush}"
                                   Margin="0,0,0,5"/>
                        <Border Background="{DynamicResource PanelBackgroundBrush}"
                                CornerRadius="6" Padding="10,10" Margin="0,0,0,14">
                            <WrapPanel x:Name="DigitalStylePanel"/>
                        </Border>

                        <!-- 아날로그 스타일 -->
                        <TextBlock Text="아날로그 스타일" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SubtleForegroundBrush}"
                                   Margin="0,0,0,5"/>
                        <Border Background="{DynamicResource PanelBackgroundBrush}"
                                CornerRadius="6" Padding="10,10" Margin="0,0,0,14">
                            <WrapPanel x:Name="AnalogStylePanel"/>
                        </Border>

                        <!-- 세계 시간 형식 -->
                        <TextBlock Text="세계 시간 형식" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SubtleForegroundBrush}"
                                   Margin="0,0,0,5"/>
                        <Border Background="{DynamicResource PanelBackgroundBrush}"
                                CornerRadius="6" Padding="12,9" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="WorldFormat12h" Content="12시간 (오전/오후)"
                                             GroupName="WFmt" IsChecked="True"
                                             Checked="WorldFormat_Checked" FontSize="13"/>
                                <RadioButton x:Name="WorldFormat24h" Content="24시간"
                                             GroupName="WFmt"
                                             Checked="WorldFormat_Checked" FontSize="13"/>
                            </StackPanel>
                        </Border>

                        <!-- 시스템 -->
                        <TextBlock Text="시스템" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SubtleForegroundBrush}"
                                   Margin="0,0,0,5"/>
                        <Border Background="{DynamicResource PanelBackgroundBrush}"
                                CornerRadius="6" Padding="12,9" Margin="0,0,0,14">
                            <Grid>
                                <TextBlock Text="시작 시 자동 실행" FontSize="13"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           VerticalAlignment="Center"/>
                                <CheckBox x:Name="StartupToggle"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Checked="Startup_Changed" Unchecked="Startup_Changed"/>
                            </Grid>
                        </Border>

                        <!-- 초기화 -->
                        <Button Content="기본값으로 초기화"
                                Height="36" FontSize="13"
                                Background="{DynamicResource DangerBrush}"
                                Foreground="White"
                                Click="Reset_Click"/>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Border>
</Window>
