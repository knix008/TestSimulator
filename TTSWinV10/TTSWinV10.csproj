<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net481</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWinFormsOutOfProcDesigner>true</UseWinFormsOutOfProcDesigner>
    <ApplicationIcon>$(MSBuildProjectDirectory)\daemon_hammer.ico</ApplicationIcon>
    <RootNamespace>TTSWinV10</RootNamespace>
    <AssemblyName>TTSWinV10</AssemblyName>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.22621.2428" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="System.Resources.Extensions" Version="8.0.0" />
    <PackageReference Include="System.Runtime.WindowsRuntime" Version="4.7.0" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Speech" />
  </ItemGroup>
  <ItemGroup>
    <None Include="daemon_hammer.ico" />
    <Content Include="daemon_hammer.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\play.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\stop.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Compile Update="MainForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="MainForm.Designer.cs">
      <DependentUpon>MainForm.cs</DependentUpon>
    </Compile>
  </ItemGroup>

  <!-- Visual Studio에서 Release로 앱만 빌드할 때도 WiX MSI가 빌드되도록 (설치 프로젝트는 별도 로드/체크가 필요할 수 있음) -->
  <PropertyGroup>
    <InstallerWixProj>$(MSBuildThisFileDirectory)TTSWinV10.Installer\TTSWinV10.Installer.wixproj</InstallerWixProj>
  </PropertyGroup>

  <Target Name="BuildInstallerMsiAfterRelease"
          AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release'
                      and '$(BuildingForInstaller)' != 'true'
                      and '$(DesignTimeBuild)' != 'true'
                      and Exists('$(InstallerWixProj)')">
    <MSBuild Projects="$(InstallerWixProj)"
             Targets="Build"
             Properties="Configuration=Release;Platform=x64" />
  </Target>
</Project>
