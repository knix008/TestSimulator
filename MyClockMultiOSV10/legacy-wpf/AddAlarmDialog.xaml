<Window x:Class="MyClockWinV10.AddAlarmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="알람 추가" Height="400" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="{DynamicResource WindowBackgroundBrush}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome GlassFrameThickness="0"
                            ResizeBorderThickness="0"
                            CaptionHeight="0"
                            CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Grid Grid.Row="0"
              Background="{DynamicResource TabBackgroundBrush}"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <TextBlock x:Name="TitleText" Text="알람 추가" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource SubtleForegroundBrush}"
                       VerticalAlignment="Center" Margin="12,0,0,0"
                       shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            <Button Content="✕" Width="30" Height="22" FontSize="11"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"
                    Background="#C0392B" Foreground="White"
                    Click="Cancel_Click"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
        </Grid>

        <!-- Content -->
        <Border Grid.Row="1" Background="{DynamicResource PanelBackgroundBrush}"
                CornerRadius="0,0,8,8" Margin="2,0,2,2">
            <Grid Margin="28,20,28,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- 0  시간 -->
                    <RowDefinition Height="12"/>     <!-- 1 -->
                    <RowDefinition Height="Auto"/>   <!-- 2  time combos -->
                    <RowDefinition Height="20"/>     <!-- 3 -->
                    <RowDefinition Height="Auto"/>   <!-- 4  반복 section -->
                    <RowDefinition Height="Auto"/>   <!-- 5  day pills (collapsed when 한번) -->
                    <RowDefinition Height="20"/>     <!-- 6 -->
                    <RowDefinition Height="Auto"/>   <!-- 7  레이블 -->
                    <RowDefinition Height="8"/>      <!-- 8 -->
                    <RowDefinition Height="Auto"/>   <!-- 9  TextBox -->
                    <RowDefinition Height="*"/>      <!-- 10 flex -->
                    <RowDefinition Height="Auto"/>   <!-- 11 buttons -->
                </Grid.RowDefinitions>

                <!-- 시간 -->
                <TextBlock Grid.Row="0" Text="시간" FontSize="13"
                           Foreground="{DynamicResource SubtleForegroundBrush}"/>
                <StackPanel Grid.Row="2" Orientation="Horizontal">
                    <ComboBox x:Name="HourCombo" Width="90" Height="46"
                              FontSize="22" HorizontalContentAlignment="Center"/>
                    <TextBlock Text=" : " FontSize="28" VerticalAlignment="Center"
                               Foreground="{DynamicResource ForegroundBrush}"/>
                    <ComboBox x:Name="MinuteCombo" Width="90" Height="46"
                              FontSize="22" HorizontalContentAlignment="Center"/>
                </StackPanel>

                <!-- 반복 -->
                <StackPanel Grid.Row="4">
                    <TextBlock Text="반복" FontSize="13"
                               Foreground="{DynamicResource SubtleForegroundBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <RadioButton x:Name="OnceRadio"  Content="한번" GroupName="RepeatMode"
                                     IsChecked="True" Checked="OnceRadio_Checked"  FontSize="13"/>
                        <RadioButton x:Name="RepeatRadio" Content="반복" GroupName="RepeatMode"
                                     Checked="RepeatRadio_Checked" FontSize="13"/>
                    </StackPanel>
                </StackPanel>

                <!-- 요일 선택 (반복 선택 시 표시) -->
                <StackPanel Grid.Row="5" x:Name="RepeatDaysPanel"
                            Orientation="Horizontal" Margin="0,10,0,0"
                            Visibility="Collapsed">
                    <CheckBox x:Name="DaySun" Content="일" Style="{StaticResource DayCheckBoxStyle}" Margin="0,0,6,0"/>
                    <CheckBox x:Name="DayMon" Content="월" Style="{StaticResource DayCheckBoxStyle}" Margin="0,0,6,0"/>
                    <CheckBox x:Name="DayTue" Content="화" Style="{StaticResource DayCheckBoxStyle}" Margin="0,0,6,0"/>
                    <CheckBox x:Name="DayWed" Content="수" Style="{StaticResource DayCheckBoxStyle}" Margin="0,0,6,0"/>
                    <CheckBox x:Name="DayThu" Content="목" Style="{StaticResource DayCheckBoxStyle}" Margin="0,0,6,0"/>
                    <CheckBox x:Name="DayFri" Content="금" Style="{StaticResource DayCheckBoxStyle}" Margin="0,0,6,0"/>
                    <CheckBox x:Name="DaySat" Content="토" Style="{StaticResource DayCheckBoxStyle}"/>
                </StackPanel>

                <!-- 레이블 -->
                <TextBlock Grid.Row="7" Text="레이블 (선택)" FontSize="13"
                           Foreground="{DynamicResource SubtleForegroundBrush}"/>
                <TextBox Grid.Row="9" x:Name="LabelText" Height="44"
                         FontSize="15" VerticalContentAlignment="Center" MaxLength="40"/>

                <!-- 버튼 -->
                <StackPanel Grid.Row="11" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="취소" Width="90" Height="40" Margin="0,0,10,0"
                            Click="Cancel_Click"/>
                    <Button x:Name="OkBtn" Content="추가" Width="90" Height="40"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="{DynamicResource ActiveBtnFgBrush}"
                            FontWeight="SemiBold"
                            Click="OK_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
