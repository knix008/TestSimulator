<Window x:Class="MyClockWinV10.AddWorldTimeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="도시 추가" Height="420" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="{DynamicResource WindowBackgroundBrush}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome GlassFrameThickness="0"
                            ResizeBorderThickness="0"
                            CaptionHeight="0"
                            CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom title bar (theme TabBackgroundBrush) -->
        <Grid Grid.Row="0"
              Background="{DynamicResource TabBackgroundBrush}"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <TextBlock Text="도시 추가" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource SubtleForegroundBrush}"
                       VerticalAlignment="Center" Margin="12,0,0,0"
                       shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            <Button Content="✕" Width="30" Height="22" FontSize="11"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"
                    Background="#C0392B" Foreground="White"
                    Click="Cancel_Click"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource PanelBackgroundBrush}"
                Margin="2,0,2,2">
            <Grid Margin="28,20,28,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 도시 이름 -->
                <TextBlock Grid.Row="0" Text="도시 이름" FontSize="13"
                           Foreground="{DynamicResource SubtleForegroundBrush}"/>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="72"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="CityBox" Grid.Column="0" Height="36" FontSize="14"
                             VerticalContentAlignment="Center" MaxLength="40"
                             TextChanged="CityBox_TextChanged"
                             LostFocus="CityBox_LostFocus"
                             PreviewKeyDown="CityBox_PreviewKeyDown"/>
                    <Button Grid.Column="2" x:Name="CitySelectBtn" Content="선택"
                            Height="36" FontSize="13"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="{DynamicResource ActiveBtnFgBrush}"
                            FontWeight="SemiBold"
                            IsEnabled="False"
                            Click="CitySelect_Click"/>
                    <Popup x:Name="CityPopup"
                           PlacementTarget="{Binding ElementName=CityBox}"
                           Placement="Bottom" StaysOpen="True"
                           Width="{Binding ActualWidth, ElementName=CityBox}">
                        <Border Background="{DynamicResource PanelBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1">
                            <ListBox x:Name="CityList"
                                     MaxHeight="200"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     SelectionChanged="CityList_SelectionChanged"
                                     PreviewMouseLeftButtonDown="CityList_PreviewMouseDown"
                                     MouseDoubleClick="CityList_MouseDoubleClick">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                                        <Setter Property="Padding" Value="10,5"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background"
                                                                    Value="{DynamicResource AccentBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background"
                                                                    Value="{DynamicResource AccentBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,2">
                                            <TextBlock Text="{Binding City}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource ForegroundBrush}"/>
                                            <TextBlock Text="{Binding Country}" FontSize="11"
                                                       Foreground="{DynamicResource SubtleForegroundBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Popup>
                </Grid>

                <!-- 지역 / 국가 -->
                <TextBlock Grid.Row="4" Text="지역 / 국가" FontSize="13"
                           Foreground="{DynamicResource SubtleForegroundBrush}"/>
                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="72"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="RegionBox" Grid.Column="0" Height="36" FontSize="14"
                             VerticalContentAlignment="Center" MaxLength="40"
                             TextChanged="RegionBox_TextChanged"
                             LostFocus="RegionBox_LostFocus"
                             PreviewKeyDown="RegionBox_PreviewKeyDown"/>
                    <Button Grid.Column="2" x:Name="RegionSelectBtn" Content="선택"
                            Height="36" FontSize="13"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="{DynamicResource ActiveBtnFgBrush}"
                            FontWeight="SemiBold"
                            IsEnabled="False"
                            Click="RegionSelect_Click"/>
                    <Popup x:Name="RegionPopup"
                           PlacementTarget="{Binding ElementName=RegionBox}"
                           Placement="Bottom" StaysOpen="True"
                           Width="{Binding ActualWidth, ElementName=RegionBox}">
                        <Border Background="{DynamicResource PanelBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1">
                            <ListBox x:Name="RegionList"
                                     MaxHeight="160"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     SelectionChanged="RegionList_SelectionChanged"
                                     PreviewMouseLeftButtonDown="RegionList_PreviewMouseDown"
                                     MouseDoubleClick="RegionList_MouseDoubleClick">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                                        <Setter Property="Padding" Value="10,6"/>
                                        <Setter Property="FontSize" Value="13"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background"
                                                                    Value="{DynamicResource AccentBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background"
                                                                    Value="{DynamicResource AccentBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Border>
                    </Popup>
                </Grid>

                <!-- 시간대 -->
                <TextBlock Grid.Row="8" Text="시간대" FontSize="13"
                           Foreground="{DynamicResource SubtleForegroundBrush}"/>
                <ComboBox Grid.Row="10" x:Name="TzCombo" Height="36" FontSize="12"
                          DisplayMemberPath="DisplayName"/>

                <!-- 하단 버튼 -->
                <StackPanel Grid.Row="12" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Content="취소" Width="90" Height="40" Margin="0,0,10,0"
                            Click="Cancel_Click"/>
                    <Button x:Name="AddBtn" Content="추가" Width="90" Height="40"
                            IsDefault="True"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="{DynamicResource ActiveBtnFgBrush}"
                            FontWeight="SemiBold"
                            Click="Add_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
