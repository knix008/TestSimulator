{
  "name": "my-clock-multios",
  "version": "1.0.0",
  "description": "Cross-platform desk clock for Windows, Linux, and macOS",
  "main": "electron/main.js",
  "author": {
    "name": "SHKWON",
    "email": "knix008@naver.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test --test-reporter=./scripts/test-reporter.js test/*.test.js",
    "test:tap": "node --test test/*.test.js",
    "clean": "node scripts/clean.js",
    "clean:all": "node scripts/clean.js --all",
    "icons": "node scripts/generate-icons.js",
    "prepack": "npm run icons",
    "pack": "electron-builder --dir",
    "prebuild": "npm run icons",
    "build": "electron-builder && node scripts/copy-installer-to-root.js",
    "prebuild:win": "npm run icons",
    "build:win": "electron-builder --win && node scripts/copy-installer-to-root.js",
    "prebuild:mac": "npm run icons",
    "build:mac": "electron-builder --mac && node scripts/copy-installer-to-root.js",
    "prebuild:linux": "npm run icons",
    "build:linux": "electron-builder --linux && node scripts/copy-installer-to-root.js",
    "dist": "npm run build",
    "dist:win": "npm run build:win",
    "dist:mac": "npm run build:mac",
    "dist:linux": "npm run build:linux"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "to-ico": "^1.1.5"
  },
  "build": {
    "appId": "com.shkwon.myclock",
    "productName": "MyClock",
    "copyright": "Copyright © 2026 SHKWON",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "asset/icon.png",
      "asset/icon.ico",
      "asset/icon.svg",
      "asset/icon-256.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "asset/icons",
        "to": "icons"
      },
      {
        "from": "asset/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "asset/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "asset/icon.ico",
      "verifyUpdateCodeSignature": false,
      "signtoolOptions": {
        "sign": "./scripts/skip-win-sign.js"
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": false,
      "menuCategory": false,
      "shortcutName": "MyClock",
      "installerIcon": "asset/icon.ico",
      "uninstallerIcon": "asset/icon.ico",
      "installerHeaderIcon": "asset/icon.ico",
      "installerLanguages": [
        "en_US",
        "ko_KR"
      ],
      "language": "1042",
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": true,
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "license": "build/license.txt",
      "include": "build/installer.nsh"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "icon": "asset/icon-1024.png",
      "darkModeSupport": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "asset/icons",
      "desktop": {
        "Name": "MyClock",
        "Comment": "Desk clock with world time, alarms, timers, and calendar",
        "Categories": "Utility;Clock;"
      }
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
