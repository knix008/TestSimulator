# ── 의존성 · 빌드 산출물 ────────────────────────────────────────
node_modules/
dist/
release/
out/
*.asar
*.log
npm-debug.log*
yarn-error.log*

# 빌드 후 프로젝트 루트로 복사되는 설치 파일 (scripts/copy-installer-to-root.js)
MyClock-Setup-*.exe
MyClock-*.dmg
MyClock-*.AppImage
MyClock_*.deb
MyClock-*-mac.zip
MyClock-*-win.zip

# ── 생성되는 아이콘 (원본은 asset/icon.svg 하나, `npm run icons` 로 재생성) ──
asset/icons/
asset/icon.ico
asset/icon.png
asset/icon-256.png
asset/icon-1024.png
asset/icon-master.png
build/icon.ico
src/favicon.png

# ── OS · 편집기 ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
.vs/
.vscode/
.idea/
.cursor/
*.swp
*~

# ── 환경 변수 · 비밀 ────────────────────────────────────────────
.env
.env.*
!.env.example

# ── 검사 (npm test) ─────────────────────────────────────────────
# 검사 자체는 산출물을 남기지 않는다 (임시 파일은 OS 임시 폴더에 만든다).
# 커버리지를 켜서 돌릴 때만 아래가 생긴다.
coverage/
.nyc_output/
*.lcov

# ── 임시 · 캐시 ─────────────────────────────────────────────────
*.tmp
*.temp
.cache/

# 디버깅용으로 앱을 띄울 때 만드는 Electron 프로필·프로파일 결과
userdata/
user-data-dir/
*.heapsnapshot
*.cpuprofile

# ── Electron 크래시 덤프 ────────────────────────────────────────
*.dmp
crashpad/
