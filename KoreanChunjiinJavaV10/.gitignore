# 주석은 반드시 줄 맨 앞에 둔다.
# git 은 줄 끝 주석을 모른다 - "out/   # 설명" 은 "out/   # 설명" 이라는
# 이름을 찾는 규칙이 되어 아무것도 걸러 내지 못한다.

# ------------------------------------------------------------------ #
# 빌드 결과                                                           #
# ------------------------------------------------------------------ #

# 컴파일된 클래스, jlink 런타임, 소스 목록
out/
# Chunjiin.jar
dist/
# jpackage 가 만든 설치 파일
release/

# ------------------------------------------------------------------ #
# 내려받은 빌드 도구                                                  #
# ------------------------------------------------------------------ #

# package.sh / package.ps1 이 WiX Toolset 이 없을 때 여기에 받아서 푼다.
# 40MB 짜리 third-party 바이너리라 저장소에는 넣지 않는다.
tools/

# ------------------------------------------------------------------ #
# 루트로 복사해 둔 설치 파일                                          #
# ------------------------------------------------------------------ #

# 손 닿는 자리에 두려고 두는 것이라 저장소에는 넣지 않는다.
/Chunjiin-*.exe
/Chunjiin-*.msi
/Chunjiin-*.dmg
/Chunjiin-*.pkg
/Chunjiin-*.deb
/Chunjiin-*.rpm
/Chunjiin-*.zip
/Chunjiin-*.tar.gz

# ------------------------------------------------------------------ #
# 자바가 남기는 것                                                    #
# ------------------------------------------------------------------ #

*.class
*.jar
hs_err_pid*.log
replay_pid*.log
.jpackage/

# ------------------------------------------------------------------ #
# 편집기 · 운영체제                                                   #
# ------------------------------------------------------------------ #

.idea/
*.iml
.vscode/
.classpath
.project
.settings/
bin/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# ------------------------------------------------------------------ #
# 로그                                                                #
# ------------------------------------------------------------------ #

*.log

# ------------------------------------------------------------------ #
# 저장소에 들어가야 하는 것                                           #
# ------------------------------------------------------------------ #

# 문서 그림은 ./test.sh --shots 로 다시 찍을 수 있지만, 저장소만 받아도
# README 가 제대로 보이도록 함께 둔다. 위 규칙이나 상위 폴더의 .gitignore 가
# 걸러 내지 않도록 여기서 되돌린다.
!docs/
!docs/images/
!docs/images/*.png
