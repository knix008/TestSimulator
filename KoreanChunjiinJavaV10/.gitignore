# 주석은 반드시 줄 맨 앞에 둔다.
# git 은 줄 끝 주석을 모른다 - "out/   # 설명" 은 "out/   # 설명" 이라는
# 이름을 찾는 규칙이 되어 아무것도 걸러 내지 못한다.

# ------------------------------------------------------------------ #
# 빌드 결과                                                           #
# ------------------------------------------------------------------ #

# 빌드가 이 안에 다 넣는다. 폴더째 걸러 내므로 아래 것들을 따로 적지 않아도 된다.
#   classes/        컴파일된 클래스
#   test-classes/   시험까지 함께 컴파일한 것
#   runtime/        jlink 가 만든 자바 런타임
#   sources.txt     javac 에 넘기는 @목록 파일
#   test-sources.txt, classes.txt, resources.txt   빌드가 세어 보려고 뽑는 목록
#   javac.log       경고·오류를 세려고 받아 둔 javac 출력
#   wix-src/        jdk.jpackage.jmod 에서 꺼낸 WiX 원본
#   wix/            그것을 고쳐 jpackage 에 --resource-dir 로 넘기는 것
out/
# Chunjiin.jar
dist/
# jpackage 가 만든 설치 파일
release/

# ------------------------------------------------------------------ #
# 내려받은 빌드 도구                                                  #
# ------------------------------------------------------------------ #

# package.sh / package.ps1 이 WiX Toolset 이 없을 때 여기에 받아서 푼다.
# 40MB 짜리 third-party 바이너리라 저장소에는 넣지 않는다.
#
# 받는 도중·푸는 도중에 생기는 것들(wix314-binaries.zip.part, 곁에 푸는 임시
# 폴더)도 모두 이 안에 생기므로 따로 적지 않아도 된다.
tools/

# ------------------------------------------------------------------ #
# 루트로 복사해 둔 설치 파일                                          #
# ------------------------------------------------------------------ #

# 손 닿는 자리에 두려고 두는 것이라 저장소에는 넣지 않는다.
/Chunjiin-*.exe
/Chunjiin-*.msi
/Chunjiin-*.dmg
/Chunjiin-*.pkg
/Chunjiin-*.deb
/Chunjiin-*.rpm
/Chunjiin-*.zip
/Chunjiin-*.tar.gz

# ------------------------------------------------------------------ #
# 자바가 남기는 것                                                    #
# ------------------------------------------------------------------ #

*.class
*.jar
hs_err_pid*.log
replay_pid*.log
.jpackage/

# ------------------------------------------------------------------ #
# 편집기 · 운영체제                                                   #
# ------------------------------------------------------------------ #

.idea/
*.iml
.vscode/
.classpath
.project
.settings/
bin/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# ------------------------------------------------------------------ #
# 로그                                                                #
# ------------------------------------------------------------------ #

*.log

# ------------------------------------------------------------------ #
# 저장소에 들어가야 하는 것                                           #
# ------------------------------------------------------------------ #

# 문서 그림은 ./test.sh --shots 로 다시 찍을 수 있지만, 저장소만 받아도
# README 가 제대로 보이도록 함께 둔다. 위 규칙이나 상위 폴더의 .gitignore 가
# 걸러 내지 않도록 여기서 되돌린다.
!docs/
!docs/images/
!docs/images/*.png
