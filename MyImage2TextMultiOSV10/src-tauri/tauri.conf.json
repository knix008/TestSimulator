{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Image2Text",
  "version": "2.0.0",
  "identifier": "com.image2text.desktop",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": {
      "script": "npm run build",
      "wait": true
    },
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Image2Text",
        "width": 1280,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 720,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#12161c",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "SHKWON",
    "copyright": "Copyright © 2026 SHKWON <knix008@naver.com>",
    "category": "Utility",
    "shortDescription": "이미지를 텍스트로 바꿉니다",
    "longDescription": "이미지를 원본과 같은 비율의 텍스트로 변환합니다.",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": true,
        "languages": ["English", "Korean"],
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "windows/installerHeader.bmp",
        "sidebarImage": "windows/installerSidebar.bmp",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "files": {
          "/usr/lib/image2text/install-choices.sh": "linux/install-choices.sh"
        },
        "postInstallScript": "linux/postinst.sh",
        "postRemoveScript": "linux/postrm.sh"
      },
      "rpm": {
        "files": {
          "/usr/lib/image2text/install-choices.sh": "linux/install-choices.sh"
        },
        "postInstallScript": "linux/postinst.sh",
        "postRemoveScript": "linux/postrm.sh"
      }
    }
  }
}
