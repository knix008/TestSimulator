{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyArchitecture",
  "mainBinaryName": "MyArchitecture",
  "version": "../package.json",
  "identifier": "com.shkwon.myarchitecture",
  "build": {
    "beforeDevCommand": {
      "script": "node scripts/dev-server.mjs",
      "wait": false
    },
    "devUrl": "http://localhost:5236",
    "beforeBuildCommand": "node scripts/build-info.mjs && node scripts/build-web.mjs",
    "frontendDist": "../dist/web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "appimage", "deb"],
    "publisher": "SHKWON",
    "copyright": "Copyright © 2026 SHKWON (knix008@naver.com)",
    "category": "GraphicsAndDesign",
    "shortDescription": "Architectural floor plans, 3D, BIM and CAD exchange",
    "longDescription": "Draw floor plans with walls, doors, windows, rooms, stairs and roofs, see the building in 3D, lay out sections, elevations and sheets, and exchange DXF, DWG, IFC, gbXML, SketchUp, OBJ, GLB and PDF.",
    "icon": [
      "../assets/icons/32x32.png",
      "../assets/icons/128x128.png",
      "../assets/icons/256x256.png",
      "../assets/icon.icns",
      "../assets/icon.ico"
    ],
    "resources": {
      "../sample/": "sample/",
      "../assets/file-icon.ico": "file-icon.ico"
    },
    "fileAssociations": [
      {
        "ext": ["myarch"],
        "name": "MyArchitecture.Project",
        "description": "MyArchitecture Project",
        "mimeType": "application/x-myarch",
        "role": "Editor"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Korean", "English"],
        "displayLanguageSelector": true,
        "installerIcon": "../assets/icon.ico",
        "headerImage": "../build/installerHeader.bmp",
        "sidebarImage": "../build/installerSidebar.bmp",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  }
}
