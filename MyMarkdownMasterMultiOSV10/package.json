{
  "name": "mymarkdown",
  "productName": "MyMarkdownMaster",
  "version": "1.0.0",
  "private": true,
  "description": "Obsidian-style Markdown knowledge base: vaults, wiki links, backlinks, graph view, canvas, split editor and preview, daily notes, templates and AI assistants — Windows, macOS, Linux (Tauri) and the web.",
  "author": "SHKWON <knix008@naver.com>",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "vite",
    "build:web": "node scripts/build-wasm.mjs && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:win": "node scripts/build.mjs win",
    "build:mac": "node scripts/build.mjs mac",
    "build:linux": "node scripts/build.mjs linux",
    "build:all": "node scripts/build.mjs all",
    "build:icons": "node scripts/render-icons.mjs",
    "build:docs": "node scripts/build-docs.mjs",
    "test": "node scripts/build-wasm.mjs && node scripts/test.mjs",
    "test:quick": "node scripts/build-wasm.mjs && node scripts/test.mjs --quick",
    "test:unit": "node scripts/build-wasm.mjs && node scripts/test.mjs --only unit,i18n",
    "test:web": "node scripts/build-wasm.mjs && node scripts/test.mjs --only web",
    "test:desktop": "node scripts/build-wasm.mjs && node scripts/test.mjs --only desktop --desktop",
    "i18n:check": "node scripts/i18n-check.mjs",
    "smoke": "node scripts/smoke-web.mjs",
    "clean": "node scripts/clean.mjs",
    "clean:all": "node scripts/clean.mjs --all",
    "build:wasm": "node scripts/build-wasm.mjs",
    "test:rust": "cargo test --manifest-path crates/mdcore/Cargo.toml && cargo test --manifest-path src-tauri/Cargo.toml --lib"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.11.0",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@lezer/highlight": "^1.2.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "dompurify": "^3.2.6",
    "marked": "^12.0.2",
    "pagedjs": "^0.4.3",
    "@codemirror/autocomplete": "^6.18.0",
    "markdown-it": "^14.1.0",
    "markdown-it-footnote": "^4.0.0",
    "katex": "^0.16.22",
    "mermaid": "^11.6.0",
    "highlight.js": "^11.11.1",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "sharp": "^0.35.5",
    "vite": "^7.3.8"
  }
}
