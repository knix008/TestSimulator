{
  "name": "my-memopad-multios",
  "productName": "MyMemoPad",
  "version": "1.0.0",
  "description": "Cross-platform sticky memo pad for Windows, Linux, macOS, and Web",
  "author": {
    "name": "SHKWON",
    "email": "knix008@naver.com"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "node scripts/dev.js",
    "web": "node scripts/serve-web.js",
    "test": "npm run test:rust",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "icons": "node scripts/generate-icons.js",
    "tauri": "tauri",
    "pack": "tauri build --no-bundle",
    "build": "tauri build && node scripts/copy-installer-to-root.js",
    "build:win": "tauri build --bundles nsis && node scripts/copy-installer-to-root.js",
    "build:mac": "tauri build --bundles dmg && node scripts/copy-installer-to-root.js",
    "build:linux": "tauri build --bundles appimage,deb && node scripts/copy-installer-to-root.js",
    "dist": "npm run build",
    "dist:win": "npm run build:win",
    "dist:mac": "npm run build:mac",
    "dist:linux": "npm run build:linux"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tauri-apps/cli": "^2.8.0",
    "to-ico": "^1.1.5"
  }
}
