<?xml version="1.0" encoding="utf-8"?>
<!--
  The MyDesktop installer.

  The payload is a self-contained publish, so the installed copy carries its own .NET and runs on a
  machine that has never had a runtime installed. PublishDir is passed in by build-installer.ps1.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="MyDesktop"
           Manufacturer="MyDesktop"
           Version="$(Version)"
           UpgradeCode="0A2606EB-8659-4911-BEC6-DCE7C57F5796"
           Scope="perMachine"
           Compressed="yes">

    <!--
      Installing replaces whatever is already there, down to the files.

      AllowSameVersionUpgrades is not a nicety. Windows Installer compares only the first three
      fields of ProductVersion, and it refuses to overwrite a file whose version matches the one on
      disk. While every build carried 1.0.0 and 1.0.0.0, installing a new build over an old one did
      nothing at all: setup ran, reported success, and left yesterday's binaries in place — so a
      fixed bug was still there afterwards, and the only hint was the file date in Program Files.
      build-installer.ps1 now stamps a fresh version on every build, and this attribute covers the
      remaining case of two builds made on the same day.

      Schedule says when the old product goes: afterInstallInitialize is before a single new file is
      written, so this is a removal followed by an installation and never the two interleaved. What
      is on disk afterwards came from this .msi and nothing else — which is the only way an installed
      copy can be trusted to be the build it says it is. It also keeps the whole thing in one
      transaction: a failure puts the previous version back.
    -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  Schedule="afterInstallInitialize"
                  DowngradeErrorMessage="A newer version of MyDesktop is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="$(IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="MyDesktop">
        <!--
          The startup choice, recorded for the machine rather than acted on here.

          A Run entry written by this installer would be the wrong one: a per-machine install runs as
          SYSTEM, so it can only write the machine-wide Run key, and nothing short of an elevated
          program can take an entry out of that key again. MyDesktop's own switch for starting with
          Windows is in its settings window and its tray menu, where it has to work for a user who
          is not an administrator. So setup leaves this default behind instead, and the first run
          under each account turns it into that account's own per-user Run entry, which the switch
          can then add and remove freely. Uninstalling takes the default away with the component.
        -->
        <Component Id="StartWithWindows" Guid="4E8D6C31-7A52-4F0D-9B36-1C5E0A24D7F8">
          <RegistryValue Root="HKLM" Key="Software\MyDesktop" Name="LaunchAtLogin"
                         Type="integer" Value="1" KeyPath="yes" />
        </Component>

        <!--
          Everything in the program folder goes before the new files are laid down, and again when
          MyDesktop is removed.

          The upgrade above already takes away every file a previous MSI installed, so this is about
          what no MSI owns: a file left behind by a crashed install, or one copied in by hand while
          chasing a bug. Those survive an upgrade and can be loaded instead of the real thing.
          RemoveFiles runs before InstallFiles, so the folder is emptied and then filled.

          The scope is this one folder, never the tree below it — the Assets folder's contents belong
          to components and leave with them.
        -->
        <Component Id="CleanInstallFolder" Guid="9F3C58A1-6D24-4B7E-8E51-2A0B7C6D4E15">
          <RemoveFile Id="PurgeInstallFolder" Name="*" On="both" />
          <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
          <RegistryValue Root="HKLM" Key="Software\MyDesktop" Name="InstallFolder"
                         Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />

          <!--
            "The copy installed here understands the quit switch."

            Setup asks a running MyDesktop to stand down by running the installed exe with that
            switch, and waits for it to finish. A build from before the switch existed does not
            recognise it, ignores it, and starts the whole application instead — so setup would sit
            waiting for a program that runs until the user quits it. The next install reads this
            value first and only then uses the switch.
          -->
          <RegistryValue Root="HKLM" Key="Software\MyDesktop" Name="QuitSwitch"
                         Type="integer" Value="1" />
        </Component>

        <!--
          The answer to "start with an empty layout?" from the feature page, recorded rather than
          acted on here: a per-machine install runs as SYSTEM and the layout belongs to each user.
          MyDesktop reads this on its next start under each account, sets that account's layout
          aside and remembers that it has done so (WorkspaceStore.ResetIfSetupAskedFor).

          The value is the version that asked, so installing a later build with the box ticked again
          asks again, while an ordinary launch does not.
        -->
        <Component Id="ResetWorkspaceFlag" Guid="C17B4E90-5A8D-4C23-9F67-3B8E1D05A742">
          <RegistryValue Root="HKLM" Key="Software\MyDesktop" Name="ResetWorkspace"
                         Type="string" Value="$(Version)" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="MyDesktop">
        <Component Id="StartMenuShortcut" Guid="2B1A7988-01C9-4452-BCA1-3E1B471289C2">
          <Shortcut Id="AppShortcut"
                    Name="MyDesktop"
                    Description="Tidy the Windows desktop into fences"
                    Target="[INSTALLFOLDER]MyDesktop.exe"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="AppIcon" />
          <RemoveFolder Id="RemoveAppMenuFolder" On="uninstall" />
          <!-- A component needs a key path, and the shortcut's own folder is not one. -->
          <RegistryValue Root="HKLM" Key="Software\MyDesktop" Name="StartMenuShortcut"
                         Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="7C4E2F1A-9D3B-4E88-AB52-6F0C1D7E4B93">
        <Shortcut Id="AppDesktopShortcut"
                  Name="MyDesktop"
                  Description="Tidy the Windows desktop into fences"
                  Target="[INSTALLFOLDER]MyDesktop.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RegistryValue Root="HKLM" Key="Software\MyDesktop" Name="DesktopShortcut"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!--
      Three features, so the shortcuts can be chosen rather than imposed.

      The root stays visible and expanded even though it cannot be deselected. The selection tree is
      a hierarchy: hiding the root takes its children off the tree with it, leaving an empty box, no
      selected feature and therefore no install location to show. AllowAbsent is what makes the
      program itself non-optional, not hiding it.

      ConfigurableDirectory is what puts a folder behind the Browse button. Without it the location
      is blank and there is nothing to change.

      The desktop shortcut starts off, because MyDesktop's whole point is a desktop with less on it.
    -->
    <Feature Id="Main" Title="MyDesktop" Description="The program itself." Level="1"
             AllowAbsent="no" Display="expand" ConfigurableDirectory="INSTALLFOLDER">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="CleanInstallFolder" />

      <Feature Id="StartMenu" Title="Start Menu shortcut"
               Description="Add MyDesktop to the Start Menu." Level="1">
        <ComponentRef Id="StartMenuShortcut" />
      </Feature>

      <Feature Id="Desktop" Title="Desktop shortcut"
               Description="Put a MyDesktop shortcut on the desktop." Level="1000">
        <ComponentRef Id="DesktopShortcut" />
      </Feature>

      <!--
        On by default: fences are where the user's desktop items now live, so a sign-in without
        MyDesktop running is a sign-in with no icons where they were left. It can be switched off
        here, and afterwards from Start with Windows in MyDesktop's own settings.
      -->
      <Feature Id="Startup" Title="Start with Windows"
               Description="Start MyDesktop when you sign in, so the fences are there with the desktop. MyDesktop's settings can change this later."
               Level="1">
        <ComponentRef Id="StartWithWindows" />
      </Feature>

      <!--
        Off by default, and it has to stay that way: the fences are where the user's desktop now
        lives, and nobody expects an update to take them away. It is offered because reinstalling is
        also how someone starts over after making a mess, and because the alternative — setup
        quietly deciding for them — is worse in both directions.

        Nothing is deleted. MyDesktop renames the layout to fences.json.before-reset.bak, so a tick
        made by mistake costs one file rename to undo.
      -->
      <Feature Id="ResetData" Title="Start with an empty layout"
               Description="Set this PC's saved fences and settings aside and start as if MyDesktop had never run. Leave this off to keep the fences you have. Nothing is deleted: the old layout is kept as fences.json.before-reset.bak."
               Level="1000">
        <ComponentRef Id="ResetWorkspaceFlag" />
      </Feature>
    </Feature>

    <!--
      The feature tree page is where the shortcuts and the startup choice are switched on and off. A
      silent install picks them with the standard property, no custom names needed:
          msiexec /i MyDesktop.msi /qn ADDLOCAL=Main,StartMenu,Desktop,Startup
      A silent install shows no exit page, so nothing starts MyDesktop and nothing has turned the
      startup default into a Run entry yet. That happens the first time MyDesktop is opened, and a
      deployment that wants it sooner can open it once from the same script.
      Setting ADDLOCAL from here instead would run in the UI sequence too and overwrite whatever the
      user had just chosen on that page.
    -->
    <!--
      Setup ends by starting MyDesktop, so the tray icon and the fences are there rather than
      waiting for a sign-out. This is also what turns the startup default above into this user's own
      Run entry, which is why the box stays ticked by default.

      The launch is a plain type 50 custom action: the path comes from a property, set on the way out
      of the exit page so it is whatever the user browsed to rather than the default folder, and the
      command line is empty because MyDesktop takes no arguments. asyncNoWait is what lets setup
      close instead of sitting and waiting for a program that runs until the user quits it.
    -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Start MyDesktop now" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />

    <CustomAction Id="StartMyDesktop" Property="StartMyDesktopTarget" ExeCommand=""
                  Execute="immediate" Impersonate="yes" Return="asyncNoWait" />

    <!--
      Before a single file is touched, the copy that is already running is asked to stand down.

      Two things go wrong without this. MyDesktop.exe is locked by the copy running from the same
      folder, so Windows Installer cannot replace it and offers a reboot instead — after which the
      user has been running yesterday's build all day. And a copy that is simply killed never
      switches the shell's desktop icons back on, so the desktop is left empty.

      MyDesktop answers the quit switch below through its own shutdown: icons back, layout flushed,
      process gone. (The switch cannot be named in this comment: XML has no way to write two dashes
      inside one.)
      Impersonated, because the signal lives in the user's session rather than the SYSTEM one setup
      otherwise runs in, and "ignore" because a machine with nothing running must still install.
    -->
    <!--
      Only a copy that was installed with the switch is asked to quit with it. A build from before
      it existed treats the switch as noise and starts up instead, and setup — which waits for the
      command to finish — would wait for as long as the user left it running.
    -->
    <Property Id="MYDESKTOPQUITSWITCH">
      <RegistrySearch Id="QuitSwitchSearch" Root="HKLM" Key="Software\MyDesktop"
                      Name="QuitSwitch" Type="raw" />
    </Property>

    <CustomAction Id="QuitRunningMyDesktop" Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]MyDesktop.exe&quot; --quit"
                  Execute="immediate" Impersonate="yes" Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="QuitRunningMyDesktop" Before="InstallValidate"
              Condition="MYDESKTOPQUITSWITCH" />
    </InstallExecuteSequence>

    <UI>
      <ui:WixUI Id="WixUI_FeatureTree" />

      <Publish Dialog="ExitDialog" Control="Finish" Property="StartMyDesktopTarget"
               Value="[INSTALLFOLDER]MyDesktop.exe" Order="1"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="StartMyDesktop" Order="2"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>

    <WixVariable Id="WixUILicenseRtf" Value="$(LicenseFile)" />
  </Package>

  <Fragment>
    <!--
      Everything the publish produced, harvested as it stands. Listing the files by hand would mean
      editing this file every time the runtime's file set changes.
    -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(PublishDir)\**" />
    </ComponentGroup>
  </Fragment>

</Wix>
