<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ====================================================================================
         The item menu, in the shape Windows 11 gives it.

         Explorer's own menu for a desktop icon is drawn by Explorer and cannot be asked for, so
         MyDesktop draws one of the same shape: a row of icon buttons on top, a short list of
         commands, and "Show more options" for the full shell menu underneath. The colours are
         held as resources rather than written in here, because the menu follows the Windows app
         theme and ItemMenu repoints them to the light or dark set before it opens.
         ==================================================================================== -->
    <SolidColorBrush x:Key="MenuSurface" Color="#2C2C2C" />
    <SolidColorBrush x:Key="MenuEdge" Color="#454545" />
    <SolidColorBrush x:Key="MenuText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="MenuTextDim" Color="#7A7A7A" />
    <SolidColorBrush x:Key="MenuHover" Color="#3D3D3D" />
    <SolidColorBrush x:Key="MenuLine" Color="#3D3D3D" />

    <Style x:Key="ShellMenuSeparator" TargetType="Separator">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="12,4" />
        <Setter Property="Background" Value="{DynamicResource MenuLine}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Rectangle Height="1" Fill="{TemplateBinding Background}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ShellMenuItem" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource MenuText}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Row" Background="Transparent" CornerRadius="4" Margin="4,1" Padding="10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ContentPresenter x:Name="Glyph" ContentSource="Icon"
                                              VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="False"
                                              VerticalAlignment="Center" Margin="0,0,24,0" />
                            <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}"
                                       Foreground="{DynamicResource MenuTextDim}" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock x:Name="Arrow" Grid.Column="3" Text="&#xE76C;" FontSize="11"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       VerticalAlignment="Center" Visibility="Collapsed" />

                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Right"
                                   HorizontalOffset="-6" VerticalOffset="-5" Focusable="False"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   PopupAnimation="Fade">
                                <Border Background="{DynamicResource MenuSurface}" BorderBrush="{DynamicResource MenuEdge}"
                                        BorderThickness="1" CornerRadius="8" Padding="0,4" Margin="8"
                                        MinWidth="180">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="3" Opacity="0.5" />
                                    </Border.Effect>
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Role" Value="TopLevelHeader">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource MenuHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource MenuTextDim}" />
                            <Setter TargetName="Glyph" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ShellMenu" TargetType="ContextMenu">
        <Setter Property="Foreground" Value="{DynamicResource MenuText}" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{DynamicResource MenuSurface}" BorderBrush="{DynamicResource MenuEdge}"
                            BorderThickness="1" CornerRadius="8" Padding="0,4" Margin="8" MinWidth="230">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.5" />
                        </Border.Effect>
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
