<Window x:Class="MyDesktop.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MyDesktop" Height="780" Width="1180" MinHeight="640" MinWidth="960"
        Background="#F3F4EF" FontFamily="Segoe UI" Foreground="#1D2924"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="258" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#19342E">
            <Grid Margin="20,22,18,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="36" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="2,0,0,30">
                    <Border Width="34" Height="34" CornerRadius="10" Background="#D9F078" VerticalAlignment="Center">
                        <TextBlock Text="P" FontSize="20" FontWeight="Bold" Foreground="#19342E"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="MYDESKTOP" FontSize="15" FontWeight="Bold" Foreground="#F4F5ED" />
                        <TextBlock Text="DESKTOP FENCES" FontSize="9" FontWeight="SemiBold" Foreground="#95AAA0" />
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Row="1" Margin="2,0,0,10">
                    <TextBlock Text="YOUR FENCES" FontSize="10" FontWeight="Bold" Foreground="#9BAFA5" VerticalAlignment="Center" />
                    <Button Content="+" Style="{StaticResource QuietButton}" Padding="8,3" Foreground="#D9F078" FontSize="18"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Click="NewFence_Click" ToolTip="New fence" />
                </Grid>

                <ListBox Grid.Row="2" ItemsSource="{Binding Fences}" SelectedItem="{Binding SelectedFence, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         ItemContainerStyle="{StaticResource LibraryListItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="4" Height="25" CornerRadius="2" VerticalAlignment="Center"
                                        Background="{Binding Accent, Converter={StaticResource Hex}}" />
                                <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" Foreground="#F1F4EE" FontSize="13" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding PortalPath}" Foreground="#7E958A" FontSize="9" TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding IsPortal, Converter={StaticResource Bool}}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Items.Count}" Margin="8,0,2,0" Foreground="#AFC0B6"
                                           FontSize="11" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="3" BorderBrush="#355149" BorderThickness="0,1,0,0" Padding="2,16,0,0">
                    <StackPanel>
                        <CheckBox Content="Start with Windows" Foreground="#CFDCD3" FontSize="11"
                                  IsChecked="{Binding Settings.LaunchAtLogin, Mode=TwoWay}" />
                        <CheckBox Content="Lock every fence" Foreground="#CFDCD3" FontSize="11" Margin="0,8,0,0"
                                  IsChecked="{Binding Settings.FencesLocked, Mode=TwoWay}" />
                        <CheckBox Content="Hide every fence" Foreground="#CFDCD3" FontSize="11" Margin="0,8,0,0"
                                  IsChecked="{Binding Settings.AllHidden, Mode=TwoWay}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="72" />
                <RowDefinition Height="*" />
                <RowDefinition Height="36" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E7E9E3" BorderThickness="0,0,0,1">
                <Grid Margin="34,0">
                    <TextBlock Text="FENCE SETTINGS" Style="{StaticResource SectionCaption}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="New folder portal" Style="{StaticResource QuietButton}" Click="NewPortal_Click" />
                        <Button Content="New fence" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="NewFence_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid Margin="38,30,38,36" IsEnabled="{Binding HasSelection}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <Button DockPanel.Dock="Right" Content="Delete fence" Style="{StaticResource QuietButton}" Click="DeleteFence_Click" />
                        <Button DockPanel.Dock="Right" Content="Show on desktop" Style="{StaticResource QuietButton}" Click="RevealFence_Click" />
                        <TextBox Text="{Binding SelectedFence.Name, UpdateSourceTrigger=PropertyChanged}" FontSize="30" FontWeight="SemiBold"
                                 Foreground="#1D2924" Background="Transparent" BorderThickness="0" Padding="0"
                                 VerticalContentAlignment="Center" />
                    </DockPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ACCENT" Style="{StaticResource SectionCaption}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button Style="{StaticResource PaletteButton}" Background="#A8CE6A" Tag="#A8CE6A" Click="Accent_Click" />
                        <Button Style="{StaticResource PaletteButton}" Background="#D9F078" Tag="#D9F078" Click="Accent_Click" />
                        <Button Style="{StaticResource PaletteButton}" Background="#E78F67" Tag="#E78F67" Click="Accent_Click" />
                        <Button Style="{StaticResource PaletteButton}" Background="#69A9A0" Tag="#69A9A0" Click="Accent_Click" />
                        <Button Style="{StaticResource PaletteButton}" Background="#D9B75E" Tag="#D9B75E" Click="Accent_Click" />
                        <Button Style="{StaticResource PaletteButton}" Background="#8C9BD0" Tag="#8C9BD0" Click="Accent_Click" />
                        <Button Style="{StaticResource PaletteButton}" Background="#D87983" Tag="#D87983" Click="Accent_Click" />

                        <TextBlock Text="FENCE COLOUR" Style="{StaticResource SectionCaption}" VerticalAlignment="Center" Margin="26,0,12,0" />
                        <Button Style="{StaticResource PaletteButton}" Background="#132B24" Tag="#132B24" Click="Background_Click" />
                        <Button Style="{StaticResource PaletteButton}" Background="#1B232B" Tag="#1B232B" Click="Background_Click" />
                        <Button Style="{StaticResource PaletteButton}" Background="#131313" Tag="#131313" Click="Background_Click" />
                        <Button Style="{StaticResource PaletteButton}" Background="#251426" Tag="#251426" Click="Background_Click" />
                        <Button Style="{StaticResource PaletteButton}" Background="#2A2318" Tag="#2A2318" Click="Background_Click" />
                        <Button Style="{StaticResource PaletteButton}" Background="#0F2A2B" Tag="#0F2A2B" Click="Background_Click" />
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="0,22,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,26,0">
                            <TextBlock Text="OPACITY" Style="{StaticResource SectionCaption}" />
                            <Slider Minimum="0.15" Maximum="1" Value="{Binding FenceOpacity, Mode=TwoWay}" Margin="0,6,0,0"
                                    TickFrequency="0.05" IsSnapToTickEnabled="True" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,26,0">
                            <TextBlock Text="ICON SIZE" Style="{StaticResource SectionCaption}" />
                            <Slider Minimum="24" Maximum="96" Value="{Binding SelectedFence.IconSize, Mode=TwoWay}" Margin="0,6,0,0"
                                    TickFrequency="8" IsSnapToTickEnabled="True" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                            <CheckBox Content="Show labels" FontSize="12" IsChecked="{Binding SelectedFence.ShowLabels, Mode=TwoWay}" />
                            <CheckBox Content="Rolled up" FontSize="12" Margin="0,7,0,0" IsChecked="{Binding SelectedFence.RolledUp, Mode=TwoWay}" />
                            <CheckBox Content="Hidden" FontSize="12" Margin="0,7,0,0" IsChecked="{Binding SelectedFence.Hidden, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="3" Margin="0,24,0,0" Background="#FFFFFF" BorderBrush="#E7E9E3" BorderThickness="1" CornerRadius="10" Padding="18,15">
                        <StackPanel>
                            <TextBlock Text="FOLDER PORTAL" Style="{StaticResource SectionCaption}" />
                            <TextBlock Text="A portal fence mirrors a folder, so its contents follow whatever is in that folder."
                                       FontSize="12" Foreground="#78857B" Margin="0,5,0,10" TextWrapping="Wrap" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Stop mirroring" Style="{StaticResource QuietButton}" Click="StopPortal_Click" />
                                <Button DockPanel.Dock="Right" Content="Choose folder" Style="{StaticResource QuietButton}" Click="PickPortal_Click" />
                                <TextBox Text="{Binding SelectedFence.PortalPath}" IsReadOnly="True" Background="#F4F5F1" BorderThickness="0"
                                         Padding="9,8" VerticalContentAlignment="Center" FontSize="12" Foreground="#3A4A41" Margin="0,0,10,0" />
                            </DockPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,11,0,0">
                                <CheckBox Content="Show hidden items" FontSize="12" IsChecked="{Binding SelectedFence.PortalShowHidden, Mode=TwoWay}" />
                                <TextBlock Text="SORT" Style="{StaticResource SectionCaption}" Margin="26,0,9,0" VerticalAlignment="Center" />
                                <ComboBox x:Name="SortChoice" ItemsSource="{Binding SortOptions}"
                                          SelectedItem="{Binding SelectedFence.Sort, Mode=TwoWay}"
                                          Width="150" FontSize="12">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumLabel}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <DockPanel Grid.Row="4" Margin="0,26,0,0">
                        <Button DockPanel.Dock="Right" Content="Add folder" Style="{StaticResource QuietButton}" Click="AddFolder_Click" />
                        <Button DockPanel.Dock="Right" Content="Add items" Style="{StaticResource QuietButton}" Click="AddItems_Click" />
                        <TextBlock Text="ITEMS IN THIS FENCE" Style="{StaticResource SectionCaption}" VerticalAlignment="Center" />
                    </DockPanel>

                    <ListBox Grid.Row="5" ItemsSource="{Binding SelectedFence.Items}" Margin="0,10,0,0" MaxHeight="290"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.Resources>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,7" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="#FFFFFF" BorderBrush="#E7E9E3" BorderThickness="1" CornerRadius="9" Padding="11,9">
                                                <ContentPresenter />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.Resources>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image Source="{Binding Icon}" Width="26" Height="26" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Margin="11,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="#26342D"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Path}" FontSize="11" Foreground="#87928B" Margin="0,3,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="×" Tag="{Binding}" Style="{StaticResource QuietButton}"
                                            Padding="8,4" FontSize="17" Click="RemoveItem_Click" ToolTip="Remove from fence" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="6" Margin="0,28,0,0" Background="#FFFFFF" BorderBrush="#E7E9E3" BorderThickness="1"
                            CornerRadius="10" Padding="18,15" IsEnabled="True">
                        <StackPanel>
                            <TextBlock Text="DESKTOP BEHAVIOUR" Style="{StaticResource SectionCaption}" />
                            <CheckBox Content="Right-drag on empty desktop draws a new fence" FontSize="12" Margin="0,11,0,0"
                                      IsChecked="{Binding Settings.CreateFenceWithRightDrag, Mode=TwoWay}" />
                            <CheckBox Content="Double-click empty desktop hides and restores every fence" FontSize="12" Margin="0,8,0,0"
                                      IsChecked="{Binding Settings.QuickHideOnDesktopDoubleClick, Mode=TwoWay}" />
                            <CheckBox Content="Snap fences to a grid while dragging" FontSize="12" Margin="0,8,0,0"
                                      IsChecked="{Binding Settings.SnapToGrid, Mode=TwoWay}" />
                            <CheckBox Content="Snap fences to screen edges and to each other" FontSize="12" Margin="0,8,0,0"
                                      IsChecked="{Binding Settings.SnapToEdges, Mode=TwoWay}" />
                            <CheckBox Content="MyDesktop draws the desktop" FontSize="12" Margin="0,8,0,0"
                                      IsChecked="{Binding Settings.DrawDesktop, Mode=TwoWay}" />
                            <TextBlock Text="The shell's icon layer is switched off and MyDesktop draws the Recycle Bin and anything not in a fence. That is what keeps an item in a fence from also appearing on the wallpaper, while its file stays in the Desktop folder where Explorer shows it. Switching this off hands the desktop back to Windows."
                                       FontSize="11" Foreground="#87928B" TextWrapping="Wrap" Margin="24,5,0,0" />
                            <CheckBox Content="Start with Windows" FontSize="12" Margin="0,14,0,0"
                                      IsChecked="{Binding Settings.LaunchAtLogin, Mode=TwoWay}" />
                            <CheckBox Content="Show the system tray icon" FontSize="12" Margin="0,8,0,0"
                                      IsChecked="{Binding Settings.ShowTrayIcon, Mode=TwoWay}" />
                            <TextBlock Text="Without the tray icon, right-click any fence and choose MyDesktop settings to get back here."
                                       FontSize="11" Foreground="#87928B" TextWrapping="Wrap" Margin="24,5,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <TextBlock Text="LANGUAGE" Style="{StaticResource SectionCaption}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <ComboBox x:Name="LanguageChoice" ItemsSource="{Binding LanguageOptions}"
                                          SelectedItem="{Binding Settings.Language, Mode=TwoWay}"
                                          Width="170" FontSize="12">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumLabel}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBlock Text="GRID" Style="{StaticResource SectionCaption}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <Slider Minimum="2" Maximum="40" Width="200" TickFrequency="2" IsSnapToTickEnabled="True"
                                        Value="{Binding Settings.GridSize, Mode=TwoWay}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Settings.GridSize}" FontSize="12" Foreground="#78857B"
                                           VerticalAlignment="Center" Margin="10,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>

            <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E7E9E3" BorderThickness="0,1,0,0">
                <DockPanel Margin="34,0" VerticalAlignment="Center">
                    <TextBlock Text="MYDESKTOP FENCES" Style="{StaticResource SectionCaption}" />
                    <TextBlock DockPanel.Dock="Right" Text="Changes apply immediately and save themselves"
                               FontSize="10" Foreground="#87928B" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
