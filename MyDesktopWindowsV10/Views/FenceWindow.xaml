<Window x:Class="MyDesktop.Views.FenceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MyDesktop fence"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" WindowStartupLocation="Manual"
        ShowActivated="False" AllowDrop="True" MinWidth="150" MinHeight="32"
        SnapsToDevicePixels="True" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Grid>
        <Border x:Name="Shell" CornerRadius="10"
                Background="{Binding Background, Converter={StaticResource Hex}}"
                BorderBrush="{Binding Accent, Converter={StaticResource Hex}, ConverterParameter=0.30}"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border x:Name="TitleBar" Grid.Row="0" Height="30" CornerRadius="9,9,0,0"
                        Background="{Binding TitleBackground, Converter={StaticResource Hex}}"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                        MouseMove="TitleBar_MouseMove"
                        MouseLeftButtonUp="TitleBar_MouseLeftButtonUp"
                        MouseRightButtonUp="Fence_MouseRightButtonUp">
                    <Grid Margin="9,0,4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="3" Height="14" CornerRadius="2" VerticalAlignment="Center"
                                Background="{Binding Accent, Converter={StaticResource Hex}}" />

                        <TextBlock x:Name="TitleText" Grid.Column="1" Margin="8,0,6,0" Text="{Binding Name}"
                                   FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{Binding Foreground, Converter={StaticResource Hex}}" />

                        <TextBox x:Name="TitleEditor" Grid.Column="1" Margin="6,4" Visibility="Collapsed"
                                 FontSize="12" FontWeight="SemiBold" BorderThickness="0" Padding="3,0"
                                 Background="#33FFFFFF" VerticalContentAlignment="Center"
                                 Foreground="{Binding Foreground, Converter={StaticResource Hex}}"
                                 KeyDown="TitleEditor_KeyDown" LostFocus="TitleEditor_LostFocus" />

                        <Border Grid.Column="2" Margin="0,0,7,0" Padding="5,1" CornerRadius="4" VerticalAlignment="Center"
                                Background="#26FFFFFF"
                                Visibility="{Binding IsPortal, Converter={StaticResource Bool}}">
                            <TextBlock Text="PORTAL" FontSize="8" FontWeight="Bold" Opacity="0.85"
                                       Foreground="{Binding Foreground, Converter={StaticResource Hex}}" />
                        </Border>

                        <TextBlock Grid.Column="3" Text="{Binding Items.Count}" Margin="0,0,6,0" FontSize="10"
                                   VerticalAlignment="Center" Opacity="0.6"
                                   Foreground="{Binding Foreground, Converter={StaticResource Hex}}" />

                        <Button x:Name="RollButton" Grid.Column="4" Style="{StaticResource FenceGlyphButton}"
                                Click="Roll_Click" ToolTip="Roll up or down"
                                Foreground="{Binding Foreground, Converter={StaticResource Hex}}" />

                        <Button Grid.Column="5" Content="&#xFE19;" Style="{StaticResource FenceGlyphButton}"
                                Click="Menu_Click" ToolTip="Fence menu"
                                Foreground="{Binding Foreground, Converter={StaticResource Hex}}" />
                    </Grid>
                </Border>

                <Grid x:Name="Body" Grid.Row="1">
                    <ListBox x:Name="ItemsView" ItemsSource="{Binding Items}" Background="Transparent"
                             BorderThickness="0" Padding="6,6,6,8" SelectionMode="Extended"
                             ItemContainerStyle="{StaticResource FenceItemContainer}" AllowDrop="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             PreviewMouseLeftButtonDown="Items_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="Items_PreviewMouseMove"
                             PreviewMouseRightButtonUp="Items_PreviewMouseRightButtonUp"

                             KeyDown="Items_KeyDown"
                             DragOver="Items_DragOver" DragLeave="Items_DragLeave" Drop="Items_Drop">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel ItemWidth="{Binding CellWidth}" ItemHeight="{Binding CellHeight}" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="1,4,1,0" ToolTip="{Binding Path}"
                                            AutomationProperties.Name="{Binding Name}">
                                    <Image Source="{Binding Icon}"
                                           Width="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                           Height="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <TextBlock Text="{Binding Name}" FontSize="10.5" TextAlignment="Center" Margin="0,3,0,0"
                                               TextWrapping="Wrap" MaxHeight="27" TextTrimming="CharacterEllipsis"
                                               Foreground="{Binding DataContext.Foreground, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource Hex}}"
                                               Visibility="{Binding DataContext.ShowLabels, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource Bool}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="Drop shortcuts here" FontSize="11" IsHitTestVisible="False" Opacity="0.45"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{Binding Foreground, Converter={StaticResource Hex}}"
                               Visibility="{Binding Items.Count, Converter={StaticResource Empty}}" />

                    <Border x:Name="DropHint" BorderBrush="{Binding Accent, Converter={StaticResource Hex}}"
                            BorderThickness="2" CornerRadius="8" Margin="2" IsHitTestVisible="False"
                            Visibility="Collapsed" />
                </Grid>
            </Grid>
        </Border>

        <Rectangle Tag="L" Width="5" HorizontalAlignment="Left" Margin="0,8,0,8" Fill="Transparent" Cursor="SizeWE"
                   MouseLeftButtonDown="Resize_MouseLeftButtonDown" MouseMove="Resize_MouseMove" MouseLeftButtonUp="Resize_MouseLeftButtonUp" />
        <Rectangle Tag="R" Width="5" HorizontalAlignment="Right" Margin="0,8,0,8" Fill="Transparent" Cursor="SizeWE"
                   MouseLeftButtonDown="Resize_MouseLeftButtonDown" MouseMove="Resize_MouseMove" MouseLeftButtonUp="Resize_MouseLeftButtonUp" />
        <Rectangle Tag="T" Height="4" VerticalAlignment="Top" Margin="8,0,8,0" Fill="Transparent" Cursor="SizeNS"
                   MouseLeftButtonDown="Resize_MouseLeftButtonDown" MouseMove="Resize_MouseMove" MouseLeftButtonUp="Resize_MouseLeftButtonUp" />
        <Rectangle Tag="B" Height="5" VerticalAlignment="Bottom" Margin="8,0,8,0" Fill="Transparent" Cursor="SizeNS"
                   MouseLeftButtonDown="Resize_MouseLeftButtonDown" MouseMove="Resize_MouseMove" MouseLeftButtonUp="Resize_MouseLeftButtonUp" />
        <Rectangle Tag="TL" Width="9" Height="9" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="Transparent" Cursor="SizeNWSE"
                   MouseLeftButtonDown="Resize_MouseLeftButtonDown" MouseMove="Resize_MouseMove" MouseLeftButtonUp="Resize_MouseLeftButtonUp" />
        <Rectangle Tag="TR" Width="9" Height="9" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="Transparent" Cursor="SizeNESW"
                   MouseLeftButtonDown="Resize_MouseLeftButtonDown" MouseMove="Resize_MouseMove" MouseLeftButtonUp="Resize_MouseLeftButtonUp" />
        <Rectangle Tag="BL" Width="9" Height="9" HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="Transparent" Cursor="SizeNESW"
                   MouseLeftButtonDown="Resize_MouseLeftButtonDown" MouseMove="Resize_MouseMove" MouseLeftButtonUp="Resize_MouseLeftButtonUp" />
        <Rectangle Tag="BR" Width="9" Height="9" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="Transparent" Cursor="SizeNWSE"
                   MouseLeftButtonDown="Resize_MouseLeftButtonDown" MouseMove="Resize_MouseMove" MouseLeftButtonUp="Resize_MouseLeftButtonUp" />
    </Grid>
</Window>
