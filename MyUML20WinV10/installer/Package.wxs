<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="MyUML20WinV10"
           Manufacturer="TestSimulator"
           Version="1.0.0.0"
           UpgradeCode="B7E3A1F2-8C4D-4E5F-9A6B-2C3D4E5F6071"
           Scope="perMachine"
           InstallerVersion="500"
           Codepage="65001">
    <MajorUpgrade DowngradeErrorMessage="A newer version of MyUML20WinV10 is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <WixVariable Id="WixUILicenseRtf" Value="assets\License.rtf" />

    <Icon Id="AppIcon.ico" SourceFile="assets\AppIcon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />

    <Launch Condition="Privileged"
            Message="관리자 권한이 필요합니다. 설치 파일을 관리자 권한으로 실행해 주세요." />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="MyUML20WinV10" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="CmpDesktopShortcut" Guid="*" Bitness="always64">
        <Shortcut Id="ShcDesktop"
                  Name="MyUML20WinV10"
                  Description="MyUML20WinV10 UML 2.0 작성 도구"
                  Target="[INSTALLFOLDER]MyUML20WinV10.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon.ico"
                  IconIndex="0" />
        <RegistryValue Root="HKCU"
                       Key="Software\TestSimulator\MyUML20WinV10\Setup"
                       Name="DesktopShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="MyUML20WinV10">
        <Component Id="CmpStartMenuShortcut" Guid="*" Bitness="always64">
          <Shortcut Id="ShcStartMenu"
                    Name="MyUML20WinV10"
                    Description="MyUML20WinV10 UML 2.0 작성 도구"
                    Target="[INSTALLFOLDER]MyUML20WinV10.exe"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="AppIcon.ico"
                    IconIndex="0" />
          <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
          <RegistryValue Root="HKCU"
                         Key="Software\TestSimulator\MyUML20WinV10\Setup"
                         Name="StartMenuShortcut"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="ProductFeature"
             Title="MyUML20WinV10"
             Description="UML 2.0 클래스 다이어그램 작성 도구"
             Display="expand"
             Level="1">
      <ComponentGroupRef Id="HarvestedApp" />
      <Feature Id="DesktopShortcutFeature"
               Title="바탕 화면 바로 가기"
               Description="바탕 화면에 프로그램 아이콘 바로 가기를 만듭니다."
               Level="1">
        <ComponentRef Id="CmpDesktopShortcut" />
      </Feature>
      <Feature Id="StartMenuShortcutFeature"
               Title="시작 메뉴 바로 가기"
               Description="시작 메뉴에 프로그램 아이콘 바로 가기를 만듭니다."
               Level="1">
        <ComponentRef Id="CmpStartMenuShortcut" />
      </Feature>
    </Feature>

    <ui:WixUI Id="WixUI_Mondo" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
  </Package>

  <Fragment>
    <ComponentGroup Id="HarvestedApp" Directory="INSTALLFOLDER">
      <Files Include="$(var.MyUML20WinV10.TargetDir)**">
        <Exclude Files="*.pdb" />
      </Files>
    </ComponentGroup>
  </Fragment>
</Wix>
