<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MyUML20WinV10</AssemblyName>
    <RootNamespace>MyUML20WinV10</RootNamespace>
    <StartupObject>MyUML20WinV10.Program</StartupObject>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <Platforms>AnyCPU</Platforms>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
  </PropertyGroup>

  <PropertyGroup Condition="'$(DesignTimeBuild)' == 'true'">
    <SkipInstaller>true</SkipInstaller>
    <DefineConstants>$(DefineConstants);DESIGNER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="MyUML20WinV10.Tests\**" />
    <Content Remove="MyUML20WinV10.Tests\**" />
    <EmbeddedResource Remove="MyUML20WinV10.Tests\**" />
    <None Remove="MyUML20WinV10.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\AppIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Templates\templates.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Templates\templates.json</Link>
    </Content>
    <Content Include="Templates\Projects\*.uml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Templates\Projects\%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <Target Name="BuildInstallerMsi" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' AND '$(SkipInstaller)' != 'true' AND '$(DesignTimeBuild)' != 'true' AND '$(MSBuildIsProjectReference)' != 'true'">
    <MSBuild Projects="$(MSBuildThisFileDirectory)installer\MyUML20WinV10.Installer.wixproj" Targets="Restore;Build" Properties="Configuration=Release;SkipInstaller=true" />
  </Target>

  <ItemGroup>
    <Compile Update="MainForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="MainForm.Designer.cs">
      <DependentUpon>MainForm.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="MainForm.resx">
      <DependentUpon>MainForm.cs</DependentUpon>
    </EmbeddedResource>
    <Compile Update="Controls\ModelExplorer.cs" />
    <Compile Update="Controls\UmlCanvas.cs">
      <SubType>Component</SubType>
    </Compile>
    <Compile Update="Controls\UmlDiagramTabBar.cs">
      <SubType>Component</SubType>
    </Compile>
    <Compile Update="Controls\UmlToolbox.cs">
      <SubType>Component</SubType>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PDFsharp" Version="6.*" />
  </ItemGroup>
</Project>
