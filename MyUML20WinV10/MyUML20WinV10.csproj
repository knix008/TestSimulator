<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MyUML20WinV10</AssemblyName>
    <RootNamespace>MyUML20WinV10</RootNamespace>
    <StartupObject>MyUML20WinV10.Program</StartupObject>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\AppIcon.ico" />
  </ItemGroup>

  <Target Name="BuildInstallerMsi" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' AND '$(SkipInstaller)' != 'true' AND '$(DesignTimeBuild)' != 'true'">
    <MSBuild
      Projects="$(MSBuildThisFileDirectory)installer\MyUML20WinV10.Installer.wixproj"
      Targets="Restore;Build"
      Properties="Configuration=Release;Platform=x64" />
  </Target>

  <ItemGroup>
    <Compile Update="MainForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="MainForm.Designer.cs">
      <DependentUpon>MainForm.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="MainForm.resx">
      <DependentUpon>MainForm.cs</DependentUpon>
    </EmbeddedResource>
    <Compile Update="Controls\ModelExplorer.cs">
      <SubType>Component</SubType>
    </Compile>
    <Compile Update="Controls\UmlCanvas.cs">
      <SubType>Component</SubType>
    </Compile>
    <Compile Update="Controls\UmlToolbox.cs">
      <SubType>Component</SubType>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PDFsharp" Version="6.*" />
  </ItemGroup>
</Project>
