{
  "name": "my-video-player-multios",
  "productName": "MyVideoPlayer",
  "version": "1.0.0",
  "description": "Cross-platform video/audio player (Web, Windows, macOS, Linux)",
  "author": "SHKWON <knix008@naver.com>",
  "license": "MIT",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/ensure-tools.js",
    "ensure:tools": "node scripts/ensure-tools.js",
    "ensure:tools:latest": "node scripts/ensure-tools.js --latest",
    "start": "tauri dev",
    "web": "npx --yes serve src -p 5173",
    "test": "node test/run.mjs",
    "test:offline": "node test/run.mjs --offline",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "build:debug": "node scripts/ensure-tools.js && cargo build --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri",
    "pack": "tauri build --no-bundle",
    "build": "tauri build && node scripts/copy-installer-to-root.js",
    "build:win": "tauri build --bundles nsis && node scripts/copy-installer-to-root.js",
    "build:mac": "tauri build --bundles dmg && node scripts/copy-installer-to-root.js",
    "build:linux": "tauri build --bundles appimage,deb && node scripts/copy-installer-to-root.js",
    "dist": "npm run build",
    "dist:win": "npm run build:win",
    "dist:mac": "npm run build:mac",
    "dist:linux": "npm run build:linux"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "ffmpeg-static": "^5.3.0"
  }
}
