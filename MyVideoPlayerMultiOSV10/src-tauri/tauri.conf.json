{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyVideoPlayer",
  "mainBinaryName": "MyVideoPlayer",
  "version": "1.0.0",
  "identifier": "com.shkwon.myvideoplayer",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "node scripts/ensure-tools.js",
    "beforeBuildCommand": "node scripts/ensure-tools.js --latest"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "appimage",
      "deb"
    ],
    "publisher": "SHKWON",
    "copyright": "Copyright © 2026 SHKWON",
    "license": "MIT",
    "licenseFile": "windows/license.txt",
    "category": "Video",
    "shortDescription": "MyVideoPlayer",
    "longDescription": "Multi-format video and audio player with YouTube, Instagram/TikTok and RTSP support",
    "icon": [
      "../asset/icons/32x32.png",
      "../asset/icons/128x128.png",
      "../asset/icons/256x256.png",
      "../asset/icon.ico"
    ],
    "resources": {
      "../vendor/yt-dlp/": "yt-dlp/",
      "../vendor/ffmpeg/": "ffmpeg/",
      "../vendor/deno/": "deno/"
    },
    "fileAssociations": [
      {
        "ext": [
          "mp4",
          "m4v",
          "webm",
          "mkv",
          "mov",
          "avi",
          "ogv",
          "hevc",
          "h265"
        ],
        "name": "MyVideoPlayer Video",
        "description": "Video file",
        "mimeType": "video/mp4",
        "role": "Viewer"
      },
      {
        "ext": [
          "mp3",
          "aac",
          "m4a",
          "wav",
          "flac",
          "opus",
          "ogg",
          "wma"
        ],
        "name": "MyVideoPlayer Audio",
        "description": "Audio file",
        "mimeType": "audio/mpeg",
        "role": "Viewer"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "displayLanguageSelector": true,
        "languages": [
          "Korean",
          "English"
        ],
        "installMode": "currentUser",
        "installerIcon": "../asset/icon.ico",
        "uninstallerIcon": "../asset/icon.ico",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
