<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <BuildTimestamp Condition="'$(BuildTimestamp)' == ''">$([System.DateTime]::Now.ToString("yyyy-MM-dd HH:mm:ss"))</BuildTimestamp>
    <CreateInstaller Condition="'$(CreateInstaller)' == '' and '$(Configuration)' == 'Release'">true</CreateInstaller>
    <InstallerPublishDir>$(MSBuildProjectDirectory)\bin\$(Configuration)\net8.0-windows\win-x64\publish</InstallerPublishDir>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BuildTimestamp</_Parameter1>
      <_Parameter2>$(BuildTimestamp)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\AppIcon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\DcmFile.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="fo-dicom" Version="5.2.6" />
    <PackageReference Include="fo-dicom.Codecs" Version="5.16.7" />
    <PackageReference Include="fo-dicom.Imaging.Desktop" Version="5.2.6" />
  </ItemGroup>

  <Target Name="BuildMsiInstaller"
          AfterTargets="Build"
          Condition="'$(CreateInstaller)' == 'true' and '$(Configuration)' == 'Release'">
    <Message Text="Publishing app for MSI packaging..." Importance="high" />
    <MSBuild Projects="$(MSBuildProjectFullPath)"
             Targets="Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x64;SelfContained=false;CreateInstaller=false" />

    <MSBuild Projects="..\DCMViewer.Installer\DCMViewer.Installer.wixproj"
             Targets="Restore"
             Properties="Configuration=$(Configuration);Platform=x64" />

    <Message Text="Building WiX MSI installer..." Importance="high" />
    <MSBuild Projects="..\DCMViewer.Installer\DCMViewer.Installer.wixproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);Platform=x64;PublishDir=$(InstallerPublishDir)" />
  </Target>

</Project>