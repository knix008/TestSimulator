# DATABASE_URL은 사용하지 않습니다. DB 접속 정보는 .env에 저장되지 않고,
# 서버 실행 후 /connect-db 화면에서 입력하면 그 프로세스가 실행 중인 동안만 메모리에 보관됩니다.
# (npx prisma generate 실행을 위해 더미 값을 하나 넣어 둡니다. 실제 접속에는 사용되지 않습니다.)
DATABASE_URL="mysql://placeholder:placeholder@localhost:3306/placeholder"

NEXTAUTH_SECRET="change-this-to-a-random-string"
NEXTAUTH_URL="http://localhost:3000"
