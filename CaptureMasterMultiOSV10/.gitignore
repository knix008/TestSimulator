# ── Dependencies ────────────────────────────────────────
node_modules/

# ── Build output (all reproducible: npm install && npm run build:<os>) ──
# renderer bundle — npm run build
dist/
# electron-builder output (unpacked app + installers)
release/
# platform icons generated from assets/*.svg — npm run generate:icons
build/icons/
# stamped with the build time and commit on every build — npm run generate:build-info
src/build-info.json
# NOTE: public/icon.svg and public/file-icon.svg are copies of assets/*.svg and
# are committed on purpose — the UI loads them by URL before any build step.

# ── Installers copied to the project root by scripts/copy-installer.js ──
*.exe
*.dmg
*.AppImage
*.deb
*.rpm
*.snap
*.zip
*.blockmap

# ── Smoke-test output (npm run smoke): screenshots, prepared scripts,
#    the private profile, recordings and capture files it writes ──
.smoke/

# ── Local / editor / OS noise ───────────────────────────
*.log
npm-debug.log*
.vite/
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
