# ── Dependencies ────────────────────────────────────────
node_modules/

# ── Build output (all reproducible: npm install && npm run build:win) ──
# renderer bundle — npm run build
dist/
# Rust build output and installers — npm start / npm run build:win
src-tauri/target/
# NSIS setup copied to this folder by postbuild:win (scripts/copy-installer.mjs)
/*-setup.exe
# schemas Tauri regenerates on every Rust build
src-tauri/gen/schemas/
# platform icons generated from assets/*.svg — npm run generate:icons
build/icons/
# stamped with the build time and commit on every build — npm run generate:build-info
src/build-info.json
# NOTE: public/icon.svg and public/file-icon.svg are copies of assets/*.svg and
# are committed on purpose — the UI loads them by URL before any build step.

# ── Local / editor / OS noise ───────────────────────────
*.log
npm-debug.log*
.vite/
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
