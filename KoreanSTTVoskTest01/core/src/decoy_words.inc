// core/src/decoy_words.inc
//
// 문법 인식에 함께 넣는 "미끼" 낱말들. 결과로는 절대 내보내지 않는다.
//
// 왜 필요한가: 한국어 소형 모델은 Vosk 의 "[unk]"(이 중 어느 것도 아님) 표시를
// 모른다. 그래서 문법에 "출근", "퇴근" 만 주면 인식기가 **모든 소리를 둘 중
// 하나로 억지로 맞춘다** — 기침도, 전혀 다른 문장도 "출근" 이 되어 버린다.
//
// 흔한 낱말을 함께 넣어 두면 인식기가 그쪽으로 빠져나갈 수 있고, 우리는 그것들을
// 결과에서 떨어내면 된다. 실제로 "안녕하세요 오늘 날씨가 참 좋습니다…" 를 넣었을
// 때 미끼가 없으면 "출근 퇴근 출근 …" 이 나오고, 있으면 아무것도 나오지 않는다.
//
// 모델이 모르는 낱말은 적재할 때 걸러내므로, 목록에 조금 섞여 있어도 괜찮다.
static const char* const kDecoyWords[] = {
    // 조사·어미 — 말끝이 여기로 빠져나간다
    "은", "는", "이", "가", "을", "를", "에", "에서", "으로", "로", "와", "과",
    "도", "만", "까지", "부터", "보다", "처럼", "에게", "한테", "의", "요",
    "입니다", "습니다", "합니다", "했습니다", "합니까", "해요", "했어요", "하고",
    "하는", "하지", "하면", "해서", "이다", "있다", "없다", "같다",

    // 대명사·지시어
    "그", "저", "이것", "그것", "저것", "여기", "거기", "저기", "누구", "무엇",
    "어디", "언제", "왜", "어떻게", "우리", "저희", "너", "나", "당신",

    // 아주 흔한 명사
    "사람", "시간", "오늘", "내일", "어제", "지금", "아침", "점심", "저녁", "밤",
    "회사", "사무실", "집", "학교", "일", "업무", "회의", "식사", "휴가", "주말",
    "전화", "메일", "문서", "자료", "보고", "결재", "과장", "부장", "팀장", "대리",
    "이름", "번호", "시작", "종료", "확인", "취소", "등록", "수정", "삭제", "저장",
    "날씨", "음성", "인식", "시험", "말", "소리", "화면", "컴퓨터", "전원",
    "자리", "책상", "문", "창문", "차", "버스", "지하철", "길", "밥", "물", "커피",

    // 흔한 동사·형용사
    "가다", "오다", "하다", "되다", "보다", "주다", "받다", "알다", "모르다",
    "좋다", "좋습니다", "나쁘다", "크다", "작다", "많다", "적다", "빠르다", "느리다",
    "시작하다", "끝나다", "기다리다", "들어가다", "나가다", "돌아오다",

    // 인사·짧은 말 — 마이크 앞에서 자주 나온다
    "안녕하세요", "감사합니다", "고맙습니다", "죄송합니다", "네", "아니요", "예",
    "여보세요", "잠깐", "잠시", "그래", "맞아", "아니", "음", "어",

