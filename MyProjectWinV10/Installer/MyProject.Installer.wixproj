<Project Sdk="WixToolset.Sdk/4.0.5">
  <PropertyGroup>
    <OutputName>MyProject_Setup</OutputName>
    <UpgradeCode>A1B2C3D4-E5F6-7890-ABCD-EF1234567890</UpgradeCode>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyProject.csproj" Publish="true" AdditionalProperties="BuildingMsiPackage=true" />
  </ItemGroup>

  <ItemGroup>
    <BindPath Include="$(MSBuildThisFileDirectory)obj\$(Configuration)\publish\MyProject" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="4.0.5" />
    <PackageReference Include="WixToolset.Util.wixext" Version="4.0.5" />
  </ItemGroup>

  <Target Name="ReportMsiOutput" AfterTargets="Build">
    <Message Importance="high" Text="MSI created: $(TargetPath)" Condition="Exists('$(TargetPath)')" />
  </Target>

  <!-- Visual Studio 17.13+ design-time build compatibility -->
  <Target Name="CollectSuggestedVisualStudioComponentIds" />
</Project>
