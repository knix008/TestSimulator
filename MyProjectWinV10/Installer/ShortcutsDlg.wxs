<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Fragment>
    <UI>
      <Dialog Id="ShortcutsDlg" Width="370" Height="270" Title="[ProductName] 설치">
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="15" Width="340" Height="20" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}바로 가기" />
        <Control Id="Description" Type="Text" X="25" Y="54" Width="330" Height="40" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Normal}MyProject를 실행할 바로 가기를 만들 위치를 선택하세요." />
        <Control Id="DesktopShortcut" Type="CheckBox" X="25" Y="110" Width="320" Height="17" Property="INSTALLDESKTOPSHORTCUT" CheckBoxValue="1" Text="바탕 화면에 바로 가기 만들기" />
        <Control Id="StartMenuShortcut" Type="CheckBox" X="25" Y="136" Width="320" Height="17" Property="INSTALLSTARTMENUSHORTCUT" CheckBoxValue="1" Text="시작 메뉴에 바로 가기 만들기" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="&amp;뒤로" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="&amp;다음" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="취소" />
      </Dialog>
    </UI>
  </Fragment>

</Wix>
