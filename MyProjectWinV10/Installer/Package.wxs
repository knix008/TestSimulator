<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="MyProject"
           Manufacturer="MyProject"
           Version="1.0.0.0"
           UpgradeCode="A1B2C3D4-E5F6-7890-ABCD-EF1234567890"
           Scope="perMachine"
           Codepage="65001">

    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <!-- Use the published EXE icon so Add/Remove Programs shows the app icon during uninstall. -->
    <Icon Id="ProductIcon.ico" SourceFile="MyProject.exe" />
    <Property Id="ARPPRODUCTICON" Value="ProductIcon.ico" />

    <Property Id="INSTALLDESKTOPSHORTCUT" Value="1" />
    <Property Id="INSTALLSTARTMENUSHORTCUT" Value="1" />

    <ui:WixUI Id="MyProject_InstallDir" InstallDirectory="INSTALLFOLDER" />

    <Feature Id="ProductFeature" Title="MyProject" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentRef Id="InstallFolderCleanup" />
      <ComponentRef Id="PreviousInstallFolderCleanup" />
      <ComponentRef Id="UserDataFolderCleanup" />
      <ComponentRef Id="LegacyX86InstallFolderCleanup" />
      <ComponentRef Id="LegacyX86RegistryCleanup" />
      <ComponentRef Id="ApplicationShortcutDesktop" />
      <ComponentRef Id="ApplicationShortcutStartMenu" />
    </Feature>

  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="MyProject">
        <Directory Id="TemplateDir" Name="Template" />
        <Directory Id="AssetsDir" Name="Assets" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="MyProject" />
    </StandardDirectory>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component>
        <File Id="MyProjectExe" Source="MyProject.exe" KeyPath="yes" />
      </Component>

      <Component Directory="TemplateDir">
        <File Source="Template\Template Project.myprj" KeyPath="yes" />
      </Component>

      <Component Directory="AssetsDir">
        <File Source="Assets\MyProject.ico" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Component Id="InstallFolderCleanup"
               Directory="INSTALLFOLDER"
               Guid="D4E5F6A7-B8C9-4012-DEF0-1234567890AB">
      <CreateFolder />
      <!-- Remove orphaned program files in the target folder before reinstall and on uninstall. -->
      <util:RemoveFolderEx On="both" Property="INSTALLFOLDER_CLEANUP" />
      <RegistryValue Root="HKLM"
                     Key="Software\MyProject"
                     Name="InstallPath"
                     Type="string"
                     Value="[INSTALLFOLDER]"
                     KeyPath="yes" />
    </Component>

    <Component Id="PreviousInstallFolderCleanup"
               Directory="INSTALLFOLDER"
               Guid="A3B4C5D6-E7F8-4901-ABCD-EF0123456789"
               Condition="PREVIOUSINSTALLFOLDER_CLEANUP">
      <CreateFolder />
      <!-- Remove a previous install folder when the user picks a different path. -->
      <util:RemoveFolderEx On="install" Property="PREVIOUSINSTALLFOLDER_CLEANUP" />
      <RegistryValue Root="HKLM"
                     Key="Software\MyProject"
                     Name="PreviousInstallCleaned"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>

    <Component Id="UserDataFolderCleanup"
               Directory="INSTALLFOLDER"
               Guid="B4C5D6E7-F809-4123-BCDE-F1234567890A">
      <CreateFolder />
      <!-- Remove %LocalAppData%\MyProject on reinstall and uninstall. -->
      <util:RemoveFolderEx On="both" Property="USERDATAFOLDER_CLEANUP" />
      <RegistryValue Root="HKLM"
                     Key="Software\MyProject"
                     Name="UserDataCleaned"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>

    <Component Id="LegacyX86InstallFolderCleanup"
               Directory="INSTALLFOLDER"
               Guid="F1A2B3C4-D5E6-4789-ABCD-EF0123456789">
      <CreateFolder />
      <util:RemoveFolderEx On="install" Property="LEGACY_X86_FOLDER_CLEANUP" />
    </Component>

    <Component Id="LegacyX86RegistryCleanup"
               Directory="INSTALLFOLDER"
               Guid="E2B3C4D5-F6A7-4890-BCDE-F12345678903">
      <CreateFolder />
      <RemoveRegistryKey Root="HKLM"
                         Key="Software\Wow6432Node\MyProject"
                         Action="removeOnInstall" />
    </Component>

    <Component Id="ApplicationShortcutDesktop"
               Directory="DesktopFolder"
               Guid="B1C2D3E4-F5A6-4789-BCDE-F12345678901"
               Condition="INSTALLDESKTOPSHORTCUT">
      <Shortcut Id="DesktopShortcut"
                Name="MyProject"
                Description="MyProject Project Manager"
                Target="[INSTALLFOLDER]MyProject.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="ProductIcon.ico" />
      <RegistryValue Root="HKCU"
                     Key="Software\MyProject"
                     Name="DesktopShortcut"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>

    <Component Id="ApplicationShortcutStartMenu"
               Directory="ApplicationProgramsFolder"
               Guid="C2D3E4F5-A6B7-4890-CDEF-123456789012"
               Condition="INSTALLSTARTMENUSHORTCUT">
      <Shortcut Id="StartMenuShortcut"
                Name="MyProject"
                Description="MyProject Project Manager"
                Target="[INSTALLFOLDER]MyProject.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="ProductIcon.ico" />
      <RemoveFolder Id="ApplicationProgramsFolderRemove" On="uninstall" />
      <RegistryValue Root="HKCU"
                     Key="Software\MyProject"
                     Name="StartMenuShortcut"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>
  </Fragment>

</Wix>
