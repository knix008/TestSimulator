<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Fragment>
    <!-- Detect any prior install (including legacy x86) that shares our UpgradeCode. -->
    <Upgrade Id="A1B2C3D4-E5F6-7890-ABCD-EF1234567890">
      <UpgradeVersion Minimum="0.0.0.0"
                      Maximum="99.9.9.9"
                      Property="PREVIOUSX86PRODUCT"
                      IncludeMinimum="yes"
                      IncludeMaximum="yes" />
    </Upgrade>

    <Property Id="LOCALAPPDATAFOLDER" Secure="yes">
      <RegistrySearch Id="LocalAppDataSearch"
                      Root="HKCU"
                      Key="Software\Microsoft\Windows\CurrentVersion\Explorer\Shell Folders"
                      Name="Local AppData"
                      Type="raw" />
    </Property>

    <Property Id="ARPINSTALLLOCATION">
      <RegistrySearch Id="SearchArpInstallLocation"
                      Root="HKLM"
                      Key="Software\MyProject"
                      Name="InstallPath"
                      Type="raw" />
    </Property>

    <!-- Legacy x86 installs wrote InstallPath under the 32-bit registry view. -->
    <Property Id="LEGACY_X86_INSTALLFOLDER">
      <RegistrySearch Id="SearchLegacyX86InstallPath"
                      Root="HKLM"
                      Key="Software\MyProject"
                      Name="InstallPath"
                      Type="raw"
                      Bitness="always32" />
    </Property>

    <SetProperty Id="INSTALLFOLDER_CLEANUP"
                 Value="[INSTALLFOLDER]"
                 Before="CostInitialize"
                 Sequence="both" />

    <SetProperty Id="USERDATAFOLDER_CLEANUP"
                 Value="[LOCALAPPDATAFOLDER]MyProject"
                 Before="CostInitialize"
                 Sequence="both" />

    <SetProperty Id="PREVIOUSINSTALLFOLDER_CLEANUP"
                 Value="[ARPINSTALLLOCATION]"
                 Before="CostInitialize"
                 Sequence="both"
                 Condition="ARPINSTALLLOCATION" />

    <SetProperty Id="LEGACY_X86_FOLDER_CLEANUP"
                 Value="[LEGACY_X86_INSTALLFOLDER]"
                 Before="CostInitialize"
                 Sequence="both"
                 Condition="LEGACY_X86_INSTALLFOLDER" />

    <!-- MajorUpgrade does not remove cross-bitness products; uninstall legacy x86 MSI first. -->
    <SetProperty Id="QuietUninstallLegacyX86"
                 Value="&quot;[SystemFolder]msiexec.exe&quot; /x [PREVIOUSX86PRODUCT] /qn REBOOT=ReallySuppress"
                 Before="QuietUninstallLegacyX86"
                 Sequence="execute"
                 Condition="PREVIOUSX86PRODUCT AND NOT UPGRADINGPRODUCTCODE AND NOT REMOVE=&quot;ALL&quot;" />

    <CustomAction Id="QuietUninstallLegacyX86"
                  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  DllEntry="WixQuietExec"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!-- Belt-and-suspenders user-data purge using the app itself (install + uninstall). -->
    <CustomAction Id="PurgeUserSettings"
                  FileRef="MyProjectExe"
                  ExeCommand="--purge-settings"
                  Execute="deferred"
                  Impersonate="yes"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="QuietUninstallLegacyX86"
              After="InstallInitialize"
              Condition="PREVIOUSX86PRODUCT AND NOT UPGRADINGPRODUCTCODE AND NOT REMOVE=&quot;ALL&quot;" />

      <!-- Always purge user settings on reinstall and on full uninstall. -->
      <Custom Action="PurgeUserSettings"
              After="InstallFiles"
              Condition="NOT REMOVE=&quot;ALL&quot;" />

      <Custom Action="PurgeUserSettings"
              Before="RemoveFiles"
              Condition='REMOVE="ALL"' />
    </InstallExecuteSequence>
  </Fragment>

</Wix>
