<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MyProject</AssemblyName>
    <RootNamespace>MyProject</RootNamespace>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Company>MyProject</Company>
    <Product>MyProject Project Manager</Product>
    <Copyright>Copyright © 2026</Copyright>
    <ApplicationIcon>Assets\MyProject.ico</ApplicationIcon>
    <UseAppHost>true</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.2" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <!-- Prevents DotNetDeltaApplier.dll from loading its named pipe to VS,
         which can block VS UI thread cleanup when the debugged process exits. -->
    <HotReloadEnabled>false</HotReloadEnabled>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <PropertyGroup Condition="'$(DesignTimeBuild)' == 'true'">
    <SkipInstaller>true</SkipInstaller>
  </PropertyGroup>

  <PropertyGroup>
    <SetupProjectPath>$(MSBuildThisFileDirectory)Installer\MyProject.Installer.wixproj</SetupProjectPath>
    <MsiOutputPath>$(MSBuildThisFileDirectory)Installer\bin\Release\MyProject_Setup.msi</MsiOutputPath>
  </PropertyGroup>

  <Target Name="RemindMsiRequiresRelease"
          AfterTargets="Build"
          Condition="'$(Configuration)' != 'Release' and '$(BuildingMsiPackage)' != 'true' and '$(SkipInstaller)' != 'true'">
    <Message Importance="high" Text="MSI is not built in $(Configuration) configuration. Switch to Release | Any CPU and rebuild to create MyProject_Setup.msi." />
  </Target>

  <Target Name="BuildInstallerMsi"
          AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release' and '$(BuildingMsiPackage)' != 'true' and '$(SkipInstaller)' != 'true' and '$(DesignTimeBuild)' != 'true' and '$(MSBuildIsProjectReference)' != 'true' and Exists('$(SetupProjectPath)')">
    <MSBuild Projects="$(SetupProjectPath)"
             Targets="Restore"
             Properties="Configuration=Release;BuildingMsiPackage=true"
             BuildInParallel="false" />
    <MSBuild Projects="$(SetupProjectPath)"
             Targets="Build"
             Properties="Configuration=Release;BuildingMsiPackage=true"
             BuildInParallel="false" />
    <Error Condition="!Exists('$(MsiOutputPath)')"
           Text="MSI was not created at $(MsiOutputPath). See MyProject.Installer build output for errors." />
    <Copy SourceFiles="$(MsiOutputPath)"
          DestinationFiles="$(OutputPath)MyProject_Setup.msi"
          SkipUnchangedFiles="true"
          Condition="Exists('$(MsiOutputPath)')" />
    <Message Importance="high" Text="MSI ready: $(MsiOutputPath)" />
    <Message Importance="high" Text="MSI copy: $(OutputPath)MyProject_Setup.msi" Condition="Exists('$(OutputPath)MyProject_Setup.msi')" />
  </Target>

  <ItemGroup>
    <Content Include="Template\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Assets\MyProject.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>