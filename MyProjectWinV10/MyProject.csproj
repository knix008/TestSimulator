<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>MyProject</RootNamespace>
    <AssemblyName>MyProject</AssemblyName>
    <StartupObject>MyProject.Program</StartupObject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\MyProject.ico</ApplicationIcon>
    <UseAppHost>true</UseAppHost>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Company>MyProject</Company>
    <Product>MyProject Project Manager</Product>
    <Copyright>Copyright © 2026</Copyright>
    <!-- Required so MSI publish (win-x64) can restore MPXJ/IKVM assets without affecting normal Release output. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <!-- IKVM: shared cache + unique stage dir per build so concurrent VS/CLI builds do not lock the same .log files. -->
  <PropertyGroup>
    <_IkvmBuildId>$([System.Guid]::NewGuid())</_IkvmBuildId>
    <IkvmCacheDir>$(LOCALAPPDATA)\IKVM\cache\</IkvmCacheDir>
    <IkvmStageDir>$(LOCALAPPDATA)\IKVM\stage\$(_IkvmBuildId)\</IkvmStageDir>
    <IkvmExportStageDir>$(LOCALAPPDATA)\IKVM\expstage\$(_IkvmBuildId)\</IkvmExportStageDir>
    <MavenCacheFile>$(LOCALAPPDATA)\IKVM\$(ProjectName).maven.cache</MavenCacheFile>
  </PropertyGroup>

  <!-- WinForms: avoid hot reload and keep a native exe for reliable VS debug stop. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <HotReloadEnabled>false</HotReloadEnabled>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <!-- MSI publish only (MyProject.Installer sets BuildingMsiPackage=true). -->
  <PropertyGroup Condition="'$(BuildingMsiPackage)' == 'true'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.2.0" />
    <PackageReference Include="MPXJ.Net" Version="16.4.0" />
    <PackageReference Include="QuestPDF" Version="2024.12.3" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\MyProject.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="Template\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <PropertyGroup>
    <SetupProjectPath>$(MSBuildThisFileDirectory)Installer\MyProject.Installer.wixproj</SetupProjectPath>
    <MsiOutputPath>$(MSBuildThisFileDirectory)Installer\bin\$(Configuration)\MyProject_Setup.msi</MsiOutputPath>
  </PropertyGroup>

  <!-- Visual Studio often cannot build WixToolset.Sdk projects without the WiX extension.
       Build MSI via dotnet after a normal Release build of this project. -->
  <Target Name="BuildInstallerMsi"
          AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release'
                     and '$(BuildingMsiPackage)' != 'true'
                     and '$(DesignTimeBuild)' != 'true'
                     and Exists('$(SetupProjectPath)')">
    <Message Importance="high" Text="Building MSI installer..." />
    <Exec Command="dotnet build &quot;$(SetupProjectPath)&quot; -c Release -p:BuildingMsiPackage=true -m:1 -v minimal"
          WorkingDirectory="$(MSBuildProjectDirectory)" />
    <Error Condition="!Exists('$(MsiOutputPath)')"
           Text="MSI was not created at $(MsiOutputPath). Install the WiX Toolset VS extension, or run: dotnet build Installer\MyProject.Installer.wixproj -c Release" />
    <Copy SourceFiles="$(MsiOutputPath)"
          DestinationFiles="$(OutputPath)MyProject_Setup.msi"
          SkipUnchangedFiles="true"
          Condition="Exists('$(MsiOutputPath)')" />
    <Message Importance="high" Text="MSI ready: $(OutputPath)MyProject_Setup.msi" Condition="Exists('$(MsiOutputPath)')" />
  </Target>

</Project>
