<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Avoid stale/incomplete packages in VS Shared\NuGetPackages breaking restore. -->
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
