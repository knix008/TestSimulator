<Project>

  <!-- Shared build settings for MyProject (app + installer publish). -->

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NuGetAudit>false</NuGetAudit>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);IKVM0100;IKVM0101;IKVM0109;NU1503;NU1603;NU1605;NU1701;NU1900;NU1901;NU1902;NU1903;NU1904</NoWarn>
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3026;MSB3027</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <!-- Visual Studio: lighter builds, no hot reload for WinForms. -->
  <PropertyGroup Condition="'$(BuildingInsideVisualStudio)' == 'true'">
    <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
    <RunAnalyzersDuringLiveAnalysis>false</RunAnalyzersDuringLiveAnalysis>
    <HotReloadEnabled>false</HotReloadEnabled>
    <BuildInParallel>false</BuildInParallel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugType>portable</DebugType>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <!-- Share IKVM/MPXJ Java translation cache with Debug (DebugSymbols must match). -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <!-- Release restore includes win-x64 so MSI publish does not need a second restore. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(MSBuildProjectExtension)' == '.csproj'">
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <!-- MPXJ.Net / IKVM: user-level cache (not under obj/) to avoid VS file locks. -->
  <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <_IkvmBuildId Condition="'$(DesignTimeBuild)' == 'true'">DesignTime</_IkvmBuildId>
    <_IkvmBuildId Condition="'$(DesignTimeBuild)' != 'true'">$(Configuration)</_IkvmBuildId>
    <IkvmCacheDir>$(LOCALAPPDATA)\IKVM\cache\</IkvmCacheDir>
    <IkvmStageDir>$(LOCALAPPDATA)\IKVM\stage\$(_IkvmBuildId)\</IkvmStageDir>
    <IkvmExportStageDir>$(LOCALAPPDATA)\IKVM\expstage\$(_IkvmBuildId)\</IkvmExportStageDir>
    <MavenCacheFile>$(LOCALAPPDATA)\IKVM\$(MSBuildProjectName).maven.cache</MavenCacheFile>
  </PropertyGroup>

  <!-- WiX installer publish only (MyProject.Installer.wixproj). -->
  <PropertyGroup Condition="'$(BuildingMsiPackage)' == 'true'">
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

</Project>
