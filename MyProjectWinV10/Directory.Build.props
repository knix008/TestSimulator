<Project>
  <PropertyGroup>
    <!-- NuGet/디자인타임 평가에서는 SDK 경고(NU1503 등)를 오류로 승격하지 않음. -->
    <TreatWarningsAsErrors Condition="'$(DesignTimeBuild)' == 'true' or '$(BuildingProject)' != 'true'">false</TreatWarningsAsErrors>
    <TreatWarningsAsErrors Condition="'$(DesignTimeBuild)' != 'true' and '$(BuildingProject)' == 'true'">true</TreatWarningsAsErrors>
    <NuGetAudit>false</NuGetAudit>
    <!-- MPXJ.Net / IKVM: non-actionable Java translation warnings on first publish. -->
    <NoWarn>$(NoWarn);IKVM0100;IKVM0101;IKVM0109;NU1503;NU1603;NU1605;NU1701;NU1900;NU1901;NU1902;NU1903;NU1904</NoWarn>
    <!-- App still running during rebuild: avoid failing the build on file-copy retries. -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3026;MSB3027</MSBuildWarningsAsMessages>
  </PropertyGroup>
</Project>
