JWT_SECRET=req-tracking-secret-key-change-in-production
PORT=3001

# 기본 DB: MariaDB (Setup Wizard에서 설정)
# 아래 값은 초기 설정 화면 기본값으로 사용됩니다.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=reqtracking

# 비밀번호 변경 알림 메일 (SMTP)
# 미설정 시 서버 콘솔에 알림 내용이 출력됩니다.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Req Tracking Board <noreply@example.com>
