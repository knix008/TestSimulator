<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="MyDiagramWinV10"
           Manufacturer="TestSimulator"
           Version="1.0.0.0"
           UpgradeCode="C4D8E2F1-9A3B-4C5D-8E7F-1A2B3C4D5E6F"
           Scope="perMachine"
           InstallerVersion="500"
           Codepage="65001">
    <MajorUpgrade DowngradeErrorMessage="A newer version of MyDiagramWinV10 is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <WixVariable Id="WixUILicenseRtf" Value="assets\License.rtf" />

    <Icon Id="AppIcon.ico" SourceFile="assets\AppIcon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />

    <Launch Condition="Privileged"
            Message="관리자 권한이 필요합니다. 설치 파일을 관리자 권한으로 실행해 주세요." />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="MyDiagramWinV10" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="CmpDesktopShortcut" Guid="*" Bitness="always64">
        <Shortcut Id="ShcDesktop"
                  Name="MyDiagramWinV10"
                  Description="MyDiagramWinV10 다이어그램 편집기"
                  Target="[INSTALLFOLDER]MyDiagramWinV10.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon.ico"
                  IconIndex="0" />
        <RegistryValue Root="HKCU"
                       Key="Software\TestSimulator\MyDiagramWinV10\Setup"
                       Name="DesktopShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="MyDiagramWinV10">
        <Component Id="CmpStartMenuShortcut" Guid="*" Bitness="always64">
          <Shortcut Id="ShcStartMenu"
                    Name="MyDiagramWinV10"
                    Description="MyDiagramWinV10 다이어그램 편집기"
                    Target="[INSTALLFOLDER]MyDiagramWinV10.exe"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="AppIcon.ico"
                    IconIndex="0" />
          <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
          <RegistryValue Root="HKCU"
                         Key="Software\TestSimulator\MyDiagramWinV10\Setup"
                         Name="StartMenuShortcut"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="MyDiagramWinV10" Level="1">
      <ComponentGroupRef Id="HarvestedApp" />
      <ComponentRef Id="CmpDesktopShortcut" />
      <ComponentRef Id="CmpStartMenuShortcut" />
    </Feature>

    <ui:WixUI Id="WixUI_InstallDir" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
  </Package>

  <Fragment>
    <ComponentGroup Id="HarvestedApp" Directory="INSTALLFOLDER">
      <Files Include="$(var.MyDiagramWinV10.TargetDir)**">
        <Exclude Files="*.pdb" />
      </Files>
    </ComponentGroup>
  </Fragment>
</Wix>
