{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyBroadcasting",
  "mainBinaryName": "MyBroadcasting",
  "version": "../package.json",
  "identifier": "com.shkwon.mybroadcasting",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5660",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$APPLOCALDATA/**",
          "$APPCONFIG/**",
          "$RESOURCE/doc/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "SHKWON",
    "copyright": "Copyright (c) SHKWON (knix008@naver.com)",
    "category": "Video",
    "shortDescription": "Personal broadcasting studio: scenes, sources, recording, streaming",
    "longDescription": "Build scenes from screens, windows, cameras, microphones, media, pictures, browser pages and text; add video and audio filters; mix the sound; switch scenes with transitions or in studio mode; record, stream (RTMP, RTMPS, SRT, RIST, WHIP), keep a replay buffer and print production reports.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../public/doc/": "doc/",
      "resources/vcam/": "vcam/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Korean",
          "English"
        ],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "headerImage": "windows/installerHeader.bmp",
        "sidebarImage": "windows/installerSidebar.bmp",
        "installerHooks": "windows/hooks.nsh",
        "startMenuFolder": "MyBroadcasting"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3"
        ]
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "mybc"
        ],
        "name": "MyBroadcasting scene collection",
        "description": "MyBroadcasting scene collection",
        "role": "Editor",
        "mimeType": "application/x-mybroadcasting"
      }
    ]
  }
}
