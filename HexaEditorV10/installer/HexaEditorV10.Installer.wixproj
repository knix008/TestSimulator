<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <Platform>x64</Platform>
    <OutputPath>$(MSBuildThisFileDirectory)msi\$(Configuration)\</OutputPath>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
    <ProjectReference Include="..\HexaEditorV10.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="PublishApp" BeforeTargets="PrepareForBuild">
    <Exec Command="dotnet publish &quot;..\HexaEditorV10.csproj&quot; -c Release -r win-x64 --self-contained true /p:PublishSingleFile=true /p:IncludeNativeLibrariesForSelfExtract=true" />
  </Target>
</Project>
