<UserControl x:Class="MyMindWin.Controls.MindMapCanvasControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1A1F2E"
             Focusable="True"
             ClipToBounds="True">

    <UserControl.Resources>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer x:Name="CanvasScroller"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      PanningMode="None"
                      PreviewMouseWheel="CanvasScroller_PreviewMouseWheel"
                      PreviewMouseDown="CanvasScroller_PreviewMouseDown"
                      PreviewMouseMove="CanvasScroller_PreviewMouseMove"
                      PreviewMouseUp="CanvasScroller_PreviewMouseUp">
            <Canvas x:Name="RootCanvas"
                    Background="Transparent"
                    MouseDown="RootCanvas_MouseDown">
                <Canvas.LayoutTransform>
                    <ScaleTransform x:Name="ScaleXform" ScaleX="1" ScaleY="1"/>
                </Canvas.LayoutTransform>

                <!-- Connection layer (rendered first = behind nodes) -->
                <Canvas x:Name="ConnectionCanvas" IsHitTestVisible="False"/>

                <!-- Node layer -->
                <Canvas x:Name="NodeCanvas"/>
            </Canvas>
        </ScrollViewer>

        <!-- 편집 오버레이: ScrollViewer 위에 겹치며 노드와 동일한 화면 좌표 사용 -->
        <Canvas x:Name="EditOverlay" IsHitTestVisible="False">
            <Border x:Name="EditBorder"
                    Visibility="Collapsed"
                    IsHitTestVisible="True"
                    CornerRadius="12"
                    BorderBrush="#64B5F6"
                    BorderThickness="2"
                    Background="#1A2744"
                    Padding="10,0,10,0">
                <TextBox x:Name="EditBox"
                         FontFamily="Segoe UI"
                         FontSize="13"
                         FontWeight="SemiBold"
                         Padding="0"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="White"
                         CaretBrush="White"
                         VerticalAlignment="Center"
                         VerticalContentAlignment="Center"
                         KeyDown="EditBox_KeyDown"
                         LostFocus="EditBox_LostFocus"/>
            </Border>
        </Canvas>

        <!-- Zoom indicator -->
        <Border HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="12"
                Padding="8,4"
                Background="#33FFFFFF"
                CornerRadius="4"
                IsHitTestVisible="False">
            <TextBlock x:Name="ZoomLabel"
                       Foreground="#AAFFFFFF"
                       FontFamily="Segoe UI"
                       FontSize="11"
                       Text="100%"/>
        </Border>
    </Grid>
</UserControl>
