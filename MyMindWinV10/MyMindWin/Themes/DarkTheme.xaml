<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 공통 팔레트 -->
    <Color x:Key="AppMenuBgColor">#2A3548</Color>
    <Color x:Key="AppMenuHighlightColor">#3D5080</Color>
    <Color x:Key="AppMenuForegroundColor">#F0F4FF</Color>
    <Color x:Key="AppMenuMutedColor">#8FA8CC</Color>
    <Color x:Key="AppMenuDisabledColor">#6688AA</Color>
    <Color x:Key="AppMenuBorderColor">#6A7FA8</Color>
    <Color x:Key="AppMenuSeparatorColor">#334466</Color>

    <SolidColorBrush x:Key="AppMenuBg" Color="{StaticResource AppMenuBgColor}"/>
    <SolidColorBrush x:Key="AppMenuHighlightBg" Color="{StaticResource AppMenuHighlightColor}"/>
    <SolidColorBrush x:Key="AppMenuForeground" Color="{StaticResource AppMenuForegroundColor}"/>
    <SolidColorBrush x:Key="AppMenuMuted" Color="{StaticResource AppMenuMutedColor}"/>
    <SolidColorBrush x:Key="AppMenuBorder" Color="{StaticResource AppMenuBorderColor}"/>
    <SolidColorBrush x:Key="AppMenuSeparatorBrush" Color="{StaticResource AppMenuSeparatorColor}"/>

    <!-- WPF 기본 메뉴/팝업이 참조하는 시스템 색 (밝은 테마 → 다크로 덮어씀) -->
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="{StaticResource AppMenuBgColor}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="{StaticResource AppMenuForegroundColor}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBarBrushKey}" Color="#0D101A"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuHighlightBrushKey}" Color="{StaticResource AppMenuHighlightColor}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{StaticResource AppMenuHighlightColor}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{StaticResource AppMenuForegroundColor}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="{StaticResource AppMenuBgColor}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="{StaticResource AppMenuForegroundColor}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="{StaticResource AppMenuBgColor}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="{StaticResource AppMenuForegroundColor}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="{StaticResource AppMenuDisabledColor}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#334466"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#AABBCC"/>

    <!-- 상단 메뉴 바 -->
    <Style TargetType="{x:Type Menu}">
        <Setter Property="Background" Value="#0D101A"/>
        <Setter Property="Foreground" Value="#CCFFFFFF"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Grid.IsSharedSizeScope" Value="True"/>
    </Style>

    <!-- 드롭다운 팝업 배경 (Popup 내부 ItemsPresenter 감싸는 Border) -->
    <Style TargetType="{x:Type Popup}">
        <Setter Property="Grid.IsSharedSizeScope" Value="True"/>
    </Style>

    <!-- 메뉴 항목 (드롭다운·하위 메뉴 포함) -->
    <Style TargetType="{x:Type MenuItem}">
        <Setter Property="Background" Value="{StaticResource AppMenuBg}"/>
        <Setter Property="Foreground" Value="{StaticResource AppMenuForeground}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="3"
                            Margin="2,1"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Icon"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Shortcut"/>
                                <ColumnDefinition Width="13"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="IconBd"
                                    Grid.Column="0"
                                    Width="22" Height="22"
                                    Margin="2,0,4,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <Viewbox Width="14" Height="14">
                                    <ContentPresenter Content="{TemplateBinding Icon}"/>
                                </Viewbox>
                            </Border>
                            <ContentPresenter x:Name="HeaderText"
                                              Grid.Column="1"
                                              ContentSource="Header"
                                              Margin="6,4,6,4"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{StaticResource AppMenuForeground}"/>
                            <TextBlock x:Name="GestureText"
                                       Grid.Column="2"
                                       Text="{TemplateBinding InputGestureText}"
                                       Margin="8,4,4,4"
                                       Foreground="{StaticResource AppMenuMuted}"
                                       FontSize="10"
                                       VerticalAlignment="Center"/>
                            <Path x:Name="Arrow"
                                  Grid.Column="3"
                                  Data="M 0,0 L 4,4 L 0,8 Z"
                                  Fill="{StaticResource AppMenuForeground}"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center"
                                  Visibility="Collapsed"/>
                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsSubmenuOpen}"
                                   Placement="Right"
                                   HorizontalOffset="-4"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="{StaticResource AppMenuBg}"
                                        BorderBrush="{StaticResource AppMenuBorder}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="4,2"
                                        SnapsToDevicePixels="True">
                                    <ItemsPresenter x:Name="ItemsPresenter"
                                                    KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Role" Value="TopLevelHeader">
                            <Setter TargetName="IconBd" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Arrow" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom"/>
                            <Setter TargetName="PART_Popup" Property="HorizontalOffset" Value="0"/>
                        </Trigger>
                        <Trigger Property="Role" Value="TopLevelItem">
                            <Setter TargetName="IconBd" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Arrow" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#4A6CAE"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#5A7CBE"/>
                            <Setter TargetName="HeaderText" Property="TextElement.Foreground" Value="White"/>
                            <Setter TargetName="GestureText" Property="Foreground" Value="#CCDDFF"/>
                            <Setter TargetName="Arrow" Property="Fill" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#3D5A9A"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#5A7CBE"/>
                            <Setter TargetName="HeaderText" Property="TextElement.Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="HeaderText" Property="TextElement.Foreground" Value="{StaticResource AppMenuDisabledColor}"/>
                            <Setter TargetName="GestureText" Property="Foreground" Value="{StaticResource AppMenuDisabledColor}"/>
                            <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource AppMenuDisabledColor}"/>
                        </Trigger>
                        <Trigger Property="IsCheckable" Value="True">
                            <Setter TargetName="IconBd" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsCheckable" Value="True"/>
                                <Condition Property="IsChecked" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="IconBd" Property="Background" Value="#3355AA"/>
                            <Setter TargetName="IconBd" Property="CornerRadius" Value="3"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

  <!-- 컨텍스트 메뉴 팝업 -->
    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="Background" Value="{StaticResource AppMenuBg}"/>
        <Setter Property="Foreground" Value="{StaticResource AppMenuForeground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AppMenuBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <StackPanel IsItemsHost="True"
                                    Background="{TemplateBinding Background}"
                                    KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 메뉴·컨텍스트 메뉴 구분선 (툴바 Separator는 ToolbarSep 유지) -->
    <Style TargetType="{x:Type Separator}">
        <Setter Property="Background" Value="{StaticResource AppMenuSeparatorBrush}"/>
        <Setter Property="Margin" Value="8,4"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1"
                            Margin="{TemplateBinding Margin}"
                            Background="{StaticResource AppMenuSeparatorBrush}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 메뉴 체크 항목(좌우 반전 등) 내부 체크박스 -->
    <Style TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="{StaticResource AppMenuForeground}"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style TargetType="{x:Type ToolTip}">
        <Setter Property="Background" Value="{StaticResource AppMenuBg}"/>
        <Setter Property="Foreground" Value="{StaticResource AppMenuForeground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AppMenuBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

</ResourceDictionary>
