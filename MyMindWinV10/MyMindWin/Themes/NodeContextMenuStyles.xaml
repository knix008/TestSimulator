<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 아이콘 열이 있는 컨텍스트 메뉴 항목 (코드에서 NodeContextMenuItem 키로 참조) -->
    <Style x:Key="NodeContextMenu" TargetType="ContextMenu" BasedOn="{StaticResource {x:Type ContextMenu}}"/>

    <Style x:Key="NodeContextMenuItem" TargetType="MenuItem">
        <Setter Property="Background" Value="{StaticResource AppMenuBg}"/>
        <Setter Property="Foreground" Value="{StaticResource AppMenuForeground}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="ItemBorder"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="3"
                            Margin="2,1"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Width="20" Height="20"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    SnapsToDevicePixels="True">
                                <Viewbox Width="14" Height="14"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center">
                                    <ContentPresenter x:Name="IconPresenter" Content="{TemplateBinding Icon}"/>
                                </Viewbox>
                            </Border>
                            <ContentPresenter x:Name="HeaderPresenter"
                                              Grid.Column="1"
                                              Content="{TemplateBinding Header}"
                                              Margin="6,0,14,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{StaticResource AppMenuForeground}"/>
                            <TextBlock x:Name="GestureText"
                                       Grid.Column="2"
                                       Text="{TemplateBinding InputGestureText}"
                                       Foreground="{StaticResource AppMenuMuted}"
                                       FontFamily="Segoe UI"
                                       FontSize="10"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="#4A6CAE"/>
                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#5A7CBE"/>
                            <Setter TargetName="HeaderPresenter" Property="TextElement.Foreground" Value="White"/>
                            <Setter TargetName="GestureText" Property="Foreground" Value="#CCDDFF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="HeaderPresenter" Property="TextElement.Foreground" Value="{StaticResource AppMenuDisabledColor}"/>
                            <Setter TargetName="GestureText" Property="Foreground" Value="{StaticResource AppMenuDisabledColor}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NodeContextMenuSeparator" TargetType="Separator" BasedOn="{StaticResource {x:Type Separator}}"/>

</ResourceDictionary>
