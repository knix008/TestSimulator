<Window x:Class="MyMindWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:MyMindWin.Controls"
        xmlns:conv="clr-namespace:MyMindWin.Converters"
        xmlns:vm="clr-namespace:MyMindWin.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=True}"
        Title="MyMind — Mind Map"
        Icon="pack://application:,,,/daemon_hammer.ico"
        Width="1280" Height="800"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#1A1F2E">

    <Window.Resources>
        <conv:ConnectionLineIconConverter x:Key="ConnectionLineIconConverter"/>

        <!-- TreeView Item Style -->
        <Style x:Key="TreeNodeStyle" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
            <Setter Property="Foreground" Value="#CCFFFFFF"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="2,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Border x:Name="ItemBorder" Grid.Row="0"
                                    Padding="4,3,4,3" CornerRadius="4"
                                    Background="Transparent">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="Expander" Grid.Column="0"
                                                  IsChecked="{Binding Path=IsExpanded,
                                                      RelativeSource={RelativeSource TemplatedParent}}"
                                                  Width="14" Height="14">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Grid Width="14" Height="14" Cursor="Hand">
                                                    <Path x:Name="ExpandArrow"
                                                          Fill="#88FFFFFF"
                                                          Data="M 3,2 L 11,7 L 3,12 Z"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="ExpandArrow" Property="Data"
                                                                Value="M 2,4 L 12,4 L 7,12 Z"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <ContentPresenter Grid.Column="1"
                                                      ContentSource="Header"
                                                      VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ItemsPresenter Grid.Row="1" Margin="14,0,0,0"
                                            x:Name="ItemsHost" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#44FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toolbar Button Style -->
        <Style x:Key="ToolbarBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCFFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#44FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#66FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCFFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#44FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3355AA"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarSep" TargetType="Separator">
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="Width" Value="1"/>
            <Setter Property="Margin" Value="2,4"/>
        </Style>

        <DataTemplate x:Key="ShapeOptionTemplate">
            <TextBlock Text="{Binding Label}"
                       Foreground="#F0F4FF"
                       FontFamily="Segoe UI"
                       FontSize="12"
                       VerticalAlignment="Center"/>
        </DataTemplate>

        <Style x:Key="ToolbarComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#2A3548"/>
            <Setter Property="Foreground" Value="#F0F4FF"/>
            <Setter Property="Padding" Value="8,4"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#3D5080"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#4A6090"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToolbarComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#2A3548"/>
            <Setter Property="Foreground" Value="#F0F4FF"/>
            <Setter Property="BorderBrush" Value="#6A7FA8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,3,24,3"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="ItemTemplate" Value="{StaticResource ShapeOptionTemplate}"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ToolbarComboBoxItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="18"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Margin="8,0,2,0"
                                                                  VerticalAlignment="Center"
                                                                  HorizontalAlignment="Left"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  TextElement.Foreground="#F0F4FF"/>
                                                <Path Grid.Column="1"
                                                      Data="M 0,0 L 4,4 L 8,0 Z"
                                                      Fill="#C8D4F0"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,6,0"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="#2A3548"
                                        BorderBrush="#6A7FA8"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="220">
                                    <ScrollViewer CanContentScroll="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ConnectionLineOptionTemplate">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Width="28" Height="28"
                        Background="#1A2744"
                        BorderBrush="#334466"
                        BorderThickness="1"
                        CornerRadius="4"
                        VerticalAlignment="Top">
                    <ContentControl HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Content="{Binding Type, Converter={StaticResource ConnectionLineIconConverter}}"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Label}"
                               Foreground="#F0F4FF"
                               FontFamily="Segoe UI"
                               FontSize="13"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Description}"
                               Foreground="#88AACC"
                               FontFamily="Segoe UI"
                               FontSize="11"
                               Margin="0,3,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <Style x:Key="ConnectionLineListItem" TargetType="ListBoxItem">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F0F4FF"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#334466"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#223049"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#556688"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#F0F4FF"/>
                                <Setter TargetName="Bd" Property="Background" Value="#334466"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#74B9FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ConnectionLineListBox" TargetType="ListBox">
            <Setter Property="Background" Value="#0D101A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#F0F4FF"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ItemTemplate" Value="{StaticResource ConnectionLineOptionTemplate}"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ConnectionLineListItem}"/>
        </Style>

        <DataTemplate x:Key="ConnectionLineThicknessOptionTemplate">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Height="28"
                        Background="#1A2744"
                        BorderBrush="#334466"
                        BorderThickness="1"
                        CornerRadius="4"
                        VerticalAlignment="Center">
                    <Line X1="8" Y1="14" X2="44" Y2="14"
                          Stroke="#74B9FF"
                          StrokeThickness="{Binding Thickness}"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Column="1"
                           Text="{Binding Label}"
                           Foreground="#F0F4FF"
                           FontFamily="Segoe UI"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"/>
            </Grid>
        </DataTemplate>

        <Style x:Key="ConnectionLineThicknessListBox" TargetType="ListBox"
               BasedOn="{StaticResource ConnectionLineListBox}">
            <Setter Property="ItemTemplate" Value="{StaticResource ConnectionLineThicknessOptionTemplate}"/>
        </Style>

        <DataTemplate x:Key="NodeColorOptionTemplate">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Width="28" Height="28"
                        BorderBrush="#334466"
                        BorderThickness="1"
                        CornerRadius="4"
                        VerticalAlignment="Center"
                        SnapsToDevicePixels="True"
                        UseLayoutRounding="True">
                    <Rectangle RadiusX="3" RadiusY="3"
                               Fill="{Binding PreviewBrush}"/>
                </Border>
                <TextBlock Grid.Column="1"
                           Text="{Binding Label}"
                           Foreground="#F0F4FF"
                           FontFamily="Segoe UI"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"/>
            </Grid>
        </DataTemplate>

        <Style x:Key="NodeColorListBox" TargetType="ListBox"
               BasedOn="{StaticResource ConnectionLineListBox}">
            <Setter Property="ItemTemplate" Value="{StaticResource NodeColorOptionTemplate}"/>
        </Style>

        <DataTemplate x:Key="NodeBorderColorOptionTemplate">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Width="28" Height="28"
                        BorderBrush="#334466"
                        BorderThickness="1"
                        CornerRadius="4"
                        VerticalAlignment="Center">
                    <Rectangle RadiusX="3" RadiusY="3"
                               Fill="{Binding PreviewBrush}"/>
                </Border>
                <TextBlock Grid.Column="1"
                           Text="{Binding Label}"
                           Foreground="#F0F4FF"
                           FontFamily="Segoe UI"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"/>
            </Grid>
        </DataTemplate>

        <Style x:Key="NodeBorderColorListBox" TargetType="ListBox"
               BasedOn="{StaticResource ConnectionLineListBox}">
            <Setter Property="ItemTemplate" Value="{StaticResource NodeBorderColorOptionTemplate}"/>
        </Style>

        <DataTemplate x:Key="NodeBorderThicknessOptionTemplate">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Width="44" Height="28"
                        Background="#1A2744"
                        BorderBrush="#74B9FF"
                        BorderThickness="{Binding PreviewBorderThickness}"
                        CornerRadius="4"
                        VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding Label}"
                           Foreground="#F0F4FF"
                           FontFamily="Segoe UI"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"/>
            </Grid>
        </DataTemplate>

        <Style x:Key="NodeBorderThicknessListBox" TargetType="ListBox"
               BasedOn="{StaticResource ConnectionLineListBox}">
            <Setter Property="ItemTemplate" Value="{StaticResource NodeBorderThicknessOptionTemplate}"/>
        </Style>
    </Window.Resources>

    <Grid Background="#0D101A">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ Menu ════════════════════════════════════════════════════════ -->
        <Menu Grid.Row="0">
            <MenuItem Header="파일(_F)">
                <MenuItem Header="새로 만들기" Command="{Binding NewDocumentCommand}"/>
                <MenuItem Header="열기..." Command="{Binding OpenCommand}"/>
                <MenuItem Header="저장" Command="{Binding SaveCommand}"/>
                <MenuItem Header="다른 이름으로 저장..." Command="{Binding SaveAsCommand}"/>
                <Separator/>
                <MenuItem Header="보내기">
                    <MenuItem Header="이미지로보내기..." Command="{Binding ExportImageCommand}"/>
                    <Separator/>
                    <MenuItem Header="Markdown으로보내기..." Command="{Binding ExportMarkdownCommand}"/>
                    <MenuItem Header="Word로보내기..." Command="{Binding ExportWordCommand}"/>
                    <MenuItem Header="PDF로보내기..." Command="{Binding ExportPdfCommand}"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="정렬(_L)">
                <MenuItem Header="트리 (수평) _T" Command="{Binding SetLayoutTreeCommand}"/>
                <MenuItem Header="방사형 _R" Command="{Binding SetLayoutRadialCommand}"/>
                <MenuItem Header="피쉬본 _F" Command="{Binding SetLayoutFishboneCommand}"/>
                <Separator/>
                <MenuItem Header="현재 뷰 자동 정렬 _A" Command="{Binding AutoLayoutCommand}" InputGestureText="F5"/>
                <Separator/>
                <MenuItem Header="좌우 반전" IsCheckable="True"
                          IsChecked="{Binding LayoutFlipHorizontal, Mode=TwoWay}"/>
                <MenuItem Header="상하 반전" IsCheckable="True"
                          IsChecked="{Binding LayoutFlipVertical, Mode=TwoWay}"/>
            </MenuItem>
            <MenuItem Header="도형(_S)">
                <MenuItem Header="둥근 사각형" Command="{Binding SetShapeCommand}" CommandParameter="rounded"/>
                <MenuItem Header="사각형" Command="{Binding SetShapeCommand}" CommandParameter="rectangle"/>
                <MenuItem Header="알약형" Command="{Binding SetShapeCommand}" CommandParameter="pill"/>
                <MenuItem Header="타원" Command="{Binding SetShapeCommand}" CommandParameter="ellipse"/>
                <MenuItem Header="마름모" Command="{Binding SetShapeCommand}" CommandParameter="diamond"/>
                <Separator/>
                <MenuItem Header="구름" Command="{Binding SetShapeCommand}" CommandParameter="cloud"/>
                <MenuItem Header="육각형" Command="{Binding SetShapeCommand}" CommandParameter="hexagon"/>
                <MenuItem Header="말풍선" Command="{Binding SetShapeCommand}" CommandParameter="speech_bubble"/>
                <MenuItem Header="별" Command="{Binding SetShapeCommand}" CommandParameter="star"/>
                <MenuItem Header="평행사변형" Command="{Binding SetShapeCommand}" CommandParameter="parallelogram"/>
            </MenuItem>
            <MenuItem Header="연결선(_C)">
                <MenuItem Header="Bezier" Tag="bezier" Click="ConnectionLineMenuItem_Click">
                    <MenuItem.Icon>
                        <Viewbox Width="16" Height="16">
                            <Path Data="{x:Static controls:ConnectionLineIconHelper.BezierGeometry}"
                                  Stroke="#74B9FF" StrokeThickness="1.6" Fill="Transparent"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Viewbox>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Linear" Tag="linear" Click="ConnectionLineMenuItem_Click">
                    <MenuItem.Icon>
                        <Viewbox Width="16" Height="16">
                            <Path Data="{x:Static controls:ConnectionLineIconHelper.LinearGeometry}"
                                  Stroke="#74B9FF" StrokeThickness="1.6" Fill="Transparent"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Viewbox>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Sharp Linear" Tag="sharp_linear" Click="ConnectionLineMenuItem_Click">
                    <MenuItem.Icon>
                        <Viewbox Width="16" Height="16">
                            <Path Data="{x:Static controls:ConnectionLineIconHelper.SharpLinearGeometry}"
                                  Stroke="#74B9FF" StrokeThickness="1.6" Fill="Transparent"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Viewbox>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Sharp Bezier" Tag="sharp_bezier" Click="ConnectionLineMenuItem_Click">
                    <MenuItem.Icon>
                        <Viewbox Width="16" Height="16">
                            <Path Data="{x:Static controls:ConnectionLineIconHelper.SharpBezierGeometry}"
                                  Stroke="#74B9FF" StrokeThickness="1.6" Fill="Transparent"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Viewbox>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="보기(_V)">
                <MenuItem Header="화면 맞춤" Command="{Binding ResetViewCommand}" InputGestureText="F4"/>
            </MenuItem>
        </Menu>

        <!-- ══ Toolbar ══════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Background="#0D101A"
                BorderBrush="#22FFFFFF" BorderThickness="0,0,0,1">
            <WrapPanel Orientation="Horizontal" Margin="6,3">
                <Button Command="{Binding NewDocumentCommand}" Style="{StaticResource ToolbarBtn}" ToolTip="New">📄 New</Button>
                <Button Command="{Binding OpenCommand}"        Style="{StaticResource ToolbarBtn}" ToolTip="Open">📂 Open</Button>
                <Button Command="{Binding SaveCommand}"        Style="{StaticResource ToolbarBtn}" ToolTip="Save">💾 Save</Button>
                <Button Command="{Binding SaveAsCommand}"      Style="{StaticResource ToolbarBtn}" ToolTip="Save As">📝 Save As</Button>
                <Button Command="{Binding ExportImageCommand}" Style="{StaticResource ToolbarBtn}" ToolTip="캔버스를 이미지로 저장 (PNG/JPG/GIF/WebP/AVIF)">🖼 Export</Button>
                <Separator Style="{StaticResource ToolbarSep}"/>
                <Button Command="{Binding AddChildCommand}"    Style="{StaticResource ToolbarBtn}" ToolTip="Add Child (Tab)">➕ Child</Button>
                <Button Command="{Binding AddSiblingCommand}"  Style="{StaticResource ToolbarBtn}" ToolTip="Add Sibling (Enter)">↕ Sibling</Button>
                <Button Command="{Binding DeleteNodeCommand}"  Style="{StaticResource ToolbarBtn}" ToolTip="Delete (Del)">🗑 Delete</Button>
                <Separator Style="{StaticResource ToolbarSep}"/>
                <TextBlock Text="도형" Foreground="#88FFFFFF" FontFamily="Segoe UI" FontSize="12"
                           VerticalAlignment="Center" Margin="6,0,2,0"/>
                <ComboBox Style="{StaticResource ToolbarComboBox}"
                          Width="118" Height="28" Margin="0,2"
                          ItemsSource="{Binding ShapeOptions}"
                          SelectedItem="{Binding SelectedShapeOption, Mode=TwoWay}"
                          ItemTemplate="{StaticResource ShapeOptionTemplate}"
                          ToolTip="새 노드 기본 도형 (선택 노드가 있으면 해당 노드에도 적용)"/>
                <Separator Style="{StaticResource ToolbarSep}"/>
                <Button Command="{Binding ExpandAllCommand}"   Style="{StaticResource ToolbarBtn}" ToolTip="Expand All">⊞ Expand</Button>
                <Button Command="{Binding CollapseAllCommand}" Style="{StaticResource ToolbarBtn}" ToolTip="Collapse All">⊟ Collapse</Button>
                <Separator Style="{StaticResource ToolbarSep}"/>
                <Button Command="{Binding SetLayoutTreeCommand}"     Style="{StaticResource ToolbarBtn}" ToolTip="트리 레이아웃 + 자동 정렬">⊣⊢ Tree</Button>
                <Button Command="{Binding SetLayoutRadialCommand}"   Style="{StaticResource ToolbarBtn}" ToolTip="방사형 레이아웃 + 자동 정렬">⊛ Radial</Button>
                <Button Command="{Binding SetLayoutFishboneCommand}" Style="{StaticResource ToolbarBtn}" ToolTip="피쉬본(어골) 다이어그램 + 자동 정렬">🐟 Fishbone</Button>
                <Button Command="{Binding AutoLayoutCommand}"     Style="{StaticResource ToolbarBtn}" ToolTip="현재 뷰 자동 정렬 (F5)">⇅ 정렬</Button>
                <ToggleButton Style="{StaticResource ToolbarToggle}"
                              IsChecked="{Binding LayoutFlipHorizontal, Mode=TwoWay}"
                              ToolTip="좌우 반전 (모든 레이아웃)">↔ LR</ToggleButton>
                <ToggleButton Style="{StaticResource ToolbarToggle}"
                              IsChecked="{Binding LayoutFlipVertical, Mode=TwoWay}"
                              ToolTip="상하 반전 (모든 레이아웃)">↕ UD</ToggleButton>
                <Separator Style="{StaticResource ToolbarSep}"/>
                <Button Command="{Binding ZoomInCommand}"    Style="{StaticResource ToolbarBtn}" ToolTip="Zoom In">🔍+</Button>
                <Button Command="{Binding ZoomOutCommand}"   Style="{StaticResource ToolbarBtn}" ToolTip="Zoom Out">🔍-</Button>
                <Button Command="{Binding ResetViewCommand}" Style="{StaticResource ToolbarBtn}" ToolTip="화면 맞춤 (F4)">⌖ 맞춤</Button>
                <Border VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock Text="우클릭=메뉴  F2=이름  F3=노트  F4=그림  Tab=Child  Del=Delete  Drag=Move  Ctrl+Wheel=Zoom"
                               Foreground="#44FFFFFF" FontFamily="Segoe UI" FontSize="11"/>
                </Border>
            </WrapPanel>
        </Border>

        <!-- ══ Main Content ══════════════════════════════════════════════════ -->
        <Grid Grid.Row="2" Background="#0D101A">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="150" MaxWidth="400"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="220" MinWidth="180" MaxWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Tree Structure Panel -->
            <Border Grid.Column="0" Background="#0D101A"
                    BorderBrush="#22FFFFFF" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#080A12" Padding="10,8">
                        <TextBlock Text="STRUCTURE" Foreground="#66FFFFFF"
                                   FontFamily="Segoe UI" FontSize="11"
                                   FontWeight="Bold"/>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto"
                                  Background="#0D101A">
                        <TreeView x:Name="StructureTree"
                                  Background="#0D101A"
                                  BorderThickness="0"
                                  Padding="6"
                                  ItemsSource="{Binding RootNodes}"
                                  ItemContainerStyle="{StaticResource TreeNodeStyle}"
                                  SelectedItemChanged="StructureTree_SelectedItemChanged"
                                  PreviewMouseRightButtonDown="StructureTree_PreviewMouseRightButtonDown"
                                  MouseDoubleClick="StructureTree_MouseDoubleClick"
                                  PreviewKeyDown="StructureTree_PreviewKeyDown">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <Grid MinWidth="80">
                                        <TextBlock Text="{Binding Text}"
                                                   Foreground="#DDFFFFFF"
                                                   FontFamily="Segoe UI"
                                                   FontSize="13"
                                                   ToolTip="{Binding Text}"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTreeEditing}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                 FontFamily="Segoe UI"
                                                 FontSize="13"
                                                 Padding="2,1"
                                                 BorderThickness="1"
                                                 BorderBrush="#64B5F6"
                                                 Background="#1A2744"
                                                 Foreground="White"
                                                 CaretBrush="White"
                                                 VerticalAlignment="Center"
                                                 KeyDown="StructureTreeEditBox_KeyDown"
                                                 LostFocus="StructureTreeEditBox_LostFocus"
                                                 Loaded="StructureTreeEditBox_Loaded">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTreeEditing}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </Grid>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- GridSplitter -->
            <GridSplitter Grid.Column="1" Width="4"
                          HorizontalAlignment="Stretch"
                          Background="#22FFFFFF" Cursor="SizeWE"/>

            <!-- Right: Mind Map Canvas -->
            <controls:MindMapCanvasControl x:Name="MindMapCanvas" Grid.Column="2"/>

            <!-- GridSplitter -->
            <GridSplitter Grid.Column="3" Width="4"
                          HorizontalAlignment="Stretch"
                          Background="#22FFFFFF" Cursor="SizeWE"/>

            <!-- Right: Properties Panel -->
            <Border Grid.Column="4" Background="#0D101A"
                    BorderBrush="#22FFFFFF" BorderThickness="1,0,0,0"
                    MinWidth="180">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#080A12" Padding="10,8">
                        <TextBlock Text="속성" Foreground="#66FFFFFF"
                                   FontFamily="Segoe UI" FontSize="11"
                                   FontWeight="Bold"/>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Background="#0D101A"
                                  Padding="0,4,0,4">
                        <StackPanel Margin="10,6,10,8" Background="#0D101A">
                            <TextBlock Text="노드 색"
                                       Foreground="#88FFFFFF"
                                       FontFamily="Segoe UI"
                                       FontSize="12"
                                       Margin="0,0,0,8"/>
                            <TextBlock Foreground="#66AACC"
                                       FontFamily="Segoe UI"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8"
                                       Text="루트는 「기본 루트 색」 또는 팔레트를 선택합니다. 하위 노드는 기본적으로 부모 색을 상속합니다."/>
                            <ListBox Style="{StaticResource NodeColorListBox}"
                                     MinHeight="200"
                                     ItemsSource="{Binding NodeColorOptions}"
                                     SelectedValue="{Binding SelectedNodeColorIndex, Mode=TwoWay}"
                                     SelectedValuePath="ColorIndex"
                                     IsEnabled="{Binding CanEditNodeColor}"/>
                            <TextBlock Text="테두리 색"
                                       Foreground="#88FFFFFF"
                                       FontFamily="Segoe UI"
                                       FontSize="12"
                                       Margin="0,16,0,8"/>
                            <ListBox Style="{StaticResource NodeBorderColorListBox}"
                                     MinHeight="160"
                                     ItemsSource="{Binding NodeBorderColorOptions}"
                                     SelectedValue="{Binding SelectedNodeBorderColorIndex, Mode=TwoWay}"
                                     SelectedValuePath="ColorIndex"
                                     IsEnabled="{Binding CanEditNodeBorder}"/>
                            <TextBlock Text="테두리 두께"
                                       Foreground="#88FFFFFF"
                                       FontFamily="Segoe UI"
                                       FontSize="12"
                                       Margin="0,16,0,8"/>
                            <ListBox Style="{StaticResource NodeBorderThicknessListBox}"
                                     MinHeight="130"
                                     ItemsSource="{Binding NodeBorderThicknessOptions}"
                                     SelectedItem="{Binding SelectedNodeBorderThicknessOption, Mode=TwoWay}"
                                     IsEnabled="{Binding CanEditNodeBorder}"/>
                            <TextBlock Text="연결선 종류"
                                       Foreground="#88FFFFFF"
                                       FontFamily="Segoe UI"
                                       FontSize="12"
                                       Margin="0,16,0,8"/>
                            <ListBox Style="{StaticResource ConnectionLineListBox}"
                                     MinHeight="130"
                                     ItemsSource="{Binding ConnectionLineOptions}"
                                     SelectedItem="{Binding SelectedConnectionLineOption, Mode=TwoWay}"/>
                            <TextBlock Text="연결선 두께"
                                       Foreground="#88FFFFFF"
                                       FontFamily="Segoe UI"
                                       FontSize="12"
                                       Margin="0,16,0,8"/>
                            <ListBox Style="{StaticResource ConnectionLineThicknessListBox}"
                                     MinHeight="110"
                                     ItemsSource="{Binding ConnectionLineThicknessOptions}"
                                     SelectedItem="{Binding SelectedConnectionLineThicknessOption, Mode=TwoWay}"/>
                            <CheckBox Content="뿌리형 가늘어짐 (중심 굵게 → 세부 가늘게)"
                                      IsChecked="{Binding ConnectionLineTaper, Mode=TwoWay}"
                                      Foreground="#CCFFFFFF"
                                      FontFamily="Segoe UI"
                                      FontSize="12"
                                      Margin="0,14,0,8"
                                      ToolTip="부모 쪽은 굵고 자식(세부) 노드 쪽으로 갈수록 연결선이 가늘어집니다."/>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Margin="10,0,10,10" Padding="10"
                            Background="#121826" CornerRadius="6" BorderBrush="#334466" BorderThickness="1">
                        <TextBlock Foreground="#66AACC"
                                   FontFamily="Segoe UI"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Text="노드 색·테두리·연결선 설정이 캔버스에 즉시 반영되며 파일 저장 시 함께 기록됩니다."/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
