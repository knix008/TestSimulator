# Build outputs
[Bb]in/
[Oo]bj/
[Bb]uild/
[Oo]ut/
_build_out/
.build-out/
publish/
artifacts/

# Visual Studio / Rider
.vs/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates
*.rsuser
*.userprefs

# VS Code (keep shared launch/tasks if present)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# NuGet
packages/
*.nupkg
project.lock.json
project.assets.json
*.nuget.g.props
*.nuget.g.targets
*.nuget.dgspec.json

# WiX / MSI installer
*.msi
*.wixobj
*.wixpdb
*.wixmst
installer/bin/
installer/obj/

# Publish profiles
**/Properties/PublishProfiles/

# Generated MSBuild / designer caches
*.g.cs
*.g.i.cs
*.AssemblyAttributes.cs
*.GlobalUsings.g.cs
*.GeneratedMSBuildEditorConfig.editorconfig
*.csproj.CoreCompileInputs.cache
*.FileListAbsolute.txt
*.genruntimeconfig.cache
*.sourcelink.json

# Logs and temp
*.log
*.tmp
*.temp
*.bak
*.cache

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Secrets and local runtime config (never commit)
.env
.env.*
!.env.example
*.pfx
*.snk
appsettings.local.json
**/appsettings.local.json

# Local SQLite databases created during development
*.db
*.db-shm
*.db-wal

# WebView2 user-data caches (beside output or executable name)
**/EBWebView/
**/WebView2/
**/*.exe.WebView2/

# Crash dumps
*.dmp
*.mdmp

# Test / scratch / local export output
TestResults/
coverage/
scratch/
export/

# Local project archives and ad-hoc export folders (keep tracked samples if any)
*.wsp

# Note: src/MyWorkspace.Win/Assets/ (app.ico, Icons/s16·s20·s28 PNG) is tracked in git.
# Regenerate with: dotnet run --project tools/IconGenerator/IconGenerator.csproj -c Release
