<Project Sdk="Microsoft.NET.Sdk">



  <PropertyGroup>

    <OutputType>WinExe</OutputType>

    <TargetFramework>net10.0-windows</TargetFramework>

    <Nullable>enable</Nullable>

    <UseWindowsForms>true</UseWindowsForms>

    <ImplicitUsings>enable</ImplicitUsings>

    <RootNamespace>MyWorkspace.Win</RootNamespace>

    <AssemblyName>MyWorkspaceWinV10</AssemblyName>

    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <StartupObject>MyWorkspace.Win.Program</StartupObject>

    <Version>1.0.0</Version>

    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>

    <SkipInstaller Condition="'$(SkipInstaller)' == ''">false</SkipInstaller>

  </PropertyGroup>



  <ItemGroup>

    <ProjectReference Include="..\MyWorkspace.Core\MyWorkspace.Core.csproj" />

    <ProjectReference Include="..\MyWorkspace.Data\MyWorkspace.Data.csproj" />

  </ItemGroup>



  <ItemGroup>

    <PackageReference Include="Markdig" Version="0.38.0" />

    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />

    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />

    <PackageReference Include="ReverseMarkdown" Version="4.6.0" />

  </ItemGroup>



  <ItemGroup>

    <EmbeddedResource Include="Assets\Icons\**\*.png" />

    <EmbeddedResource Include="Assets\app.ico" />

    <None Update="appsettings.json">

      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>

    </None>

    <None Update="Templates\Pages\**\*">

      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>

    </None>

  </ItemGroup>



  <Target Name="GenerateIconsIfMissing" BeforeTargets="PrepareForBuild" Condition="!Exists('$(MSBuildProjectDirectory)\Assets\Icons\s16\workspace.png') or !Exists('$(MSBuildProjectDirectory)\Assets\app.ico')">

    <Message Importance="high" Text="Generating application icons..." />

    <Exec Command="dotnet run --project &quot;$(MSBuildProjectDirectory)\..\..\tools\IconGenerator\IconGenerator.csproj&quot; -c Release" />

  </Target>



  <Target Name="BuildInstallerOnRelease" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' and '$(SkipInstaller)' != 'true' and Exists('$(MSBuildProjectDirectory)\..\..\installer\MyWorkspaceWinV10.Installer.wixproj')">

    <Message Importance="high" Text="Building MSI installer (WiX)..." />

    <Exec Command="dotnet build &quot;$(MSBuildProjectDirectory)\..\..\installer\MyWorkspaceWinV10.Installer.wixproj&quot; -c Release -p:Platform=x64" />

    <Message Importance="high" Text="MSI created: $(MSBuildProjectDirectory)\..\..\installer\bin\Release\ko-kr\MyWorkspaceWinV10Setup.msi" />

  </Target>



</Project>


