<Project Sdk="Microsoft.NET.Sdk">



  <PropertyGroup>

    <OutputType>WinExe</OutputType>

    <TargetFramework>net10.0-windows</TargetFramework>

    <Nullable>enable</Nullable>

    <UseWindowsForms>true</UseWindowsForms>

    <ImplicitUsings>enable</ImplicitUsings>

    <RootNamespace>MyWorkspace.Win</RootNamespace>

    <AssemblyName>MyWorkspaceWinV10</AssemblyName>

    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <StartupObject>MyWorkspace.Win.Program</StartupObject>

    <Version>1.0.0</Version>

    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>

    <SkipInstaller Condition="'$(SkipInstaller)' == ''">false</SkipInstaller>

  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <SatelliteResourceLanguages>ko;en</SatelliteResourceLanguages>
  </PropertyGroup>



  <ItemGroup>

    <ProjectReference Include="..\MyWorkspace.Core\MyWorkspace.Core.csproj" />

    <ProjectReference Include="..\MyWorkspace.Data\MyWorkspace.Data.csproj" />

  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>MyWorkspace.MultiImage.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>



  <ItemGroup>

    <PackageReference Include="DocumentFormat.OpenXml" Version="3.2.0" />

    <PackageReference Include="Markdig" Version="0.38.0" />

    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />

    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />

    <PackageReference Include="ReverseMarkdown" Version="4.6.0" />

    <PackageReference Include="Svg.Skia" Version="2.0.0.1" />

  </ItemGroup>



  <ItemGroup>

    <EmbeddedResource Include="Assets\Icons\**\*.png" />

    <EmbeddedResource Include="Assets\app.ico" />

    <None Update="appsettings.json">

      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>

    </None>

    <None Update="Templates\Pages\**\*">

      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>

    </None>

  </ItemGroup>



  <Target Name="GenerateIconsIfMissing" BeforeTargets="PrepareForBuild" Condition="!Exists('$(MSBuildProjectDirectory)\Assets\Icons\s16\workspace.png') or !Exists('$(MSBuildProjectDirectory)\Assets\app.ico') or !Exists('$(MSBuildProjectDirectory)\Assets\wsp.ico')">

    <Message Importance="high" Text="Generating application icons..." />

    <Exec Command="dotnet run --project &quot;$(MSBuildProjectDirectory)\..\..\tools\IconGenerator\IconGenerator.csproj&quot; -c Release" />

  </Target>



  <!-- Release publish: remove debug/dump helpers and non-Windows runtime assets from MSI payload. -->
  <Target Name="PruneUnnecessaryPublishFiles" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <UnnecessaryPublishFile Include="$(PublishDir)createdump.exe" />
      <UnnecessaryPublishFile Include="$(PublishDir)mscordaccore.dll" />
      <UnnecessaryPublishFile Include="$(PublishDir)mscordaccore_*.dll" />
      <UnnecessaryPublishFile Include="$(PublishDir)mscordbi.dll" />
      <UnnecessaryPublishFile Include="$(PublishDir)Microsoft.DiaSymReader.Native.amd64.dll" />
      <UnnecessaryPublishFile Include="$(PublishDir)msquic.dll" />
      <UnnecessaryPublishFile Include="$(PublishDir)clrgc.dll" />
      <UnnecessaryPublishFile Include="$(PublishDir)dbgshim.dll" />
    </ItemGroup>
    <Delete Files="@(UnnecessaryPublishFile)" TreatErrorsAsWarnings="true" />
  </Target>

  <Target Name="PruneForeignRuntimeAssets" AfterTargets="PruneUnnecessaryPublishFiles" Condition="'$(Configuration)' == 'Release' AND Exists('$(PublishDir)runtimes')">
    <ItemGroup>
      <ForeignRuntimeDir Include="$(PublishDir)runtimes\android-*" />
      <ForeignRuntimeDir Include="$(PublishDir)runtimes\browser-wasm" />
      <ForeignRuntimeDir Include="$(PublishDir)runtimes\ios*" />
      <ForeignRuntimeDir Include="$(PublishDir)runtimes\iossimulator-*" />
      <ForeignRuntimeDir Include="$(PublishDir)runtimes\linux-*" />
      <ForeignRuntimeDir Include="$(PublishDir)runtimes\maccatalyst-*" />
      <ForeignRuntimeDir Include="$(PublishDir)runtimes\osx-*" />
      <ForeignRuntimeDir Include="$(PublishDir)runtimes\unix" Condition="Exists('$(PublishDir)runtimes\unix')" />
    </ItemGroup>
    <RemoveDir Directories="@(ForeignRuntimeDir)" ContinueOnError="true" />
  </Target>



  <!-- Release 빌드 시 MSI 생성. SkipInstaller=true 로 순환 참조 방지. -->
  <Target Name="BuildInstallerOnRelease" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'&#xD;&#xA;                     AND '$(SkipInstaller)' != 'true'&#xD;&#xA;                     AND '$(BuildingMsiPackage)' != 'true'&#xD;&#xA;                     AND '$(DesignTimeBuild)' != 'true'&#xD;&#xA;                     AND Exists('$(MSBuildProjectDirectory)\..\..\installer\MyWorkspaceWinV10.Installer.wixproj')">
    <Message Importance="high" Text="Building MSI installer package (WiX)..." />
    <Exec Command="cmd /c taskkill /IM MyWorkspaceWinV10.exe /F &gt;nul 2&gt;&amp;1" IgnoreExitCode="true" />
    <MSBuild Projects="$(MSBuildProjectDirectory)\..\..\installer\MyWorkspaceWinV10.Installer.wixproj" Targets="Restore;Build" BuildInParallel="false" Properties="Configuration=Release;Platform=x64;SkipInstaller=true;BuildingMsiPackage=true" />
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\..\..\installer\bin\Release\MyWorkspaceWinV10Setup.msi')" Text="MSI was not created. Close any running MyWorkspaceWinV10.exe and rebuild Release." />
    <Message Importance="high" Text="MSI created: $(MSBuildProjectDirectory)\..\..\installer\bin\Release\MyWorkspaceWinV10Setup.msi" />
  </Target>



  <Target Name="CopyWspIconToOutput" AfterTargets="Build">

    <Copy SourceFiles="$(MSBuildProjectDirectory)\Assets\wsp.ico" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="Exists('$(MSBuildProjectDirectory)\Assets\wsp.ico')" />

  </Target>



  <Target Name="CopyWspIconToPublish" AfterTargets="Publish">

    <Copy SourceFiles="$(MSBuildProjectDirectory)\Assets\wsp.ico" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="Exists('$(MSBuildProjectDirectory)\Assets\wsp.ico')" />

  </Target>



</Project>


