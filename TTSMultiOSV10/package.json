{
  "name": "tts-multios-v10",
  "version": "0.1.0",
  "description": "Embedded-ready TTS Multi OS Application",
  "author": "SHKWON <knix008@naver.com>",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "rebuild:native": "electron-builder install-app-deps",
    "web": "node server.js",
    "copy:installers": "node scripts/copy-installers.mjs",
    "copy:installers:win": "node scripts/copy-installers.mjs --platform win",
    "copy:installers:mac": "node scripts/copy-installers.mjs --platform mac",
    "copy:installers:linux": "node scripts/copy-installers.mjs --platform linux",
    "build": "electron-builder && npm run copy:installers",
    "build:win": "electron-builder --win && npm run copy:installers:win",
    "build:mac": "electron-builder --mac && npm run copy:installers:mac",
    "build:linux": "electron-builder --linux && npm run copy:installers:linux"
  },
  "build": {
    "appId": "com.shkwon.tts-multios",
    "productName": "TTS Multi OS",
    "copyright": "Copyright © 2025-2026 SHKWON (knix008@naver.com)",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "assets/**/*",
      "index.html",
      "server.js",
      "!node_modules/**/*.map",
      "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/linux/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**"
    ],
    "asarUnpack": [
      "node_modules/onnxruntime-node/**/*",
      "node_modules/sherpa-onnx-node/**/*",
      "node_modules/sherpa-onnx-win-x64/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TTS Multi OS",
      "deleteAppDataOnUninstall": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "AudioVideo"
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron@31.7.7": true,
    "onnxruntime-node@1.27.0": true
  },
  "dependencies": {
    "@piper-plus/g2p": "^0.4.1",
    "onnxruntime-node": "^1.27.0",
    "phonemizer": "^1.2.1",
    "sherpa-onnx-node": "^1.13.4",
    "sherpa-onnx-win-x64": "^1.13.4"
  }
}
