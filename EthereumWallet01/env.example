# Ethereum Wallet 환경 변수 설정
# 이 파일을 .env로 복사하고 실제 값을 입력하세요

# 방법 1: 개인키와 주소 직접 설정
PRIVATE_KEY=0x1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef
PUBLIC_ADDRESS=0x742d35Cc6634C0532925a3b8D4C9db96C4b4d8b6

# 방법 2: 니모닉 구문 사용 (방법 1과 중복 사용 불가)
# MNEMONIC=abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon about

# 네트워크 설정 (선택사항)
# INFURA_API_KEY=your_infura_api_key_here
# ALCHEMY_API_KEY=your_alchemy_api_key_here

# 주의사항:
# 1. .env 파일은 절대 Git에 커밋하지 마세요
# 2. 실제 개인키를 사용할 때는 테스트넷에서만 사용하세요
# 3. 개인키와 니모닉을 안전하게 보관하세요
# 4. 이 파일은 예제용이므로 실제 값으로 교체해야 합니다
