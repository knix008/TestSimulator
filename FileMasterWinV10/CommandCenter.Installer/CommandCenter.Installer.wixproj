<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <OutputName>CommandCenterSetup</OutputName>
    <Platform>x64</Platform>
    <!-- 같은 버전 재설치를 의도적으로 허용하므로 ICE61 검증만 억제한다. -->
    <SuppressIces>ICE61</SuppressIces>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FileMasterWinV10.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" GeneratePathProperty="true" />
  </ItemGroup>

  <Target Name="CopyMsiNextToApplication" AfterTargets="Build">
    <PropertyGroup>
      <_MsiPath>$(MSBuildProjectDirectory)\bin\x64\$(Configuration)\$(OutputName).msi</_MsiPath>
      <_AppOutDir>$(MSBuildThisFileDirectory)..\bin\$(Configuration)\net8.0-windows\</_AppOutDir>
    </PropertyGroup>
    <Copy
      SourceFiles="$(_MsiPath)"
      DestinationFiles="$(_AppOutDir)$(OutputName).msi"
      SkipUnchangedFiles="true"
      Condition="Exists('$(_MsiPath)')" />
  </Target>
</Project>
