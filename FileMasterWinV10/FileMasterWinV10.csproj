<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CommandCenter</AssemblyName>
    <RootNamespace>FileMasterWinV10</RootNamespace>
    <Product>Command Center</Product>
    <AssemblyTitle>Command Center</AssemblyTitle>
    <Description>Command Center - dual-pane file manager</Description>
    <Company>Command Center</Company>
    <ApplicationIcon>app_icon.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <Version>1.0.0.0</Version>
    <!-- 빌드 시각을 어셈블리 메타데이터로 주입해 About 화면에 표시한다(UTC). -->
    <BuildTimestamp>$([System.DateTime]::UtcNow.ToString(yyyy-MM-dd HH:mm:ss "UTC"))</BuildTimestamp>
    <!-- Release 빌드 시 MSI 설치 패키지도 함께 생성 -->
    <GenerateMsiOnBuild>true</GenerateMsiOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="BuildTimestamp" Value="$(BuildTimestamp)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="app_icon.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Compile Update="MainForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="MainForm.Designer.cs">
      <DependentUpon>MainForm.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="MainForm.resx">
      <DependentUpon>MainForm.cs</DependentUpon>
    </EmbeddedResource>
    <Compile Update="Controls\FilePanel.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="Controls\FilePanel.Designer.cs">
      <DependentUpon>FilePanel.cs</DependentUpon>
    </Compile>
    <Compile Update="Controls\PreviewPanel.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="Controls\PreviewPanel.Designer.cs">
      <DependentUpon>PreviewPanel.cs</DependentUpon>
    </Compile>
    <Compile Update="Controls\FolderTreeDropdownPanel.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="Controls\FolderTreeDropdownPanel.Designer.cs">
      <DependentUpon>FolderTreeDropdownPanel.cs</DependentUpon>
    </Compile>
    <Compile Update="Dialogs\SearchDialog.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Dialogs\SearchDialog.Designer.cs">
      <DependentUpon>SearchDialog.cs</DependentUpon>
    </Compile>
    <Compile Update="Dialogs\InputDialog.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Dialogs\InputDialog.Designer.cs">
      <DependentUpon>InputDialog.cs</DependentUpon>
    </Compile>
    <Compile Update="Dialogs\FileOperationProgressDialog.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Dialogs\FileOperationProgressDialog.Designer.cs">
      <DependentUpon>FileOperationProgressDialog.cs</DependentUpon>
    </Compile>
  </ItemGroup>

  <Target
    Name="BuildInstallerMsi"
    AfterTargets="Build"
    Condition="'$(Configuration)' == 'Release' and '$(GenerateMsiOnBuild)' == 'true'">
    <Message Importance="high" Text="Building MSI installer (Release)..." />
    <Exec Command="dotnet build &quot;$(MSBuildProjectDirectory)\CommandCenter.Installer\CommandCenter.Installer.wixproj&quot; -c $(Configuration) -p:GenerateMsiOnBuild=false -p:BuildProjectReferences=false" />
    <Message Importance="high" Text="Building setup bootstrapper .exe (Release)..." />
    <Exec Command="dotnet build &quot;$(MSBuildProjectDirectory)\CommandCenter.Bootstrapper\CommandCenter.Bootstrapper.wixproj&quot; -c $(Configuration) -p:GenerateMsiOnBuild=false -p:BuildProjectReferences=false" />
  </Target>
</Project>
