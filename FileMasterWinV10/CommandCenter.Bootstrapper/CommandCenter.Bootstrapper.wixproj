<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputType>Bundle</OutputType>
    <OutputName>CommandCenterSetup</OutputName>
  </PropertyGroup>

  <ItemGroup>
    <!-- MSI 빌드 순서 보장 및 $(var.CommandCenter.Installer.*) 변수 제공 -->
