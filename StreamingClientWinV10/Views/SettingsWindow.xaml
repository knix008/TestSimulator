<Window x:Class="StreamingClientWinV10.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="서버 설정"
        Width="460" Height="200"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}">

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="스트리밍 서버 설정"
                   Foreground="{StaticResource TextPrimBrush}"
                   FontSize="16" FontWeight="SemiBold"/>

        <!-- URL field -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="서버 URL"
                       Foreground="{StaticResource TextSecBrush}"
                       FontSize="13" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" x:Name="UrlBox"
                     FontSize="13" Padding="10,7"
                     Background="{StaticResource SurfaceBrush}"
                     Foreground="{StaticResource TextPrimBrush}"
                     CaretBrush="{StaticResource TextPrimBrush}"
                     BorderBrush="{StaticResource BorderBrush2}"
                     BorderThickness="1">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TextBox">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="5"
                                            Padding="{TemplateBinding Padding}">
                                        <ScrollViewer x:Name="PART_ContentHost"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TextBox.Style>
            </TextBox>
        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="취소" Click="OnCancelClick"
                    Style="{StaticResource SecondaryBtn}" Width="80" Margin="0,0,8,0"/>
            <Button Content="저장" Click="OnSaveClick" IsDefault="True"
                    Style="{StaticResource PrimaryBtn}" Width="80"/>
        </StackPanel>
    </Grid>
</Window>
