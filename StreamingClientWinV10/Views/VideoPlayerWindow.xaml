<Window x:Class="StreamingClientWinV10.Views.VideoPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="StreamTV Player"
        Width="1200" Height="700" MinWidth="800" MinHeight="500"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        Closing="OnWindowClosing">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>          <!-- Video + controls -->
            <ColumnDefinition Width="320"/>        <!-- Comments panel -->
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════
             Left: Video + Controls
             ══════════════════════════════ -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>    <!-- Video -->
                <RowDefinition Height="Auto"/> <!-- Controls -->
            </Grid.RowDefinitions>

            <!-- Video area -->
            <Border Grid.Row="0" Background="Black">
                <MediaElement x:Name="MediaPlayer"
                              LoadedBehavior="Manual"
                              UnloadedBehavior="Stop"
                              Stretch="Uniform"
                              MediaOpened="OnMediaOpened"
                              MediaEnded="OnMediaEnded"
                              MediaFailed="OnMediaFailed"/>
            </Border>

            <!-- Controls panel -->
            <Border Grid.Row="1" Background="#0B1120"
                    BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,1,0,0"
                    Padding="16,10">
                <StackPanel>

                    <!-- Title -->
                    <TextBlock x:Name="TitleBlock"
                               Foreground="{StaticResource TextPrimBrush}"
                               FontSize="14" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,0,8"/>

                    <!-- Seek bar -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="SeekBar"
                                Grid.Column="0"
                                Style="{StaticResource DarkSlider}"
                                Minimum="0" Maximum="1"
                                VerticalAlignment="Center"
                                Thumb.DragStarted="OnSeekDragStarted"
                                Thumb.DragCompleted="OnSeekDragCompleted"
                                PreviewMouseLeftButtonDown="OnSeekBarClick"/>
                        <TextBlock x:Name="TimeBlock"
                                   Grid.Column="1"
                                   Text="0:00 / 0:00"
                                   Foreground="{StaticResource TextSecBrush}"
                                   FontSize="12" VerticalAlignment="Center"
                                   Margin="12,0,0,0" MinWidth="90"
                                   HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- Playback buttons + volume -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Playback controls -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button x:Name="PlayPauseBtn"
                                    Content="▶"
                                    Style="{StaticResource IconBtn}"
                                    FontSize="20" Width="48" Height="48"
                                    Foreground="{StaticResource AccentBrush}"
                                    Click="OnPlayPauseClick"
                                    ToolTip="재생 / 일시 정지 (Space)"
                                    Margin="0,0,4,0"/>
                            <Button Content="⏹"
                                    Style="{StaticResource IconBtn}"
                                    Click="OnStopClick"
                                    ToolTip="정지"/>
                        </StackPanel>

                        <!-- Center: empty spacer -->
                        <StackPanel Grid.Column="1"/>

                        <!-- Volume -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button x:Name="MuteBtn"
                                    Content="🔊"
                                    Style="{StaticResource IconBtn}"
                                    FontSize="16"
                                    Click="OnMuteClick"
                                    ToolTip="음소거"
                                    Margin="0,0,8,0"/>
                            <Slider x:Name="VolumeBar"
                                    Style="{StaticResource DarkSlider}"
                                    Minimum="0" Maximum="1"
                                    Value="0.7"
                                    Width="100"
                                    ValueChanged="OnVolumeChanged"
                                    ToolTip="볼륨"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══════════════════════════════
             Right: Comments panel
             ══════════════════════════════ -->
        <Border Grid.Column="1"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush2}"
                BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Header -->
                    <RowDefinition Height="*"/>     <!-- List -->
                    <RowDefinition Height="3"/>     <!-- Loading -->
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Padding="16,12"
                        BorderBrush="{StaticResource BorderBrush2}"
                        BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💬" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="CommentCountBlock"
                                   Text="댓글"
                                   Foreground="{StaticResource TextPrimBrush}"
                                   FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Comment list -->
                <ListBox x:Name="CommentList"
                         Grid.Row="1"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding"      Value="0"/>
                            <Setter Property="Background"   Value="Transparent"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBd" Background="Transparent"
                                                Padding="14,10"
                                                BorderBrush="{StaticResource BorderBrush2}"
                                                BorderThickness="0,0,0,1">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBd" Property="Background"
                                                        Value="#0A3B82F6"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Author + time -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                    <TextBlock Text="{Binding Author}"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding TimeAgo}"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="11"/>
                                </StackPanel>

                                <!-- Content -->
                                <TextBlock Grid.Row="1"
                                           Text="{Binding Content}"
                                           Foreground="{StaticResource TextPrimBrush}"
                                           FontSize="12" TextWrapping="Wrap"
                                           Margin="0,4,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Comments loading bar -->
                <ProgressBar x:Name="CommentProgress"
                             Grid.Row="2"
                             IsIndeterminate="True"
                             Foreground="{StaticResource AccentBrush}"
                             Background="Transparent"
                             BorderThickness="0"
                             Visibility="Collapsed"/>
            </Grid>
        </Border>
    </Grid>
</Window>
