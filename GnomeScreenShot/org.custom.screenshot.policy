<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Custom Screenshot</vendor>
  <vendor_url>https://github.com/screenshot-app</vendor_url>

  <action id="org.custom.screenshot.capture">
    <description>Take screenshots</description>
    <message>Authentication is required to take screenshots</message>
    <icon_name>camera-photo</icon_name>
    <defaults>
      <allow_any>yes</allow_any>
      <allow_inactive>yes</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>
</policyconfig>
