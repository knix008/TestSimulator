{
  "name": "myworkforce",
  "productName": "MyWorkForce",
  "private": true,
  "version": "1.0.0",
  "description": "Work tracking for Web, Windows, macOS and Linux (Tauri) — projects, issues, scrum and kanban boards, backlog, sprints, roadmap, dashboards, reports and service queues",
  "author": "SHKWON <knix008@naver.com>",
  "type": "module",
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "vite",
    "build:web": "vite build",
    "preview": "vite preview --port 4180 --strictPort",
    "tauri": "tauri",
    "test": "node scripts/test.mjs",
    "server": "node server/index.mjs",
    "stage": "node scripts/stage-runtime.mjs --check",
    "build:icons": "node scripts/render-icons.mjs",
    "build:win": "node scripts/build.mjs win",
    "build:mac": "node scripts/build.mjs mac",
    "build:linux": "node scripts/build.mjs linux",
    "build:all": "node scripts/build.mjs all",
    "clean": "node scripts/clean.mjs",
    "clean:all": "node scripts/clean.mjs --all",
    "guide:shots": "node scripts/guide-shots.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "mssql": "^11.0.1",
    "mysql2": "^3.14.3",
    "nodemailer": "^7.0.5",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "vite": "^7.1.7"
  }
}
