{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyWorkForce",
  "mainBinaryName": "MyWorkForce",
  "version": "../package.json",
  "identifier": "com.shkwon.myworkforce",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1480",
    "beforeBuildCommand": "npm run stage && npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "SHKWON",
    "copyright": "Copyright (c) SHKWON (knix008@naver.com)",
    "category": "Productivity",
    "shortDescription": "Work tracking for projects, boards and queues",
    "longDescription": "Projects, issues, scrum and kanban boards, backlog, sprints, roadmap, dashboards, reports, service queues and a workspace file you can open on the web or on the desktop.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "runtime/": "runtime/",
      "../samples/": "samples/"
    },
    "fileAssociations": [
      {
        "ext": ["mwf"],
        "name": "MyWorkForce.Workspace",
        "description": "MyWorkForce workspace",
        "mimeType": "application/x-myworkforce",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Korean", "English"],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "MyWorkForce",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "macOS": { "minimumSystemVersion": "11.0" },
    "linux": {
      "deb": { "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"] },
      "rpm": { "depends": ["webkit2gtk4.1", "gtk3"] }
    }
  }
}
