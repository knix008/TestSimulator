{
  "name": "myphotoworkmultiosv10",
  "productName": "My Photo Work V1.0",
  "private": true,
  "version": "1.0.0",
  "description": "A cross-platform Photoshop-style photo editor for Web, Windows, macOS, and Linux.",
  "author": "SHKWON <knix008@naver.com>",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "start": "npm run electron:dev",
    "dev": "npm run build:info && vite --host 127.0.0.1 --port 5173 --strictPort",
    "electron": "node scripts/start-electron.mjs",
    "electron:dev": "node scripts/electron-dev.mjs",
    "build": "npm run build:info && tsc -b && vite build",
    "build:web": "npm run build",
    "build:icons": "node scripts/create-icons.cjs",
    "build:info": "node scripts/generate-build-info.cjs",
    "dist": "npm run build:icons && npm run build && electron-builder && node scripts/copy-installers.cjs",
    "dist:win": "npm run build:icons && npm run build && electron-builder --win nsis && node scripts/copy-installers.cjs",
    "build:win": "npm run dist:win",
    "dist:mac": "npm run build:icons && npm run build && electron-builder --mac dmg zip && node scripts/copy-installers.cjs",
    "dist:linux": "npm run build:icons && npm run build && electron-builder --linux AppImage deb rpm && node scripts/copy-installers.cjs",
    "postinstall": "node node_modules/electron/install.js",
    "pretest": "npm run build:icons && npm run build:info",
    "test": "node --test --import ./test/helpers/setup.mjs test/*.test.mjs",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.shkwon.myphotoworkmultios",
    "productName": "My Photo Work V1.0",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.ico",
      "build/icon.png",
      "build/icons/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.photography"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "icon": "build/icons",
      "category": "Graphics"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "My Photo Work V1.0",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  },
  "dependencies": {
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "utif": "^3.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@napi-rs/canvas": "^1.0.9",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "png-to-ico": "^3.0.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "wait-on": "^9.1.0"
  }
}
