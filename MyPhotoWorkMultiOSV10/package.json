{
  "name": "myphotoworkmultiosv10",
  "productName": "My Photo Work V1.0",
  "private": true,
  "version": "1.0.0",
  "description": "A cross-platform layer-based raster photo editor for Web, Windows, macOS, and Linux (Tauri desktop shell).",
  "author": "SHKWON <knix008@naver.com>",
  "type": "module",
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "node scripts/dev.mjs",
    "tauri": "tauri",
    "build": "npm run build:info && tsc -b && vite build",
    "build:web": "npm run build",
    "build:icons": "node scripts/create-icons.cjs",
    "build:info": "node scripts/generate-build-info.cjs",
    "build:guide": "node scripts/build-guide.mjs",
    "build:win": "npm run build:icons && node scripts/platform-build.mjs win",
    "build:mac": "npm run build:icons && node scripts/platform-build.mjs mac",
    "build:linux": "npm run build:icons && node scripts/platform-build.mjs linux",
    "guide:shots": "node scripts/guide-shots.mjs",
    "pretest": "npm run build:icons && npm run build:info",
    "test": "node --test --test-reporter=./test/helpers/reporter.mjs --import ./test/helpers/setup.mjs test/*.test.mjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:e2e": "node scripts/e2e.mjs",
    "verify:images": "node --import ./test/helpers/setup.mjs scripts/verify-images.mjs",
    "verify:features": "node --import ./test/helpers/setup.mjs scripts/verify-features.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:ui": "node scripts/audit-ui.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@techstark/opencv-js": "^5.0.0-release.1",
    "dicom-parser": "^1.8.21",
    "libheif-js": "^1.23.2",
    "lucide-react": "^1.28.0",
    "onnxruntime-web": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "utif": "^3.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@napi-rs/canvas": "^1.0.9",
    "@resvg/resvg-js": "^2.6.2",
    "@tauri-apps/cli": "^2.11.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "png-to-ico": "^3.0.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0"
  }
}
