# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Build output
release
*.tsbuildinfo

# `out/` is deliberately NOT ignored. It holds the results of
# `npm run verify:images` — the real photos in images/ taken through the whole
# open → edit → export → print pipeline — and those are kept so the run can be
# looked at rather than merely believed. `out/index.html` is the gallery and
# `out/report.md` the record. The directory is rebuilt from scratch every run.
#
# The repository root ignores `[Oo]ut/` for every project under it, and a
# directory that is excluded cannot have its contents re-included one by one.
# So the directory itself has to be un-excluded first, and its contents after.
!out/
!out/**

# Generated before every build, never edited by hand.
#   src/build-info.json   <- scripts/generate-build-info.cjs (changes every build)
#   build/icon.*          <- scripts/create-icons.cjs, rendered from public/app-icon.svg
# `npm test` regenerates both first, so a fresh clone still passes.
src/build-info.json
build/icon.ico
build/icon.png
build/icons/

# Packaged installers copied to the project root by scripts/copy-installers.cjs
/*.exe
/*.dmg
/*.AppImage
/*.deb
/*.rpm
/*.zip

# Scratch output from the packaging and screenshot helpers
screenshots/
*.tmp

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
