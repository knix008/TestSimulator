# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Build output
release
*.tsbuildinfo

# Results of `npm run verify:images` (the real photos in images/ taken through
# the whole open -> edit -> export -> print pipeline). Rebuilt from scratch every
# run; open out/index.html locally to look at them.
out/

# Generated before every build, never edited by hand.
#   src/build-info.json   <- scripts/generate-build-info.cjs (changes every build)
#   build/icon.*          <- scripts/create-icons.cjs, rendered from public/app-icon.svg
# `npm test` regenerates both first, so a fresh clone still passes.
src/build-info.json
build/icon.ico
build/icon.png
build/icons/

# Packaged installers copied to the project root by scripts/copy-installers.cjs
/*.exe
/*.dmg
/*.AppImage
/*.deb
/*.rpm
/*.zip

# Scratch output from the packaging and screenshot helpers
screenshots/
*.tmp
# Neural network weights are fetched into the user's data folder at run time
# (Edit > Neural Models), never into the project; a stray copy must not be
# committed, nor the scratch scripts the live checks are driven with.
*.onnx
*.part.onnx
*.tmp.mjs

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
