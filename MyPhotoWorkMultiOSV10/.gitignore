# Dependencies
node_modules/

# Build output
dist/
src-tauri/target/
src-tauri/gen/

# Generated before every build or test run
#   build/               scripts/create-icons.cjs, from public/app-icon.svg
#   src/build-info.json  scripts/generate-build-info.cjs
build/
src/build-info.json

# Installers copied to the project root by scripts/platform-build.mjs
/*.exe
/*.dmg
/*.AppImage
/*.deb

# out/test-report.md from npm test, and the results of npm run verify:images and verify:features (over samples/), rebuilt on every run
out/

# Neural network weights belong in the user's data folder, never in the project
*.onnx

# Logs and local settings
*.log
*.local
.env
.env.*
!.env.example

# Editors and the OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.sw?
