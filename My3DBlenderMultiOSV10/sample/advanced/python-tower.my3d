,"emissionStrength":1,"useNodes":false,"nodes":null},{"id":"matmw7ndveudk","name":"Material.020","baseColor":[0.8108695652173914,0.45587518501063,0.2804347826086957],"metallic":0,"roughness":0.35,"specular":0.5,"ior":1.45,"transmission":0,"alpha":1,"emission":[0,0,0],"emissionStrength":1,"useNodes":false,"nodes":null},{"id":"matmw7ndvevdm","name":"Material.021","baseColor":[0.8456521739130435,0.41952032695387254,0.24782608695652175],"metallic":0,"roughness":0.35,"specular":0.5,"ior":1.45,"transmission":0,"alpha":1,"emission":[0,0,0],"emissionStrength":1,"useNodes":false,"nodes":null},{"id":"matmw7ndvewdo","name":"Material.022","baseColor":[0.8804347826086957,0.3809390313471074,0.21521739130434792],"metallic":0,"roughness":0.35,"specular":0.5,"ior":1.45,"transmission":0,"alpha":1,"emission":[0,0,0],"emissionStrength":1,"useNodes":false,"nodes":null},{"id":"matmw7ndvexdq","name":"Material.023","baseColor":[0.9152173913043479,0.340849994728874,0.18260869565217386],"metallic":0,"roughness":0.35,"specular":0.5,"ior":1.45,"transmission":0,"alpha":1,"emission":[0,0,0],"emissionStrength":1,"useNodes":false,"nodes":null},{"id":"matmw7ndvezds","name":"Material.024","baseColor":[0.9500000000000001,0.30000000000000004,0.15000000000000002],"metallic":0,"roughness":0.35,"specular":0.5,"ior":1.45,"transmission":0,"alpha":1,"emission":[0,0,0],"emissionStrength":1,"useNodes":false,"nodes":null}],"images":[],"texts":[{"id":"txtmw7ndvebcg","name":"tower.py","body":"# Builds a twisted tower, floor by floor. Change the numbers and press Ctrl+Enter.\nimport bpy\nimport math\n\nFLOORS = 24\nTWIST = 7.5        # degrees per floor\nHEIGHT = 0.42\n\ndef floor_colour(i):\n    t = i / (FLOORS - 1)\n    return (0.15 + 0.8 * t, 0.3 + 0.3 * math.sin(t * math.pi), 0.9 - 0.75 * t)\n\nfor i in range(FLOORS):\n    t = i / FLOORS\n    bpy.ops.mesh.primitive_cube_add(size=1, location=(0, 0, 0.3 + i * HEIGHT))\n    block = bpy.context.active_object\n    block.name = f\"Floor {i + 1:02d}\"\n    width = 3.4 - 2.2 * t\n    block.scale = (width, width, 0.36)\n    block.rotation[2] = i * TWIST\n    bpy.ops.material.new()\n    mat = bpy.data.materials[-1]\n    mat.baseColor = list(floor_colour(i))\n    mat.roughness = 0.35\n\nprint(\"Built\", FLOORS, \"floors:\", len(bpy.data.objects), \"objects in all\")\n"}],"palettes":[],"clips":[],"actions":[],"caches":[],"collections":[{"id":"col_root","name":"Scene Collection","parent":null,"hide":false,"exclude":false}],"activeCollection":"col_root","activeId":"obmw7ndveydr","selected":["obmw7ndveydr"],"mode":"OBJECT","cursor":[0,0,0],"activeCamera":"obmw7ndvebcf","proportional":{"enabled":false,"size":1,"falloff":"SMOOTH","connected":false},"snap":{"enabled":false,"target":"INCREMENT"},"scenes":[{"id":"scene_1","name":"Scene","state":null}],"activeScene":"scene_1","nodeGroups":[],"frame":1,"frameStart":1,"frameEnd":120,"fps":24,"frameStep":1,"markers":[],"gravity":[0,0,-9.81],"unitScale":1,"unitSystem":"METRIC","world":{"color":[0.5,0.56,0.68],"strength":1,"useNodes":false,"nodes":null,"aoDistance":10,"mist":{"start":5,"depth":25,"falloff":"QUADRATIC"}},"render":{"engine":"PATH","samples":32,"bounces":4,"width":1920,"height":1080,"percent":50,"filmTransparent":false,"exposure":0,"gamma":1,"format":"PNG","dofAperture":0,"viewTransform":"FILMIC","denoise":true,"seed":0,"freestyle":{"enabled":false,"thickness":1.5,"color":[0,0,0],"crease":40,"silhouette":true,"border":true,"creases":true}},"compositor":null,"compositorEnabled":false,"sequence":{"strips":[],"channels":8},"viewLayers":[{"id":"vl1","name":"ViewLayer","usePass":{"combined":true,"z":false,"normal":false}}],"sample":{"id":"python-tower","level":"advanced"}}