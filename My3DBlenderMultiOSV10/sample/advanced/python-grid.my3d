","name":"field.py","body":"import bpy\nfrom math import sin, cos, hypot\n\nclass Field:\n    def __init__(self, size, spacing):\n        self.size = size\n        self.spacing = spacing\n\n    def points(self):\n        half = self.size // 2\n        return [(x * self.spacing, y * self.spacing) for x in range(-half, half + 1) for y in range(-half, half + 1)]\n\ndef wave(x, y):\n    d = hypot(x, y)\n    return 1.1 + cos(d * 1.1) * 0.9\n\nfield = Field(size=14, spacing=0.8)\nshared = None\nfor x, y in field.points():\n    h = wave(x, y)\n    bpy.ops.mesh.primitive_cube_add(size=1, location=(x, y, h / 2))\n    column = bpy.context.active_object\n    column.scale = (0.68, 0.68, h)\n    if shared is None:\n        bpy.ops.material.new()\n        shared = bpy.data.materials[-1]\n        shared.baseColor = [0.1, 0.55, 0.75]\n        shared.roughness = 0.3\n    column.materials = [shared.id]\nprint(len(field.points()), \"columns\")\n"}],"palettes":[],"clips":[],"collections":[{"id":"col_root","name":"Scene Collection","parent":null,"hide":false,"exclude":false}],"activeCollection":"col_root","activeId":"obmw5oxiqcby","selected":["obmw5oxiqcby"],"mode":"OBJECT","cursor":[0,0,0],"activeCamera":"obmw5oxiek5n","proportional":{"enabled":false,"size":1,"falloff":"SMOOTH","connected":false},"scenes":[{"id":"scene_1","name":"Scene","state":null}],"activeScene":"scene_1","nodeGroups":[],"frame":1,"frameStart":1,"frameEnd":120,"fps":24,"frameStep":1,"markers":[],"gravity":[0,0,-9.81],"unitScale":1,"unitSystem":"METRIC","world":{"color":[0.5,0.56,0.68],"strength":1,"useNodes":false,"nodes":null},"render":{"engine":"PATH","samples":32,"bounces":4,"width":1920,"height":1080,"percent":50,"filmTransparent":false,"exposure":0,"gamma":1,"format":"PNG","dofAperture":0,"viewTransform":"FILMIC","denoise":true,"seed":0,"freestyle":{"enabled":false,"thickness":1.5,"color":[0,0,0],"crease":40,"silhouette":true,"border":true,"creases":true}},"compositor":null,"compositorEnabled":false,"sequence":