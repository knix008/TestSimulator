{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "My3DBlender",
  "mainBinaryName": "My3DBlender",
  "version": "../package.json",
  "identifier": "com.shkwon.my3dblender",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1537",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "SHKWON",
    "copyright": "Copyright (c) SHKWON (knix008@naver.com)",
    "category": "GraphicsAndDesign",
    "shortDescription": "3D creation suite",
    "longDescription": "Model, sculpt, paint, animate, simulate and render in 3D: polygon modeling with a modifier stack, shader, geometry and compositor nodes, keyframe animation and armatures, physics, a path-traced renderer and scripting.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["my3d"],
        "name": "My3DBlender.Project",
        "description": "My3DBlender Project",
        "mimeType": "application/x-my3dblender",
        "role": "Editor"
      }
    ],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Korean", "English"],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "headerImage": "windows/installerHeader.bmp",
        "sidebarImage": "windows/installerSidebar.bmp",
        "installerHooks": "windows/hooks.nsh",
        "startMenuFolder": "My3DBlender"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"],
        "files": {
          "/usr/share/mime/packages/my3dblender.xml": "linux/my3dblender.xml"
        },
        "postInstallScript": "linux/postinst.sh",
        "postRemoveScript": "linux/postrm.sh"
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "gtk3"],
        "files": {
          "/usr/share/mime/packages/my3dblender.xml": "linux/my3dblender.xml"
        },
        "postInstallScript": "linux/postinst.sh",
        "postRemoveScript": "linux/postrm.sh"
      }
    }
  }
}
