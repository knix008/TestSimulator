<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>DiffMergeWinV10.ico</ApplicationIcon>
    <AssemblyTitle>Diff &amp; Merge Win V10</AssemblyTitle>
    <Product>Diff &amp; Merge Win V10</Product>
  </PropertyGroup>

  <ItemGroup>
    <None Include="DiffMergeWinV10.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Release build in Visual Studio: publish + WiX MSI (SkipInstaller=true avoids recursion from wixproj). -->
  <Target Name="BuildMsiPackage"
          AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release'
                     and '$(SkipInstaller)' != 'true'
                     and '$(DesignTimeBuild)' != 'true'
                     and '$(BuildingProject)' == 'true'">
    <Message Importance="high" Text="Building MSI: installer\bin\Release\DiffMergeWinV10Setup.msi" />
    <Exec WorkingDirectory="$(MSBuildThisFileDirectory).."
          Command="dotnet build &quot;$(MSBuildThisFileDirectory)..\installer\DiffMergeWinV10.Installer.wixproj&quot; -c Release -p:Platform=x64 -p:BuildProjectReferences=false" />
  </Target>

</Project>
