<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="MDMakerWinV10"
           Manufacturer="TestSimulator"
           Version="1.0.0.0"
           UpgradeCode="FA413CC8-1D6E-4D6A-B413-238DD7F38E8A"
           Scope="perMachine"
           InstallerVersion="500"
           Codepage="65001">
    <MajorUpgrade DowngradeErrorMessage="A newer version of MDMakerWinV10 is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="assets\daemon_hammer.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <WixVariable Id="WixUILicenseRtf" Value="assets\License.rtf" />
    <WixVariable Id="WixUIExclamationIco" Value="assets\daemon_hammer.ico" />
    <WixVariable Id="WixUIInfoIco" Value="assets\daemon_hammer.ico" />
    <WixVariable Id="WixUINewIco" Value="assets\daemon_hammer.ico" />
    <WixVariable Id="WixUIUpIco" Value="assets\daemon_hammer.ico" />

    <Launch Condition="Privileged"
            Message="관리자 권한이 필요합니다. 설치 파일을 관리자 권한으로 실행해 주세요." />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="MDMakerWinV10">
        <!-- .mdm 파일 연결 -->
        <Component Id="CmpFileAssociation" Guid="8E2F3A1C-4B7D-4E9F-A2C3-5D6E7F8A9B0C" Bitness="always64">
          <RegistryValue Root="HKLM" Key="Software\Classes\.mdm"
                         Type="string" Value="MDMakerWinV10.mdm" KeyPath="yes" />
          <RegistryValue Root="HKLM" Key="Software\Classes\MDMakerWinV10.mdm"
                         Type="string" Value="MD Maker 프로젝트" />
          <RegistryValue Root="HKLM" Key="Software\Classes\MDMakerWinV10.mdm\DefaultIcon"
                         Type="string" Value="[INSTALLFOLDER]assets\icons\mdm-file.ico,0" />
          <RegistryValue Root="HKLM" Key="Software\Classes\MDMakerWinV10.mdm\shell\open\command"
                         Type="string" Value="&quot;[INSTALLFOLDER]MDMakerWinV10.exe&quot; &quot;%1&quot;" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="CmpDesktopShortcut" Guid="*" Bitness="always64">
        <Shortcut Id="ShcDesktop"
                  Name="MDMakerWinV10"
                  Description="MDMakerWinV10"
                  Target="[INSTALLFOLDER]MDMakerWinV10.exe"
                  Icon="AppIcon"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU"
                       Key="Software\TestSimulator\MDMakerWinV10\Setup"
                       Name="DesktopShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="MDMakerWinV10">
        <Component Id="CmpStartMenuShortcut" Guid="*" Bitness="always64">
          <Shortcut Id="ShcStartMenu"
                    Name="MDMakerWinV10"
                    Description="MDMakerWinV10"
                    Target="[INSTALLFOLDER]MDMakerWinV10.exe"
                    Icon="AppIcon"
                    WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
          <RegistryValue Root="HKCU"
                         Key="Software\TestSimulator\MDMakerWinV10\Setup"
                         Name="StartMenuShortcut"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="MDMakerWinV10" Level="1"
             ConfigurableDirectory="INSTALLFOLDER">
      <ComponentGroupRef Id="HarvestedApp" />
      <ComponentRef Id="CmpFileAssociation" />
      <Feature Id="DesktopShortcut" Title="바탕화면 바로가기" Level="1">
        <ComponentRef Id="CmpDesktopShortcut" />
      </Feature>
      <Feature Id="StartMenuShortcut" Title="시작 메뉴 바로가기" Level="1">
        <ComponentRef Id="CmpStartMenuShortcut" />
      </Feature>
    </Feature>

    <ui:WixUI Id="WixUI_FeatureTree" />
  </Package>

  <Fragment>
    <ComponentGroup Id="HarvestedApp" Directory="INSTALLFOLDER">
      <Files Include="$(var.MDMakerWinV10.TargetDir)**">
        <Exclude Files="*.pdb" />
      </Files>
    </ComponentGroup>
  </Fragment>
</Wix>
