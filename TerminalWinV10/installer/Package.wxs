<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="TerminalWinV10"
           Manufacturer="TestSimulator"
           Version="1.0.0.0"
           UpgradeCode="C8E4F2A1-5B6D-4E3F-9A2C-1D7B8E9F0A1B"
           Scope="perMachine"
           InstallerVersion="500"
           Codepage="65001">
    <MajorUpgrade DowngradeErrorMessage="이미 최신 버전의 [ProductName]이(가) 설치되어 있습니다." />
    <MediaTemplate EmbedCab="yes" />

    <!-- MSI 아이콘 테이블 + 제어판/Windows 설정 앱 목록 아이콘 -->
    <Icon Id="AppIcon.ico" SourceFile="assets\daemon_hammer.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPCOMMENTS" Value="Serial/TCP 터미널" />

    <WixVariable Id="WixUILicenseRtf" Value="assets\License.rtf" />
    <WixVariable Id="WixUIExclamationIco" Value="assets\daemon_hammer.ico" />
    <WixVariable Id="WixUIInfoIco" Value="assets\daemon_hammer.ico" />
    <WixVariable Id="WixUINewIco" Value="assets\daemon_hammer.ico" />
    <WixVariable Id="WixUIUpIco" Value="assets\daemon_hammer.ico" />

    <Launch Condition="Privileged"
            Message="관리자 권한이 필요합니다. 설치 파일을 관리자 권한으로 실행해 주세요." />

    <!-- WixUI_FeatureTree: 설치 중 바탕화면/시작 메뉴 바로가기를 각각 선택 -->
    <Feature Id="ProductFeature"
             Title="TerminalWinV10"
             Description="프로그램 파일 설치 및 바로가기 옵션"
             Level="1"
             Display="expand"
             ConfigurableDirectory="INSTALLFOLDER">

      <ComponentGroupRef Id="HarvestedApp" />

      <Feature Id="DesktopShortcutFeature"
               Title="바탕화면 바로가기"
               Description="바탕화면에 TerminalWinV10 바로가기를 만듭니다."
               Level="1"
               AllowAbsent="yes"
               AllowAdvertise="no">
        <ComponentRef Id="DesktopShortcutComponent" />
      </Feature>

      <Feature Id="StartMenuShortcutFeature"
               Title="시작 메뉴 바로가기"
               Description="시작 메뉴에 TerminalWinV10 바로가기를 만듭니다."
               Level="1"
               AllowAbsent="yes"
               AllowAdvertise="no">
        <ComponentRef Id="StartMenuShortcutComponent" />
      </Feature>
    </Feature>

    <ui:WixUI Id="WixUI_FeatureTree" />
  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="TerminalWinV10" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="TerminalWinV10" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />
  </Fragment>

  <Fragment>
    <ComponentGroup Id="HarvestedApp" Directory="INSTALLFOLDER">
      <Files Include="$(var.TerminalWinV10.TargetDir)**">
        <Exclude Files="*.pdb" />
      </Files>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <Component Id="DesktopShortcutComponent" Directory="DesktopFolder" Guid="*" Bitness="always64">
      <Shortcut Id="DesktopShortcut"
                Name="TerminalWinV10"
                Description="Serial/TCP terminal"
                Target="[INSTALLFOLDER]TerminalWinV10.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon.ico"
                IconIndex="0" />
      <RegistryValue Root="HKCU"
                     Key="Software\TestSimulator\TerminalWinV10\Setup"
                     Name="DesktopShortcut"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>

    <Component Id="StartMenuShortcutComponent" Directory="ApplicationProgramsFolder" Guid="*" Bitness="always64">
      <Shortcut Id="StartMenuShortcut"
                Name="TerminalWinV10"
                Description="Serial/TCP terminal"
                Target="[INSTALLFOLDER]TerminalWinV10.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon.ico"
                IconIndex="0" />
      <RemoveFolder Id="RemoveApplicationProgramsFolder" Directory="ApplicationProgramsFolder" On="uninstall" />
      <RegistryValue Root="HKCU"
                     Key="Software\TestSimulator\TerminalWinV10\Setup"
                     Name="StartMenuShortcut"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>
  </Fragment>
</Wix>
