# Dependencies
node_modules/

# ── Build outputs (directories) ──────────────────────────────
dist/
dist-web/
out/
release/
*-unpacked/
__appImage-*/
AppDir/

# ── Build targets / installers (incl. copies at project root) ──
# Windows
*.exe
*.msi
*.msix
*.appx
*.nupkg
*.blockmap

# macOS
*.dmg
*.pkg

# Linux
*.AppImage
*.deb
*.rpm
*.snap
*.flatpak

# Archives (electron-builder / copy-artifacts)
*.zip
*.7z
*.tar
*.tar.gz
*.tgz
*.gz

# Product-named artifacts (NSIS Setup, linux package names, …)
/AV Editor*
/av-editor-*
/av-editor_*.*

# electron-updater / builder metadata next to artifacts
/latest*.yml
/latest*.yaml
/builder-effective-config.yaml
/builder-debug.yml

# Keep icon assets (not matched by installer globs above)
!assets/**/*.ico
!assets/**/*.icns

# ── Generated icons (keep source SVG; npm run generate-icons) ──
assets/icons/icon-*.png
assets/icons/icon.png
assets/icons/icon.ico
assets/icons/icon.icns
assets/icons/linux/

# ── Logs ─────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── OS ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ── Editors / IDE ────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.cursor/

# ── Env / secrets ────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Electron / cache ─────────────────────────────────────────
.electron/
.cache/
.webpack/

# ── Test / coverage ──────────────────────────────────────────
coverage/
.nyc_output/

# ── Temp ─────────────────────────────────────────────────────
tmp/
temp/
*.tmp
*.temp
*.bak

# Synced from node_modules on npm start / build:web (large WASM)
src/renderer/vendor/transformers/
