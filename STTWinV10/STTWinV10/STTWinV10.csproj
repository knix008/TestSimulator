<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>daemon_hammer.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Whisper.net" Version="1.7.0" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.7.0" />
    <!-- GPU 가속을 위한 CUDA 런타임 (선택적) -->
    <!-- GPU가 있고 CUDA를 사용하려면 아래 주석을 해제하세요 -->
    <!-- <PackageReference Include="Whisper.net.Runtime.Cuda" Version="1.7.0" /> -->
    <PackageReference Include="System.Reactive" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="daemon_hammer.ico" />
  </ItemGroup>

  <!-- Release에서 앱(csproj)만 빌드할 때 MSI까지 생성. 솔루션 빌드(BuildingSolutionFile)일 때는 설치 프로젝트가 빌드되므로 여기서는 생략. WiX ProjectReference에서는 DisableInstallerChain으로 재호출 방지. -->
  <Target Name="BuildInstallerAfterRelease" AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release' and '$(MSBuildIsProjectReference)' != 'true' and '$(DesignTimeBuild)' != 'true' and '$(BuildingPackage)' != 'true' and '$(DisableInstallerChain)' != 'true' and '$(BuildingSolutionFile)' != 'true'">
    <Exec Command="dotnet build &quot;$(MSBuildThisFileDirectory)..\STTWinV10.Installer\STTWinV10.Installer.wixproj&quot; -c Release -p:Platform=x64" />
  </Target>

</Project>
