<Window x:Class="STTWinV10.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="실시간 음성 인식 (Whisper STT)" Height="600" Width="800"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="25,15"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="MinHeight" Value="50"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="5" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1976D2"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CCCCCC"/>
                    <Setter Property="Foreground" Value="#666666"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 제목 -->
        <TextBlock Grid.Row="0" 
                   Text="🎤 실시간 음성 인식 (Whisper)" 
                   FontSize="24" 
                   FontWeight="Bold"
                   Margin="0,0,0,20"
                   Foreground="#2196F3"/>

        <!-- 컨트롤 버튼 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
            <Button x:Name="StartButton" 
                    Content="🎙️ 시작" 
                    Style="{StaticResource ButtonStyle}"
                    Click="StartButton_Click"
                    Background="#4CAF50"/>
            
            <Button x:Name="StopButton" 
                    Content="⏹️ 중지" 
                    Style="{StaticResource ButtonStyle}"
                    Click="StopButton_Click"
                    IsEnabled="False"
                    Background="#F44336"/>
            
            <Button x:Name="ProcessButton" 
                    Content="⚡ 즉시 처리" 
                    Style="{StaticResource ButtonStyle}"
                    Click="ProcessButton_Click"
                    IsEnabled="False"
                    Background="#FF9800"/>
            
            <Button x:Name="ClearButton" 
                    Content="🗑️ 지우기" 
                    Style="{StaticResource ButtonStyle}"
                    Click="ClearButton_Click"
                    Background="#9E9E9E"/>
        </StackPanel>

        <!-- 인식 결과 표시 영역 -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" 
                       Text="인식 결과:" 
                       FontSize="16" 
                       FontWeight="SemiBold"
                       Margin="0,0,0,10"/>

            <Border Grid.Row="1" 
                    BorderBrush="#DDDDDD" 
                    BorderThickness="2" 
                    CornerRadius="5"
                    Background="#F9F9F9">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="TranscriptionTextBox"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             FontSize="14"
                             Padding="10"
                             BorderThickness="0"
                             Background="Transparent"
                             IsReadOnly="False"
                             VerticalAlignment="Stretch"/>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 상태 표시줄 -->
        <Border Grid.Row="3" 
                Background="#F5F5F5" 
                Padding="10" 
                Margin="0,20,0,0"
                CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                           Text="상태: " 
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                
                <TextBlock x:Name="StatusTextBlock" 
                           Grid.Column="1"
                           Text="준비" 
                           VerticalAlignment="Center"
                           Foreground="#666666"/>
            </Grid>
        </Border>
    </Grid>
</Window>
