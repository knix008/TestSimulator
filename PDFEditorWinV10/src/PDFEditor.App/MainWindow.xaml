<Window x:Class="PDFEditor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PDFEditor.App.ViewModels"
        mc:Ignorable="d"
        Title="{Binding DocumentTitle}"
        Height="900"
        Width="1400"
        MinHeight="600"
        MinWidth="1000"
        Background="White">
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenPdfCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SavePdfCommand}"/>
    </Window.InputBindings>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="파일">
                <MenuItem Header="PDF 열기..." Command="{Binding OpenPdfCommand}" InputGestureText="Ctrl+O"/>
                <Separator/>
                <MenuItem Header="PDF 저장..." Command="{Binding SavePdfCommand}" InputGestureText="Ctrl+S"/>
                <MenuItem Header="JSON 저장..." Command="{Binding SaveJsonCommand}"/>
            </MenuItem>
            <MenuItem Header="도구">
                <MenuItem Header="OCR - 현재 페이지" Command="{Binding OcrCurrentPageCommand}"/>
                <MenuItem Header="OCR - 스캔 페이지 전체" Command="{Binding OcrAllPagesCommand}"/>
            </MenuItem>
            <MenuItem Header="보기">
                <MenuItem Header="이전 페이지" Command="{Binding PreviousPageCommand}"/>
                <MenuItem Header="다음 페이지" Command="{Binding NextPageCommand}"/>
            </MenuItem>
        </Menu>

        <ToolBar DockPanel.Dock="Top" Padding="8,4">
            <Button Content="열기" Command="{Binding OpenPdfCommand}" Padding="12,6" Margin="0,0,6,0"/>
            <Button Content="PDF 저장" Command="{Binding SavePdfCommand}" Padding="12,6" Margin="0,0,6,0"/>
            <Button Content="JSON 저장" Command="{Binding SaveJsonCommand}" Padding="12,6" Margin="0,0,12,0"/>
            <Separator/>
            <Button Content="◀" Command="{Binding PreviousPageCommand}" Padding="10,6"/>
            <TextBlock VerticalAlignment="Center" Margin="8,0">
                <Run Text="{Binding CurrentPageIndex, Mode=OneWay}"/>
                <Run Text="/"/>
                <Run Text="{Binding PageCount, Mode=OneWay}"/>
            </TextBlock>
            <Button Content="▶" Command="{Binding NextPageCommand}" Padding="10,6"/>
        </ToolBar>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding ToolStatusText}" Foreground="#64748B" FontSize="11"/>
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8"
                    Margin="0,0,8,0">
                <TabControl SelectedIndex="{Binding SelectedTabIndex}" BorderThickness="0" Background="Transparent">
                    <TabItem Header="텍스트">
                        <ListBox ItemsSource="{Binding TextElements}"
                                 SelectedItem="{Binding SelectedTextElement}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Margin="0,8,0,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TextElementViewModel}">
                                    <StackPanel Margin="0,4">
                                        <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock FontSize="11" Foreground="#64748B"
                                                   Text="{Binding FontName, StringFormat=폰트: {0}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                    <TabItem Header="이미지">
                        <ListBox ItemsSource="{Binding ImageElements}"
                                 SelectedItem="{Binding SelectedImageElement}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Margin="0,8,0,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ImageElementViewModel}">
                                    <StackPanel Margin="0,4">
                                        <TextBlock Text="{Binding XObjectName}" FontWeight="SemiBold"/>
                                        <TextBlock FontSize="11" Foreground="#64748B"
                                                   Text="{Binding Id}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                    <TabItem Header="주석">
                        <ListBox ItemsSource="{Binding AnnotationElements}"
                                 SelectedItem="{Binding SelectedAnnotationElement}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Margin="0,8,0,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:AnnotationElementViewModel}">
                                    <StackPanel Margin="0,4">
                                        <TextBlock Text="{Binding Subtype}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Contents}" TextTrimming="CharacterEllipsis"
                                                   FontSize="11" Foreground="#64748B"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                    <TabItem Header="폼">
                        <ListBox ItemsSource="{Binding FormFields}"
                                 SelectedItem="{Binding SelectedFormField}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Margin="0,8,0,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:FormFieldViewModel}">
                                    <StackPanel Margin="0,4">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock FontSize="11" Foreground="#64748B"
                                                   Text="{Binding FieldType, StringFormat=유형: {0}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                </TabControl>
            </Border>

            <Border Grid.Column="1"
                    Background="#EEF2F7"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Padding="16">
                    <Grid Width="{Binding PageWidth}"
                          Height="{Binding PageHeight}"
                          Background="White">
                        <Image Source="{Binding PageImage}"
                               Stretch="Fill"/>

                        <ItemsControl ItemsSource="{Binding ImageElements}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding DisplayLeft}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding DisplayTop}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ImageElementViewModel}">
                                    <Border Width="{Binding DisplayWidth}"
                                            Height="{Binding DisplayHeight}"
                                            BorderThickness="1"
                                            CornerRadius="2"
                                            Cursor="Hand"
                                            MouseLeftButtonDown="ImageOverlay_MouseLeftButtonDown">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#33D97706"/>
                                                <Setter Property="BorderBrush" Value="#66D97706"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="#55D97706"/>
                                                        <Setter Property="BorderBrush" Value="#D97706"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding AnnotationElements}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding DisplayLeft}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding DisplayTop}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:AnnotationElementViewModel}">
                                    <Border Width="{Binding DisplayWidth}"
                                            Height="{Binding DisplayHeight}"
                                            BorderThickness="1"
                                            CornerRadius="2"
                                            Cursor="Hand"
                                            MouseLeftButtonDown="AnnotationOverlay_MouseLeftButtonDown">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#339333EA"/>
                                                <Setter Property="BorderBrush" Value="#669333EA"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="#559333EA"/>
                                                        <Setter Property="BorderBrush" Value="#9333EA"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding FormFields}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding DisplayLeft}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding DisplayTop}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasBounds}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:FormFieldViewModel}">
                                    <Border Width="{Binding DisplayWidth}"
                                            Height="{Binding DisplayHeight}"
                                            BorderThickness="1"
                                            CornerRadius="2"
                                            Cursor="Hand"
                                            MouseLeftButtonDown="FormFieldOverlay_MouseLeftButtonDown">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#3316A34A"/>
                                                <Setter Property="BorderBrush" Value="#6616A34A"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="#5516A34A"/>
                                                        <Setter Property="BorderBrush" Value="#16A34A"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding TextElements}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding DisplayLeft}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding DisplayTop}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TextElementViewModel}">
                                    <Border Width="{Binding DisplayWidth}"
                                            Height="{Binding DisplayHeight}"
                                            BorderThickness="1"
                                            CornerRadius="2"
                                            Cursor="Hand"
                                            MouseLeftButtonDown="TextOverlay_MouseLeftButtonDown">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#332563EB"/>
                                                <Setter Property="BorderBrush" Value="#662563EB"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="#552563EB"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12"
                    Margin="8,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="텍스트 속성" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <TextBlock Text="선택된 텍스트" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding SelectedTextElement.Text, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="72"
                                 Margin="0,0,0,12"
                                 IsEnabled="{Binding HasDocument}"/>
                        <TextBlock Text="폰트" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding SelectedTextElement.FontName, TargetNullValue=-}"
                                   Margin="0,0,0,12"/>
                        <TextBlock Text="크기 (pt)" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding SelectedTextElement.FontSize, StringFormat={}{0:F1}}"
                                   Margin="0,0,0,16"/>

                        <Separator Margin="0,0,0,12"/>
                        <TextBlock Text="이미지 속성" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <TextBlock Text="XObject" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding SelectedImageElement.XObjectName, TargetNullValue=-}"
                                   Margin="0,0,0,12"/>
                        <TextBlock Text="너비 (pt)" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding SelectedImageElement.Width, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,8"
                                 IsEnabled="{Binding HasSelectedImage}"/>
                        <TextBlock Text="높이 (pt)" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding SelectedImageElement.Height, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,8"
                                 IsEnabled="{Binding HasSelectedImage}"/>
                        <TextBlock Text="교체 파일" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding SelectedImageElement.ReplacementPath, Mode=OneWay}"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 Margin="0,0,0,8"/>
                        <Button Content="이미지 교체..."
                                Command="{Binding ReplaceImageCommand}"
                                Padding="12,6"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,16"/>

                        <Separator Margin="0,0,0,12"/>
                        <TextBlock Text="주석 속성" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <TextBlock Text="유형" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding SelectedAnnotationElement.Subtype, TargetNullValue=-}"
                                   Margin="0,0,0,12"/>
                        <TextBlock Text="제목 (Subject)" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding SelectedAnnotationElement.Subject, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,8"
                                 IsEnabled="{Binding HasSelectedAnnotation}"/>
                        <TextBlock Text="내용 (Contents)" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding SelectedAnnotationElement.Contents, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="72"
                                 Margin="0,0,0,16"
                                 IsEnabled="{Binding HasSelectedAnnotation}"/>

                        <Separator Margin="0,0,0,12"/>
                        <TextBlock Text="폼 필드 속성" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <TextBlock Text="필드 이름" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding SelectedFormField.Name, TargetNullValue=-}"
                                   Margin="0,0,0,12"/>
                        <TextBlock Text="유형" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding SelectedFormField.FieldType, TargetNullValue=-}"
                                   Margin="0,0,0,12"/>
                        <CheckBox Content="체크됨"
                                  IsChecked="{Binding SelectedFormField.IsChecked}"
                                  Margin="0,0,0,8"
                                  IsEnabled="{Binding HasSelectedFormField}">
                            <CheckBox.Style>
                                <Style TargetType="CheckBox">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedFormField.IsCheckbox}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </CheckBox.Style>
                        </CheckBox>
                        <TextBlock Text="값" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding SelectedFormField.Value, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap"
                                 MinHeight="48"
                                 Margin="0,0,0,16"
                                 IsEnabled="{Binding HasSelectedFormField}">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedFormField.IsCheckbox}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <Separator Margin="0,0,0,12"/>
                        <TextBlock Text="OCR" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="Tesseract 언어" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding OcrLanguages, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,8"
                                 IsEnabled="{Binding HasDocument}"/>
                        <Button Content="현재 페이지 OCR"
                                Command="{Binding OcrCurrentPageCommand}"
                                Padding="12,6"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,8"/>
                        <Button Content="스캔 페이지 전체 OCR"
                                Command="{Binding OcrAllPagesCommand}"
                                Padding="12,6"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,16"/>

                        <Separator Margin="0,0,0,12"/>
                        <TextBlock Text="찾을 텍스트" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding FindText, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,8"
                                 IsEnabled="{Binding HasDocument}"/>
                        <TextBlock Text="바꿀 텍스트" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding ReplaceText, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,8"
                                 IsEnabled="{Binding HasDocument}"/>
                        <CheckBox Content="대소문자 구분"
                                  IsChecked="{Binding MatchCase}"
                                  Margin="0,0,0,8"
                                  IsEnabled="{Binding HasDocument}"/>
                        <Button Content="모두 바꾸기"
                                Command="{Binding FindAndReplaceCommand}"
                                Padding="12,6"
                                HorizontalAlignment="Stretch"
                                IsEnabled="{Binding HasDocument}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
