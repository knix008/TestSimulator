<Window x:Class="PDFEditor.App.Dialogs.ErrorDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="오류"
        SizeToContent="Height"
        Width="640"
        MinWidth="480"
        MinHeight="280"
        MaxHeight="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="White">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleTextBlock"
                   Grid.Row="0"
                   Text="오류가 발생했습니다."
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="#111827"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"/>

        <Border Grid.Row="1"
                BorderBrush="#D1D5DB"
                BorderThickness="1"
                CornerRadius="4"
                Background="White"
                Margin="0,0,0,16">
            <TextBox x:Name="DetailsTextBox"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     BorderThickness="0"
                     Background="White"
                     Foreground="#111827"
                     FontFamily="Consolas"
                     FontSize="12"
                     Padding="10"
                     MinHeight="160"
                     MaxHeight="480"/>
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="내용 복사"
                    Click="CopyButton_Click"
                    Padding="16,8"
                    Margin="0,0,8,0"
                    MinWidth="96"/>
            <Button Content="닫기"
                    Click="CloseButton_Click"
                    Padding="16,8"
                    MinWidth="96"
                    IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
