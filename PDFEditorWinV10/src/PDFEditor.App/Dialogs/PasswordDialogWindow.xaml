<Window x:Class="PDFEditor.App.Dialogs.PasswordDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PDF 암호"
        SizeToContent="Height"
        Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="White">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="MessageTextBlock"
                   Grid.Row="0"
                   TextWrapping="Wrap"
                   Foreground="#111827"
                   Margin="0,0,0,12"/>

        <PasswordBox x:Name="PasswordBox"
                     Grid.Row="1"
                     Padding="8,6"
                     Margin="0,0,0,8"/>

        <TextBlock x:Name="ErrorTextBlock"
                   Grid.Row="2"
                   Foreground="#B91C1C"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"
                   Visibility="Collapsed"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="취소"
                    Click="CancelButton_Click"
                    Padding="16,8"
                    Margin="0,0,8,0"
                    MinWidth="88"
                    IsCancel="True"/>
            <Button Content="확인"
                    Click="OkButton_Click"
                    Padding="16,8"
                    MinWidth="88"
                    IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
