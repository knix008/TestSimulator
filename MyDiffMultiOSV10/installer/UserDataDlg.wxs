<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <UI>
      <Dialog Id="UserDataDlg"
              Width="370"
              Height="270"
              Title="!(loc.UserDataDlg_Title)">
        <Control Id="Next"
                   Type="PushButton"
                   X="236"
                   Y="243"
                   Width="56"
                   Height="17"
                   Default="yes"
                   Text="!(loc.WixUINext)" />
        <Control Id="Cancel"
                   Type="PushButton"
                   X="304"
                   Y="243"
                   Width="56"
                   Height="17"
                   Cancel="yes"
                   Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
        <Control Id="BannerBitmap"
                   Type="Bitmap"
                   X="0"
                   Y="0"
                   Width="370"
                   Height="44"
                   TabSkip="yes"
                   Text="!(loc.UserDataDlgBannerBitmap)" />
        <Control Id="BannerLine"
                   Type="Line"
                   X="0"
                   Y="44"
                   Width="370"
                   Height="0" />
        <Control Id="BottomLine"
                   Type="Line"
                   X="0"
                   Y="234"
                   Width="370"
                   Height="0" />
        <Control Id="Back"
                   Type="PushButton"
                   X="180"
                   Y="243"
                   Width="56"
                   Height="17"
                   Text="!(loc.WixUIBack)" />
        <Control Id="Title"
                   Type="Text"
                   X="20"
                   Y="55"
                   Width="330"
                   Height="20"
                   Transparent="yes"
                   NoPrefix="yes"
                   Text="!(loc.UserDataDlgTitle)" />
        <Control Id="UpgradeDescription"
                   Type="Text"
                   X="20"
                   Y="80"
                   Width="330"
                   Height="40"
                   Transparent="yes"
                   NoPrefix="yes"
                   Text="!(loc.UserDataDlgUpgradeDescription)"
                   ShowCondition="WIX_UPGRADE_DETECTED"
                   HideCondition="NOT WIX_UPGRADE_DETECTED" />
        <Control Id="RemoveDescription"
                   Type="Text"
                   X="20"
                   Y="80"
                   Width="330"
                   Height="40"
                   Transparent="yes"
                   NoPrefix="yes"
                   Text="!(loc.UserDataDlgRemoveDescription)"
                   ShowCondition="REMOVE=&quot;ALL&quot;"
                   HideCondition="REMOVE&lt;&gt;&quot;ALL&quot;" />
        <Control Id="InstallDescription"
                   Type="Text"
                   X="20"
                   Y="80"
                   Width="330"
                   Height="40"
                   Transparent="yes"
                   NoPrefix="yes"
                   Text="!(loc.UserDataDlgInstallDescription)"
                   ShowCondition="EXISTINGUSERDATA AND NOT WIX_UPGRADE_DETECTED AND REMOVE&lt;&gt;&quot;ALL&quot;"
                   HideCondition="NOT EXISTINGUSERDATA OR WIX_UPGRADE_DETECTED OR REMOVE=&quot;ALL&quot;" />
        <Control Id="RemoveUserDataCheck"
                   Type="CheckBox"
                   X="20"
                   Y="155"
                   Width="330"
                   Height="17"
                   Property="REMOVEUSERDATA"
                   CheckBoxValue="1"
                   Text="!(loc.UserDataDlgCheckBox)"
                   ShowCondition="EXISTINGUSERDATA"
                   HideCondition="NOT EXISTINGUSERDATA" />
        <Control Id="FolderDescription"
                   Type="Text"
                   X="20"
                   Y="120"
                   Width="330"
                   Height="30"
                   Transparent="yes"
                   NoPrefix="yes"
                   Text="!(loc.UserDataDlgFolderDescription)"
                   ShowCondition="EXISTINGUSERDATA"
                   HideCondition="NOT EXISTINGUSERDATA" />
      </Dialog>
    </UI>
  </Fragment>
</Wix>
