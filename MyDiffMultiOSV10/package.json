{
  "name": "mydiff",
  "version": "10.0.0",
  "private": true,
  "type": "module",
  "description": "MyDiff — cross-platform 2-way file, directory and git diff viewer",
  "author": "Suho Kwon",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "start": "node scripts/dev.mjs desktop",
    "dev": "node scripts/dev.mjs desktop",
    "dev:web": "node scripts/dev.mjs web",
    "serve": "node dist-server/cli.mjs",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/generate-icons.mjs",
    "build:ui": "vite build",
    "build:server": "node scripts/bundle-server.mjs",
    "build": "npm run icons && npm run build:ui && npm run build:server",
    "preview": "npm run build && node scripts/preview.mjs",
    "pack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "build:all": "npm run build && electron-builder --win --mac --linux"
  },
  "dependencies": {
    "express": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.2"
  },
  "engines": {
    "node": ">=20.19"
  }
}
