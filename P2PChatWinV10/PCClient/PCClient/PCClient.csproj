<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>daemon_hammer.ico</ApplicationIcon>
    <StartupObject />
  </PropertyGroup>

  <ItemGroup>
    <Content Include="daemon_hammer.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Net.WebSockets.Client" Version="4.3.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>


  <Target Name="BuildInstaller" AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release' AND '$(InstallerBuildInProgress)' != 'true'">
    <Message Text="MSI 인스톨러 빌드 시작..." Importance="high" />
    <Exec Command="dotnet build &quot;$(MSBuildThisFileDirectory)..\PCClient.Installer\PCClient.Installer.wixproj&quot; -c Release -p:Platform=x86 -p:InstallerBuildInProgress=true"
          WorkingDirectory="$(MSBuildThisFileDirectory)" />
    <Message Text="MSI 생성 완료: PCClient.Installer\bin\x86\Release\PCClientInstaller.msi" Importance="high" />
  </Target>

</Project>
