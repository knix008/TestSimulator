{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyAudioMaker",
  "mainBinaryName": "MyAudioMaker",
  "version": "../package.json",
  "identifier": "com.shkwon.myaudiomaker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5494",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$APPLOCALDATA/**",
          "$APPCONFIG/**",
          "$RESOURCE/doc/video/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "SHKWON",
    "copyright": "Copyright (c) SHKWON (knix008@naver.com)",
    "category": "Music",
    "shortDescription": "AI music and lyrics maker",
    "longDescription": "Compose whole songs with AI: lyrics in Korean or English (built-in writer, Claude or Ollama), melody, chords, accompaniment, bass and drums in 18 genres. Edit in the arrangement, piano roll, lyrics editor and lead sheet; listen with the built-in synthesizer and guide voice; export WAV, stems, MIDI and LRC; print lead sheets, lyrics and chord charts.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "icons/project.ico": "project.ico",
      "icons/project.icns": "project.icns",
      "icons/project.png": "project.png",
      "../doc/": "doc/",
      "../samples/": "samples/",
      "../licenses/": "licenses/"
    },
    "fileAssociations": [
      {
        "ext": [
          "mam"
        ],
        "name": "MyAudioMaker.Song",
        "description": "MyAudioMaker Song",
        "mimeType": "application/x-myaudiomaker",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Korean",
          "English"
        ],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "headerImage": "windows/installerHeader.bmp",
        "sidebarImage": "windows/installerSidebar.bmp",
        "installerHooks": "windows/hooks.nsh",
        "startMenuFolder": "MyAudioMaker"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ],
        "files": {
          "/usr/share/mime/packages/myaudiomaker.xml": "linux/myaudiomaker.xml",
          "/usr/share/icons/hicolor/256x256/mimetypes/application-x-myaudiomaker.png": "icons/project.png"
        },
        "postInstallScript": "linux/postinst.sh",
        "postRemoveScript": "linux/postrm.sh"
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3"
        ],
        "files": {
          "/usr/share/mime/packages/myaudiomaker.xml": "linux/myaudiomaker.xml",
          "/usr/share/icons/hicolor/256x256/mimetypes/application-x-myaudiomaker.png": "icons/project.png"
        },
        "postInstallScript": "linux/postinst.sh",
        "postRemoveScript": "linux/postrm.sh"
      }
    }
  }
}
